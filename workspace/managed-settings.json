{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(//home/claude/.ssh/**)",
      "Read(//home/claude/.config/fraim/**)",
      "Read(//home/claude/.claude/.credentials.json)",
      "Read(//home/claude/.claude.json)",
      "Read(//etc/fraim/**)",
      "Edit(//home/claude/.config/fraim/**)",
      "Edit(//home/claude/.ssh/**)",
      "Edit(//home/claude/.claude/settings.json)",
      "Bash(sudo:*)",
      "Bash(fraim-brain apply:*)",
      "Bash(fraim-brain discard:*)",
      "Bash(fraim-brain skill install:*)",
      "Bash(fraim-brain skill discard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/fraim-audit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/fraim-guard"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
