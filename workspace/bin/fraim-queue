<body>
<div class="app">
  <section class="pane list"><div class="lh"><h1>Inbox</h1><a href="/team">Team</a></div><div class="tabs" id="tabs"></div><div class="scroll" id="list"></div></section>
  <main class="pane"><div class="scroll" id="message"></div></main>
  <aside class="pane agents"><div id="agents" class="pane" style="flex:1"></div><div class="reply" id="reply"><textarea id="say" rows="1" placeholder="Write to the agents"></textarea></div></aside>
</div>
<div class="toast" id="toast" role="status"></div>
<script>
var rows = [], cur = null, tab = 'all', data = null, midKey = '', sideKey = '', listKey = '', seen = null, chief = null, chatKey = '', chiefTimer = null
var quote = {}, orig = {}, imgs = {}, opened = {}, allOlder = {}
var TABS = [['all', 'All'], ['need', 'Needs you'], ['work', 'Working'], ['done', 'Done']]
var TAG = { need: ['Needs you', 'need'], work: ['Working', 'work'], new: ['New', 'new'] }
var COLORS = ['#6f7bf0', '#a27ce8', '#2f8fb0', '#c9772e', '#3aa577', '#b0568f', '#7a8a3a', '#d9484d', '#5b8def']
function $(s) { return document.querySelector(s) }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] }) }
function links(s) { return esc(s).replace(/https?:\/\/[^\s<]+/g, function (u) { return '<a href="' + u + '" target="_blank" rel="noopener">' + u + '</a>' }) }
function hue(n) { var h = 0; String(n).split('').forEach(function (c) { h = (h * 31 + c.charCodeAt(0)) >>> 0 }); return COLORS[h % COLORS.length] }
function initials(n) { var p = String(n).trim().split(/\s+/); return esc(((p[0] || '?').charAt(0) + (p.length > 1 ? p[p.length - 1].charAt(0) : (p[0] || '').charAt(1))).toUpperCase()) }
function av(n) { return '<span class="av" style="--c:' + hue(n) + '">' + initials(n) + '</span>' }
function when(d, short) {
  var t = new Date(String(d || '').replace(' at ', ' '))
  if (isNaN(t)) return esc(d || '')
  var hm = t.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false })
  if (t.toDateString() === new Date().toDateString()) return short ? hm : 'Today ' + hm
  var day = t.toLocaleDateString([], { day: 'numeric', month: 'short' })
  return short ? day : day + ', ' + hm
}
function toast(t) { var e = $('#toast'); e.textContent = t; e.style.display = 'block'; clearTimeout(toast.t); toast.t = setTimeout(function () { e.style.display = 'none' }, 3000) }
function shown() { return rows.filter(function (r) { return tab === 'all' ? !(r.kind === 'item' && r.state === 'done') : r.state === tab || (tab === 'work' && r.state === 'new') }) }
function drawList() {
  var key = JSON.stringify([rows, cur, tab, chief && chief.typing, chief && chief.messages.length]); if (key === listKey) return; listKey = key
  $('#tabs').innerHTML = TABS.map(function (x) { return '<button data-t="' + x[0] + '" class="' + (tab === x[0] ? 'on' : '') + '">' + x[1] + '</button>' }).join('')
  var l = shown()
  $('#list').innerHTML = pinHtml() + (l.length ? l.map(function (r) {
    var g = TAG[r.state]
    return '<button class="msg' + (r.unread ? ' unread' : '') + (r.id === cur ? ' on' : '') + '" data-id="' + esc(r.id) + '">' + av(r.who) + '<span style="min-width:0"><span class="top"><span class="from">' + esc(r.who) + '</span><span class="time">' + when(r.time, true) + '</span></span><span class="top"><span class="subj">' + esc(r.title) + '</span>' + (g ? '<span class="tag ' + g[1] + '">' + g[0] + '</span>' : '') + '</span><span class="snip">' + esc(r.snippet) + '</span></span></button>'
  }).join('') : '<div class="none">Nothing here.</div>')
}
function pinHtml() {
  if (!chief || !chief.exists) return ''
  var last = chief.messages[chief.messages.length - 1]
  var snip = chief.typing ? 'Typing' : last ? (last.who === 'owner' ? 'You: ' : '') + last.text.replace(/\s+/g, ' ') : 'Ask me anything.'
  return '<button class="msg pin' + (cur === 'chief' ? ' on' : '') + '" data-id="chief">' + av('Chief of staff') + '<span style="min-width:0"><span class="top"><span class="from" style="color:var(--ink);font-weight:600">Chief of staff</span>' + (last ? '<span class="time">' + when(last.time.replace(' ', 'T'), true) + '</span>' : '') + '</span><span class="snip">' + esc(snip) + '</span></span></button>'
}
function spoken(t) { return links(t).replace(/(^|\s)\*(\S[^*\n]*)\*/g, '$1<b>$2</b>') }
function bubble(m) {
  var me = m.who === 'owner'
  return '<div class="row' + (me ? ' me' : '') + '"><div class="bub">' + spoken(m.text) + (m.refs || []).map(function (r) { return '<button class="ref" data-go="' + esc(r.id) + '">' + esc(r.title) + '</button>' }).join('') + '<small>' + when(m.time.replace(' ', 'T'), true) + (me && !m.app ? ', on WhatsApp' : '') + '</small></div></div>'
}
function drawChief() {
  if (!chief) return
  if (!$('#clines')) {
    chatKey = ''
    $('#message').innerHTML = '<div class="talk"><div class="th">' + av('Chief of staff') + '<div><b>Chief of staff</b><small>Same conversation as on WhatsApp</small></div></div><div class="lines" id="clines"></div><div class="box"><textarea id="csay" rows="1" placeholder="Message your chief of staff"></textarea></div></div>'
  }
  var key = JSON.stringify([chief.messages, chief.typing]); if (key === chatKey) return
  chatKey = key
  var box = $('#clines'), end = !box.innerHTML || box.scrollTop + box.clientHeight >= box.scrollHeight - 40
  box.innerHTML = (chief.messages.length ? chief.messages.map(bubble).join('') : '<div class="none">Ask me anything.</div>') + (chief.typing ? '<div class="dots">Chief of staff is typing</div>' : '')
  if (end) box.scrollTop = box.scrollHeight
}
async function loadChief() {
  var r = await fetch('/api/chief').catch(function () {})
  if (!r || !r.ok) return
  chief = await r.json()
  if (cur === 'chief') drawChief()
  if (chief.typing && !chiefTimer) chiefTimer = setTimeout(function () { chiefTimer = null; loadChief().then(drawList) }, 1500)
}

function page(m, i) {
  var csp = "default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data: cid:" + (imgs[i] ? ' https: http:' : '')
  var doc = '<!doctype html><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="' + csp + '"><base target="_blank"><style>html,body{margin:0;background:#fff;color:#111;font:14px/1.5 sans-serif}body{padding:12px}img{max-width:100%;height:auto}</style>' + m.html
  return '<iframe class="sheet" title="The original mail" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="' + esc(doc) + '"></iframe>'
}
function mailBody(m, i) {
  var sheet = m.html && (orig[i] === undefined ? m.designed : orig[i])
  var out = sheet ? page(m, i) : '<div class="text">' + (m.text ? links(m.text) : '<span style="color:var(--muted)">There is no text in this mail.</span>') + '</div>'
  if (!sheet && m.quoted) out += quote[i] ? '<div class="quoted">' + links(m.quoted) + '</div><button class="link" data-quote="' + i + '">Hide earlier text</button>' : '<button class="link" data-quote="' + i + '">Show earlier text</button>'
  if (m.html) out += '<button class="link" data-orig="' + i + '">' + (sheet ? 'Show as plain text' : 'Show the original') + '</button>'
  if (sheet) out += '<button class="link" data-img="' + i + '">' + (imgs[i] ? 'Hide pictures' : 'Show pictures') + '</button>'
  if (m.attachments && m.attachments.length) out += '<div class="files">' + m.attachments.map(function (a) { return '<span class="file">' + esc(a.name) + '<small>' + esc(a.size) + '</small></span>' }).join('') + '</div>'
  return out
}
function mailOpen(m, i) {
  return '<div class="mail">' + (m.forwardedBy ? '<div class="fwd">Forwarded by ' + esc(m.forwardedBy) + (m.forwardNote ? ': ' + esc(m.forwardNote) : '') + '</div>' : '') +
    '<div class="who">' + av(m.from) + '<div style="min-width:0"><b>' + esc(m.from) + '</b> <small>' + esc(m.address) + '</small>' + (m.to ? '<br><small>to ' + esc(m.to.replace(/<[^>]*>/g, '').trim()) + '</small>' : '') + '</div><span class="d">' + when(m.date) + '</span></div>' + mailBody(m, i) + '</div>'
}
function drawMail(t) {
  var ms = t.messages, last = ms.length - 1, html = '<h2>' + esc(t.title) + '</h2>'
  var hide = last > 3 && !allOlder[t.id]
  ms.forEach(function (m, i) {
    if (hide && i > 0 && i < last - 1) { if (i === 1) html += '<button class="more" data-older="1">' + (last - 2) + ' earlier messages</button>'; return }
    if (i === last || opened[t.id + i]) html += (i === last ? '' : '<button class="link" data-fold="' + i + '" style="margin:10px 0 0">Fold</button>') + mailOpen(m, i)
    else html += '<button class="fold" data-fold="' + i + '">' + av(m.from) + '<b>' + esc(m.from) + '</b><span class="sn">' + esc(m.text.replace(/\s+/g, ' ')) + '</span><small>' + when(m.date) + '</small></button>'
  })
  return html
}
function chips(t) {
  var f = t.fields || {}, keys = Object.keys(f).filter(function (k) { return f[k] })
  return keys.length ? '<div class="chips">' + keys.map(function (k) { return '<span class="chip"><b>' + esc(k) + '</b>' + esc(f[k]) + '</span>' }).join('') + '</div>' : ''
}
function drawLinear(t) {
  return '<h2>' + esc(t.title) + '</h2>' + chips(t) + '<div class="who">' + av(t.who) + '<div><b>' + esc(t.who) + '</b><br><small>opened this issue</small></div><span class="d">' + when(t.created) + '</span></div><div class="text">' + links(t.text) + '</div>' +
    (t.comments || []).map(function (c) { return '<div class="cm"><b>' + esc(c.who) + '</b><small>' + when(c.time) + '</small><br>' + links(c.text) + '</div>' }).join('')
}
function drawError(t) {
  var s = t.stats || {}
  return '<h2>' + esc(t.title) + '</h2><div class="stats"><div class="stat"><b>' + esc(s.count || 1) + '</b><span>times so far</span></div><div class="stat"><b>' + when(s.first || t.created, true) + '</b><span>first time</span></div><div class="stat"><b>' + when(s.last || t.created, true) + '</b><span>last time</span></div></div>' + chips(t) + '<div class="text">' + links(t.text) + '</div>' +
    (t.details ? '<details class="tech"><summary>Technical details</summary><pre>' + esc(t.details) + '</pre></details>' : '')
}
function drawCard(t) {
  return '<h2>' + esc(t.title || '(no subject)') + '</h2>' + chips(t) + '<div class="who">' + av(t.who || '?') + '<div><b>' + esc(t.who || 'Someone') + '</b></div><span class="d">' + when(t.created) + '</span></div><div class="text">' + (t.text ? links(t.text) : '<span style="color:var(--muted)">There is no text with this.</span>') + '</div>' +
    (t.media || []).map(function (m) { var src = '/media/' + t.id + '/' + encodeURIComponent(m); return /\.(webm|mp4|mov)$/i.test(m) ? '<video class="shot" controls preload="metadata" src="' + src + '"></video>' : '<img class="shot" alt="" src="' + src + '">' }).join('') +
    ((t.links || []).length ? '<div class="files">' + t.links.map(function (u) { return '<a class="file" target="_blank" rel="noopener" href="' + esc(/^https?:/i.test(u) ? u : '#') + '">' + esc(u) + '</a>' }).join('') + '</div>' : '')
}
var LAYOUT = { email: drawMail, linear: drawLinear, error: drawError }
function sizeSheets() {
  document.querySelectorAll('iframe.sheet').forEach(function (f) {
    var fit = function () { try { f.style.height = Math.max(120, f.contentDocument.documentElement.scrollHeight) + 'px' } catch (e) {} }
    f.addEventListener('load', function () { fit(); setTimeout(fit, 400) })
  })
}
function drawMiddle(force) {
  var t = data; if (!t) { $('#message').innerHTML = '<div class="none">Choose a message on the left.</div>'; return }
  var key = JSON.stringify([t.id, t.title, t.who, t.text, t.fields, t.messages, t.comments, t.stats, t.details, t.media, t.links])
  if (key === midKey && !force) return
  midKey = key
  var box = $('#message'), top = box.scrollTop, html
  try {
    var draw = t.kind === 'email' && !t.messages.length ? drawCard : (LAYOUT[t.kind] || drawCard)
    html = draw(t)
  } catch (e) { html = drawCard({ id: t.id, title: t.title, who: t.who, created: t.created, text: t.text }) }
  box.innerHTML = '<div class="body">' + html + '</div>'
  sizeSheets()
  if (force) box.scrollTop = top; else box.scrollTop = 0
}
function chatHtml(c) {
  var time = when(c.time, true)
  if (c.from === 'You') return '<div class="row me"><div class="bub">' + esc(c.text) + '<small>' + time + '</small></div></div>'
  var i = c.item, open = i && i.state === 'open'
  if (!i && c.to !== 'You') return '<div class="c side">' + av(c.from) + '<div><div class="n"><em>' + esc(c.from) + '</em> to <em>' + esc(c.to || 'the team') + '</em><small>' + time + '</small></div><div class="b">' + esc(c.text) + '</div></div></div>'
  var head = '<div class="n">' + esc(c.from) + '<small>' + time + '</small></div>'
  if (!i) return '<div class="c">' + av(c.from) + '<div>' + head + '<div class="ask"><div class="foryou">For you</div>' + esc(c.text) + '</div></div></div>'
  return '<div class="c">' + av(c.from) + '<div>' + head + '<div class="ask' + (open ? '' : ' closed') + '">' + (open ? '<div class="foryou">For you</div>' : '') + esc(i.ask || i.title) + (i.need ? '<p>' + esc(i.need) + '</p>' : '') + (i.if_yes ? '<p>If yes: ' + esc(i.if_yes) + '</p>' : '') +
    (open ? '<div class="acts"><button class="btn p" data-v="approved" data-item="' + esc(i.id) + '">Yes</button><button class="btn" data-v="dismissed" data-item="' + esc(i.id) + '">No</button></div>' : '') + '</div></div></div>'
}
function drawAgents() {
  var t = data; if (!t) { $('#agents').innerHTML = ''; return }
  var key = JSON.stringify([t.id, t.chat, t.working]); if (key === sideKey) return
  var same = sideKey && JSON.parse(sideKey)[0] === t.id
  sideKey = key
  var waiting = t.chat.some(function (c) { return c.item && c.item.state === 'open' })
  var status = waiting ? 'Needs your answer' : t.working.length ? t.working.join(', ') + (t.working.length > 1 ? ' are' : ' is') + ' working on it. Nothing needed from you.' : t.chat.length ? 'Nothing needed from you.' : 'No agent has picked this up yet'
  var old = $('#chat'), atEnd = !old || old.scrollTop + old.clientHeight >= old.scrollHeight - 30
  $('#agents').innerHTML = '<div class="ah"><b>Agents on this</b><div>' + esc(status) + '</div></div><div class="scroll" id="chat"><div class="chat">' + t.chat.map(chatHtml).join('') +
    (t.working.length ? '<div class="typing">' + esc(t.working[0]) + ' is working on it</div>' : '') + '</div></div>'
  var box = $('#chat'); if (!same || atEnd) box.scrollTop = box.scrollHeight
  $('#reply').style.display = /^t/.test(t.id) ? '' : 'none'
}
function tellApp() {
  var h = window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.fraim
  if (!h) return
  var open = rows.filter(function (r) { return r.state === 'need' })
  var fresh = seen ? open.filter(function (r) { return !seen[r.id] }) : []
  seen = {}; open.forEach(function (r) { seen[r.id] = true })
  try { h.postMessage({ count: open.length, fresh: fresh.slice(0, 5).map(function (r) { return { id: r.id, title: r.title, body: r.snippet } }) }) } catch (e) {}
}
async function loadRows() {
  var r = await fetch('/api/threads').catch(function () {})
  if (!r) return
  if (!r.ok) { $('#message').innerHTML = '<div class="none">No access. Ask Claude for your queue link.</div>'; return }
  rows = await r.json(); tellApp()
  await loadChief()
  if (!cur && chief && chief.exists) await pick('chief', true)
  else if (cur !== 'chief' && (!cur || !rows.some(function (x) { return x.id === cur }))) { var f = shown()[0]; if (f) await pick(f.id, true) }
  drawList()
}
async function loadDetail() {
  if (!cur || cur === 'chief') return
  var id = cur, r = await fetch('/api/threads/' + id).catch(function () {})
  if (!r || !r.ok || id !== cur) return
  data = await r.json(); drawMiddle(); drawAgents()
}
async function pick(id, keepUnread) {
  cur = id; midKey = ''; sideKey = ''; quote = {}; orig = {}; imgs = {}
  $('.app').classList.toggle('solo', id === 'chief')
  if (id === 'chief') { drawChief(); drawList(); return }
  await loadDetail()
  if (!keepUnread && /^t/.test(id)) {
    fetch('/api/threads/' + id + '/seen', { method: 'POST', headers: { 'X-Fraim-Queue': '1' } }).catch(function () {})
    rows.forEach(function (r) { if (r.id === id) r.unread = false })
  }
  drawList()
}
async function post(url, body) {
  var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Fraim-Queue': '1' }, body: JSON.stringify(body) }).catch(function () {})
  if (!r || !r.ok) { toast('That did not work. Try again.'); return false }
  return true
}
function move(step) { var l = shown(), i = l.findIndex(function (r) { return r.id === cur }), n = l[i + step]; if (n) pick(n.id) }
$('#list').addEventListener('click', function (e) { var b = e.target.closest('.msg'); if (b) pick(b.dataset.id) })
$('#tabs').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; tab = b.dataset.t; var f = shown()[0]; if (f && !shown().some(function (r) { return r.id === cur })) pick(f.id); else drawList() })
$('#message').addEventListener('click', function (e) {
  var b = e.target.closest('button'); if (!b) return
  var d = b.dataset
  if (d.go) { pick(d.go); return }
  if (d.quote) quote[d.quote] = !quote[d.quote]
  else if (d.orig) { var m = data.messages[+d.orig]; orig[d.orig] = !(orig[d.orig] === undefined ? m.designed : orig[d.orig]) }
  else if (d.img) imgs[d.img] = !imgs[d.img]
  else if (d.older) allOlder[data.id] = true
  else if (d.fold) opened[data.id + d.fold] = !opened[data.id + d.fold]
  else return
  drawMiddle(true)
})
$('#agents').addEventListener('click', async function (e) {
  var b = e.target.closest('button[data-v]'); if (!b) return
  if (await post('/api/items/' + b.dataset.item + '/decide', { verdict: b.dataset.v, note: '' })) { sideKey = ''; loadRows(); loadDetail() }
})
$('#message').addEventListener('keydown', async function (e) {
  if (e.target.id !== 'csay' || e.key !== 'Enter' || e.shiftKey) return
  e.preventDefault()
  var ta = e.target, text = ta.value.trim(); if (!text) return
  ta.value = ''
  chief.messages.push({ who: 'owner', text: text, time: new Date().toISOString(), app: true, refs: [] }); chief.typing = true; drawChief(); drawList()
  if (!await post('/api/chief/say', { text: text })) { ta.value = text; return }
  setTimeout(loadChief, 800)
})
$('#say').addEventListener('keydown', async function (e) {
  if (e.key !== 'Enter' || e.shiftKey) return
  e.preventDefault()
  var ta = e.target, text = ta.value.trim(); if (!text || !cur) return
  if (await post('/api/threads/' + cur + '/say', { text: text })) { ta.value = ''; loadDetail(); loadRows() }
})
document.addEventListener('keydown', function (e) {
  if (e.target.tagName === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return
  if (e.key === 'j' || e.key === 'ArrowDown') { e.preventDefault(); move(1) }
  if (e.key === 'k' || e.key === 'ArrowUp') { e.preventDefault(); move(-1) }
})
setInterval(function () { loadRows(); loadDetail() }, 5000)
loadRows()
</script>
</body>
</html>
`

// --- CLI ---------------------------------------------------------------------------------

function parseArgs(argv, multi = []) {
  const out = { _: [] }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--') { out._.push(...argv.slice(i + 1)); break }
    if (!a.startsWith('--')) { out._.push(a); continue }
    const key = a.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase())
    if (['all', 'json', 'quiet', 'result'].includes(key)) { out[key] = true; continue }
    if (i + 1 >= argv.length) usage(`${a} needs a value`)
    const value = argv[++i]
    if (multi.includes(key)) (out[key] ||= []).push(value)
    else out[key] = value
  }
  return out
}

function threadCommand(args) {
  const [what, id, ...words] = args._
  switch (what) {
    case 'mail':
      return captureMail(id, args.quiet).then((r) => console.log(r.thread.id))
    case 'put': {
      const data = JSON.parse(fs.readFileSync(args.file || 0, 'utf8'))
      if (args.kind) data.kind = args.kind
      if (args.key) data.key = args.key
      const r = putThread(data)
      if (r.news && !args.quiet) announce(r)
      return console.log(r.thread.id)
    }
    case 'say':
      if (!id) usage('thread say tN --from WHO [--to WHO] -- TEXT')
      return sayInThread(id, args.from || 'owner', args.to || '', words.join(' '))
    case 'show':
      if (!id) usage('thread show tN')
      return console.log(describeThread(id))
    case 'list':
      return console.log(inboxRows().map((r) => `${r.id}  ${r.state}  ${r.who}  ${r.title}`).join('\n'))
    default:
      usage('thread mail GMAIL_THREAD_ID | put [--kind K] [--key K] [--file F] | say tN --from WHO -- TEXT | show tN | list')
  }
}

function main(argv) {
  const [action, ...rest] = argv
  const args = parseArgs(rest, ['link', 'media', 'why'])
  const id = args._[0]
  switch (action) {
    case 'add': {
      let summary = args.summary || ''
      if (args.summaryFile) summary = fs.readFileSync(args.summaryFile, 'utf8')
      const item = addItem({ ...args, summary, links: args.link, media: args.media })
      if (!args.result || item.state === 'open') console.log(item.id)
      return
    }
    case 'grant': {
      const item = grantRequest(args.title, args.note, args.via === 'whatsapp' ? 'whatsapp' : 'cli')
      console.log(item.id)
      return
    }
    case 'list': {
      let items = rank(allItems().filter((i) => args.all || i.state === 'open'))
      if (args.lead) items = items.filter((i) => i.lead === args.lead)
      if (args.json) return console.log(JSON.stringify(items))
      if (!items.length) return console.log('Nothing waits for you.')
      return console.log(items.slice(0, 50).map(line).join('\n'))
    }
    case 'show': {
      if (!id) usage('show ID')
      const item = readItem(id)
      return console.log(args.json ? JSON.stringify(item) : describe(item))
    }
    case 'approve':
    case 'reject':
    case 'dismiss': {
      if (!id) usage(`${action} ID`)
      const verdict = { approve: 'approved', reject: 'rejected', dismiss: 'dismissed' }[action]
      const item = decide(id, verdict, args.note || args._.slice(1).join(' '), args.via === 'whatsapp' ? 'whatsapp' : 'cli')
      return console.log(`${item.id} ${item.state}${item.follow_up ? `; goal ${item.follow_up} started` : ''}${item.outcome ? `. ${item.outcome}` : ''}`)
    }
    case 'supersede': {
      const closed = supersedeFailed(args.origin, args.by)
      return console.log(closed.length ? `closed ${closed.join(' ')}` : 'nothing to close')
    }
    case 'solved': {
      if (!id) usage('solved ID --proof "<what proves it is solved>"')
      const item = markSolved(id, args.proof)
      return console.log(`${item.id} closed as solved`)
    }
    case 'recovered': {
      const closed = closeRecovered(args.source)
      return console.log(closed.length ? `closed ${closed.join(' ')}` : 'nothing to close')
    }
    case 'prio': {
      if (!id || !args._[1]) usage('prio ID 1|2|3')
      const item = setPriority(id, args._[1])
      return console.log(`${item.id} priority ${item.priority}`)
    }
    case 'url':
      token()
      return console.log(queueUrl())
    case 'thread':
      return threadCommand(args)
    case 'token':
      return console.log(token())
    case 'serve': {
      SERVING = true
      const server = createServer()
      server.on('error', (err) => {
        process.stderr.write(`fraim-queue: ${err.message}\n`)
        process.exit(1)
      })
      server.listen(PORT, process.env.FRAIM_QUEUE_BIND || '0.0.0.0', () => process.stderr.write(`fraim-queue: page on port ${PORT}\n`))
      return
    }
    default:
      usage('add | grant --title T | list | show ID | approve ID | reject ID --note TEXT | dismiss ID | solved ID --proof TEXT | recovered --source S | prio ID N | serve | url')
  }
}

const isMain = process.argv[1] && fs.realpathSync(process.argv[1]) === fs.realpathSync(new URL(import.meta.url).pathname)
if (isMain) {
  const fail = (err) => {
    process.stderr.write(`fraim-queue: ${err.message}\n`)
    process.exit(err instanceof UsageError ? 2 : 1)
  }
  try {
    Promise.resolve(main(process.argv.slice(2))).catch(fail)
  } catch (err) {
    fail(err)
  }
}
