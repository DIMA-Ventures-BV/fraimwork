#!/usr/bin/env node
// fraim-queue: one prioritized list of everything that needs the owner. Goals and lead
// agents add items; the owner clears them in batches on a web page, on WhatsApp or here.
//
//   fraim-queue add --title T [--ask QUESTION] [--advise approve|reject|dismiss] [--why REASON]...
//                   [--summary S | --summary-file F] [--kind review|decision|idea|info|failed]
//                   [--priority 1|2|3] [--source S] [--goal gN] [--lead NAME] [--link URL]...
//                   [--media FILE]... [--on-approve TEXT] [--brain pN | --skill sN] [--switch-on NAME] [--quiet]
//                   [--result] [--continues qN]                 --result: a goal's finished work, added by the
//                                                               server; without a question nothing waits.
//                                                               --continues: the next step of that card's job
//                                                               prints the id (q1, q2, ...)
//   fraim-queue list [--all] [--json] [--lead NAME]   open items, most urgent first
//   fraim-queue show ID [--json]
//   fraim-queue approve ID [--note TEXT]   switches on the item's automation (--switch-on) and runs its
//                                          on-approve step as a goal, if it has them
//   fraim-queue add ... --approved-by qN   the owner already approved qN (last 14 days): the new item
//                                          is approved at once and the owner is told it started
//   fraim-queue grant --title T [--note OWNER_WORDS] [--via whatsapp]
//                                          record a request the owner gave in the chat as their yes
//   fraim-queue reject ID --note TEXT      saves the reason for the brain; reworks the goal behind it
//   fraim-queue dismiss ID                 closes the item, nothing else happens
//   fraim-queue prio ID 1|2|3
//   fraim-queue solved ID --proof TEXT   the chief closes a card that proved solved; nothing else happens
//   fraim-queue recovered --source S     closes the failure cards of an automation that works again
//   fraim-queue serve                      the web page (started by the workspace container)
//   fraim-queue url                        the page address, with its access token
//   fraim-queue thread mail GMAIL_THREAD_ID   save a mail chain as a conversation (--quiet: tell nobody)
//   fraim-queue thread put [--kind K] [--key K] [--file F]   save anything else, JSON on stdin or in F
//   fraim-queue thread say tN --from WHO [--to WHO] -- TEXT  add a line to the agents' chat
//   fraim-queue thread close tN --from WHO --reason TEXT    no work needed; refused while it waits for the owner
//   fraim-queue thread ignore --from ADDRESS|@DOMAIN        keep a sender out for good (~/fraim/inbox-rules.md)
//   fraim-queue thread ignore "RULE"                        an example of what does not belong
//   fraim-queue thread show tN | list
//   fraim-queue thread whatsapp --number N [--name NAME] -- TEXT   a contact wrote (from the WhatsApp channel)
//   fraim-queue reply tN [--file F | -- TEXT] [--lead NAME] [--need WHY] [--priority N]
//                                          draft an answer to whoever wrote in tN; it goes out only when the owner approves
//
// Items live in ~/fraim/queue/<id>/item.json, media next to it. Priority 1 is urgent.
// Exit codes: 0 ok, 1 failure, 2 usage.
import { execFile, execFileSync, spawn, spawnSync } from 'node:child_process'
import crypto from 'node:crypto'
import fs from 'node:fs'
import http from 'node:http'
import path from 'node:path'
import { createSettings } from './fraim-settings.mjs'

const HOME = process.env.HOME || '/home/claude'
const QUEUE = process.env.FRAIM_QUEUE_DIR || path.join(HOME, 'fraim/queue')
const GOALS = process.env.FRAIM_GOALS_DIR || path.join(HOME, 'fraim/goals')
const TOKEN_FILE = path.join(HOME, '.config/fraim/queue-token')
const PORT = parseInt(process.env.FRAIM_QUEUE_PORT || '3109', 10)
const KINDS = ['review', 'decision', 'idea', 'info', 'failed']
const STATES = ['open', 'approved', 'rejected', 'dismissed']
const ADVICE = ['approve', 'reject', 'dismiss']
const MEDIA_TYPES = {
  '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.webp': 'image/webp',
  '.webm': 'video/webm', '.mp4': 'video/mp4', '.mov': 'video/quicktime',
}

class UsageError extends Error {}
function usage(msg) { throw new UsageError(msg) }

// The page server answers one request at a time, so it never waits on a message to send: it
// starts fraim-notify and fraim-lead tell and moves on. The command line waits for them.
let SERVING = false
function fire(cmd, args, env = process.env) {
  if (!SERVING) return void spawnSync(cmd, args, { env, stdio: 'ignore', timeout: 30000 })
  try {
    const child = spawn(cmd, args, { env, stdio: 'ignore' })
    child.on('error', () => {})
    const kill = setTimeout(() => child.kill(), 30000)
    child.on('exit', () => clearTimeout(kill))
  } catch {}
}

function runtimeEnv() {
  const env = {}
  try {
    for (const line of fs.readFileSync(process.env.FRAIM_RUNTIME_ENV || '/etc/fraim/runtime.env', 'utf8').split('\n')) {
      const m = line.match(/^([A-Z_]+)=(.*)$/)
      if (m) env[m[1]] = m[2].replace(/^'(.*)'$/, '$1').replace(/\\(.)/g, '$1')
    }
  } catch {}
  return { ...env, ...process.env }
}

// The command on PATH; otherwise the script next to this one (a checkout without an install).
function tool(name) {
  for (const dir of (process.env.PATH || '').split(':')) {
    if (dir && fs.existsSync(path.join(dir, name))) return name
  }
  try {
    const sibling = path.join(path.dirname(fs.realpathSync(process.argv[1])), name)
    if (fs.existsSync(sibling)) return sibling
  } catch {}
  return name
}

const now = () => new Date().toISOString().replace(/\.\d+Z$/, 'Z')
const validId = (id) => /^q\d{1,6}$/.test(id)
const itemDir = (id) => path.join(QUEUE, id)

function readItem(id) {
  if (!validId(id)) usage(`'${id}' is not a queue id (q1, q2, ...)`)
  try {
    return JSON.parse(fs.readFileSync(path.join(itemDir(id), 'item.json'), 'utf8'))
  } catch {
    throw new Error(`no queue item ${id}`)
  }
}

function writeItem(item) {
  const file = path.join(itemDir(item.id), 'item.json')
  fs.writeFileSync(`${file}.tmp`, JSON.stringify(item, null, 2) + '\n')
  fs.renameSync(`${file}.tmp`, file)
}

function allItems() {
  let names = []
  try { names = fs.readdirSync(QUEUE) } catch { return [] }
  const out = []
  for (const name of names) {
    if (!validId(name)) continue
    try { out.push(JSON.parse(fs.readFileSync(path.join(QUEUE, name, 'item.json'), 'utf8'))) } catch {}
  }
  return out
}

// Open before closed; then priority 1 first; then the oldest first, so nothing waits forever.
export function rank(items) {
  return [...items].sort((a, b) => {
    const ao = a.state === 'open' ? 0 : 1
    const bo = b.state === 'open' ? 0 : 1
    if (ao !== bo) return ao - bo
    if (ao === 1) return (b.decided || '').localeCompare(a.decided || '')
    if (a.priority !== b.priority) return a.priority - b.priority
    return a.created.localeCompare(b.created) || parseInt(a.id.slice(1), 10) - parseInt(b.id.slice(1), 10)
  })
}

function newId() {
  fs.mkdirSync(QUEUE, { recursive: true })
  const last = path.join(QUEUE, '.last')
  let n = 1
  try { n = parseInt(fs.readFileSync(last, 'utf8'), 10) + 1 || 1 } catch {}
  for (;;) {
    try {
      fs.mkdirSync(path.join(QUEUE, `q${n}`))
      break
    } catch (err) {
      if (err.code !== 'EEXIST') throw err
      n++
    }
  }
  fs.writeFileSync(last, `${n}\n`)
  return `q${n}`
}

function copyMedia(dir, files, taken = []) {
  const names = []
  if (!files.length) return names
  fs.mkdirSync(path.join(dir, 'media'), { recursive: true })
  for (const file of files) {
    const ext = path.extname(file).toLowerCase()
    if (!MEDIA_TYPES[ext]) {
      process.stderr.write(`fraim-queue: skipped ${file}: only images and videos can be attached\n`)
      continue
    }
    if (!fs.statSync(file, { throwIfNoEntry: false })?.isFile()) {
      process.stderr.write(`fraim-queue: skipped ${file}: not a file\n`)
      continue
    }
    let name = path.basename(file).replace(/[^\w.-]/g, '_')
    while (names.includes(name) || taken.includes(name)) name = `1-${name}`
    fs.copyFileSync(file, path.join(dir, 'media', name))
    names.push(name)
  }
  return names
}

function queueUrl() {
  const env = runtimeEnv()
  const start = parseInt(String(env.FRAIM_PREVIEW_PORTS || '3100-3109').split('-')[0], 10)
  const port = start + (PORT - 3100)
  let token = ''
  try { token = fs.readFileSync(TOKEN_FILE, 'utf8').trim() } catch {}
  const query = token ? `/?t=${token}` : '/'
  if (env.FRAIM_PREVIEW_HOST) return `http://${env.FRAIM_PREVIEW_HOST}:${port}${query}`
  const mode = env.FRAIM_ACCESS_MODE || ''
  if (mode === 'tailscale') return `http://${env.FRAIM_HOSTNAME || 'fraim'}:${port}${query}`
  if (mode === 'local') return `http://localhost:${port}${query}`
  return `on the laptop: fraim queue open${env.FRAIM_SPACE && env.FRAIM_SPACE !== 'main' ? ` --space ${env.FRAIM_SPACE}` : ''}`
}

// direct: the owner reads it word for word (a security notice), not rewritten by the chief.
function notify(text, direct = false) {
  if (process.env.FRAIM_QUEUE_QUIET === '1') return
  const env = { ...process.env, FRAIM_NOTIFY_NO_ALERT: '1', ...(direct ? { FRAIM_NOTIFY_DIRECT: '1' } : {}) }
  fire('fraim-notify', [text], env)
}

const ADVICE_WORD = { approve: 'Approve', reject: 'Send back', dismiss: 'Skip' }

// The message about a new item says what it is about and what the owner gains or risks, so the
// owner can decide from the message alone.
export function newText(item) {
  const lines = [`New in your queue: ${item.title}`]
  if (item.ask) lines.push(item.ask)
  if (item.need) lines.push(`Why: ${item.need}`)
  if (item.if_yes) lines.push(`If you approve: ${item.if_yes}`)
  if (item.if_no) lines.push(`If you say no: ${item.if_no}`)
  if (item.advise) lines.push(`My advice: ${ADVICE_WORD[item.advise]}`)
  lines.push(queueUrl())
  return lines.join('\n')
}

// One job, one card: the card a goal was started from, when it can carry the next step.
function cardToContinue(id) {
  if (!id) return null
  if (!/^q\d{1,6}$/.test(id)) usage('--continues needs a queue item id (q1, q2, ...)')
  try {
    const card = readItem(id)
    return card.brain || card.skill || card.reply ? null : card
  } catch { return null }
}

// The next step of a job lands on the job's card and the step before it moves to the card's
// history. With a new question the card waits for the owner again. With nothing to decide a
// card the owner approved stays closed; rework the owner sent back always comes back to them.
function continueCard(card, step, nothingToDecide) {
  const history = [...(card.history || []), {
    title: card.title, ask: card.ask, state: card.state, note: card.note, created: card.created, decided: card.decided,
    via: card.via || '', goal: card.goal, summary: card.summary.slice(0, 4000), links: card.links, media: card.media,
  }]
  const result = { summary: step.summary, goal: step.goal, source: step.source, lead: step.lead || card.lead, links: step.links, media: step.media, history }
  if (nothingToDecide && card.state === 'approved') return { ...card, ...result }
  return { ...card, ...step, ...result, thread: step.thread || card.thread || '', id: card.id, title: card.title, started: card.started || card.created, follow_up: '', outcome: '', via: '', approved_by: '', switch_on: '' }
}

// The conversation an item belongs to: said outright, set for this run, or that of its goal.
function itemThread(opts) {
  const fromGoal = opts.goal ? readText(path.join(GOALS, String(opts.goal), 'thread'), 40).trim() : ''
  const id = String(opts.thread || process.env.FRAIM_THREAD || fromGoal)
  return validThread(id) && fs.existsSync(path.join(THREADS, id, 'thread.json')) ? id : ''
}

export function addItem(opts) {
  const title = String(opts.title || '').trim()
  if (!title) usage('add needs --title')
  if (process.env.FRAIM_GOAL && !opts.result && !opts.brain && !opts.skill && !opts.switchOn && !opts.approvedBy) {
    usage(`a goal does not add queue items itself: write ~/fraim/goals/${process.env.FRAIM_GOAL}/queue.json and the server makes the card; other questions go in its "more" list`)
  }
  const kind = opts.kind || 'review'
  if (!KINDS.includes(kind)) usage(`--kind must be one of ${KINDS.join(', ')}`)
  const priority = parseInt(opts.priority || '2', 10)
  if (![1, 2, 3].includes(priority)) usage('--priority must be 1, 2 or 3')
  if (opts.brain && !/^p\d{1,6}$/.test(opts.brain)) usage('--brain needs a proposal id (p1, p2, ...)')
  if (opts.skill && !/^s\d{1,6}$/.test(opts.skill)) usage('--skill needs a skill proposal id (s1, s2, ...)')
  if (opts.switchOn && !/^[a-z0-9][a-z0-9_-]{0,47}$/.test(opts.switchOn)) usage('--switch-on needs an automation name')
  if (opts.approvedBy && !/^q\d{1,6}$/.test(opts.approvedBy)) usage('--approved-by needs the id of a queue item the owner approved (q1, q2, ...)')
  if (opts.switchOn) requireTrial(opts.switchOn)
  const advise = opts.advise ? String(opts.advise).toLowerCase().replace(/^send-?back$/, 'reject').replace(/^skip$/, 'dismiss') : ''
  if (advise && !ADVICE.includes(advise)) usage('--advise must be approve, reject (send back) or dismiss (skip)')
  const why = (Array.isArray(opts.why) ? opts.why : opts.why ? [opts.why] : []).map((w) => String(w).trim()).filter(Boolean).slice(0, 3)
  const origin = cardToContinue(opts.continues)
  const id = origin ? origin.id : newId()
  const dir = itemDir(id)
  const takenMedia = origin ? [...origin.media, ...(origin.history || []).flatMap((s) => s.media || [])] : []
  const step = {
    id,
    title: title.slice(0, 200),
    // The decision in one look: the question for the owner, the advice, why it is needed, what
    // changes when the owner says yes or no, and at most 3 reasons for the advice.
    ask: String(opts.ask || '').trim().slice(0, 300),
    advise,
    need: String(opts.need || '').trim().slice(0, 400),
    if_yes: String(opts.ifYes || '').trim().slice(0, 400),
    if_no: String(opts.ifNo || '').trim().slice(0, 400),
    why: why.map((w) => w.slice(0, 300)),
    summary: String(opts.summary || '').slice(0, 20000),
    kind,
    priority,
    source: opts.source || (opts.goal ? `goal ${opts.goal}` : opts.lead ? `lead ${opts.lead}` : 'manual'),
    goal: opts.goal || '',
    lead: opts.lead || '',
    links: opts.links || [],
    media: copyMedia(dir, opts.media || [], takenMedia),
    on_approve: String(opts.onApprove || ''),
    brain: opts.brain || '',
    skill: opts.skill || '',
    // An automation or lead the engineer built switched off; approve switches it on.
    switch_on: opts.switchOn || '',
    thread: itemThread(opts),
    // Set only by draftReply; a value from the command line is a string and does not count.
    ...(opts.reply && typeof opts.reply === 'object' ? { reply: opts.reply } : {}),
    state: 'open',
    note: '',
    created: now(),
    decided: '',
  }
  const nothingToDecide = Boolean(opts.result) && !step.ask && !step.on_approve && kind !== 'failed'
  const item = origin ? continueCard(origin, step, nothingToDecide) : step
  if (!origin && nothingToDecide) Object.assign(item, { state: 'dismissed', note: 'Nothing to decide.', decided: now(), via: 'system' })
  writeItem(item)
  if (opts.approvedBy) {
    try {
      return approvedByGrant(item, String(opts.approvedBy))
    } catch (err) {
      if (err instanceof UsageError) throw err
      process.stderr.write(`fraim-queue: ${err.message}. ${id} waits in the queue as a normal question.\n`)
    }
  }
  if (!opts.quiet && item.state === 'open') notify(newText(item))
  // A lead hears at once when a goal it started ends; the chief hears through its queue events.
  if (item.goal && item.lead && !isChief(item.lead)) {
    tellLead(item.lead, `goal ${item.goal}`, `${kind === 'failed' ? 'A task you started failed' : 'A task you started is done'}: ${item.title} (queue item ${id}, fraim-queue show ${id}).`, item.thread)
  }
  return item
}

function brain(args) {
  const res = spawnSync(tool('fraim-brain'), args, { encoding: 'utf8', timeout: 30000 })
  if (res.status !== 0) throw new Error((res.stderr || res.error?.message || 'fraim-brain failed').trim().replace(/^fraim-brain: /, ''))
  return res.stdout.trim()
}

// Every reason the owner gives is evidence for the brain. A failed write must not undo a decision.
function brainNote(item, verdict, note) {
  if (!note) return
  const args = ['log', '--verdict', verdict, '--item', item.id, '--title', item.title]
  if (item.lead) args.push('--lead', item.lead)
  try { brain([...args, '--', note]) } catch (err) { process.stderr.write(`fraim-queue: the brain did not save the reason: ${err.message}\n`) }
}

// A switched-off employee is only offered to the owner after a passed trial of its current brief.
function requireTrial(name) {
  const dir = path.join(LEADS, name)
  if (!fs.existsSync(path.join(dir, 'lead.md')) || !fs.existsSync(path.join(dir, 'paused'))) return
  const res = spawnSync(tool('fraim-lead'), ['try', name, '--status'], { encoding: 'utf8', timeout: 30000 })
  if (res.status !== 0) throw new Error(`${name} cannot be hired yet: ${(res.stdout || res.stderr || res.error?.message || '').trim()}`)
}

function switchOn(name, granted = false) {
  const env = { ...process.env }
  if (granted) delete env.FRAIM_HEADLESS
  const res = spawnSync(tool('fraim-auto'), ['on', name], { encoding: 'utf8', timeout: 30000, env })
  if (res.status !== 0) throw new Error(`could not switch on ${name}: ${(res.stderr || res.error?.message || '').trim().replace(/^fraim-auto: /, '')}`)
  return res.stdout.trim()
}

function startGoal(text, item) {
  const args = ['start']
  if (item.lead) args.push('--lead', item.lead)
  args.push('--queue', item.id, '--', text)
  const env = { ...process.env, FRAIM_GOAL_FROM_QUEUE: '1' }
  const res = spawnSync('fraim-goal', args, { encoding: 'utf8', timeout: 30000, env })
  if (res.status !== 0) throw new Error(`could not start the follow-up goal: ${(res.stderr || res.error?.message || '').trim()}`)
  return res.stdout.trim()
}

function readGoalFile(goal, name, max = 4000) {
  if (!/^g\d{1,6}$/.test(goal)) return ''
  try { return fs.readFileSync(path.join(GOALS, goal, name), 'utf8').slice(0, max).trim() } catch { return '' }
}

export function reworkText(item, note) {
  const original = readGoalFile(item.goal, 'goal.md') || item.title
  const result = readGoalFile(item.goal, 'result.md') || item.summary
  return [
    `Rework after the owner's review of queue item ${item.id} ("${item.title}").`,
    '',
    'The original goal:',
    original,
    '',
    'Your previous result:',
    result,
    '',
    "The owner's feedback, which wins over anything above:",
    note,
    '',
    item.goal ? `Earlier notes and files are in ~/fraim/goals/${item.goal}. Build on that work instead of starting over.` : '',
  ].join('\n').trim()
}

export function approveText(item, note) {
  return [
    `The owner approved queue item ${item.id} ("${item.title}"). Do this approved next step now:`,
    item.on_approve,
    note ? `\nThe owner added: ${note}` : '',
    item.goal ? `\nContext and earlier work: ~/fraim/goals/${item.goal}.` : '',
  ].join('\n').trim()
}

// The one place where a decision has effects, used by the CLI, the page and WhatsApp.
// Only the owner decides: a headless Claude run (goal, lead, automation) cannot.
export function decide(id, verdict, note = '', via = 'cli', editedText = undefined) {
  if (process.env.FRAIM_HEADLESS === '1') throw new Error('only the owner decides; a goal, lead or automation cannot approve, reject or dismiss')
  const item = readItem(id)
  if (item.state !== 'open') throw new Error(`${id} is already ${item.state}`)
  note = String(note || '').trim()
  if (verdict === 'rejected' && !note) usage('reject needs a reason (--note), so the agent knows what to change')
  if (!['approved', 'rejected', 'dismissed'].includes(verdict)) usage(`unknown decision ${verdict}`)
  if (item.reply && verdict === 'approved' && editedText != null) {
    const text = String(editedText).trim()
    if (!text) usage('the reply is empty')
    if (text.length > MAX_REPLY) usage(`a reply is at most ${MAX_REPLY} characters`)
    if (text !== item.reply.text) {
      Object.assign(item.reply, { text, edited: true })
      item.summary = replySummary(item.reply)
    }
  }
  return applyDecision(item, verdict, note, via)
}

// The owner's yes covers the work that follows from it. An item added with --approved-by qN
// (qN approved by the owner in the last 14 days) is approved at once: what was built for that
// yes starts without a second question, and the owner hears that it runs.
const GRANT_DAYS = 14
export function approvedByGrant(item, grantId) {
  if (!/^q\d{1,6}$/.test(grantId || '')) usage('--approved-by needs the id of a queue item the owner approved (q1, q2, ...)')
  const grant = readItem(grantId)
  // A card that moved on to its next question still carries the owner's last decision.
  const decision = [grant, ...[...(grant.history || [])].reverse()].find((s) => s.state !== 'open')
  if (decision?.state !== 'approved' || decision.via === 'grant') throw new Error(`${grantId} is not a yes from the owner; ask the owner in the queue instead`)
  if (grant.brain || grant.skill) throw new Error(`${grantId} approved a brain change; ask the owner in the queue instead`)
  if (grant.reply) throw new Error(`${grantId} approved one message to one person; ask the owner in the queue instead`)
  const age = Date.now() - Date.parse(String(decision.decided).replace(' ', 'T'))
  if (!(age < GRANT_DAYS * 86400000)) throw new Error(`the owner's yes on ${grantId} is older than ${GRANT_DAYS} days; ask again in the queue`)
  item.approved_by = grantId
  const done = applyDecision(item, 'approved', `The owner already said yes: "${grant.title}" (${grantId})${decision.note ? `: ${decision.note}` : ''}`, 'grant', { HEADLESS_OK: true })
  grant.used_by = [...(grant.used_by || []), item.id]
  writeItem(grant)
  notify(`Started, because you already said yes to "${grant.title}": ${item.title}.${item.if_yes ? ` ${item.if_yes}` : ''}${done.follow_up ? ' A task for it has started.' : ''}`)
  return done
}

// A request the owner gave in the chat is already their yes: record it as an approved item, so
// what gets built for it can cite it with --approved-by and start without a second question.
export function grantRequest(title, note, via = 'cli') {
  if (process.env.FRAIM_HEADLESS === '1') throw new Error('only the owner gives a yes; a goal, lead or automation cannot')
  title = String(title || '').trim()
  if (!title) usage('grant needs --title "<what the owner asked for>"')
  const item = addItem({ title, kind: 'decision', source: 'the owner in the chat', quiet: true })
  return applyDecision(item, 'approved', String(note || '').trim(), via)
}

function applyDecision(item, verdict, note, via, opts = {}) {
  let followUp = ''
  let outcome = ''
  // A brain proposal or a new skill changes nothing until the owner approves it here.
  if (item.brain) {
    outcome = verdict === 'approved' ? brain(['apply', item.brain]) : brain(['discard', item.brain, '--note', verdict === 'rejected' ? note : ''])
  } else if (item.skill) {
    outcome = verdict === 'approved' ? brain(['skill', 'install', item.skill]) : brain(['skill', 'discard', item.skill, '--note', note])
  } else if (verdict === 'approved' && item.reply) {
    item.reply = { ...item.reply, status: 'sending', error: '' }
  } else if (verdict === 'approved' && (item.switch_on || item.on_approve)) {
    if (item.switch_on) outcome = switchOn(item.switch_on, opts.HEADLESS_OK)
    if (item.on_approve) followUp = startGoal(approveText(item, note), item)
  } else if (verdict === 'rejected' && item.goal) {
    // A rejected idea only teaches the brain; a rejected piece of work is done again.
    followUp = startGoal(reworkText(item, note), item)
  }
  item.state = verdict
  item.note = note
  item.decided = now()
  item.follow_up = followUp
  item.outcome = outcome
  item.via = via
  writeItem(item)
  // The sender reads the card, so it starts after the write. It never waits inside the page.
  if (verdict === 'approved' && item.reply) fire(tool('fraim-queue'), ['send-reply', item.id], runtimeEnv())
  // A change to the brain from the command line could come from an agent: tell the owner.
  if ((item.brain || item.skill) && verdict === 'approved' && via === 'cli') notify(`${item.id} was approved from the command line: ${outcome}\nNot you? Tell me and I undo it.`, true)
  if (verdict !== 'dismissed' && via !== 'grant') brainNote(item, verdict === 'approved' ? 'approved' : 'rejected', note)
  if (item.lead && via !== 'grant') {
    const covers = verdict === 'approved' && !item.reply ? ` This yes covers the work that follows from it: when you ask the engineer to build something for it, say "the owner approved ${item.id}", so it starts without a second question.` : ''
    tellLead(item.lead, 'owner', `The owner ${verdict} "${item.title}" (${item.id})${note ? `: ${note}` : '.'}${followUp ? ` Goal ${followUp} started for it.` : ''}${covers}`, item.thread)
  }
  return item
}

// A failed attempt at a decision is no longer a question once a later goal for the same
// decision succeeded: close those failures (not a decision of the owner, so no brain note).
// origin: the queue item the goals were started from (~/fraim/goals/gN/queue).
export function supersedeFailed(origin, by) {
  if (!/^q\d{1,6}$/.test(origin || '') || !/^g\d{1,6}$/.test(by || '')) usage('supersede --origin qN --by gN')
  const goals = process.env.FRAIM_GOALS_DIR || path.join(HOME, 'fraim', 'goals')
  const read = (g, f) => { try { return fs.readFileSync(path.join(goals, g, f), 'utf8').trim() } catch { return '' } }
  // Only a goal that really finished for this decision closes its earlier failures.
  if (!read(by, 'state').startsWith('done') || read(by, 'queue') !== origin) throw new Error(`goal ${by} did not finish ${origin}`)
  const closed = []
  for (const item of allItems()) {
    if (item.state !== 'open' || item.kind !== 'failed' || !/^g\d+$/.test(item.goal || '') || item.goal === by) continue
    if (read(item.goal, 'queue') !== origin) continue
    let fresh
    try { fresh = readItem(item.id) } catch { continue }
    if (fresh.state !== 'open') continue
    Object.assign(item, fresh)
    item.state = 'dismissed'
    item.note = `done after all by goal ${by}`
    item.decided = now()
    item.via = 'system'
    writeItem(item)
    closed.push(item.id)
  }
  return closed
}

// Solved is not a decision: the problem on the card is gone, so nobody has to choose anything.
// The chief may do this, unlike decide(). It starts nothing and teaches the brain nothing.
function closeSolved(item, proof, via) {
  item.state = 'dismissed'
  item.note = `Solved: ${proof}`
  item.decided = now()
  item.via = via
  writeItem(item)
  return item
}

// A card with a next step still asks the owner something, and a goal result is the owner's to
// review. Those stay open whatever a run believes.
export function markSolved(id, proof) {
  proof = String(proof || '').trim()
  if (proof.length < 10) usage('solved ID --proof "<what proves it is solved>"')
  const item = readItem(id)
  if (item.state !== 'open') throw new Error(`${id} is already ${item.state}`)
  if (item.on_approve || item.switch_on || item.brain || item.skill || item.reply) throw new Error(`${id} still needs the owner's decision`)
  if (item.kind !== 'failed' && !/^automation /.test(item.source || '')) throw new Error(`${id} is for the owner to review`)
  return closeSolved(item, proof, 'chief')
}

// The automation itself proved it works again, so even a card with a next step is out of date.
export function closeRecovered(source) {
  if (!/^automation [a-z0-9_-]+$/.test(source || '')) usage('recovered --source "automation NAME"')
  const closed = []
  for (const item of allItems()) {
    if (item.state !== 'open' || item.kind !== 'failed' || item.source !== source) continue
    let fresh
    try { fresh = readItem(item.id) } catch { continue }
    if (fresh.state !== 'open') continue
    closeSolved(fresh, 'the automation works again', 'system')
    closed.push(item.id)
  }
  return closed
}

export function setPriority(id, priority) {
  const item = readItem(id)
  const p = parseInt(priority, 10)
  if (![1, 2, 3].includes(p)) usage('priority must be 1, 2 or 3')
  item.priority = p
  writeItem(item)
  return item
}

// --- the team: leads, automations and the chief's last digest, for the page --------------

const AUTOS = process.env.FRAIM_AUTOMATIONS_DIR || path.join(HOME, 'fraim/automations')
const AUTO_STATE = process.env.FRAIM_AUTO_STATE_DIR || path.join(HOME, '.local/state/fraim/automations')
const LEADS = process.env.FRAIM_LEADS_DIR || path.join(HOME, 'fraim/leads')

function isChief(lead) {
  return /^role:\s*chief/m.test(readText(path.join(LEADS, lead, 'lead.md'), 2000))
}

// A note in the lead's inbox that wakes it now (fraim-lead tell).
function tellLead(lead, from, text, thread = '') {
  if (!/^[a-z0-9][a-z0-9-]{0,39}$/.test(lead) || !fs.existsSync(path.join(LEADS, lead, 'lead.md'))) return
  fire('fraim-lead', ['tell', lead, '--from', from, ...(thread ? ['--thread', thread] : []), '--', text])
}

function readText(file, max = 20000) {
  try { return fs.readFileSync(file, 'utf8').slice(0, max) } catch { return '' }
}

function header(text) {
  const out = {}
  const lines = text.split('\n')
  if (lines[0] !== '---') return out
  for (const l of lines.slice(1)) {
    if (l === '---') break
    const m = /^\s*([a-z_]+)\s*:\s*(.*?)\s*(?:\s#.*)?$/.exec(l)
    if (m) out[m[1]] = m[2].replace(/^"(.*)"$/, '$1')
  }
  return out
}

function lastStatus(name) {
  const dir = path.join(AUTO_STATE, name)
  const paused = fs.existsSync(path.join(dir, 'paused'))
  const raw = readText(path.join(dir, 'last_status'), 500).trim()
  const m = /^(\w+)\s+(\d{4}-\d{2}-\d{2} \d{2}:\d{2})\s*(.*)$/.exec(raw)
  let status = m ? m[1] : 'never'
  if (status === 'silent' || status === 'skipped') status = 'ok'
  if (paused) status = 'paused'
  return { status, last: m ? m[2] : '', detail: m && m[1] === 'failed' ? m[3] : '' }
}

function leadRuns(dir, count) {
  let files = []
  try { files = fs.readdirSync(dir).filter((f) => /^\d{8}-\d{6}\.md$/.test(f)).sort().reverse().slice(0, count) } catch {}
  return files.map((f) => {
    const m = /^(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})/.exec(f)
    // The run log ends with the inbox notes the run read (for the lead's own history); the owner
    // sees only the answer.
    const text = readText(path.join(dir, f), 4000).split('\n--- inbox this run read ---')[0].trim()
    return { text, time: `${m[1]}-${m[2]}-${m[3]} ${m[4]}:${m[5]}` }
  })
}

function latestRun(dir) {
  return leadRuns(dir, 1)[0] || null
}

function automationRuns(dir, count) {
  let names = []
  try { names = fs.readdirSync(dir).filter((f) => /^\d{4}-\d{2}-\d{2}T/.test(f)).sort().reverse().slice(0, count) } catch {}
  return names.map((n) => {
    const m = /^(\d{4}-\d{2}-\d{2})T(\d{2})\D?(\d{2})/.exec(n)
    return { text: readText(path.join(dir, n, 'output.md'), 4000).trim(), time: m ? `${m[1]} ${m[2]}:${m[3]}` : n }
  })
}

export function team() {
  const leads = []
  const automations = []
  let chief = null
  let names = []
  try { names = fs.readdirSync(AUTOS).filter((n) => !n.startsWith('_') && !n.startsWith('.')).sort() } catch {}
  for (const name of names) {
    const h = header(readText(path.join(AUTOS, name, 'automation.md'), 4000))
    if (!Object.keys(h).length && !fs.existsSync(path.join(AUTOS, name, 'automation.md'))) continue
    const when = h.schedule ? `schedule ${h.schedule}` : h.every ? `every ${h.every}` : h.trigger ? h.trigger : 'by hand'
    const base = { name, title: displayName(h.lead || name), when, description: (h.description || '').replace(/^Lead [a-z0-9-]+:\s*/, ''), off: /^(false|no|off|0)$/i.test(h.enabled || ''), ...lastStatus(name) }
    if (!h.lead) { automations.push(base); continue }
    const role = /^role:\s*chief/m.test(readText(path.join(LEADS, h.lead, 'lead.md'), 2000)) ? 'chief' : 'lead'
    leads.push({ ...base, lead: h.lead, role })
    if (role === 'chief') chief = { name: h.lead, title: displayName(h.lead), schedule: h.schedule || '', ...(latestRun(path.join(LEADS, h.lead, 'runs')) || {}) }
  }
  return { chief, leads, automations }
}

// --- active agents: who works right now --------------------------------------------------
// Interactive Claudes (the main chat, goals, coding sessions) come from herdr when it is
// installed; headless lead and automation runs come from the fraim-auto run locks.

// Never blocks the page server: other requests go on while herdr or hc answers.
function run(cmd, args, timeout = 8000) {
  return new Promise((resolve) => {
    execFile(tool(cmd), args, { encoding: 'utf8', timeout, env: runtimeEnv(), maxBuffer: 4 << 20 }, (err, stdout) => resolve(err ? null : stdout))
  })
}

// The steps of a headless run (claude -p --output-format stream-json), as lines a person reads:
// what Claude wrote and each tool it used, newest last.
const TOOL_ARG = ['command', 'file_path', 'path', 'pattern', 'url', 'query', 'description', 'prompt', 'skill']
export function transcript(jsonl) {
  const out = []
  for (const raw of String(jsonl || '').split('\n')) {
    let e
    try { e = JSON.parse(raw) } catch { continue }
    if (!e || typeof e !== 'object') continue
    if (e.type === 'assistant') {
      for (const c of e.message?.content || []) {
        if (c.type === 'text' && c.text?.trim()) out.push(c.text.trim())
        if (c.type === 'tool_use') {
          const i = c.input || {}
          const k = TOOL_ARG.find((key) => typeof i[key] === 'string' && i[key])
          const arg = k ? String(i[k]).replace(/\s+/g, ' ').slice(0, 160) : ''
          out.push(`> ${c.name}${arg ? `: ${arg}` : ''}`)
        }
      }
    } else if (e.type === 'result') {
      out.push(e.is_error ? `Stopped with an error: ${String(e.result || '').slice(0, 400)}` : `Done.${e.result ? `\n\n${String(e.result).slice(0, 4000)}` : ''}`)
    }
  }
  return out.slice(-120).join('\n\n')
}

// The live log of a lead or automation run: while it works, the file it writes now; after,
// the log of its last run.
function runLog(name) {
  const h = header(readText(path.join(AUTOS, name, 'automation.md'), 4000))
  if (!Object.keys(h).length) return null
  const newest = (dir, re) => { try { return fs.readdirSync(dir).filter((f) => re.test(f)).sort().at(-1) } catch { return undefined } }
  if (h.lead) {
    if (!/^[a-z0-9][a-z0-9-]{0,39}$/.test(h.lead)) return null
    const dir = path.join(LEADS, h.lead)
    const live = path.join(dir, '.running/live.jsonl')
    if (fs.existsSync(live)) return live
    const f = newest(path.join(dir, 'runs'), /^\d{8}-\d{6}\.md\.jsonl$/)
    return f ? path.join(dir, 'runs', f) : ''
  }
  const runs = path.join(AUTOS, name, 'runs')
  const f = newest(runs, /^\d{4}-\d{2}-\d{2}T/)
  return f && fs.existsSync(path.join(runs, f, 'log.jsonl')) ? path.join(runs, f, 'log.jsonl') : ''
}

// The steps of a run for the lead page: what Claude said and did, in the words a person uses.
const TOOL_WORD = { Bash: 'Ran', Read: 'Read', Write: 'Wrote', Edit: 'Changed', Grep: 'Searched', Glob: 'Looked for', WebFetch: 'Opened', WebSearch: 'Searched the web', Task: 'Asked a helper', Agent: 'Asked a helper', Skill: 'Used skill' }
export function runSteps(jsonl) {
  const out = []
  for (const raw of String(jsonl || '').split('\n')) {
    let e
    try { e = JSON.parse(raw) } catch { continue }
    if (e?.type !== 'assistant') continue
    for (const c of e.message?.content || []) {
      if (c.type === 'text' && c.text?.trim()) out.push({ say: c.text.trim().slice(0, 600) })
      if (c.type === 'tool_use') {
        const i = c.input || {}
        const k = ['description', ...TOOL_ARG].find((key) => typeof i[key] === 'string' && i[key])
        out.push({ did: TOOL_WORD[c.name] || `Used ${String(c.name).split('__').at(-1)}`, what: k ? String(i[k]).replace(/\s+/g, ' ').slice(0, 160) : '' })
      }
    }
  }
  return out
}

// All the page shows for one lead or automation: what it is for, what it does now, what it found.
export function member(name) {
  if (!validAgent(name)) usage('not a lead or automation name')
  const text = readText(path.join(AUTOS, name, 'automation.md'), 4000)
  if (!text) return null
  const h = header(text)
  const lead = /^[a-z0-9][a-z0-9-]{0,39}$/.test(h.lead || '') ? h.lead : ''
  const area = lead ? /^## Area\n+((?:[^\n#][^\n]*\n?)+)/m.exec(readText(path.join(LEADS, lead, 'lead.md'))) : null
  const lock = path.join(AUTO_STATE, name, 'lock')
  const running = fs.existsSync(lock)
  const log = running ? runLog(name) : ''
  let since = ''
  try { since = fs.statSync(lock).mtime.toISOString() } catch {}
  return {
    name, running, since,
    about: area ? area[1].trim() : (h.description || '').replace(/^Lead [a-z0-9-]+:\s*/, ''),
    steps: log ? runSteps(readText(log, 4000000)).slice(-40).reverse() : [],
    runs: lead ? leadRuns(path.join(LEADS, lead, 'runs'), 10) : automationRuns(path.join(AUTOS, name, 'runs'), 10),
  }
}

export async function active() {
  const out = []
  const herd = await run('fraim-herdr', ['ls', '--json'])
  if (herd) {
    try {
      for (const a of JSON.parse(herd)) {
        if (!a || !a.name || a.kind === 'shell') continue
        out.push({ name: String(a.name), kind: String(a.kind || 'session'), status: String(a.status || 'none'), question: String(a.question || ''), cwd: String(a.cwd || ''), turn: String(a.turn || ''), live: true })
      }
    } catch {}
  }
  let names = []
  try { names = fs.readdirSync(AUTO_STATE) } catch {}
  for (const name of names) {
    if (!fs.existsSync(path.join(AUTO_STATE, name, 'lock'))) continue
    const h = header(readText(path.join(AUTOS, name, 'automation.md'), 4000))
    const since = (() => { try { return fs.statSync(path.join(AUTO_STATE, name, 'lock')).mtime.toISOString() } catch { return '' } })()
    out.push({ name, kind: h.lead ? 'lead' : 'automation', status: 'working', question: '', cwd: '', turn: since, live: true })
  }
  const order = { blocked: 0, working: 1, error: 2, idle: 3, done: 4, none: 5 }
  return out.sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9) || a.name.localeCompare(b.name))
}

const validAgent = (n) => /^[a-z0-9][a-z0-9_-]{0,47}$/.test(n)

export async function agentScreen(name) {
  if (!validAgent(name)) usage('not an agent name')
  if (fs.existsSync(path.join(AUTO_STATE, name, 'lock'))) {
    const log = runLog(name)
    if (log != null) return { name, text: log ? transcript(readText(log, 4000000)) : '' }
  }
  const text = /^g\d+$/.test(name) ? await run('fraim-goal', ['read', name]) : await run('hc', ['read', name, '--lines', '80'])
  return { name, text: text == null ? '' : text.slice(-20000) }
}

export async function agentSend(name, text) {
  if (!validAgent(name)) usage('not an agent name')
  text = String(text || '').trim()
  if (!text) usage('write a message first')
  const r = /^g\d+$/.test(name) ? await run('fraim-goal', ['send', name, text], 15000)
    : /^s\d+$/.test(name) ? await run('fraim-sessions', ['send', name, text], 15000) : null
  if (r == null) throw new Error(`could not send to ${name}; only goals (g1) and sessions (s1) take messages`)
  return { ok: true }
}

function line(item) {
  const flag = item.state === 'open' ? `p${item.priority}` : item.state
  const extra = item.media.length ? `  [${item.media.length} media]` : ''
  return `${item.id}  ${flag}  ${item.kind}  ${item.title}  (${item.source})${extra}`
}

function describe(item) {
  const parts = [`${item.id}: ${item.title}`, `${item.kind}, priority ${item.priority}, ${item.state}, from ${item.source}, ${item.created}`]
  if (item.ask) parts.push('', `Question: ${item.ask}`)
  if (item.need) parts.push(`Why it is needed: ${item.need}`)
  if (item.if_yes) parts.push(`If you approve: ${item.if_yes}`)
  if (item.if_no) parts.push(`If you say no: ${item.if_no}`)
  if (item.advise) parts.push(`Advice: ${ADVICE_WORD[item.advise]}`)
  for (const w of item.why || []) parts.push(`- ${w}`)
  if (item.summary) parts.push('', item.ask ? 'Details:' : '', item.summary)
  if (item.links.length) parts.push('', ...item.links.map((l) => `link: ${l}`))
  if (item.media.length) parts.push('', ...item.media.map((m) => `media: ${path.join(itemDir(item.id), 'media', m)}`))
  if (item.history?.length) parts.push('', 'Earlier steps:', ...item.history.map((s) => `- ${s.ask || s.title} (${s.state}${s.note ? `: ${s.note}` : ''})`))
  if (item.switch_on) parts.push('', `On approve: switch on ${item.switch_on}`)
  if (item.on_approve) parts.push('', `On approve: ${item.on_approve}`)
  if (item.note) parts.push('', `Owner: ${item.note}`)
  if (item.follow_up) parts.push(`Follow-up goal: ${item.follow_up}`)
  if (item.outcome) parts.push(item.outcome)
  return parts.join('\n')
}

// --- conversations: what came in, and the agents talking about it -------------------------
// ~/fraim/threads/<tN>/thread.json holds the thing that came in, saved from its source and not
// rewritten by an agent; chat.jsonl holds what the agents said about it.

const THREADS = process.env.FRAIM_THREADS_DIR || path.join(HOME, 'fraim/threads')
const validThread = (id) => /^t\d{1,6}$/.test(id)

function readThread(id) {
  if (!validThread(id)) usage(`'${id}' is not a conversation id (t1, t2, ...)`)
  try {
    return JSON.parse(fs.readFileSync(path.join(THREADS, id, 'thread.json'), 'utf8'))
  } catch {
    throw new Error(`no conversation ${id}`)
  }
}

function writeThread(t) {
  const file = path.join(THREADS, t.id, 'thread.json')
  fs.writeFileSync(`${file}.tmp`, JSON.stringify(t, null, 2) + '\n')
  fs.renameSync(`${file}.tmp`, file)
}

function allThreads() {
  let names = []
  try { names = fs.readdirSync(THREADS) } catch { return [] }
  const out = []
  for (const name of names) {
    if (!validThread(name)) continue
    try { out.push(JSON.parse(fs.readFileSync(path.join(THREADS, name, 'thread.json'), 'utf8'))) } catch {}
  }
  return out
}

function newThreadId() {
  fs.mkdirSync(THREADS, { recursive: true })
  const last = path.join(THREADS, '.last')
  let n = 1
  try { n = parseInt(fs.readFileSync(last, 'utf8'), 10) + 1 || 1 } catch {}
  for (;;) {
    try {
      fs.mkdirSync(path.join(THREADS, `t${n}`))
      break
    } catch (err) {
      if (err.code !== 'EEXIST') throw err
      n++
    }
  }
  fs.writeFileSync(last, `${n}\n`)
  return `t${n}`
}

// One thing, one conversation: the same key (a mail chain, a Linear issue, an error) lands in the
// same conversation. news is true when there is something new to read; a repeat of an error
// only raises its count.
export function putThread(data) {
  const key = String(data.key || '').slice(0, 200)
  let t = key ? allThreads().find((x) => x.key === key) : null
  const isNew = !t
  if (isNew) {
    t = { id: newThreadId(), kind: String(data.kind || 'other'), key, title: '', who: '', url: '', text: '', details: '', fields: {}, messages: [], comments: [], stats: null, created: now(), changed: now(), active: '', seen: '' }
  }
  const before = JSON.stringify([t.messages.length, t.comments.length, t.text])
  for (const [k, max] of [['title', 200], ['who', 200], ['url', 500], ['text', 40000], ['details', 20000]]) {
    if (data[k] != null) t[k] = String(data[k]).slice(0, max)
  }
  if (data.fields && typeof data.fields === 'object') t.fields = { ...t.fields, ...data.fields }
  if (Array.isArray(data.messages)) t.messages = data.messages
  if (Array.isArray(data.comments)) t.comments = data.comments.slice(0, 200)
  if (data.hit) {
    const n = Number(data.hit) || 1
    t.stats = { count: (t.stats?.count || 0) + n, first: t.stats?.first || now(), last: now() }
  }
  const news = isNew || before !== JSON.stringify([t.messages.length, t.comments.length, t.text])
  if (news) {
    t.changed = now()
    delete t.closed
  }
  writeThread(t)
  return { thread: t, isNew, news }
}

export function sayInThread(id, from, to, text) {
  const t = readThread(id)
  fs.appendFileSync(path.join(THREADS, id, 'chat.jsonl'), `${JSON.stringify({ time: now(), from: String(from), to: String(to || ''), text: String(text).slice(0, 4000) })}\n`)
  t.active = now()
  writeThread(t)
}

// What does not belong in the inbox, in a file the owner can read and change. "never:" lines keep
// a sender out for good; "not relevant:" lines are examples the mail check learns from.
const RULES = path.join(HOME, 'fraim/inbox-rules.md')
const RULES_HEAD = '# What does not belong in the inbox. Change this file as you like.\n# never: an address or @domain that is kept out for good\n# not relevant: a mail you marked, an example for the mail check\n'

function addRule(line) {
  const clean = String(line).replace(/\s+/g, ' ').trim().slice(0, 200)
  const old = readText(RULES, 200000) || RULES_HEAD
  const lines = old.split('\n').filter(Boolean)
  if (!lines.includes(`- ${clean}`)) lines.push(`- ${clean}`)
  const head = lines.filter((l) => !l.startsWith('- '))
  fs.writeFileSync(RULES, `${[...head, ...lines.filter((l) => l.startsWith('- ')).slice(-300)].join('\n')}\n`)
  return clean
}

function removeRule(line) {
  const old = readText(RULES, 200000)
  if (old) fs.writeFileSync(RULES, old.split('\n').filter((l) => l !== `- ${line}`).join('\n'))
}

function neverShow(address) {
  const a = String(address || '').toLowerCase()
  if (!a) return false
  return readText(RULES, 200000).split('\n').some((l) => {
    const m = /^- never:\s*(\S+)/i.exec(l)
    return m && (a === m[1].toLowerCase() || (m[1].startsWith('@') && a.endsWith(m[1].toLowerCase())))
  })
}

// The owner's "Not relevant": gone from the list, questions about it closed, and the mail check learns.
export function dismissThread(t) {
  for (const i of allItems().filter((x) => x.thread === t.id && x.state === 'open')) decide(i.id, 'dismissed', 'Not relevant', 'page')
  const last = t.messages.at(-1)
  const rule = addRule(`not relevant: ${last?.from || t.who}${last?.address ? ` <${last.address}>` : ''}, "${t.title}"`)
  t.closed = { by: 'owner', time: now(), rule }
  writeThread(t)
  if (t.active) tellChief(t, 'owner', promptText('thread-closed', { title: t.title }))
}

export function restoreThread(t) {
  if (t.closed?.rule) removeRule(t.closed.rule)
  delete t.closed
  writeThread(t)
}

// An agent closes what needs no work. What still waits for the owner stays.
export function closeThread(id, from, reason) {
  const t = readThread(id)
  const why = String(reason || '').trim()
  if (!why) usage('thread close needs --reason')
  if (allItems().some((i) => i.thread === id && i.state === 'open')) throw new Error('this conversation still needs the owner')
  sayInThread(id, from || 'chief', '', why)
  const fresh = readThread(id)
  fresh.closed = { by: String(from || 'chief'), time: now() }
  writeThread(fresh)
}

function readChat(id) {
  return readText(path.join(THREADS, id, 'chat.jsonl'), 2000000).split('\n').flatMap((l) => {
    try { return l ? [JSON.parse(l)] : [] } catch { return [] }
  })
}

function theChief() {
  try { return fs.readdirSync(LEADS).find((n) => isChief(n)) || '' } catch { return '' }
}

function tellChief(thread, from, text) {
  const chief = theChief()
  if (chief) fire('fraim-lead', ['tell', chief, '--from', from, '--thread', thread.id, '--', text])
}

// What an agent is told is a file the owner can change. A broken setup still passes the facts on.
function promptText(name, values) {
  try {
    return execFileSync(tool('fraim-prompt'), ['render', name, ...Object.entries(values).flatMap(([k, v]) => ['--set', `${k}=${v}`])], { encoding: 'utf8', timeout: 10000, stdio: ['ignore', 'pipe', 'ignore'] }).trim()
  } catch {
    return Object.values(values).join(' ')
  }
}

const SOURCE_WORD = { email: 'email', whatsapp: 'WhatsApp message', linear: 'Linear issue', error: 'website problem' }
function announce({ thread, isNew }) {
  tellChief(thread, thread.kind, promptText('thread-new', { is_new: isNew ? '1' : '', what: SOURCE_WORD[thread.kind] || thread.kind, who: thread.messages.at(-1)?.from || thread.who || 'someone', title: thread.title, id: thread.id }))
}

// The name people see is the display: line of the lead's brief; without one, its folder name.
export function displayName(name) {
  const n = String(name || '')
  if (n === 'owner') return 'You'
  if (n === 'manual') return 'Fraim'
  if (/^goal /.test(n)) return 'A helper'
  if (/^automation /.test(n)) return displayName(n.slice(11))
  const own = header(readText(path.join(LEADS, n, 'lead.md'), 2000)).display
  if (own) return own
  if (isChief(n)) return 'Chief of staff'
  const plain = n.replace(/-/g, ' ')
  return plain ? plain.charAt(0).toUpperCase() + plain.slice(1) : 'Someone'
}

const leadArea = (name) => /^## Area\n+((?:[^\n#][^\n]*\n?)+)/m.exec(readText(path.join(LEADS, name, 'lead.md')))?.[1]?.trim() || ''

// What a tool entry is called on the page: mcp__linear__list_issues is Linear. Shell commands are not listed.
function toolNames(entries) {
  const names = entries.map((t) => /^mcp__([^_]+(?:_[^_]+)*?)(?:__|$)/.exec(t.trim())?.[1]).filter(Boolean).map((t) => t.replace(/[-_]mcp$/, ''))
  return [...new Set(names)].map((t) => t.charAt(0).toUpperCase() + t.slice(1)).sort()
}

// Everyone who works here, read from the files they are set up with.
export function employees() {
  const products = {}
  let repos = []
  try { repos = fs.readdirSync(path.join(HOME, 'fraim/projects')) } catch {}
  for (const repo of repos) {
    for (const l of readText(path.join(HOME, 'fraim/projects', repo, 'installed.tsv')).split('\n')) {
      const [kind, name] = l.split('\t')
      if (kind && name) products[`${kind}:${name}`] = repo
    }
  }
  const { leads, automations } = team()
  const people = leads.filter((m) => m.name === m.lead).map((m) => ({
    name: m.name, title: displayName(m.name), does: leadArea(m.name) || m.description, product: products[`lead:${m.name}`] || '',
    off: m.off || fs.existsSync(path.join(LEADS, m.name, 'paused')), status: m.status, last: m.last,
    starts: leads.filter((x) => x.lead === m.lead).map((x) => x.when),
    tools: toolNames(readText(path.join(LEADS, m.name, 'tools')).split('\n')),
  }))
  const watchers = automations.map((m) => ({
    name: m.name, title: displayName(m.name), does: m.description, product: products[`auto:${m.name}`] || '', off: m.off, status: m.status, last: m.last,
    starts: [m.when], tools: toolNames(String(header(readText(path.join(AUTOS, m.name, 'automation.md'), 4000)).tools || '').split(',')),
  }))
  return { people, watchers }
}

// Agent notes keep exact file names and logs after a line "Details:"; people read what is above it.
const spoken = (text) => String(text || '').split(/^Details:\s*$/m)[0].trim()

function workers() {
  const out = {}
  const add = (id, name) => { (out[id] ||= []).includes(name) || out[id].push(name) }
  let leads = []
  try { leads = fs.readdirSync(LEADS) } catch {}
  for (const n of leads) {
    for (const id of readText(path.join(LEADS, n, '.running/thread'), 200).split('\n')) if (validThread(id)) add(id, displayName(n))
  }
  let goals = []
  try { goals = fs.readdirSync(GOALS) } catch {}
  for (const g of goals) {
    const id = readText(path.join(GOALS, g, 'thread'), 40).trim()
    if (id && /^(running|starting|working)/.test(readText(path.join(GOALS, g, 'state'), 40))) add(id, 'A helper')
  }
  return out
}

const RECENT = 15 * 60 * 1000
function threadState(t, open, working) {
  if (t.closed) return 'done'
  if (open.length) return 'need'
  if (working?.length) return 'work'
  if (!t.active) return 'new'
  return Date.now() - Math.max(Date.parse(t.changed) || 0, Date.parse(t.active) || 0) < RECENT ? 'work' : 'done'
}

function firstWords(text) {
  return (String(text || '').split('\n').find((l) => l.trim()) || '').trim().slice(0, 160)
}

export function inboxRows() {
  const items = allItems()
  const working = workers()
  const rows = allThreads().map((t) => {
    const mine = items.filter((i) => i.thread === t.id)
    const open = mine.filter((i) => i.state === 'open')
    const chat = readChat(t.id).at(-1)
    const last = t.messages.at(-1)
    const asker = open[0] && displayName(itemOwner(open[0]))
    return {
      id: t.id, kind: t.kind, title: t.title || '(no subject)', who: t.who || 'Someone',
      snippet: open[0] ? `${asker}: ${open[0].ask || open[0].title}` : chat ? `${displayName(chat.from)}: ${firstWords(spoken(chat.text))}` : firstWords(last?.text || t.text),
      time: [t.changed, t.active, ...mine.map((i) => i.created)].sort().at(-1),
      state: threadState(t, open, working[t.id]),
      closed: Boolean(t.closed),
      unread: !t.closed && t.changed > (t.seen || ''),
    }
  })
  const loose = items.filter((i) => !i.thread)
  const shown = [...loose.filter((i) => i.state === 'open'), ...loose.filter((i) => i.state !== 'open').sort((a, b) => b.decided.localeCompare(a.decided)).slice(0, 100)]
  for (const i of shown) {
    rows.push({ id: i.id, kind: 'item', title: i.title, who: displayName(itemOwner(i)), snippet: i.ask || i.need || firstWords(i.summary), time: i.state === 'open' ? i.created : i.decided, state: i.state === 'open' ? 'need' : 'done', unread: i.state === 'open' })
  }
  return rows.sort((a, b) => String(b.time).localeCompare(String(a.time)))
}

function itemOwner(i) {
  return i.lead || (/^automation /.test(i.source) ? i.source.slice(11) : i.source)
}

const ANSWER = { approved: 'Yes, go ahead.', dismissed: 'No, leave it.', rejected: 'No.' }
const REPLY_ANSWER = { approved: 'Send it.', dismissed: 'Do not send it.', rejected: 'Not like this.' }
function itemChat(i) {
  const ask = { time: i.created, from: displayName(itemOwner(i)), to: 'You', item: { id: i.id, title: i.title, ask: i.ask, need: i.need, if_yes: i.if_yes, advise: i.advise, state: i.state, reply: i.reply } }
  if (i.state === 'open') return [ask]
  return [ask, { time: i.decided, from: 'You', to: displayName(itemOwner(i)), text: `${(i.reply ? REPLY_ANSWER : ANSWER)[i.state] || ''}${i.note ? ` ${i.note}` : ''}`.trim() }]
}

export function threadDetail(id) {
  if (validId(id)) {
    const i = readItem(id)
    return { id: i.id, kind: 'item', title: i.title, who: displayName(itemOwner(i)), text: i.summary, created: i.created, links: i.links, media: i.media, fields: {}, messages: [], comments: [], chat: itemChat(i), working: [] }
  }
  const t = readThread(id)
  const { seen: _seen, ...shown } = t
  const said = readChat(id).map((c) => ({ time: c.time, from: displayName(c.from), to: c.to ? displayName(c.to) : '', text: spoken(c.text) }))
  const items = allItems().filter((i) => i.thread === id)
  const chat = [...said, ...items.flatMap(itemChat)].sort((a, b) => String(a.time).localeCompare(String(b.time)))
  return { ...shown, links: [], media: [], chat, working: workers()[id] || [] }
}

export function describeThread(id) {
  const t = readThread(id)
  const parts = [`${t.id}: ${t.title}`, `From ${t.who}, ${t.kind}`]
  for (const m of t.messages) parts.push('', `${m.from}${m.forwardedBy ? `, forwarded by ${m.forwardedBy}` : ''}, ${m.date}:`, m.text)
  if (t.text) parts.push('', t.text)
  for (const [k, v] of Object.entries(t.fields)) parts.push(`${k}: ${v}`)
  for (const c of t.comments) parts.push('', `${c.who}: ${c.text}`)
  if (t.details) parts.push('', t.details)
  const chat = readChat(id)
  if (chat.length) parts.push('', 'What the agents said so far:', ...chat.map((c) => `${c.from} to ${c.to || 'everyone'}: ${c.text}`))
  return parts.join('\n')
}

// --- the chat with the chief of staff: the same conversation as WhatsApp ---------------------

const RELAY = process.env.FRAIM_RELAY_DIR || path.join(HOME, 'fraim/relay')

export function chiefChat() {
  const items = allItems()
  const titles = Object.fromEntries(allThreads().map((t) => [t.id, t.title]))
  const lines = readText(path.join(RELAY, 'conversation.jsonl'), 4000000).split('\n').flatMap((l) => {
    try { return l ? [JSON.parse(l)] : [] } catch { return [] }
  })
  const messages = lines.slice(-200).map((m) => {
    const refs = new Map()
    for (const q of String(m.about || '').split(/\s+/).filter(validId)) {
      const item = items.find((i) => i.id === q)
      if (item) refs.set(item.thread || item.id, titles[item.thread] || item.title)
    }
    return { who: m.who === 'owner' ? 'owner' : 'chief', text: String(m.text || ''), time: String(m.time || ''), app: m.chat === 'app', refs: [...refs].slice(0, 3).map(([id, title]) => ({ id, title })) }
  })
  return { exists: Boolean(theChief()), title: displayName(theChief()), typing: fs.existsSync(path.join(RELAY, 'chat.lock')), messages }
}

// A chief's answer takes longer than fire() allows, and the page does not wait for it.
function askChief(text) {
  const child = spawn(tool('fraim-relay'), ['chat', '--', text], { env: runtimeEnv(), stdio: 'ignore', detached: true })
  child.on('error', () => {})
  child.unref()
}

// --- reading a mail chain -------------------------------------------------------------------

function person(from) {
  const m = /^\s*"?([^"<]*?)"?\s*<([^>]+)>/.exec(from || '')
  return m ? { name: m[1].trim() || m[2], address: m[2] } : { name: String(from || 'Someone').trim(), address: '' }
}

// What was written now and what is only quoted from earlier mails. When no quote is found, or the
// cut would leave nothing, the whole text stays.
export function splitQuote(body) {
  const lines = String(body).split('\n')
  const start = lines.findIndex((l, i) => {
    const two = `${l} ${lines[i + 1] || ''}`
    return /^>/.test(l)
      || /^(On|Op)\s.+(wrote|schreef[^:]*):\s*$/i.test(l)
      || /^(On|Op)\s.+(wrote|schreef[^:]*):\s*$/i.test(two)
      || /^-{2,}\s*(Original Message|Oorspronkelijk bericht)/i.test(l)
      || (/^(From|Van):\s.+/.test(l) && lines.slice(i + 1, i + 4).some((x) => /^(Sent|Date|Verzonden|Datum):\s/.test(x)))
  })
  if (start < 0) return { text: String(body).trim(), quoted: '' }
  const text = lines.slice(0, start).join('\n').trim()
  return text ? { text, quoted: lines.slice(start).join('\n').trim() } : { text: String(body).trim(), quoted: '' }
}

function unforward(body) {
  const m = /^[-\s]*(?:Forwarded message|Doorgestuurd bericht|Begin forwarded message)[-\s:]*$/mi.exec(body)
  if (!m) return null
  const note = body.slice(0, m.index).trim()
  const rest = body.slice(m.index + m[0].length).replace(/^\n+/, '')
  const end = rest.indexOf('\n\n')
  const head = end < 0 ? rest : rest.slice(0, end)
  const get = (re) => re.exec(head)?.[1]?.trim() || ''
  const from = get(/^(?:From|Van):[ \t]*(.*)$/mi)
  if (!from) return null
  return { note, from, date: get(/^(?:Date|Datum|Sent|Verzonden):[ \t]*(.*)$/mi), to: get(/^(?:To|Aan):[ \t]*(.*)$/mi), body: end < 0 ? '' : rest.slice(end + 2) }
}

// Walled off in the page; this takes out what could still reach outside the frame.
function cleanHtml(html) {
  const out = String(html).replace(/<(script|style\s+type="text\/javascript")[\s\S]*?<\/\1>/gi, '').replace(/<(meta|base|link)\b[^>]*>/gi, '').trim()
  return out.length > 400000 ? '' : out
}

const isDesigned = (html) => (html.match(/<img\b/gi) || []).length >= 3 || (html.match(/<table\b/gi) || []).length >= 4

export function parseGmailThread(text, html = '') {
  const parts = (s) => {
    const p = String(s).replace(/\r\n/g, '\n').split(/^=== Message \d+ ===$/m)
    return { head: p[0], bodies: p.slice(1).map((b) => {
      const raw = b.replace(/^\n+/, '')
      const end = raw.indexOf('\n\n')
      return { head: end < 0 ? raw : raw.slice(0, end), body: end < 0 ? '' : raw.slice(end + 2) }
    }) }
  }
  const t = parts(text)
  const h = parts(html)
  const subject = /^Subject:[ \t]*(.*)$/m.exec(t.head)?.[1]?.trim() || ''
  const messages = t.bodies.map((m, i) => {
    const get = (name) => {
      const v = new RegExp(`^${name}:[ \\t]*(.*)$`, 'm').exec(m.head)?.[1]?.trim() || ''
      return /^\[not present/.test(v) ? '' : v
    }
    const [body, attached = ''] = m.body.split(/^--- ATTACHMENTS ---$/m)
    const attachments = [...attached.matchAll(/^\d+\.\s+(.+?)\s+\(([^,)]+),\s*([^)]+)\)$/gm)].map((a) => ({ name: a[1], type: a[2], size: a[3] }))
    const fwd = unforward(body.trim())
    const sender = person(fwd ? fwd.from : get('From'))
    const { text: said, quoted } = splitQuote(fwd ? fwd.body : body)
    const page = cleanHtml((h.bodies[i]?.body || '').split(/^--- ATTACHMENTS ---$/m)[0])
    return {
      from: sender.name, address: sender.address, to: fwd ? fwd.to : get('To'), date: fwd?.date || get('Date'),
      forwardedBy: fwd ? person(get('From')).name : '', forwardNote: fwd?.note || '',
      text: said.slice(0, 40000), quoted: quoted.slice(0, 40000), html: page, designed: Boolean(page) && !fwd && !quoted && isDesigned(page), attachments,
    }
  })
  return { title: subject.replace(/^((re|fwd?|antw|aw)\s*:\s*)+/i, '').trim() || '(no subject)', who: messages[0]?.from || 'Someone', messages }
}

async function mcpCaller(url) {
  let session = ''
  let n = 0
  const rpc = async (method, params, note) => {
    const headers = { 'Content-Type': 'application/json', Accept: 'application/json, text/event-stream', ...(session ? { 'mcp-session-id': session } : {}) }
    const r = await fetch(url, { method: 'POST', headers, body: JSON.stringify({ jsonrpc: '2.0', method, params, ...(note ? {} : { id: ++n }) }), signal: AbortSignal.timeout(60000) })
    session = r.headers.get('mcp-session-id') || session
    if (note) return null
    const raw = await r.text()
    const data = raw.split('\n').filter((l) => l.startsWith('data:')).pop()
    return JSON.parse(data ? data.slice(5) : raw)
  }
  const init = await rpc('initialize', { protocolVersion: '2025-03-26', capabilities: {}, clientInfo: { name: 'fraim-queue', version: '1' } })
  await rpc('notifications/initialized', {}, true)
  const call = async (name, args) => {
    const out = await rpc('tools/call', { name, arguments: args })
    const text = out.result?.content?.[0]?.text
    if (out.error || out.result?.isError || typeof text !== 'string') throw new Error(`Gmail did not answer: ${out.error?.message || text || 'empty answer'}`)
    return text
  }
  call.account = init.result?.instructions?.match(/^Connected Google account: ([^\s/#?]+@[^\s/#?]+)$/m)?.[1]
  return call
}

// Path /u/0 is whichever account the browser signed in to first, so name the account when known.
const gmailUrl = (thread, account) => `https://mail.google.com/mail/u/${account || 0}/#all/${thread}`

export async function captureMail(gmailThread, quiet = false) {
  if (!/^[\w-]{6,64}$/.test(gmailThread || '')) usage('thread mail needs the Thread ID of the mail')
  const call = await mcpCaller(process.env.FRAIM_GOOGLE_MCP || 'http://google:8000/mcp')
  const text = await call('get_gmail_thread_content', { thread_id: gmailThread })
  const html = await call('get_gmail_thread_content', { thread_id: gmailThread, body_format: 'html' })
  const parsed = parseGmailThread(text, html)
  if (!parsed.messages.length) throw new Error('that mail chain has no messages')
  if (neverShow(parsed.messages.at(-1).address)) return { thread: null, isNew: false, news: false }
  const r = putThread({ kind: 'email', key: `gmail:${gmailThread}`, url: gmailUrl(gmailThread, call.account), ...parsed })
  if (r.news && !quiet) announce(r)
  return r
}

// A contact wrote on WhatsApp. Each number is one conversation, and the message never reaches a
// Claude as a chat: the chief reads it as data, like a mail.
export function addWhatsApp(number, name, text) {
  const phone = String(number || '').replace(/\D/g, '')
  if (!/^\d{8,15}$/.test(phone)) usage('thread whatsapp needs --number with the phone number')
  if (!String(text || '').trim()) usage('thread whatsapp needs the text of the message')
  const key = `whatsapp:${phone}`
  const who = String(name || '').trim() || `+${phone}`
  const before = allThreads().find((t) => t.key === key)
  const message = { from: who, address: `+${phone}`, to: '', date: now(), text: String(text).slice(0, 40000), quoted: '', html: '', designed: false, attachments: [] }
  const r = putThread({ kind: 'whatsapp', key, title: `WhatsApp from ${who}`, who, messages: [...(before?.messages || []), message].slice(-200) })
  if (r.news) announce(r)
  return r
}

// --- answering someone outside: an agent drafts, only the owner's yes sends ------------------

const MAX_REPLY = 20000
const CHANNEL_WORD = { email: 'email', whatsapp: 'WhatsApp' }
const replySummary = (r) => `To: ${r.name} (${r.to}), by ${CHANNEL_WORD[r.channel]}${r.subject ? `\nSubject: ${r.subject}` : ''}\n\n${r.text}`

async function replyCall(channel, route, body) {
  const env = runtimeEnv()
  const base = channel === 'email' ? env.FRAIM_REPLY_MAIL_URL || 'http://google:8001' : env.FRAIM_GATEWAY_URL
  if (!env.FRAIM_REPLY_TOKEN || !base) throw new Error('sending replies is not set up on this server; run fraim update')
  const r = await fetch(`${base}${route}`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${env.FRAIM_REPLY_TOKEN}` }, body: JSON.stringify(body), signal: AbortSignal.timeout(25000) })
  const out = await r.json().catch(() => ({}))
  if (!r.ok) throw new Error(out.error || `the sender answered ${r.status}`)
  return out
}

// Who the answer goes to comes from the conversation itself, never from the agent.
async function replyTarget(t) {
  const mail = /^gmail:([\w-]{6,64})$/.exec(t.key)
  if (mail) {
    const who = await replyCall('email', '/who', { thread_id: mail[1] })
    return { channel: 'email', to: who.to, name: who.name || who.to, subject: who.subject, gmail_thread: mail[1] }
  }
  const phone = /^whatsapp:(\d{8,15})$/.exec(t.key)
  if (phone) {
    await replyCall('whatsapp', '/reply/check', { to: phone[1] })
    return { channel: 'whatsapp', to: phone[1], name: t.who || `+${phone[1]}`, subject: '' }
  }
  usage('only a mail or a WhatsApp conversation has someone to answer')
}

export function draftText(item) {
  const r = item.reply
  return [`Reply ready for ${r.name} (${r.to}), by ${CHANNEL_WORD[r.channel]}. Nothing has gone out.`, '', r.text, '', ...(item.need ? [`Why: ${item.need}`] : []), 'Send it? You can change it in the inbox first:', queueUrl()].join('\n')
}

export async function draftReply(id, text, opts = {}) {
  if (process.env.FRAIM_GOAL) usage('a task does not answer people itself: tell the chief of staff what to say')
  const t = readThread(id)
  text = String(text || '').trim()
  if (!text) usage('reply needs the text of the answer (--file F or -- TEXT)')
  if (text.length > MAX_REPLY) usage(`a reply is at most ${MAX_REPLY} characters`)
  const reply = { ...await replyTarget(t), text, status: 'draft', error: '' }
  // One waiting answer per conversation: a new draft takes the place of the one before.
  for (const old of allItems()) {
    if (old.thread === t.id && old.state === 'open' && old.reply) closeSolved(old, 'a newer draft took its place', 'system')
  }
  const item = addItem({
    title: `Reply to ${reply.name}`, ask: `Send this ${CHANNEL_WORD[reply.channel]} to ${reply.name}?`, advise: 'approve', kind: 'decision',
    need: opts.need, ifYes: `${reply.name} receives exactly this text.`, ifNo: 'Nothing goes out.', summary: replySummary(reply),
    priority: opts.priority || 2, lead: opts.lead, source: opts.lead ? `lead ${opts.lead}` : 'chief', thread: t.id, reply, quiet: true,
  })
  notify(draftText(item), true)
  return item
}

// Runs once, for a card the owner approved. A failed send puts the question back; when the
// answer never came, the mail may be out, so a retry could send it twice and it stays closed.
export async function sendApproved(id) {
  const item = readItem(id)
  if (item.state !== 'approved' || item.reply?.status !== 'sending') throw new Error(`${id} is not an approved reply waiting to go out`)
  const claim = path.join(itemDir(id), '.sending')
  fs.mkdirSync(claim)
  const r = item.reply
  const finish = (changes, card = {}) => {
    const fresh = readItem(id)
    Object.assign(fresh, card)
    fresh.reply = { ...fresh.reply, ...changes }
    writeItem(fresh)
  }
  try {
    if (r.channel === 'email') await replyCall('email', '/reply', { thread_id: r.gmail_thread, to: r.to, text: r.text })
    else await replyCall('whatsapp', '/reply', { to: r.to, text: r.text })
  } catch (err) {
    if (err.name === 'TimeoutError') {
      finish({ status: 'unknown', error: 'no answer from the sender' })
      notify(`I do not know if your reply to ${r.name} went out: the sender did not answer. Check your sent messages before you send it again.`, true)
      return
    }
    fs.rmdirSync(claim)
    finish({ status: 'failed', error: err.message }, { state: 'open', decided: '', via: '' })
    notify(`Your reply to ${r.name} did not go out: ${err.message}. It waits in your inbox.`, true)
    return
  }
  finish({ status: 'sent', sent: now() })
  try { if (item.thread) sayInThread(item.thread, item.lead || 'manual', '', `Sent to ${r.name}:\n\n${r.text}`) } catch {}
  notify(`Your reply to ${r.name} went out.`)
}

// --- the web page ------------------------------------------------------------------------

function token() {
  try {
    const t = fs.readFileSync(TOKEN_FILE, 'utf8').trim()
    if (t) return t
  } catch {}
  const t = crypto.randomBytes(24).toString('base64url')
  fs.mkdirSync(path.dirname(TOKEN_FILE), { recursive: true, mode: 0o700 })
  fs.writeFileSync(TOKEN_FILE, `${t}\n`, { mode: 0o600 })
  return t
}

function sameToken(a, b) {
  const x = Buffer.from(String(a || ''))
  const y = Buffer.from(String(b || ''))
  return x.length === y.length && crypto.timingSafeEqual(x, y)
}

function cookieToken(req) {
  const m = /(?:^|;\s*)fraim_queue=([^;]+)/.exec(req.headers.cookie || '')
  return m ? m[1] : ''
}

function send(res, code, body, type = 'application/json') {
  res.writeHead(code, { 'Content-Type': type, 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'no-referrer' })
  res.end(type === 'application/json' ? JSON.stringify(body) : body)
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    let data = ''
    req.on('data', (c) => {
      data += c
      if (data.length > 100000) reject(new Error('request too large'))
    })
    req.on('end', () => {
      try { resolve(data ? JSON.parse(data) : {}) } catch { reject(new Error('invalid JSON')) }
    })
  })
}

export function createServer(secret = token()) {
  const settings = createSettings({ employees, team, tool, runtimeEnv, send, readBody })
  return http.createServer(async (req, res) => {
    const url = new URL(req.url, 'http://queue')
    try {
      if (url.pathname === '/health') return send(res, 200, { ok: true })
      if (url.searchParams.has('t')) {
        if (!sameToken(url.searchParams.get('t'), secret)) return send(res, 403, 'Wrong link. Ask Claude for the queue link again.', 'text/plain')
        res.writeHead(303, {
          Location: '/',
          'Set-Cookie': `fraim_queue=${secret}; HttpOnly; SameSite=Strict; Path=/; Max-Age=31536000`,
        })
        return res.end()
      }
      if (!sameToken(cookieToken(req), secret)) {
        return send(res, 401, 'Open the queue with the link that includes ?t=. Ask Claude: "give me my queue link".', 'text/plain')
      }
      if (req.method === 'GET' && url.pathname === '/') return send(res, 200, uiPage('inbox', url.searchParams.has('builtin')), 'text/html; charset=utf-8')
      if (await settings.handle(req, res, url)) return
      if (req.method === 'GET' && url.pathname === '/team') return send(res, 200, uiPage('team', url.searchParams.has('builtin')), 'text/html; charset=utf-8')
      if (req.method === 'GET' && url.pathname === '/settings') return send(res, 200, uiPage('settings', url.searchParams.has('builtin')), 'text/html; charset=utf-8')
      if (req.method === 'GET' && /^\/p\/[a-z0-9][a-z0-9-]{0,39}$/.test(url.pathname)) {
        const extra = uiPage(url.pathname.slice(3))
        return extra.trim() ? send(res, 200, extra, 'text/html; charset=utf-8') : send(res, 404, { error: 'no such page' })
      }
      if (req.method === 'GET' && url.pathname === '/api/chief') return send(res, 200, chiefChat())
      if (req.method === 'POST' && url.pathname === '/api/chief/say') {
        if (req.headers['x-fraim-queue'] !== '1') return send(res, 403, { error: 'missing header' })
        const text = String((await readBody(req)).text || '').trim()
        if (!text) usage('write a message first')
        askChief(text)
        return send(res, 200, { ok: true })
      }
      if (req.method === 'GET' && url.pathname === '/api/employees') return send(res, 200, employees())
      if (req.method === 'GET' && url.pathname === '/api/threads') return send(res, 200, inboxRows())
      const conv = /^\/api\/threads\/([tq]\d{1,6})(?:\/(seen|say|dismiss|restore))?$/.exec(url.pathname)
      if (conv && req.method === 'GET' && !conv[2]) return send(res, 200, threadDetail(conv[1]))
      if (conv && req.method === 'POST' && conv[2]) {
        if (req.headers['x-fraim-queue'] !== '1') return send(res, 403, { error: 'missing header' })
        const t = readThread(conv[1])
        if (conv[2] === 'dismiss' || conv[2] === 'restore') {
          if (conv[2] === 'dismiss') dismissThread(t)
          else restoreThread(t)
          return send(res, 200, { ok: true })
        }
        if (conv[2] === 'seen') {
          t.seen = now()
          writeThread(t)
          return send(res, 200, { ok: true })
        }
        const text = String((await readBody(req)).text || '').trim()
        if (!text) usage('write a message first')
        sayInThread(t.id, 'owner', '', text)
        tellChief(t, 'owner', promptText('thread-owner', { text }))
        return send(res, 200, { ok: true })
      }
      if (req.method === 'GET' && url.pathname === '/api/items') {
        const all = url.searchParams.get('all') === '1'
        return send(res, 200, rank(allItems().filter((i) => all || i.state === 'open')))
      }
      if (req.method === 'GET' && url.pathname === '/api/team') return send(res, 200, team())
      if (req.method === 'GET' && url.pathname === '/api/active') return send(res, 200, await active())
      const who = /^\/api\/member\/([a-z0-9][a-z0-9_-]{0,47})$/.exec(url.pathname)
      if (who && req.method === 'GET') {
        const m = member(who[1])
        return m ? send(res, 200, m) : send(res, 404, { error: 'no such lead or automation' })
      }
      const agent = /^\/api\/active\/([a-z0-9][a-z0-9_-]{0,47})\/(screen|send)$/.exec(url.pathname)
      if (agent && req.method === 'GET' && agent[2] === 'screen') return send(res, 200, await agentScreen(agent[1]))
      if (agent && req.method === 'POST' && agent[2] === 'send') {
        if (req.headers['x-fraim-queue'] !== '1') return send(res, 403, { error: 'missing header' })
        return send(res, 200, await agentSend(agent[1], (await readBody(req)).text))
      }
      const media = /^\/media\/(q\d{1,6})\/([^/]+)$/.exec(url.pathname)
      if (req.method === 'GET' && media) {
        const item = readItem(media[1])
        const name = decodeURIComponent(media[2])
        if (!item.media.includes(name)) return send(res, 404, { error: 'no such file' })
        const file = path.join(itemDir(item.id), 'media', name)
        const type = MEDIA_TYPES[path.extname(name).toLowerCase()] || 'application/octet-stream'
        res.writeHead(200, { 'Content-Type': type, 'Content-Length': fs.statSync(file).size, 'Cache-Control': 'private, max-age=3600' })
        return fs.createReadStream(file).pipe(res)
      }
      const action = /^\/api\/items\/(q\d{1,6})\/(decide|priority)$/.exec(url.pathname)
      if (req.method === 'POST' && action) {
        // A custom header: a form on another site cannot send it, so no cross-site posts.
        if (req.headers['x-fraim-queue'] !== '1') return send(res, 403, { error: 'missing header' })
        const body = await readBody(req)
        if (action[2] === 'priority') return send(res, 200, setPriority(action[1], body.priority))
        return send(res, 200, decide(action[1], body.verdict, body.note, 'page', body.text))
      }
      return send(res, 404, { error: 'not found' })
    } catch (err) {
      const code = err instanceof UsageError ? 400 : /^no queue item|already/.test(err.message) ? 409 : 500
      return send(res, code, { error: err.message })
    }
  })
}

// The pages are files the owner's chief can change (fraim-ui): the owner's file wins, and
// ?builtin=1 always shows the default, so a broken page can never lock the owner out.
const UI_DEFAULTS = process.env.FRAIM_UI_DEFAULTS || (() => {
  const checkout = process.argv[1] ? path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'ui') : ''
  return checkout && fs.existsSync(checkout) ? checkout : '/etc/fraim/ui'
})()
const UI_OWNER = process.env.FRAIM_UI_DIR || path.join(HOME, 'fraim/ui')
const UI_MAX = 8000000

function uiPage(name, builtin) {
  if (!builtin) {
    const own = readText(path.join(UI_OWNER, `${name}.html`), UI_MAX)
    if (own.trim()) return own
  }
  return readText(path.join(UI_DEFAULTS, `${name}.html`), UI_MAX)
}

// The inbox: what came in on the left, the thing itself in the middle (shown, never edited), the
// agents talking about it on the right. Code draws the middle from saved fields, one layout per
// kind; anything unknown gets the plain card, so that pane is never blank.

// --- CLI ---------------------------------------------------------------------------------

function parseArgs(argv, multi = []) {
  const out = { _: [] }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--') { out._.push(...argv.slice(i + 1)); break }
    if (!a.startsWith('--')) { out._.push(a); continue }
    const key = a.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase())
    if (['all', 'json', 'quiet', 'result'].includes(key)) { out[key] = true; continue }
    if (i + 1 >= argv.length) usage(`${a} needs a value`)
    const value = argv[++i]
    if (multi.includes(key)) (out[key] ||= []).push(value)
    else out[key] = value
  }
  return out
}

function threadCommand(args) {
  const [what, id, ...words] = args._
  switch (what) {
    case 'mail':
      return captureMail(id, args.quiet).then((r) => console.log(r.thread ? r.thread.id : 'kept out by inbox-rules.md'))
    case 'put': {
      const data = JSON.parse(fs.readFileSync(args.file || 0, 'utf8'))
      if (args.kind) data.kind = args.kind
      if (args.key) data.key = args.key
      const r = putThread(data)
      if (r.news && !args.quiet) announce(r)
      return console.log(r.thread.id)
    }
    case 'close':
      if (!id) usage('thread close tN --from WHO --reason TEXT')
      return closeThread(id, args.from, args.reason)
    case 'ignore':
      if (!args.from && !id) usage('thread ignore --from ADDRESS|@DOMAIN, or thread ignore "RULE"')
      return console.log(addRule(args.from ? `never: ${args.from}` : `not relevant: ${[id, ...words].join(' ')}`))
    case 'say':
      if (!id) usage('thread say tN --from WHO [--to WHO] -- TEXT')
      return sayInThread(id, args.from || 'owner', args.to || '', words.join(' '))
    case 'whatsapp': {
      const r = addWhatsApp(args.number, args.name, args._.slice(1).join(' '))
      return console.log(r.thread.id)
    }
    case 'show':
      if (!id) usage('thread show tN')
      return console.log(describeThread(id))
    case 'list':
      return console.log(inboxRows().map((r) => `${r.id}  ${r.state}  ${r.who}  ${r.title}`).join('\n'))
    default:
      usage('thread mail GMAIL_THREAD_ID | put [--kind K] [--key K] [--file F] | say tN --from WHO -- TEXT | close tN --from WHO --reason TEXT | ignore --from ADDRESS | ignore "RULE" | show tN | list')
  }
}

function main(argv) {
  const [action, ...rest] = argv
  const args = parseArgs(rest, ['link', 'media', 'why'])
  const id = args._[0]
  switch (action) {
    case 'add': {
      let summary = args.summary || ''
      if (args.summaryFile) summary = fs.readFileSync(args.summaryFile, 'utf8')
      const item = addItem({ ...args, summary, links: args.link, media: args.media })
      if (!args.result || item.state === 'open') console.log(item.id)
      return
    }
    case 'grant': {
      const item = grantRequest(args.title, args.note, args.via === 'whatsapp' ? 'whatsapp' : 'cli')
      console.log(item.id)
      return
    }
    case 'list': {
      let items = rank(allItems().filter((i) => args.all || i.state === 'open'))
      if (args.lead) items = items.filter((i) => i.lead === args.lead)
      if (args.json) return console.log(JSON.stringify(items))
      if (!items.length) return console.log('Nothing waits for you.')
      return console.log(items.slice(0, 50).map(line).join('\n'))
    }
    case 'show': {
      if (!id) usage('show ID')
      const item = readItem(id)
      return console.log(args.json ? JSON.stringify(item) : describe(item))
    }
    case 'approve':
    case 'reject':
    case 'dismiss': {
      if (!id) usage(`${action} ID`)
      const verdict = { approve: 'approved', reject: 'rejected', dismiss: 'dismissed' }[action]
      const item = decide(id, verdict, args.note || args._.slice(1).join(' '), args.via === 'whatsapp' ? 'whatsapp' : 'cli')
      return console.log(`${item.id} ${item.state}${item.follow_up ? `; goal ${item.follow_up} started` : ''}${item.outcome ? `. ${item.outcome}` : ''}`)
    }
    case 'reply': {
      if (!id) usage('reply tN [--file F | -- TEXT] [--lead NAME] [--need WHY] [--priority N]')
      const text = args.file ? fs.readFileSync(args.file, 'utf8') : args._.slice(1).join(' ')
      return draftReply(id, text, { lead: args.lead, need: args.need, priority: args.priority }).then((item) => console.log(item.id))
    }
    case 'send-reply':
      if (!id) usage('send-reply ID')
      return sendApproved(id)
    case 'supersede': {
      const closed = supersedeFailed(args.origin, args.by)
      return console.log(closed.length ? `closed ${closed.join(' ')}` : 'nothing to close')
    }
    case 'solved': {
      if (!id) usage('solved ID --proof "<what proves it is solved>"')
      const item = markSolved(id, args.proof)
      return console.log(`${item.id} closed as solved`)
    }
    case 'recovered': {
      const closed = closeRecovered(args.source)
      return console.log(closed.length ? `closed ${closed.join(' ')}` : 'nothing to close')
    }
    case 'prio': {
      if (!id || !args._[1]) usage('prio ID 1|2|3')
      const item = setPriority(id, args._[1])
      return console.log(`${item.id} priority ${item.priority}`)
    }
    case 'url':
      token()
      return console.log(queueUrl())
    case 'thread':
      return threadCommand(args)
    case 'token':
      return console.log(token())
    case 'serve': {
      SERVING = true
      const server = createServer()
      server.on('error', (err) => {
        process.stderr.write(`fraim-queue: ${err.message}\n`)
        process.exit(1)
      })
      server.listen(PORT, process.env.FRAIM_QUEUE_BIND || '0.0.0.0', () => process.stderr.write(`fraim-queue: page on port ${PORT}\n`))
      return
    }
    default:
      usage('add | grant --title T | reply tN | list | show ID | approve ID | reject ID --note TEXT | dismiss ID | solved ID --proof TEXT | recovered --source S | prio ID N | serve | url')
  }
}

const isMain = process.argv[1] && fs.realpathSync(process.argv[1]) === fs.realpathSync(new URL(import.meta.url).pathname)
if (isMain) {
  const fail = (err) => {
    process.stderr.write(`fraim-queue: ${err.message}\n`)
    process.exit(err instanceof UsageError ? 2 : 1)
  }
  try {
    Promise.resolve(main(process.argv.slice(2))).catch(fail)
  } catch (err) {
    fail(err)
  }
}
