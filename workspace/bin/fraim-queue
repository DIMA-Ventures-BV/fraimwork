  inbox: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 9.5l1.6-5.2A1.5 1.5 0 0 1 5 3.2h6a1.5 1.5 0 0 1 1.4 1.1L14 9.5V12a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12z"/><path d="M2 9.5h3.2l.8 1.5h4l.8-1.5H14"/></svg>',
  done: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="6"/><path d="M5.5 8.2l1.7 1.7 3.3-3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  mic: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>',
  up: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 10l4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  down: '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  clear: '<svg width="28" height="28" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="8" cy="8" r="6.5"/><path d="M5.3 8.2l1.8 1.8 3.6-3.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'
}

async function load(keepId) {
  var got = await Promise.all([fetch('/api/items?all=1'), fetch('/api/team').catch(function () {}), fetch('/api/active').catch(function () {})])
  var res = got[0]
  if (!res.ok) { $('#detail').innerHTML = '<div class="empty"><b>No access</b>' + esc(await res.text()) + '</div>'; return }
  all = await res.json()
  try { if (got[1] && got[1].ok) teamData = await got[1].json() } catch (e) {}
  try { if (got[2] && got[2].ok) agents = await got[2].json() } catch (e) {}
  tellApp()
  if (!/^who:/.test(view) || whoItem) { clearInterval(memberTimer); memberTimer = null; memberKey = '' }
  $('.app').classList.remove('solo')
  $('#back').style.display = 'none'
  if (view === 'active') {
    var keep = keepId || (items[sel] && items[sel].name)
    items = agents
    var ai = keep ? items.findIndex(function (a) { return a.name === keep }) : -1
    sel = ai >= 0 ? ai : Math.min(sel, Math.max(items.length - 1, 0))
    $('#toggle').style.display = 'none'
    renderSide(all.filter(function (i) { return i.state === 'open' }), []); renderAgents(); renderAgent()
    return
  }
  clearInterval(screenTimer)
  var open = all.filter(function (i) { return i.state === 'open' })
  var done = all.filter(function (i) { return i.state !== 'open' }).sort(function (a, b) { return String(b.decided).localeCompare(String(a.decided)) })
  if (view === 'done') items = done
  else {
    var pool = open
    if (/^p[123]$/.test(view)) pool = open.filter(function (i) { return i.priority === +view[1] })
    else if (/^who:/.test(view)) pool = open.filter(function (i) { return owner(i) === view.slice(4) })
    items = pool.slice().sort(function (a, b) { return a.priority - b.priority })
    if (showDone) items = items.concat(view === 'inbox' ? done : done.filter(function (i) { return /^who:/.test(view) ? owner(i) === view.slice(4) : /^p/.test(view) ? i.priority === +view[1] : true }))
  }
  var idx = keepId ? items.findIndex(function (i) { return i.id === keepId }) : -1
  sel = idx >= 0 ? idx : Math.min(sel, Math.max(items.length - 1, 0))
  $('#toggle').setAttribute('aria-pressed', showDone)
  $('#toggle').style.display = view === 'done' ? 'none' : ''
  if (view === 'people') {
    items = []; sel = -1
    $('.app').classList.add('solo')
    renderSide(open, done); renderPeople()
    return
  }
  if (whoItem && !items.length) whoItem = null
  var page = /^who:/.test(view) && !whoItem && memberOf(view.slice(4))
  if (page) {
    sel = -1
    $('.app').classList.add('solo')
    renderSide(open, done); renderMember(page)
    return
  }
  if (whoItem) $('#back').style.display = ''
  renderSide(open, done); renderList(); renderDetail()
}

var peopleKey = ''
function personRow(p) {
  var st = agents.some(function (a) { return a.name === p.name && a.status === 'working' }) ? 'running' : p.off ? 'off' : p.status
  var word = st === 'running' ? 'Working now' : st === 'off' ? 'Switched off' : st === 'paused' ? 'Paused' : st === 'failed' ? 'Last run failed' : st === 'never' ? 'Not started yet' : 'On'
  var starts = p.starts.map(whenWords).join(', ')
  return '<button class="p-row" data-who="' + esc(p.name) + '"><span class="p-a">' + esc((p.title || '?').slice(0, 2).toUpperCase()) + '</span><span class="p-m"><b>' + esc(p.title) + '</b>' + (p.product ? ' <small>' + esc(p.product) + '</small>' : '') + '<span class="p-d">' + esc(p.does) + '</span></span><span class="p-s">' + esc(starts) + '</span><span class="p-t">' + (p.tools.length ? p.tools.map(function (t) { return '<i>' + esc(t) + '</i>' }).join('') : '') + '</span><span class="p-w st-' + st + '">' + word + '</span></button>'
}
async function renderPeople() {
  var r = await fetch('/api/employees').catch(function () {})
  if (!r || !r.ok || view !== 'people') return
  var d = await r.json(), key = JSON.stringify([d, agents.map(function (a) { return a.name + a.status })])
  if (key === peopleKey && $('#people')) return
  peopleKey = key
  $('#detail').innerHTML = '<div id="people" style="display:contents"><div class="bar"><div class="crumb"><b>Employees</b></div></div><div class="doc"><div class="doc-in" style="max-width:1040px"><h2>Employees</h2><p class="about">Everyone who works for you. To hire someone or change how someone works, tell the chief of staff.</p>' +
    '<div class="boxed">' + d.people.map(personRow).join('') + '</div>' +
    (d.watchers.length ? '<div class="h3">Automations</div><div class="boxed">' + d.watchers.map(personRow).join('') + '</div>' : '') +
    '<p class="quiet" style="margin-top:14px">The tools listed are not locked yet: every employee can use everything connected to this server.</p></div></div></div>'
}

// A schedule as a person says it: no cron fields on the page.
function whenWords(w) {
  var m = /^schedule (\\S+) (\\S+) (\\S+) (\\S+) (\\S+)$/.exec(w || '')
  if (m) {
    var at = /^\\d+$/.test(m[1]) && /^\\d+$/.test(m[2]) ? ('0' + m[2]).slice(-2) + ':' + ('0' + m[1]).slice(-2) : ''
    var days = { '*': 'Every day', '1-5': 'Every weekday', '0': 'Every Sunday', '1': 'Every Monday', '2': 'Every Tuesday', '3': 'Every Wednesday', '4': 'Every Thursday', '5': 'Every Friday', '6': 'Every Saturday' }
    if (at && m[3] === '*' && m[4] === '*' && days[m[5]]) return days[m[5]] + ' at ' + at
    if (at && m[3] === '*' && m[4] === '*' && /^[0-6](,[0-6])+$/.test(m[5])) return 'Every ' + m[5].split(',').map(function (x) { return days[x].slice(6) }).join(' and ') + ' at ' + at
    var n = /^\\*\\/(\\d+)$/.exec(m[1])
    if (n && m[2] === '*') return 'Every ' + n[1] + ' minutes'
    var h = /^\\*\\/(\\d+)$/.exec(m[2])
    if (h && /^\\d+$/.test(m[1])) return 'Every ' + h[1] + ' hours'
    return 'On a schedule (' + w.slice(9) + ')'
  }
  var e = /^every (\\d+)\\s*([mhd])/.exec(w || '')
  if (e) return 'Every ' + e[1] + ' ' + { m: 'minutes', h: 'hours', d: 'days' }[e[2]]
  if (w === 'by hand') return 'Only when someone starts it'
  if (/^queue:/.test(w || '')) return 'When something new lands in the queue'
  var t = /^(\\w+):\\s*(.*)$/.exec(w || '')
  if (t && t[1] === 'files') return 'When a new file lands in ' + t[2]
  if (t && t[1] === 'after') return 'After ' + t[2] + ' finishes'
  return w || ''
}
function isQuiet(t) { return !t || /(^|\\s)SILENT\\s*$/.test(t) }
function readable(t) { return esc(t).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>').replace(/^#+\\s*(.+)$/gm, '<b>$1</b>') }
var MEMBER_STATUS = { failed: 'Last run failed', paused: 'Paused: it skips its runs until someone resumes it', never: 'Has not run yet', off: 'Switched off: it does not run', ok: 'Last run went fine' }
function renderMember(m) {
  var same = $('#member') && $('#member').dataset.name === m.name
  if (!same) {
    memberData = null; memberKey = ''
    $('#detail').innerHTML = '<div id="member" data-name="' + esc(m.name) + '" style="display:contents"></div>'
    clearInterval(memberTimer)
    memberTimer = setInterval(function () { fetchMember(m) }, 4000)
    fetchMember(m)
  }
  paintMember(m)
}
async function fetchMember(m) {
  var r = await fetch('/api/member/' + encodeURIComponent(m.name)).catch(function () {})
  if (!r || !r.ok || view !== 'who:' + m.name || whoItem) return
  var d = await r.json(), flipped = memberData && memberData.running !== d.running
  memberData = d
  if (flipped) load(); else paintMember(m)
}
function paintMember(m) {
  var box = $('#member'), d = memberData; if (!box) return
  var key = JSON.stringify([d, m, agents.map(function (a) { return a.name + a.status }), items.map(function (i) { return i.id })])
  if (key === memberKey) return
  memberKey = key
  var keep = {}; box.querySelectorAll('details[open]').forEach(function (e) { keep[e.dataset.run] = true })
  var doc = box.querySelector('.doc'), top = doc ? doc.scrollTop : 0
  var st = d && d.running ? 'running' : memberState(m) === 'running' ? (d ? (m.off ? 'off' : m.status) : 'running') : memberState(m)
  var runs = d ? d.runs : [], last = runs[0]
  var status = st === 'running' ? '<span class="live" style="margin:0 3px"></span>Running now' + (d && d.since ? ', started ' + (ago(d.since) === 'now' ? 'just now' : ago(d.since) + ' ago') : '') : '<span class="dot d-' + st + '"></span>' + esc(MEMBER_STATUS[st] || st)
  var openItems = items.filter(function (i) { return i.state === 'open' })
  var waiting = openItems.length ? openItems.length + (openItems.length === 1 ? ' item' : ' items') : 'Nothing'
  var html = '<div class="bar"><div class="crumb">' + (m.lead ? 'Leads' : 'Automations') + '<span>/</span><b>' + esc(m.title || m.name) + '</b></div></div><div class="doc"><div class="doc-in"><h2>' + esc(m.title || m.name) + '</h2>' +
    ((d && d.about) || m.description ? '<p class="about">' + esc((d && d.about) || m.description) + '</p>' : '') +
    '<dl class="props"><dt>Status</dt><dd>' + status + '</dd><dt>Starts when</dt><dd>' + esc(whenWords(m.when)) + (m.lead ? ', or when someone leaves it a note' : '') + '</dd>' +
    '<dt>Last run</dt><dd>' + esc(last ? since(last.time) : since(m.last)) + '</dd><dt>Waiting for you</dt><dd>' + waiting + '</dd></dl>' +
    (st === 'failed' && m.detail ? '<div class="ask">' + esc(m.detail) + '</div>' : '')
  if (openItems.length) html += '<div class="h3" style="margin-top:0">Waiting for you</div><div class="boxed">' + openItems.map(rowHtml).join('') + '</div>'
  if (st === 'running') {
    html += '<div class="h3">What it does now</div>'
    html += d && d.steps.length ? '<ol class="steps">' + d.steps.map(function (s, i) {
      var mark = '<span>' + (i === 0 ? '<span class="live" style="display:block"></span>' : '') + '</span>'
      return '<li>' + mark + (s.say ? '<span class="say">' + esc(s.say) + '</span>' : '<span class="v">' + esc(s.did) + '</span><span class="w" title="' + esc(s.what) + '">' + esc(s.what) + '</span>') + '</li>'
    }).join('') + '</ol>' : '<div class="quiet">Starting up.</div>'
  }
  if (last) html += '<div class="h3">' + (st === 'running' ? 'Previous run' : 'Last run') + ', ' + esc(since(last.time)) + '</div><div class="desc' + (isQuiet(last.text) ? ' quiet' : '') + '">' + (isQuiet(last.text) ? 'It found nothing to report.' : readable(last.text)) + '</div>'
  if (runs.length > 1) html += '<div class="h3">Earlier runs</div><div class="boxed">' + runs.slice(1).map(function (r) {
    var q = isQuiet(r.text), first = q ? 'Nothing to report' : r.text.split('\\n').filter(Boolean)[0].replace(/[#*]/g, '').trim()
    return '<details class="run" data-run="' + esc(r.time) + '"' + (keep[r.time] ? ' open' : '') + '><summary><span class="when">' + esc(since(r.time)) + '</span><span class="pv' + (q ? ' quiet' : '') + '">' + esc(first) + '</span></summary>' + (q ? '' : '<div class="desc">' + readable(r.text) + '</div>') + '</details>'
  }).join('') + '</div>'
  box.innerHTML = html + '</div></div>'
  var nd = box.querySelector('.doc'); if (nd) nd.scrollTop = top
}

function navBtn(id, icon, label, count) {
  return '<button data-view="' + esc(id) + '" aria-current="' + (view === id) + '">' + icon + '<span class="nm">' + esc(label) + '</span><span class="c">' + (count || '') + '</span></button>'
}
// The state of a lead or automation in words: the dot alone did not say what it meant.
var MEMBER_WORD = { running: 'running', failed: 'failed', paused: 'paused', never: 'not run yet', off: 'off' }
function memberState(m) {
  if (agents.some(function (a) { return a.name === m.name && a.status === 'working' })) return 'running'
  return m.off ? 'off' : m.status
}
function memberTitle(m) {
  var st = memberState(m)
  return st === 'running' ? 'Running now. Click to see what it does.' : st === 'off' ? 'Switched off: it does not run until it is switched on.'
    : st === 'failed' ? 'Failed ' + since(m.last) + (m.detail ? ': ' + m.detail : '') : st === 'paused' ? 'Paused: it skips its runs until resumed.'
    : st === 'never' ? 'Not run yet. ' + whenWords(m.when) + '.' : 'Last run ' + since(m.last) + ' went fine. ' + whenWords(m.when) + '.'
}
function memberBtn(m, open) {
  var n = open.filter(function (i) { return owner(i) === m.name }).length
  var st = memberState(m)
  var dot = st === 'running' ? '<span class="live" style="margin:0 3px"></span>' : '<span class="dot d-' + st + '"></span>'
  var text = MEMBER_WORD[st] || (m.last ? since(m.last).replace('today ', '') : '')
  var word = text ? '<span class="st st-' + st + '">' + esc(text) + '</span>' : ''
  return '<button data-view="who:' + esc(m.name) + '" aria-current="' + (view === 'who:' + m.name) + '" title="' + esc(memberTitle(m)) + '">' + dot + '<span class="nm">' + esc(m.title || m.name) + '</span>' + word + '<span class="c">' + (n || '') + '</span></button>'
}
function memberOf(name) {
  return teamData.leads.concat(teamData.automations).filter(function (m) { return m.name === name })[0]
}
// The app shell (Fraim Queue.app) shows the inbox count on its Dock icon and a notice for each
// new item. In a browser there is no shell and this does nothing.
var seenIds = null
function tellApp() {
  var h = window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.fraim
  if (!h) return
  var open = all.filter(function (i) { return i.state === 'open' })
  var fresh = seenIds ? open.filter(function (i) { return !seenIds[i.id] }) : []
  seenIds = {}; open.forEach(function (i) { seenIds[i.id] = true })
  try { h.postMessage({ count: open.length, fresh: fresh.slice(0, 5).map(function (i) { return { id: i.id, title: i.title, body: i.ask || i.need || owner(i) } }) }) } catch (e) {}
}
function renderSide(open, done) {
  var leads = teamData.leads.filter(function (m) { return m.role !== 'chief' })
  var html = '<div class="ws"><span class="logo">f</span>fraim</div><div class="nav">' +
    '<a class="back" href="/">' + ICON.inbox + '<span class="nm">Inbox</span><span class="c">' + (open.length || '') + '</span></a>' +
    navBtn('people', ICON.done, 'Employees', '') +
    navBtn('active', agents.some(function (a) { return a.status === 'working' }) ? '<span class="live" style="margin:0 3px"></span>' : ICON.done, 'Active', agents.filter(function (a) { return a.status === 'working' || a.status === 'blocked' }).length) + '</div>'
  if (leads.length) html += '<div class="sec">Leads</div><div class="nav">' + leads.map(function (m) { return memberBtn(m, open) }).join('') + '</div>'
  if (teamData.automations.length) html += '<div class="sec">Automations</div><div class="nav">' + teamData.automations.map(function (m) { return memberBtn(m, open) }).join('') + '</div>'
  $('#side').innerHTML = html
  var title = view === 'active' ? 'Active' : view === 'inbox' ? 'Inbox' : view === 'done' ? 'Decided' : /^p/.test(view) ? WHEN[+view[1]] : view.slice(4)
  $('#view-title').textContent = title
  $('#view-count').textContent = items.filter(function (i) { return i.state === 'open' }).length || ''
}

function briefHtml() {
  var c = teamData.chief
  if (view !== 'inbox') return ''
  var text, quiet = false, when
  if (!c) { text = 'No chief of staff yet. Ask Claude to make one: it reads every lead, automation and this inbox, and briefs you each morning.'; quiet = true; when = '' }
  else if (!c.text) { var s = (c.schedule || '').split(' '); text = 'The first briefing arrives ' + (s.length === 5 ? 'at ' + s[1] + ':' + ('0' + s[0]).slice(-2) : 'on its schedule') + '.'; quiet = true; when = '' }
  else if (c.text.replace(/\\s/g, '') === 'SILENT') { text = 'Nothing needs you today.'; when = since(c.time) }
  else { text = c.text; when = since(c.time) }
  var long = text.split('\\n').length > 3 || text.length > 280
  return '<div class="brief"><div class="brief-h"><span class="av">CS</span><b>Chief of staff</b>' + (when ? '<span>' + esc(when) + '</span>' : '') + '</div>' +
    '<div class="brief-t' + (quiet ? ' quiet' : '') + (long && !briefOpen ? ' clamp' : '') + '">' + esc(text) + '</div>' +
    (long ? '<button class="linkbtn" id="more">' + (briefOpen ? 'Show less' : 'Show all') + '</button>' : '') + '</div>'
}
function rowHtml(it, i) {
  var o = owner(it)
  return '<button class="row' + (it.state === 'open' ? '' : ' done') + '" data-i="' + i + '" aria-current="' + (i === sel) + '">' +
    (it.state === 'open' ? prioIcon(it.priority) : '<span></span>') + '<span class="id">' + esc(it.id.toUpperCase()) + '</span>' + statusIcon(it) +
    '<span class="t">' + esc(it.title) + '</span>' +
    '<span class="r"><span class="label" style="--lc:' + (KIND_COLOR[it.kind] || 'var(--faint)') + '"><i></i>' + esc(o) + '</span><span>' + ago(it.state === 'open' ? it.created : it.decided) + '</span></span></button>'
}
function renderList() {
  var html = briefHtml()
  if (!items.length) {
    $('#list').innerHTML = html + '<div class="none">' + (view === 'done' ? 'Nothing decided yet.' : 'Nothing here.') + '</div>'
    return
  }
  var last = null
  items.forEach(function (it, i) {
    var g = it.state === 'open' ? 'p' + it.priority : 'done'
    if (g !== last && view !== 'done') {
      var n = items.filter(function (x) { return (x.state === 'open' ? 'p' + x.priority : 'done') === g }).length
      html += '<div class="ghead">' + (g === 'done' ? ICON.done + 'Decided' : prioIcon(+g[1]) + WHEN[+g[1]]) + '<span class="c">' + n + '</span></div>'
      last = g
    }
    html += rowHtml(it, i)
  })
  $('#list').innerHTML = html
}

function mediaHtml(it) {
  return it.media.map(function (m) {
    var src = '/media/' + it.id + '/' + encodeURIComponent(m)
    return /\\.(webm|mp4|mov)$/i.test(m) ? '<video controls preload="metadata" src="' + src + '"></video>'
      : '<a href="' + src + '" target="_blank"><img src="' + src + '" alt="Screenshot ' + esc(m) + '"></a>'
  }).join('')
}
function linkHtml(u) {
  var gh = '<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.8-3.6 4 .3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 0z"/></svg>'
  var lk = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6.5 9.5l3-3M7 4.5l1-1a2.8 2.8 0 0 1 4 4l-1 1M9 11.5l-1 1a2.8 2.8 0 0 1-4-4l1-1" stroke-linecap="round"/></svg>'
  var m = /github\\.com\\/([^/]+\\/[^/]+)\\/(pull|issues)\\/(\\d+)/.exec(u)
  var body = m ? gh + (m[2] === 'pull' ? 'Pull request #' : 'Issue #') + m[3] + ' <span>' + esc(m[1]) + '</span>' : (function () {
    try { var p = new URL(u); return lk + esc(p.hostname.replace(/^www\\./, '')) + ' <span>' + esc(p.pathname.length > 1 ? p.pathname : '') + '</span>' } catch (e) { return lk + esc(u) }
  })()
  return '<a target="_blank" rel="noopener" href="' + esc(safeUrl(u)) + '">' + body + '</a>'
}
function renderDetail() {
  var el = $('#detail'), it = items[sel]
  if (!it) {
    el.innerHTML = '<div class="empty">' + ICON.clear + '<b>' + (view === 'done' ? 'Nothing decided yet' : 'Inbox zero') + '</b>Leads, goals and automations put what needs you here. The chief briefs you each morning.</div>'
    return
  }
  var open = it.state === 'open'
  var crumb = view === 'inbox' ? 'Inbox' : view === 'done' ? 'Decided' : /^p/.test(view) ? WHEN[+view[1]] : view.slice(4)
  var html = '<div class="bar"><div class="crumb">' + esc(crumb) + '<span>/</span><b>' + esc(it.id.toUpperCase()) + '</b></div><span class="grow"></span>' +
    '<span class="c">' + (sel + 1) + ' / ' + items.length + '</span><button class="icon" id="prev" title="Previous (k)" aria-label="Previous">' + ICON.up + '</button><button class="icon" id="next" title="Next (j)" aria-label="Next">' + ICON.down + '</button></div>'
  var ADV = { approve: ['Approve', 'var(--green)'], reject: ['Send back', 'var(--red)'], dismiss: ['Skip', 'var(--muted)'] }
  var card = it.ask || it.advise || it.need || (it.why && it.why.length)
  var effects = [['Why it is needed', it.need], ['If you approve', it.if_yes], ['If you say no', it.if_no]].filter(function (e) { return e[1] })
  html += '<div class="doc"><div class="doc-in">' +
    '<h2>' + esc(it.title) + '</h2>' +
    (card ? '<div class="decide">' + (it.ask ? '<p class="q">' + esc(it.ask) + '</p>' : '') +
      (it.advise ? '<div class="adv" style="--advc:' + ADV[it.advise][1] + '">My advice: <b>' + ADV[it.advise][0] + '</b></div>' : '') +
      (effects.length ? '<dl class="fx">' + effects.map(function (e) { return '<dt>' + e[0] + '</dt><dd>' + esc(e[1]) + '</dd>' }).join('') + '</dl>' : '') +
      (it.why && it.why.length ? '<ul>' + it.why.map(function (w) { return '<li>' + esc(w) + '</li>' }).join('') + '</ul>' : '') +
      '</div>' : '') +
    (card && !it.if_yes && (it.on_approve || it.switch_on) ? '<div class="h3" style="margin-top:0">If you approve</div><div class="next" style="margin-bottom:20px">' + esc(it.on_approve || ('It starts running: ' + it.switch_on + '.')) + '</div>' : '') +
    '<dl class="props">' +
    '<dt>Status</dt><dd>' + statusIcon(it) + (open ? 'Waiting for you' : VERB[it.state] + ' ' + ago(it.decided) + ' ago') + '</dd>' +
    '<dt>Type</dt><dd><span class="label" style="--lc:' + KIND_COLOR[it.kind] + '"><i></i>' + esc(KIND[it.kind] || it.kind) + '</span></dd>' +
    '<dt>Needed</dt><dd>' + (open ? '<span class="seg" role="group" aria-label="When is it needed">' + [1, 2, 3].map(function (p) { return '<button data-p="' + p + '" aria-pressed="' + (it.priority === p) + '">' + prioIcon(p) + WHEN[p] + '</button>' }).join('') + '</span>' : prioIcon(it.priority) + WHEN[it.priority]) + '</dd>' +
    '<dt>From</dt><dd>' + esc(owner(it)) + (it.goal ? ' <span class="c">goal ' + esc(it.goal) + '</span>' : '') + '</dd>' +
    '<dt>Created</dt><dd>' + esc(new Date(it.created).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })) + '</dd>' +
    '</dl>' +
    (it.summary ? (card ? '<details class="more"><summary>Full report</summary><div class="desc">' + esc(it.summary) + '</div></details>' : '<div class="desc">' + esc(it.summary) + '</div>') : (card ? '' : '<div class="desc" style="color:var(--muted)">No description.</div>')) +
    (it.media.length ? '<div class="h3">Screenshots</div><div class="media">' + mediaHtml(it) + '</div>' : '') +
    (it.links.length ? '<div class="h3">Links</div><div class="att">' + it.links.map(linkHtml).join('') + '</div>' : '') +
    (it.on_approve && !card ? '<div class="h3">On approve, the server starts</div><div class="next">' + esc(it.on_approve) + '</div>' : '') +
    (open ? '' : '<div class="h3">Activity</div><div class="activity">' + statusIcon(it) + '<span>' + VERB[it.state] + (it.note ? ': ' + esc(it.note) : '') + (it.follow_up ? '. Started goal ' + esc(it.follow_up) + '.' : '') + '</span></div>') +
    (it.history && it.history.length ? '<details class="more" style="margin-top:20px"><summary>Earlier steps of this job (' + it.history.length + ')</summary>' + it.history.slice().reverse().map(stepHtml).join('') + '</details>' : '') +
    '</div></div>'
  if (open) {
    html += '<div class="composer"><div class="composer-in"><textarea id="note" rows="1" placeholder="Leave a note for the agent. Sending back needs one."></textarea>' +
      '<div class="ctl"><button class="icon" id="mic" title="Dictate (v)" aria-label="Dictate a note">' + ICON.mic + '</button><span class="grow"></span>' +
      '<button class="act' + (it.advise === 'dismiss' ? ' advised' : '') + '" data-v="dismissed">Skip <kbd>D</kbd></button><button class="act danger' + (it.advise === 'reject' ? ' advised' : '') + '" data-v="rejected">Send back <kbd>R</kbd></button><button class="act primary' + (it.advise === 'approve' ? ' advised' : '') + '" data-v="approved">Approve <kbd>A</kbd></button></div></div></div>'
  }
  el.innerHTML = html
  var ta = $('#note'); if (ta) ta.addEventListener('input', function () { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px' })
}
function stepHtml(s) {
  return '<div class="h3">' + esc(s.ask || s.title) + '</div><div class="activity">' + statusIcon(s) + '<span>' + esc(VERB[s.state] || 'Waited') + (s.note ? ': ' + esc(s.note) : '') + ' ' + ago(s.decided || s.created) + ' ago</span></div>' + (s.summary ? '<div class="desc">' + esc(s.summary) + '</div>' : '')
}
function agentIcon(a) {
  var c = AGENT_COLOR[a.status] || 'var(--faint)'
  if (a.status === 'working') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5" stroke-dasharray="4 2.4"><animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="2.4s" repeatCount="indefinite"/></circle><circle cx="8" cy="8" r="2.4" fill="' + c + '"/></svg>'
  if (a.status === 'blocked') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="' + c + '"/><path d="M8 4.2v4.6" stroke="#111" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.3" r="1" fill="#111"/></svg>'
  if (a.status === 'error') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/><path d="M6 6l4 4M10 6l-4 4" stroke="' + c + '" stroke-width="1.5" stroke-linecap="round"/></svg>'
  return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/></svg>'
}
var KIND_LABEL = { main: 'WhatsApp chat', goal: 'Goal', session: 'Coding session', lead: 'Lead run', automation: 'Automation' }
function renderAgents() {
  $('#view-count').textContent = items.length || ''
  if (!items.length) { $('#list').innerHTML = '<div class="none">Nobody is working right now. Goals, coding sessions, lead runs and automations show up here while they run.</div>'; return }
  $('#list').innerHTML = items.map(function (a, i) {
    var sub = a.status === 'blocked' && a.question ? a.question : (a.cwd || KIND_LABEL[a.kind] || a.kind)
    return '<button class="row" data-i="' + i + '" aria-current="' + (i === sel) + '" style="grid-template-columns:16px minmax(0,1fr) auto">' + agentIcon(a) +
      '<span class="t">' + esc(a.name) + ' <span style="color:var(--muted);font-weight:400">' + esc(sub) + '</span></span>' +
      '<span class="r"><span class="label" style="--lc:' + (AGENT_COLOR[a.status] || 'var(--faint)') + '"><i></i>' + esc(AGENT_STATUS[a.status] || a.status) + '</span></span></button>'
  }).join('')
}
function renderAgent() {
  var el = $('#detail'), a = items[sel]
  clearInterval(screenTimer)
  if (!a) { el.innerHTML = '<div class="empty">' + ICON.clear + '<b>All quiet</b>No agent is running right now.</div>'; return }
  var canSend = /^[gs]\\d+$/.test(a.name)
  var html = '<div class="bar"><div class="crumb">Active<span>/</span><b>' + esc(a.name) + '</b></div><span class="grow"></span><span class="c">' + (sel + 1) + ' / ' + items.length + '</span><button class="icon" id="prev" title="Previous (k)" aria-label="Previous">' + ICON.up + '</button><button class="icon" id="next" title="Next (j)" aria-label="Next">' + ICON.down + '</button></div>' +
    '<div class="doc"><div class="doc-in"><h2>' + esc(a.name) + '</h2><dl class="props">' +
    '<dt>Status</dt><dd>' + agentIcon(a) + esc(AGENT_STATUS[a.status] || a.status) + '</dd>' +
    '<dt>Type</dt><dd>' + esc(KIND_LABEL[a.kind] || a.kind) + '</dd>' +
    (a.cwd ? '<dt>Folder</dt><dd>' + esc(a.cwd) + '</dd>' : '') +
    (a.turn ? '<dt>Since</dt><dd>' + esc(/T/.test(a.turn) ? ago(a.turn) + ' ago' : a.turn) + '</dd>' : '') +
    (a.kind === 'session' ? '<dt>Take over</dt><dd class="cmd"><code>fraim shell ' + esc(a.name) + '</code><button class="btn" id="copy">Copy</button></dd>' : '') +
    '</dl>' + (a.status === 'blocked' && a.question ? '<div class="ask">' + esc(a.question) + '</div>' : '') +
    (a.live || /^g\\d+$/.test(a.name) ? '<div class="h3">Screen</div><pre class="screen" id="screen">Loading...</pre>' : '<div class="desc" style="color:var(--muted)">This run works in the background. Its answer lands in the inbox or the run history when it is done.</div>') +
    '</div></div>'
  if (canSend) html += '<div class="composer"><div class="composer-in"><textarea id="note" rows="1" placeholder="Send a message to ' + esc(a.name) + '"></textarea><div class="ctl"><button class="icon" id="mic" title="Dictate (v)" aria-label="Dictate">' + ICON.mic + '</button><span class="grow"></span><button class="act primary" id="send">Send <kbd>Ctrl Enter</kbd></button></div></div></div>'
  el.innerHTML = html
  if (a.live || /^g\\d+$/.test(a.name)) { loadScreen(a.name); screenTimer = setInterval(function () { loadScreen(a.name) }, 4000) }
}
async function loadScreen(name) {
  try {
    var r = await fetch('/api/active/' + encodeURIComponent(name) + '/screen'); var s = $('#screen'); if (!s || !r.ok) return
    var d = await r.json(), atEnd = s.scrollTop + s.clientHeight >= s.scrollHeight - 20
    s.textContent = d.text || '(nothing on the screen yet)'
    if (atEnd) s.scrollTop = s.scrollHeight
  } catch (e) {}
}
async function sendToAgent() {
  var a = items[sel], ta = $('#note'); if (!a || !ta || !ta.value.trim()) return
  var r = await fetch('/api/active/' + encodeURIComponent(a.name) + '/send', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Fraim-Queue': '1' }, body: JSON.stringify({ text: ta.value.trim() }) })
  var out = await r.json()
  if (!r.ok) { toast(out.error || 'That did not work.'); return }
  ta.value = ''; toast('Sent to ' + a.name + '.'); loadScreen(a.name)
}
function select(i) {
  if (sel < 0 || i < 0 || i >= items.length || i === sel) return
  if (view === 'active') { sel = i; renderAgents(); renderAgent(); return }
  sel = i; renderList(); renderDetail()
  var el = document.querySelector('.row[aria-current="true"]'); if (el) el.scrollIntoView({ block: 'nearest' })
}
async function post(id, what, body) {
  var res = await fetch('/api/items/' + id + '/' + what, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Fraim-Queue': '1' }, body: JSON.stringify(body) })
  var out = await res.json()
  if (!res.ok) { toast(out.error || 'That did not work. Try again.'); return null }
  return out
}
async function decide(verdict) {
  var it = items[sel]; if (!it || it.state !== 'open') return
  var ta = $('#note'), note = ta ? ta.value.trim() : ''
  if (verdict === 'rejected' && !note) { toast('Write why first, so the agent knows what to change.'); if (ta) ta.focus(); return }
  var out = await post(it.id, 'decide', { verdict: verdict, note: note })
  if (!out) return
  toast(it.id.toUpperCase() + ' ' + VERB[verdict].toLowerCase() + (out.follow_up ? '. Started goal ' + out.follow_up + '.' : '.'))
  await load()
  var d = $('#detail'); d.classList.remove('flash'); void d.offsetWidth; d.classList.add('flash')
}
async function setPrio(p) { var it = items[sel]; if (it && await post(it.id, 'priority', { priority: p })) load(it.id) }
function dictate() {
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition, ta = $('#note'), mic = $('#mic')
  if (!ta) return
  if (!SR) { toast('This browser cannot dictate. Use the dictation key of your keyboard.'); ta.focus(); return }
  if (rec) { rec.stop(); return }
  rec = new SR(); rec.lang = navigator.language || 'nl-NL'; rec.continuous = true; rec.interimResults = true
  var start = ta.value
  rec.onresult = function (e) { ta.value = (start ? start + ' ' : '') + Array.from(e.results).map(function (r) { return r[0].transcript }).join(' ') }
  rec.onend = function () { rec = null; if (mic) mic.classList.remove('on') }
  if (mic) mic.classList.add('on'); rec.start()
}
function setView(v) { view = v; sel = 0; whoItem = null; load() }
function backToMember() { whoItem = null; sel = 0; load() }
$('#side').addEventListener('click', function (e) { var b = e.target.closest('button[data-view]'); if (b) setView(b.dataset.view) })
$('#list').addEventListener('click', function (e) {
  if (e.target.id === 'more') { briefOpen = !briefOpen; renderList(); return }
  var b = e.target.closest('.row'); if (b) select(+b.dataset.i)
})
$('#detail').addEventListener('click', function (e) {
  var b = e.target.closest('button'); if (!b) return
  if (b.classList.contains('row') && sel < 0) { whoItem = items[+b.dataset.i].id; load(whoItem); return }
  if (b.dataset.who) { setView('who:' + b.dataset.who); return }
  if (b.dataset.v) decide(b.dataset.v); else if (b.dataset.p) setPrio(+b.dataset.p)
  else if (b.id === 'send') sendToAgent()
  else if (b.id === 'copy') { var c = b.previousElementSibling; if (navigator.clipboard && c) navigator.clipboard.writeText(c.textContent).then(function () { toast('Copied. Paste it in a terminal.') }) }
  else if (b.id === 'mic') dictate(); else if (b.id === 'prev') select(sel - 1); else if (b.id === 'next') select(sel + 1)
})
$('#toggle').onclick = function () { showDone = !showDone; load() }
$('#back').onclick = backToMember
document.addEventListener('keydown', function (e) {
  if (e.target.tagName === 'TEXTAREA') {
    if (e.key === 'Escape') e.target.blur()
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); if (view === 'active') sendToAgent(); else decide('rejected') }
    return
  }
  if (e.metaKey || e.ctrlKey || e.altKey) return
  var k = e.key
  if (k === 'j' || k === 'ArrowDown') { e.preventDefault(); select(sel + 1) }
  else if (k === 'k' || k === 'ArrowUp') { e.preventDefault(); select(sel - 1) }
  else if (k === 'a') decide('approved')
  else if (k === 'r') { var ta = $('#note'); if (ta && !ta.value.trim()) { e.preventDefault(); ta.focus(); toast('Write why, then press Ctrl+Enter.') } else decide('rejected') }
  else if (k === 'd') decide('dismissed')
  else if (k === 'v') { e.preventDefault(); dictate() }
  else if (k === 'c' || k === 'n') { e.preventDefault(); var t = $('#note'); if (t) t.focus() }
  else if (k === 'g') location.href = '/'
  else if (k === 'Escape' && whoItem) backToMember()
  else if (k === 'Escape' && view !== 'people') setView('people')
  else if (k === '1' || k === '2' || k === '3') setPrio(+k)
})
setInterval(function () { if (!document.activeElement || document.activeElement.tagName !== 'TEXTAREA') { if (!rec) { var it = items[sel]; load(it && it.id) } } }, 30000)
load()
</script>
</body>
</html>
`

// The inbox: what came in on the left, the thing itself in the middle (shown, never edited), the
// agents talking about it on the right. Code draws the middle from saved fields, one layout per
// kind; anything unknown gets the plain card, so that pane is never blank.
const INBOX_PAGE = String.raw`<!doctype html>
