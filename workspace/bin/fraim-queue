var agents = [], screenTimer = null, whoItem = null, memberTimer = null, memberData = null, memberKey = ''
var AGENT_STATUS = { working: 'Working', blocked: 'Waiting for you', idle: 'Idle', done: 'Done', error: 'Error', none: 'No Claude running in it' }
var AGENT_COLOR = { working: 'var(--green)', blocked: 'var(--yellow)', idle: 'var(--gray)', done: 'var(--accent)', error: 'var(--red)', none: 'var(--faint)' }
var all = [], items = [], teamData = { leads: [], automations: [], chief: null }, sel = 0, view = 'people', showDone = false, rec = null, briefOpen = false
var KIND = { review: 'Review', decision: 'Decision', idea: 'Idea', info: 'Info', failed: 'Failed' }
var KIND_COLOR = { review: 'var(--green)', decision: 'var(--blue)', idea: 'var(--yellow)', info: 'var(--gray)', failed: 'var(--red)' }
var WHEN = { 1: 'Today', 2: 'This week', 3: 'Later' }
var VERB = { approved: 'Approved', rejected: 'Sent back', dismissed: 'Skipped' }

function $(s) { return document.querySelector(s) }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] }) }
function safeUrl(u) { return /^https?:\\/\\//i.test(u) ? u : '#' }
function ago(iso) {
  var m = Math.round((Date.now() - new Date(iso).getTime()) / 60000)
  if (m < 1) return 'now'; if (m < 60) return m + 'm'
  var h = Math.round(m / 60); if (h < 24) return h + 'h'
  return Math.round(h / 24) + 'd'
}
function since(local) {
  if (!local) return 'not yet'
  var d = new Date(local.replace(' ', 'T')), today = new Date(), hm = local.slice(11, 16)
  if (d.toDateString() === today.toDateString()) return 'today ' + hm
  var y = new Date(today); y.setDate(today.getDate() - 1)
  if (d.toDateString() === y.toDateString()) return 'yesterday ' + hm
  return local.slice(5, 10) + ' ' + hm
}
function owner(it) { return it.lead || (/^automation /.test(it.source) ? it.source.slice(11) : '') || it.source }
function toast(t) { var el = $('#toast'); el.textContent = t; el.style.display = 'block'; clearTimeout(toast.t); toast.t = setTimeout(function () { el.style.display = 'none' }, 3000) }

/* icons, drawn like an issue tracker: priority bars and status circles */
function prioIcon(p) {
  if (p === 1) return '<svg width="14" height="14" viewBox="0 0 16 16" aria-label="Today"><rect x="1" y="1" width="14" height="14" rx="3" fill="var(--urgent)"/><path d="M8 4v5" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="8" cy="12" r="1.1" fill="#fff"/></svg>'
  var on = p === 2 ? 2 : 1
  return '<svg width="14" height="14" viewBox="0 0 16 16" aria-label="' + WHEN[p] + '">' + [0, 1, 2].map(function (i) {
    return '<rect x="' + (1.5 + i * 5) + '" y="' + (10 - i * 4) + '" width="3" height="' + (4 + i * 4) + '" rx="1" fill="' + (i < on ? 'var(--high)' : 'var(--line2)') + '"/>'
  }).join('') + '</svg>'
}
function statusIcon(it) {
  var c = KIND_COLOR[it.kind] || 'var(--gray)'
  if (it.state === 'approved') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="var(--accent)"/><path d="M5 8.2l2 2 4-4.2" stroke="#fff" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  if (it.state === 'rejected') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="var(--red)"/><path d="M10.5 10.5V9a2 2 0 0 0-2-2H5.5M7 5L5.2 7 7 9" stroke="#fff" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  if (it.state === 'dismissed') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="var(--faint)"/><path d="M5.5 10.5l5-5" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>'
  if (it.kind === 'failed') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/><path d="M6 6l4 4M10 6l-4 4" stroke="' + c + '" stroke-width="1.5" stroke-linecap="round"/></svg>'
  if (it.kind === 'review') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/><path d="M8 4a4 4 0 0 1 0 8z" fill="' + c + '"/></svg>'
  if (it.kind === 'decision') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/><circle cx="8" cy="8" r="2.4" fill="' + c + '"/></svg>'
  if (it.kind === 'idea') return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5" stroke-dasharray="2.2 2"/></svg>'
  return '<svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3" fill="none" stroke="' + c + '" stroke-width="1.5"/></svg>'
}
