  .item { padding: 22px 16px 160px; }
  .dock { padding: 14px 16px 16px; }
  .prio { margin-left: 0; }
}
</style>
</head>
<body>
<div class="app">
  <aside class="rail">
    <div class="rail-head">
      <h1>Queue</h1>
      <div class="count" id="count"></div>
      <div class="bar"><span id="bar"></span></div>
    </div>
    <ul class="list" id="list"></ul>
    <div class="rail-foot"><span id="done-count"></span><button class="linkish" id="toggle">Show done</button></div>
  </aside>
  <main class="stage" id="stage"></main>
</div>
<div class="keys">j k move &nbsp; a approve &nbsp; r send back &nbsp; d skip &nbsp; v dictate</div>
<div class="stamp" id="stamp"><span></span></div>
<div class="toast" id="toast" role="status"></div>
<script>
var items = [], sel = 0, showDone = false, rec = null, startOpen = null
var KIND = { review: 'Check this work', decision: 'Your call', idea: 'Idea', info: 'For your info', failed: 'Failed, needs a retry' }
var WHEN = { 1: 'Today', 2: 'This week', 3: 'Whenever' }
var WHEN_COLOR = { 1: 'var(--today)', 2: 'var(--week)', 3: 'var(--later)' }
var VERB = { approved: 'Approved', rejected: 'Sent back', dismissed: 'Skipped' }
function $(s) { return document.querySelector(s) }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] }) }
function safeUrl(u) { return /^https?:\\/\\//i.test(u) ? u : '#' }
function ago(iso) {
  var m = Math.round((Date.now() - new Date(iso).getTime()) / 60000)
  if (m < 1) return 'just now'; if (m < 60) return m + ' min ago'
  var h = Math.round(m / 60); if (h < 24) return h + ' h ago'
  return Math.round(h / 24) + ' days ago'
}
function toast(t) { var el = $('#toast'); el.textContent = t; el.style.display = 'block'; clearTimeout(toast.t); toast.t = setTimeout(function () { el.style.display = 'none' }, 2600) }
function stamp(verdict) {
  var el = $('#stamp'), span = el.firstElementChild
  span.textContent = VERB[verdict]
  span.style.color = verdict === 'approved' ? 'var(--go)' : verdict === 'rejected' ? 'var(--stop)' : 'var(--muted)'
  el.classList.remove('show'); void el.offsetWidth; el.classList.add('show')
}
async function load(keepId) {
  var res = await fetch('/api/items?all=1')
  if (!res.ok) { $('#stage').innerHTML = '<div class="empty"><h2>No access</h2><p>' + esc(await res.text()) + '</p></div>'; return }
  var all = await res.json()
  var open = all.filter(function (i) { return i.state === 'open' })
  var done = all.filter(function (i) { return i.state !== 'open' })
  if (startOpen === null || open.length > startOpen) startOpen = open.length + done.filter(function (i) { return Date.now() - new Date(i.decided).getTime() < 864e5 }).length
  items = showDone ? open.concat(done) : open
  var idx = keepId ? items.findIndex(function (i) { return i.id === keepId }) : -1
  sel = idx >= 0 ? idx : Math.min(sel, Math.max(items.length - 1, 0))
  $('#count').textContent = open.length ? open.length + ' waiting for you' : 'All clear'
  $('#done-count').textContent = done.length + ' done'
  $('#toggle').textContent = showDone ? 'Hide done' : 'Show done'
  var cleared = Math.max(startOpen - open.length, 0)
  $('#bar').style.width = startOpen ? Math.round(100 * cleared / startOpen) + '%' : '100%'
  renderList(); renderItem(false)
}
function renderList() {
  $('#list').innerHTML = items.map(function (it, i) {
    var color = it.state === 'open' ? WHEN_COLOR[it.priority] : 'var(--line)'
    var sub = it.state === 'open' ? (KIND[it.kind] || it.kind) + ', ' + ago(it.created) : VERB[it.state]
    return '<li class="' + (it.state === 'open' ? '' : 'done') + '"><button data-i="' + i + '" aria-current="' + (i === sel) + '">' +
      '<span class="stripe" style="background:' + color + '"></span><span><span class="t">' + esc(it.title) + '</span><span class="s">' + esc(sub) + '</span></span></button></li>'
  }).join('')
}
function mediaHtml(it) {
  return it.media.map(function (m) {
    var src = '/media/' + it.id + '/' + encodeURIComponent(m)
    return /\\.(webm|mp4|mov)$/i.test(m) ? '<video controls preload="metadata" src="' + src + '"></video>'
      : '<a href="' + src + '" target="_blank"><img src="' + src + '" alt="Screenshot ' + esc(m) + '"></a>'
  }).join('')
}
function renderItem(animate) {
  var stage = $('#stage'), it = items[sel]
  if (!it) {
    stage.innerHTML = '<div class="empty"><h2>Nothing waits for you.</h2><p>Leads put ideas and decisions here, and goals put their finished work here. You get a WhatsApp message when something arrives.</p></div>'
    return
  }
  var open = it.state === 'open'
  var html = '<article class="item' + (animate ? ' enter' : '') + '">' +
    '<div class="tags"><span class="when" style="color:' + WHEN_COLOR[it.priority] + '">' + WHEN[it.priority] + '</span><span>' + esc(KIND[it.kind] || it.kind) + '</span><span>from ' + esc(it.source) + '</span><span>' + ago(it.created) + '</span></div>' +
    '<h2>' + esc(it.title) + '</h2>' +
    (it.media.length ? '<div class="media">' + mediaHtml(it) + '</div>' : '') +
    (it.summary ? '<p class="summary">' + esc(it.summary) + '</p>' : '') +
    (it.links.length ? '<div class="links">' + it.links.map(function (l) { return '<a target="_blank" rel="noopener" href="' + esc(safeUrl(l)) + '">' + esc(l) + '</a>' }).join('') + '</div>' : '') +
    (it.on_approve ? '<div class="next"><b>When you approve, the server does this</b>' + esc(it.on_approve) + '</div>' : '') +
    (open ? '' : '<p class="verdict">' + VERB[it.state] + (it.note ? ': ' + esc(it.note) : '') + (it.follow_up ? '. Follow-up goal ' + esc(it.follow_up) + '.' : '') + (it.outcome ? ' ' + esc(it.outcome) : '') + '</p>') +
    '</article>'
  if (open) {
    html += '<div class="dock"><div class="dock-in">' +
      '<div class="note"><textarea id="note" rows="1" placeholder="Why? Needed to send it back. Press v to talk."></textarea><button class="mic" id="mic" title="Dictate (v)" aria-label="Dictate a note">' +
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button></div>' +
      '<div class="acts"><button class="act approve" data-v="approved">Approve <kbd>a</kbd></button><button class="act reject" data-v="rejected">Send back <kbd>r</kbd></button><button class="act skip" data-v="dismissed">Skip <kbd>d</kbd></button>' +
      '<span class="prio">Needed<button data-p="1" aria-pressed="' + (it.priority === 1) + '">Today</button><button data-p="2" aria-pressed="' + (it.priority === 2) + '">This week</button><button data-p="3" aria-pressed="' + (it.priority === 3) + '">Whenever</button></span></div>' +
      '</div></div>'
  }
  stage.innerHTML = html
  stage.scrollTop = 0
}
function select(i) {
  if (i < 0 || i >= items.length || i === sel) return
  sel = i; renderList(); renderItem(true)
  var el = document.querySelector('[aria-current="true"]'); if (el) el.scrollIntoView({ block: 'nearest' })
}
async function post(id, what, body) {
  var res = await fetch('/api/items/' + id + '/' + what, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Fraim-Queue': '1' }, body: JSON.stringify(body) })
  var out = await res.json()
  if (!res.ok) { toast(out.error || 'That did not work. Try again.'); return null }
  return out
}
async function decide(verdict) {
  var it = items[sel]; if (!it || it.state !== 'open') return
  var ta = $('#note'), note = ta ? ta.value.trim() : ''
  if (verdict === 'rejected' && !note) { toast('Say why first, so the agent knows what to change'); if (ta) ta.focus(); return }
  var out = await post(it.id, 'decide', { verdict: verdict, note: note })
  if (!out) return
  stamp(verdict)
  if (out.follow_up) toast(VERB[verdict] + '. The server started goal ' + out.follow_up + '.')
  else if (out.outcome) toast(VERB[verdict] + '. ' + out.outcome)
  setTimeout(function () { load().then(function () { renderItem(true) }) }, 420)
}
async function setPrio(p) { var it = items[sel]; if (it && await post(it.id, 'priority', { priority: p })) load(it.id) }
function dictate() {
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition, ta = $('#note'), mic = $('#mic')
  if (!ta) return
  if (!SR) { toast('This browser cannot dictate. Use the dictation key of your keyboard.'); ta.focus(); return }
  if (rec) { rec.stop(); return }
  rec = new SR(); rec.lang = navigator.language || 'nl-NL'; rec.continuous = true; rec.interimResults = true
  var start = ta.value
  rec.onresult = function (e) { ta.value = (start ? start + ' ' : '') + Array.from(e.results).map(function (r) { return r[0].transcript }).join(' ') }
  rec.onend = function () { rec = null; if (mic) mic.classList.remove('on') }
  if (mic) mic.classList.add('on'); rec.start()
}
$('#list').addEventListener('click', function (e) { var b = e.target.closest('button[data-i]'); if (b) select(+b.dataset.i) })
$('#stage').addEventListener('click', function (e) {
  var b = e.target.closest('button'); if (!b) return
  if (b.dataset.v) decide(b.dataset.v); else if (b.dataset.p) setPrio(+b.dataset.p); else if (b.id === 'mic') dictate()
})
$('#toggle').onclick = function () { showDone = !showDone; load() }
document.addEventListener('keydown', function (e) {
  if (e.target.tagName === 'TEXTAREA') {
    if (e.key === 'Escape') e.target.blur()
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); decide('rejected') }
    return
  }
  if (e.metaKey || e.ctrlKey || e.altKey) return
  var k = e.key
  if (k === 'j' || k === 'ArrowDown') { e.preventDefault(); select(sel + 1) }
  else if (k === 'k' || k === 'ArrowUp') { e.preventDefault(); select(sel - 1) }
  else if (k === 'a') decide('approved')
  else if (k === 'r') { var ta = $('#note'); if (ta && !ta.value.trim()) { e.preventDefault(); ta.focus(); toast('Say why, then press Ctrl+Enter') } else decide('rejected') }
  else if (k === 'd') decide('dismissed')
  else if (k === 'v') { e.preventDefault(); dictate() }
  else if (k === 'n') { e.preventDefault(); var t = $('#note'); if (t) t.focus() }
  else if (k === '1' || k === '2' || k === '3') setPrio(+k)
})
setInterval(function () { if (!document.activeElement || document.activeElement.tagName !== 'TEXTAREA') { if (!rec) { var it = items[sel]; load(it && it.id) } } }, 30000)
load()
</script>
</body>
</html>
`

// --- CLI ---------------------------------------------------------------------------------

function parseArgs(argv, multi = []) {
  const out = { _: [] }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--') { out._.push(...argv.slice(i + 1)); break }
    if (!a.startsWith('--')) { out._.push(a); continue }
    const key = a.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase())
    if (['all', 'json', 'quiet'].includes(key)) { out[key] = true; continue }
    if (i + 1 >= argv.length) usage(`${a} needs a value`)
    const value = argv[++i]
    if (multi.includes(key)) (out[key] ||= []).push(value)
    else out[key] = value
  }
  return out
}

function main(argv) {
  const [action, ...rest] = argv
  const args = parseArgs(rest, ['link', 'media'])
  const id = args._[0]
  switch (action) {
    case 'add': {
      let summary = args.summary || ''
      if (args.summaryFile) summary = fs.readFileSync(args.summaryFile, 'utf8')
      const item = addItem({ ...args, summary, links: args.link, media: args.media })
      console.log(item.id)
      return
    }
    case 'list': {
      let items = rank(allItems().filter((i) => args.all || i.state === 'open'))
      if (args.lead) items = items.filter((i) => i.lead === args.lead)
      if (args.json) return console.log(JSON.stringify(items))
      if (!items.length) return console.log('Nothing waits for you.')
      return console.log(items.slice(0, 50).map(line).join('\n'))
    }
    case 'show': {
      if (!id) usage('show ID')
      const item = readItem(id)
      return console.log(args.json ? JSON.stringify(item) : describe(item))
    }
    case 'approve':
    case 'reject':
    case 'dismiss': {
      if (!id) usage(`${action} ID`)
      const verdict = { approve: 'approved', reject: 'rejected', dismiss: 'dismissed' }[action]
      const item = decide(id, verdict, args.note || args._.slice(1).join(' '))
      return console.log(`${item.id} ${item.state}${item.follow_up ? `; goal ${item.follow_up} started` : ''}${item.outcome ? `. ${item.outcome}` : ''}`)
    }
    case 'prio': {
      if (!id || !args._[1]) usage('prio ID 1|2|3')
      const item = setPriority(id, args._[1])
      return console.log(`${item.id} priority ${item.priority}`)
    }
    case 'url':
      token()
      return console.log(queueUrl())
    case 'token':
      return console.log(token())
    case 'serve': {
      const server = createServer()
      server.on('error', (err) => {
        process.stderr.write(`fraim-queue: ${err.message}\n`)
        process.exit(1)
      })
      server.listen(PORT, process.env.FRAIM_QUEUE_BIND || '0.0.0.0', () => process.stderr.write(`fraim-queue: page on port ${PORT}\n`))
      return
    }
    default:
      usage('add | list | show ID | approve ID | reject ID --note TEXT | dismiss ID | prio ID N | serve | url')
  }
}

const isMain = process.argv[1] && fs.realpathSync(process.argv[1]) === fs.realpathSync(new URL(import.meta.url).pathname)
if (isMain) {
  try {
    main(process.argv.slice(2))
  } catch (err) {
    process.stderr.write(`fraim-queue: ${err.message}\n`)
    process.exit(err instanceof UsageError ? 2 : 1)
  }
}
