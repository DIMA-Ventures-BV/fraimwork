#!/usr/bin/env bash
# Runs an interactive sign-in (claude auth login, claude mcp login) in its own herdr terminal,
# so the laptop can show the human the sign-in link and pass the code back without the
# code ever being a command-line argument or appearing in a chat.
#
#   fraim-tty start NAME -- CMD [ARGS]   start CMD in terminal tty-NAME, print the first https link
#   fraim-tty send NAME                  type one line read from stdin into it, then Enter
#   fraim-tty wait NAME PATTERN [SECS]   exit 0 once the screen matches PATTERN (grep -E)
#   fraim-tty show NAME                  print the current screen
#   fraim-tty stop NAME
# Exit codes: 0 ok, 1 failure, 2 usage.
set -euo pipefail

usage() { echo "fraim-tty: $*" >&2; exit 2; }
die() { echo "fraim-tty: $*" >&2; exit 1; }

action="${1:-}"
name="${2:-}"
[ -n "$action" ] && [ -n "$name" ] || usage "start|send|wait|show|stop NAME"
printf '%s' "$name" | grep -Eq '^[a-z][a-z0-9-]{0,30}$' || usage "NAME must be lowercase letters, digits and dashes"
session="tty-$name"
shift 2

# Through fraim-herdr: a run without the owner may not drive a sign-in.
hc() { fraim-herdr hc "$@"; }
# hc read joins a wrapped line, so a long sign-in link stays whole.
screen() { hc read "$session" --lines 200 2>/dev/null; }
stop() { hc kill "$session" >/dev/null 2>&1 || true; hc rm "$session" >/dev/null 2>&1 || true; }

case "$action" in
  start)
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || usage "start NAME -- CMD [ARGS]"
    stop
    fraim-herdr open "$session" signin "$HOME" -- \
      bash -c "$(printf '%q ' "$@"); echo; echo '[fraim-tty: finished]'; sleep 600" \
      || die "could not start the sign-in terminal"
    for _ in $(seq 60); do
      sleep 1
      link="$(screen | grep -Eo 'https://[^[:space:]"<>]+' | head -1 || true)"
      if [ -n "$link" ]; then printf '%s\n' "$link"; exit 0; fi
      if screen | grep -q '\[fraim-tty: finished\]'; then
        screen | tail -20 >&2
        die "the command ended without showing a sign-in link"
      fi
    done
    screen | tail -20 >&2
    die "no sign-in link appeared within 60 seconds"
    ;;
  send)
    [ "$(hc get "$session" --json 2>/dev/null | jq -r '.state // ""')" = live ] \
      || die "no sign-in is waiting ($session); start it again"
    IFS= read -r line || true
    line="$(printf '%s' "$line" | tr -d '\r')"
    [ -n "$line" ] || usage "nothing to send (stdin was empty)"
    hc send --force "$session" "$line" >/dev/null
    ;;
  wait)
    pattern="${1:-}"
    secs="${2:-30}"
    [ -n "$pattern" ] || usage "wait NAME PATTERN [SECS]"
    for _ in $(seq "$secs"); do
      if screen | grep -Eqi -- "$pattern"; then exit 0; fi
      sleep 1
    done
    exit 1
    ;;
  show) screen ;;
  stop) stop ;;
  *) usage "start|send|wait|show|stop NAME" ;;
esac
