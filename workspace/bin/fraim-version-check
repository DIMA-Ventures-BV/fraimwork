#!/usr/bin/env bash
# Compares the running fraimwork version with the newest vX.Y.Z release on GitHub.
#   --notify  WhatsApp the owner once per new release
# Exit 0 up to date, 3 unknown (could not check), 10 update available.
set -u
# shellcheck source=/dev/null
. /etc/fraim/runtime.env 2>/dev/null || true

repo="${FRAIM_RELEASES_REPO:-}"
current="${FRAIM_VERSION:-dev}"
[ -n "$repo" ] || exit 0

latest="$(curl -fsS --max-time 15 "https://api.github.com/repos/$repo/tags?per_page=100" 2>/dev/null \
  | jq -r '.[].name' 2>/dev/null | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)"
[ -n "$latest" ] || { echo "unknown: could not check for releases (repo private, no releases yet, or offline)"; exit 3; }

if [ "$current" = "$latest" ] || [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" = "$current" ]; then
  echo "up to date ($current)"
  exit 0
fi

echo "update available: $current -> $latest"
# With auto-update on, the server installs it by itself (bin/fraim-updater): nothing to ask.
if [ "${1:-}" = "--notify" ] && [ "${FRAIM_AUTO_UPDATE:-on}" = off ]; then
  state="$HOME/.local/state/fraim/version.notified"
  mkdir -p "$(dirname "$state")"
  if [ "$(cat "$state" 2>/dev/null)" != "$latest" ]; then
    fraim-notify "fraimwork $latest is available (you run $current). Ask Claude on your laptop: update fraim." || true
    printf '%s' "$latest" > "$state"
  fi
fi
exit 10
