#!/usr/bin/env bash
# fraim-style: how Claude writes, per place. One setting per place, one style file per style.
#
#   places   whatsapp (chat replies, goal and automation results), queue (queue items and the
#            chief's briefing on the queue page), default (any other output)
#   styles   adhd (short, action first), detailed (full reasoning), normal (no extra rules),
#            or any ~/fraim/styles/NAME.md the owner writes (it also overrides a built-in one)
#
#   fraim-style                       the style of every place
#   fraim-style set PLACE STYLE       change one place (PLACE all changes every place)
#   fraim-style list                  the styles there are
#   fraim-style show STYLE            the rules of one style
#   fraim-style prompt PLACE          the block a prompt gets for that place
#   fraim-style voice                 the owner's own rules for how the chief talks to them
#   fraim-style voice add RULE        add one ("Talk English to me", "Call me Michael")
#   fraim-style voice remove N        drop rule N
#   fraim-style voice clear           drop them all
#
# Settings live in ~/fraim/styles/settings as PLACE=STYLE lines, the voice in ~/fraim/styles/voice.md
# (one "- rule" per line; the owner may edit it by hand). The voice goes into every place and wins
# over every other writing rule. Exit codes: 0 ok, 1 failure, 2 usage.
set -euo pipefail

dir="${FRAIM_STYLE_DIR:-${FRAIM_FILES_DIR:-$HOME/fraim}/styles}"
settings="$dir/settings"
voice="$dir/voice.md"
PLACES="whatsapp queue default"
DEFAULT_STYLE=adhd

usage() { printf 'usage: %s\n' "$1" >&2; exit 2; }

builtin_style() {
  case "$1" in
    adhd|detailed) fraim-prompt render "style-$1" ;;
    normal) ;;
    *) return 1 ;;
  esac
}

style_text() {
  if [ -f "$dir/$1.md" ]; then cat "$dir/$1.md"; else builtin_style "$1"; fi
}

style_exists() {
  case "$1" in ''|*/*|.*) return 1 ;; esac
  [ -f "$dir/$1.md" ] || builtin_style "$1" >/dev/null
}

style_of() {
  local v=""
  [ -f "$settings" ] && v="$(sed -n "s/^$1=//p" "$settings" | tail -1)"
  if [ -z "$v" ] && [ "$1" != default ]; then v="$(style_of default)"; fi
  printf '%s' "${v:-$DEFAULT_STYLE}"
}

# Rules for every text the owner reads, whatever the style: the owner does not know the
# server's ids, commands or internals and must understand a message without asking.
plain_words() { fraim-prompt render plain-words; }

voice_rules() { [ -f "$voice" ] && grep -E '^- ' "$voice" || true; }

voice_block() {
  local rules
  rules="$(voice_rules)"
  [ -n "$rules" ] || return 0
  printf "\nThe owner's own rules for how you talk to them. They win over every rule above:\n%s\n" "$rules"
}

cmd_voice() {
  local sub="${1:-show}" tmp n
  shift || true
  case "$sub" in
    show)
      if [ -z "$(voice_rules)" ]; then echo "No own rules yet. Add one: fraim-style voice add \"Talk English to me\""; return 0; fi
      voice_rules | awk '{ sub(/^- /, ""); printf "%d. %s\n", NR, $0 }' ;;
    add)
      [ $# -gt 0 ] || usage 'fraim-style voice add RULE'
      local rule
      rule="$(printf '%s' "$*" | tr '\n' ' ' | sed -e 's/^[[:space:]-]*//' -e 's/[[:space:]]*$//')"
      [ -n "$rule" ] || usage 'fraim-style voice add RULE'
      mkdir -p "$dir"
      [ -f "$voice" ] || printf '# How the chief of staff talks to me\n\n' > "$voice"
      if voice_rules | grep -qixF -- "- $rule"; then echo "Already a rule: $rule"; return 0; fi
      printf -- '- %s\n' "$rule" >> "$voice"
      echo "Added: $rule" ;;
    remove)
      n="${1:-}"
      [[ "$n" =~ ^[0-9]+$ ]] || usage 'fraim-style voice remove N'
      [ "$n" -ge 1 ] && [ "$n" -le "$(voice_rules | wc -l)" ] || { echo "no rule $n: run fraim-style voice" >&2; exit 1; }
      tmp="$(mktemp "$dir/.voice.XXXXXX")"
      awk -v n="$n" '/^- / { i++; if (i == n) { sub(/^- /, ""); print > "/dev/stderr"; next } } { print }' "$voice" > "$tmp" 2> "$tmp.gone"
      mv "$tmp" "$voice"
      echo "Removed: $(cat "$tmp.gone")"
      rm -f "$tmp.gone" ;;
    clear)
      rm -f "$voice"
      echo "No own rules now." ;;
    *) usage 'fraim-style voice [add RULE | remove N | clear]' ;;
  esac
}

valid_place() { case " $PLACES " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

set_place() {
  local place="$1" style="$2" tmp
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.settings.XXXXXX")"
  { [ -f "$settings" ] && grep -v "^$place=" "$settings" || true; printf '%s=%s\n' "$place" "$style"; } > "$tmp"
  mv "$tmp" "$settings"
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  status)
    for p in $PLACES; do printf '%-9s %s\n' "$p" "$(style_of "$p")"; done
    printf '%-9s %s own rules (fraim-style voice)\n' voice "$(voice_rules | wc -l | tr -d ' ')" ;;
  set)
    [ $# -eq 2 ] || usage "fraim-style set whatsapp|queue|default|all STYLE"
    style_exists "$2" || { printf 'no style "%s": run fraim-style list\n' "$2" >&2; exit 1; }
    if [ "$1" = all ]; then
      for p in $PLACES; do set_place "$p" "$2"; done
    else
      valid_place "$1" || usage "fraim-style set whatsapp|queue|default|all STYLE"
      set_place "$1" "$2"
    fi
    printf '%s now writes %s\n' "$1" "$2" ;;
  list)
    { printf '%s\n' adhd detailed normal
      for f in "$dir"/*.md; do [ -f "$f" ] && basename "$f" .md; done
    } | sort -u ;;
  show)
    [ $# -eq 1 ] || usage "fraim-style show STYLE"
    style_exists "$1" || { printf 'no style "%s"\n' "$1" >&2; exit 1; }
    style_text "$1" ;;
  prompt)
    [ $# -eq 1 ] || usage "fraim-style prompt whatsapp|queue|default"
    place="$1"; valid_place "$place" || place=default
    style="$(style_of "$place")"
    rules="$(style_text "$style" 2>/dev/null || true)"
    [ -z "$rules" ] || printf 'Writing style for %s (%s). Follow it unless the owner asks for more or less detail in this message:\n%s\n\n' "$place" "$style" "$rules"
    plain_words
    voice_block ;;
  voice) cmd_voice "$@" ;;
  *) usage "fraim-style [set PLACE STYLE | list | show STYLE | prompt PLACE | voice [add RULE | remove N | clear]]" ;;
esac
