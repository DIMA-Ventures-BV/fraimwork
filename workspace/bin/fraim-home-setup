#!/usr/bin/env bash
# Prepares the claude user's home. Runs AS claude (never as root): everything under
# /home/claude is claude-controlled, and root following a planted symlink there could
# be turned into root access. Usage: fraim-home-setup workspace|scheduler
set -euo pipefail
home="$HOME"

# Planted symlinks for these paths would only break startup; remove them.
for p in "$home/.claude" "$home/.claude.json" "$home/.ssh"; do
  [ ! -L "$p" ] || rm -f "$p"
done
mkdir -p "$home/fraim/jobs" "$home/fraim/logs/jobs" "$home/fraim/automations" "$home/.ssh" "$home/.claude"
chmod 700 "$home/.ssh"
rm -f "$home/.ssh/authorized_keys"

(cd /etc/fraim/skel && find . -type f) | while read -r file; do
  target="$home/${file#./}"
  [ -e "$target" ] || install -D -m 0644 "/etc/fraim/skel/${file#./}" "$target"
done

# Security migrations for existing homes (skel files are only copied when missing):
# bare WebFetch must never be pre-approved (a page could make Claude send data out).
settings="$home/.claude/settings.json"
if [ -f "$settings" ] && [ ! -L "$settings" ] && jq -e . "$settings" >/dev/null 2>&1; then
  tmp="$(mktemp)"
  # Goals, automations, the queue, leads, the brain and session commands run without a prompt, also in older homes.
  jq 'if .permissions.allow then .permissions.allow |= (map(select(. != "WebFetch"))
        | reduce ("Bash(fraim-goal:*)", "Bash(fraim-auto:*)", "Bash(fraim-queue:*)", "Bash(fraim-lead:*)", "Bash(fraim-brain:*)", "Bash(fraim-style:*)", "Bash(fraim-sessions:*)", "Bash(fraim-herdr ls:*)", "mcp__whatsapp__session_command") as $r (.; if index($r) then . else . + [$r] end)) else . end' "$settings" > "$tmp" \
    && cat "$tmp" > "$settings"
  # fraim-claude skips permission prompts (PERMISSIONS=all); without this the always-on
  # session would stop at the "Bypass Permissions mode" warning screen at every start.
  jq '.skipDangerousModePermissionPrompt = true' "$settings" > "$tmp" && cat "$tmp" > "$settings"
  rm -f "$tmp"
fi

# Skip Claude Code's first-run theme picker and the folder trust prompt for ~/fraim,
# so the always-on session never waits for a human at those screens.
state="$home/.claude.json"
[ -s "$state" ] || echo '{}' > "$state"
tmp="$(mktemp)"
jq --arg dir "$home/fraim" '
  .hasCompletedOnboarding = true
  | .theme = (.theme // "dark")
  | .projects[$dir].hasTrustDialogAccepted = true
' "$state" > "$tmp" && cat "$tmp" > "$state"
rm -f "$tmp"
chmod 0600 "$state"

if [ "${1:-}" = scheduler ] && [ ! -f "$home/fraim/jobs/crontab" ]; then
  install -m 0644 /etc/fraim/skel-jobs/crontab "$home/fraim/jobs/crontab"
fi
# One switched-off example, only in a home that has no automations yet.
if [ "${1:-}" = scheduler ] && [ -z "$(ls -A "$home/fraim/automations")" ]; then
  mkdir -p "$home/fraim/automations/new-files"
  { echo ---; echo 'enabled: false'; tail -n +2 /etc/fraim/automation-kit/examples/new-files/automation.md; } \
    > "$home/fraim/automations/new-files/automation.md"
fi
