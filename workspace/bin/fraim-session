#!/usr/bin/env bash
# Runs the always-on Claude session in the herdr terminal "main" (fraim-herdr starts it)
# and restarts Claude when it exits.
set -u
# shellcheck source=/dev/null
. /etc/fraim/runtime.env 2>/dev/null || true
cd "$HOME/fraim" || exit 1

# A module that talks to main declares its Claude Code channel in its manifest
# ("claude-channel: server:NAME"); every module that is on loads its own.
args=()
for module in ${FRAIM_MODULES//,/ }; do
  while read -r channel; do
    [ -z "$channel" ] || args+=(--dangerously-load-development-channels "$channel")
  done < <(sed -n 's/^claude-channel: *//p' "${FRAIM_MODULES_DIR:-/etc/fraim/modules}/$module.manifest" 2>/dev/null)
done
rc_args=()
# Remote Control (the Claude phone app) needs a full login; a setup-token cannot use it.
# The session shows up in the app as "<server> <space>".
if [ -f "$HOME/.config/fraim/full-login" ] && [ -s "$HOME/.claude/.credentials.json" ] && [ "${FRAIM_REMOTE_CONTROL:-on}" != off ]; then
  rc_args=(--remote-control "${FRAIM_HOSTNAME:-fraim} ${FRAIM_SPACE:-main}")
fi

# The WhatsApp channel is a development channel, so Claude Code asks for confirmation
# at every start. The owner enabled it in .env, so confirm it here unless disabled.
# One watcher for the life of this script: one pass of the loop can start Claude twice.
confirm_pid=""
if [ "${#args[@]}" -gt 0 ] && [ "${FRAIM_AUTO_CONFIRM_CHANNEL:-1}" = 1 ]; then
  fraim-herdr confirm-channel &
  confirm_pid=$!
fi

while true; do
  fraim-claude --continue "${args[@]}" "${rc_args[@]}" || fraim-claude "${args[@]}" "${rc_args[@]}"
  echo
  echo "fraim: Claude stopped. It restarts in 5 seconds. Press Ctrl-C to get a plain shell."
  sleep 5 || break
done

[ -z "$confirm_pid" ] || kill "$confirm_pid" 2>/dev/null
exec bash -l
