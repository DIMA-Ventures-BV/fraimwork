#!/usr/bin/env bash
# Kept for old crontab lines and habits: scheduled jobs are automations now.
# fraim-job NAME runs ~/fraim/automations/NAME (see fraim-auto). fraim-auto migrate moves
# ~/fraim/jobs/NAME.md there when the scheduler starts.
set -uo pipefail
name="${1:?usage: fraim-job <name>}"
autos="${FRAIM_AUTOMATIONS_DIR:-$HOME/fraim/automations}"
if [ ! -f "$autos/$name/automation.md" ] && [ -f "$HOME/fraim/jobs/$name.md" ]; then
  fraim-auto migrate >/dev/null || true
fi
exec fraim-auto run "$name"
