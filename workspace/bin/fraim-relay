#!/usr/bin/env bash
# fraim-relay: the chief of staff is the one voice that tells the owner things on WhatsApp.
# Push notices (a goal is done, a coding session asks something, an automation failed) are not
# sent as they are. fraim-notify hands them here; the chief reads them with what it knows about
# the owner's work and writes one message a person understands, or holds back noise.
#
#   fraim-relay add [--chat CHAT_ID] -- TEXT   queue a notice (fraim-notify does this) and send it soon
#   fraim-relay drain                          send what waits (one run at a time; add starts it)
#   fraim-relay said [N]                       the last N messages and the notices behind them
#   fraim-relay on                             true when a chief exists to write the messages
#   fraim-relay log owner|me [--chat C] [--about "q4 g2"] -- TEXT
#                                              add a line to the WhatsApp conversation with the owner
#   fraim-relay context                        the conversation of the last day and the open decisions:
#                                              what the chat, the chief and the brief read before they answer
#   fraim-relay chat -- TEXT                   the owner writes in the app; the chief answers there
#   fraim-relay timing [gap|wait SECONDS]      show or set how often the chief may send a message
#
# The conversation (~/fraim/relay/conversation.jsonl) holds every WhatsApp message between the owner
# and the server: what the owner wrote, the chat's answers and the chief's messages, each with the
# things it was about. So every voice of the server knows what the owner already said.
#
# Notices that arrive close together become one message (FRAIM_RELAY_WAIT seconds, default 20).
# The owner gets at most one message per FRAIM_RELAY_GAP seconds (default 900): notices that come
# in sooner wait and go into the next message.
# The owner sets both with `fraim-relay timing` (~/fraim/relay/settings); the variables still win.
# When the chief cannot run (not signed in, usage limit, FRAIM_RELAY_TIMEOUT seconds, default
# 180), the notices go out as they are, so nothing is lost. Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail
# shellcheck source=/dev/null
[ ! -f "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" ] || . "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}"

files="${FRAIM_FILES_DIR:-$HOME/fraim}"
relay="${FRAIM_RELAY_DIR:-$files/relay}"
leads="${FRAIM_LEADS_DIR:-$files/leads}"
goals="${FRAIM_GOALS_DIR:-$files/goals}"
sessions="${FRAIM_SESSIONS_DIR:-$files/sessions}"
pending="$relay/pending"
said="$relay/said.md"
convo="$relay/conversation.jsonl"

usage() { echo "fraim-relay: $*" >&2; exit 2; }
die() { echo "fraim-relay: $*" >&2; exit 1; }
# SILENT means nothing to report. Models sometimes explain first ("None today, so: SILENT"), so the
# answer is silent when its last non-empty line is SILENT, with or without brackets or stars.
is_silent() { [ "$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -1 | tr -d '[:space:][]*`.:')" = SILENT ]; }

the_chief() { FRAIM_LEADS_DIR="$leads" fraim-authority role chief 2>/dev/null; }

cmd_on() {
  [ "${FRAIM_RELAY:-on}" != off ] || return 1
  local chief
  chief="$(the_chief)" || return 1
  [ ! -f "$leads/$chief/paused" ]
}

cmd_add() {
  local chat=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --chat) chat="${2:-}"; shift 2 || usage "--chat needs a chat id" ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local text="$*"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage 'add [--chat CHAT_ID] -- TEXT'
  mkdir -p "$pending"
  local name tmp
  name="$(date +%s%N 2>/dev/null || date +%s)-$$-$RANDOM.json"
  tmp="$pending/.$name"
  jq -n --arg time "$(date '+%Y-%m-%d %H:%M:%S')" --arg chat "$chat" --arg text "${text:0:6000}" \
    '{time: $time, chat: $chat, text: $text}' > "$tmp" && mv "$tmp" "$pending/$name"
  if [ "${FRAIM_RELAY_SYNC:-}" = 1 ]; then
    cmd_drain
  else
    nohup "$0" drain >/dev/null 2>&1 < /dev/null &
  fi
}

# One drain at a time; a lock from a drain that died is taken over.
lock() {
  mkdir "$relay/.lock" 2>/dev/null && { printf '%s\n' "$$" > "$relay/.lock/pid"; return 0; }
  kill -0 "$(cat "$relay/.lock/pid" 2>/dev/null)" 2>/dev/null && return 1
  rm -rf "$relay/.lock"
  mkdir "$relay/.lock" 2>/dev/null && { printf '%s\n' "$$" > "$relay/.lock/pid"; return 0; }
  return 1
}
has_pending() { compgen -G "$pending/*.json" >/dev/null; }

relay_setting() {
  local v
  v="$(sed -n "s/^$1=//p" "$relay/settings" 2>/dev/null | tail -1)"
  case "$v" in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$v" ;; esac
}

cmd_timing() {
  if [ $# -eq 0 ]; then
    printf 'gap %s seconds between messages\nwait %s seconds to collect notices into one message\n' "$(relay_setting gap 900)" "$(relay_setting wait 20)"
    return 0
  fi
  case "${1:-}:${2:-}" in
    gap:|wait:|gap:*[!0-9]*|wait:*[!0-9]*) echo 'usage: fraim-relay timing [gap|wait SECONDS]' >&2; return 2 ;;
    gap:*|wait:*) ;;
    *) echo 'usage: fraim-relay timing [gap|wait SECONDS]' >&2; return 2 ;;
  esac
  if [ "${FRAIM_HEADLESS:-}" = 1 ]; then echo 'only the owner changes the timing; this run has no owner watching' >&2; return 1; fi
  mkdir -p "$relay"
  local seconds=$((10#$2))
  { grep -v "^$1=" "$relay/settings" 2>/dev/null; printf '%s=%s\n' "$1" "$seconds"; } > "$relay/settings.tmp" && mv "$relay/settings.tmp" "$relay/settings"
  printf '%s is now %s seconds\n' "$1" "$seconds"
}

wait_for_gap() {
  local last left
  last="$(cat "$relay/last-sent" 2>/dev/null)"
  [[ "$last" =~ ^[0-9]+$ ]] || return 0
  left=$(( last + ${FRAIM_RELAY_GAP:-$(relay_setting gap 900)} - $(date +%s) ))
  [ "$left" -le 0 ] || sleep "$left"
}

cmd_drain() {
  mkdir -p "$pending"
  while has_pending; do
    lock || return 0
    sleep "${FRAIM_RELAY_WAIT:-$(relay_setting wait 20)}"
    wait_for_gap
    while has_pending; do drain_once; done
    rm -rf "$relay/.lock"
  done
}

# Takes every waiting notice and sends one message per chat.
drain_once() {
  local batch f chat
  batch="$relay/.batch-$$"
  mkdir -p "$batch"
  for f in "$pending"/*.json; do [ -f "$f" ] && mv "$f" "$batch/"; done
  while IFS= read -r chat; do
    relay_chat "$batch" "$chat"
  done < <(cat "$batch"/*.json 2>/dev/null | jq -rs 'map(.chat) | unique | .[]')
  rm -rf "$batch"
}

notices_of() {
  cat "$1"/*.json 2>/dev/null | jq -rs --arg chat "$2" \
    'map(select(.chat == $chat)) | sort_by(.time) | .[] | "[\(.time)] \(.text)\n"'
}

# What the owner asked for, behind each goal, coding session and queue item a notice names.
background() {
  local id n dir
  for id in $(printf '%s' "$1" | grep -oE '[gsq][0-9]{1,6}' | sort -u); do
    n="${id#?}"
    case "$id" in
      g*) dir="$goals/g$n"; [ -f "$dir/goal.md" ] || continue
          printf '%s, what the owner asked for:\n%s\n\n' "$id" "$(head -c 1500 "$dir/goal.md")" ;;
      s*) dir="$sessions/s$n"; [ -f "$dir/task" ] || continue
          printf '%s, a coding session in %s, its task:\n%s\n\n' "$id" "$(cat "$dir/repo" 2>/dev/null)" "$(head -c 1500 "$dir/task")" ;;
      q*) command -v fraim-queue >/dev/null || continue
          fraim-queue show "$id" 2>/dev/null | head -c 1500 | sed '1s/^/queue item: /'; printf '\n\n' ;;
    esac
  done
}

# How the chief writes to the owner is the prompt file "relay" (fraim-prompt).
prompt_for() {
  local chief="$1" notices="$2"
  FRAIM_LEADS_DIR="$leads" fraim-prompt render relay --lead "$chief" \
    --set "chief=$chief" --set "display=$(fraim-lead display "$chief" 2>/dev/null)" --set "today=$(date '+%A %Y-%m-%d %H:%M')" \
    --set "brief=$(awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front' "$leads/$chief/lead.md")" \
    --set "rules=$(fraim-brain show --for "$chief" --all 2>/dev/null)" \
    --set "recent=$(cmd_context 2>/dev/null)" \
    --set "background=$(background "$notices")" \
    --set "notices=$notices" \
    --set "style=$(fraim-style prompt whatsapp 2>/dev/null)"
}

send() {
  local chat="$1" text="$2" body
  if [ -n "$chat" ]; then
    body="$(jq -cn --arg chat "$chat" --arg text "$text" '{chat_id: $chat, text: $text}')"
  else
    body="$(jq -cn --arg to "${WHATSAPP_OWNER:-}" --arg text "$text" '{to: $to, text: $text}')"
  fi
  fraim-gateway POST /send "$body" >/dev/null
}

remember() {
  local chat="$1" message="$2" notices="$3"
  mkdir -p "$relay"
  {
    printf '## %s%s\n%s\n\nAbout these notices:\n%s\n\n' "$(date '+%Y-%m-%d %H:%M')" "${chat:+ to $chat}" "$message" "$notices"
  } >> "$said"
  # Keep about the last 100 messages.
  if [ "$(grep -c '^## ' "$said")" -gt 100 ]; then
    local tmp
    tmp="$(mktemp)"
    awk -v skip="$(( $(grep -c '^## ' "$said") - 100 ))" '/^## / { n++ } n > skip' "$said" > "$tmp" && cat "$tmp" > "$said"
    rm -f "$tmp"
  fi
}

relay_chat() {
  local batch="$1" chat="$2" notices chief output code
  notices="$(notices_of "$batch" "$chat")"
  [ -n "$notices" ] || return 0
  output=""
  code=1
  if chief="$(the_chief)" && [ ! -f "$leads/$chief/paused" ]; then
    local limit=() model=()
    ! command -v timeout >/dev/null || limit=(timeout "${FRAIM_RELAY_TIMEOUT:-180}")
    [ -z "${FRAIM_RELAY_MODEL:-}" ] || model=(--model "$FRAIM_RELAY_MODEL")
    mkdir -p "$relay"
    # A message to the owner never waits for free memory (fraim-capacity): it is one short
    # run, and the reserve keeps room for it.
    output="$(cd "$files" 2>/dev/null || cd "$HOME" || exit 1; export FRAIM_NO_CAPACITY_WAIT=1; "${limit[@]}" fraim-claude -p "$(prompt_for "$chief" "$notices")" \
      ${model[@]+"${model[@]}"} --allowedTools "Read,Glob,Grep,Bash(fraim-queue list:*),Bash(fraim-queue show:*),Bash(fraim-goal list:*),Bash(fraim-goal show:*),Bash(fraim-sessions list:*),Bash(fraim-lead list:*),Bash(fraim-auto list:*),Bash(fraim-auto show:*)" \
      2>>"$relay/errors.log")"
    code=$?
  fi
  output="$(printf '%s' "$output" | sed -e 's/[[:space:]]*$//')"
  if [ "$code" -eq 0 ] && [ -n "$output" ]; then
    if is_silent "$output"; then
      remember "$chat" "(held back)" "$notices"
      return 0
    fi
    send "$chat" "${output:0:3500}" && { date +%s > "$relay/last-sent"; remember "$chat" "$output" "$notices"; add_line me "$chat" "$(about_of "$notices")" "$output"; return 0; }
  fi
  # The chief could not write it: the owner gets the notices as they are.
  local raw
  raw="$(cat "$batch"/*.json | jq -rs --arg chat "$chat" 'map(select(.chat == $chat)) | sort_by(.time) | map(.text) | join("\n\n")')"
  send "$chat" "${raw:0:3500}" && { date +%s > "$relay/last-sent"; add_line me "$chat" "$(about_of "$notices")" "$raw"; }
  remember "$chat" "(sent as it was; the chief could not write it)
$raw" "$notices"
}

# The ids of what notices are about: the ids they name and the open decisions whose title they quote.
about_of() {
  local notices="$1" id title
  {
    printf '%s' "$notices" | grep -oE '[gsq][0-9]{1,6}' || true
    command -v fraim-queue >/dev/null && fraim-queue list --json 2>/dev/null | jq -r '.[] | [.id, .title] | @tsv' 2>/dev/null |
      while IFS=$'\t' read -r id title; do
        [ -n "$title" ] && printf '%s' "$notices" | grep -qF -- "$title" && printf '%s\n' "$id"
      done
  } | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/ *$//'
}

add_line() {
  local who="$1" chat="$2" about="$3" text="$4" tmp
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || return 0
  mkdir -p "$relay"
  jq -cn --arg time "$(date '+%Y-%m-%d %H:%M')" --arg who "$who" --arg chat "$chat" --arg about "$about" --arg text "${text:0:3000}" \
    '{time: $time, who: $who, chat: $chat, about: $about, text: $text}' >> "$convo"
  if [ "$(wc -l < "$convo")" -gt 400 ]; then
    tmp="$(mktemp)"
    tail -n 300 "$convo" > "$tmp" && cat "$tmp" > "$convo"
    rm -f "$tmp"
  fi
}

cmd_log() {
  local who="${1:-}" chat="" about=""
  case "$who" in owner|me) shift ;; *) usage 'log owner|me [--chat CHAT_ID] [--about "q4 g2"] -- TEXT' ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --chat) chat="${2:-}"; shift 2 || usage "--chat needs a chat id" ;;
      --about) about="${2:-}"; shift 2 || usage "--about needs ids" ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  add_line "$who" "$chat" "$about" "$*"
}

cmd_context() {
  local since lines="" decisions=""
  since="$(date -d '-24 hours' '+%Y-%m-%d %H:%M' 2>/dev/null || date -v-24H '+%Y-%m-%d %H:%M')"
  [ ! -s "$convo" ] || lines="$(jq -Rr --arg since "$since" 'fromjson? | select(.time >= $since)
    | "[\(.time[5:])] \(if .who == "owner" then "Owner" else "You" end)\(if (.about // "") != "" then " (about \(.about))" else "" end): \(.text | gsub("\n+"; " / ") | .[0:700])"' "$convo" 2>/dev/null | tail -n 24)"
  printf 'The WhatsApp conversation with the owner in the last 24 hours, newest last. "You" is the server: the chat and the chief of staff are one voice to the owner. Ids in brackets are for commands, never for the owner.\n%s\n' "${lines:-(no messages)}"
  ! command -v fraim-queue >/dev/null || decisions="$(fraim-queue list --json 2>/dev/null | jq -r '.[:15][] | "- \(.id): \(.title)" + (if (.ask // "") != "" then ". Asks: \(.ask)" else "" end)' 2>/dev/null)"
  printf '\nDecisions that still wait for the owner (not answered yet):\n%s\n' "${decisions:-(none)}"
  local changed=""
  ! command -v fraim-watch >/dev/null || changed="$(fraim-watch open 2>/dev/null)"
  [ -z "$changed" ] || printf '\nChanges to what the agents are told that the owner was alerted about and can still undo:\n%s\n' "$changed"
}

# chat TEXT: a message from the owner in the app, answered by the chief. Both land in the same
# conversation as WhatsApp, so every voice knows what was said; the answer stays in the app.
cmd_chat() {
  [ "${1:-}" != -- ] || shift
  local text="$*" chief lock="$relay/chat.lock" output code waited=0
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage 'chat -- TEXT'
  [ "${FRAIM_HEADLESS:-}" != 1 ] || die "only the owner writes in this chat; a goal, lead or automation cannot"
  chief="$(the_chief)" || die "there is no chief of staff yet"
  mkdir -p "$relay"
  add_line owner app "" "$text"
  until mkdir "$lock" 2>/dev/null; do
    [ -z "$(find "$lock" -maxdepth 0 -mmin +7 2>/dev/null)" ] || rmdir "$lock" 2>/dev/null
    sleep 2
    waited=$((waited + 2))
    [ "$waited" -lt 400 ] || die "the chief is still busy with an earlier message"
  done
  # shellcheck disable=SC2064
  trap "rmdir $(printf '%q' "$lock") 2>/dev/null" EXIT
  local limit=()
  ! command -v timeout >/dev/null || limit=(timeout "${FRAIM_CHAT_TIMEOUT:-300}")
  output="$(cd "$files" 2>/dev/null || cd "$HOME" || exit 1; export FRAIM_NO_CAPACITY_WAIT=1 FRAIM_OWNER_CHAT=1; "${limit[@]}" fraim-claude -p "$(fraim-prompt render chief-chat --lead "$chief" \
      --set "chief=$chief" --set "display=$(fraim-lead display "$chief" 2>/dev/null)" --set "today=$(date '+%A %Y-%m-%d %H:%M')" \
      --set "brief=$(awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front' "$leads/$chief/lead.md")" \
      --set "rules=$(fraim-brain show --for "$chief" --all 2>/dev/null)" \
      --set "knows=$(fraim-lead brief 2>/dev/null | head -c 60000)" \
      --set "recent=$(cmd_context 2>/dev/null)" \
      --set "style=$(fraim-style prompt whatsapp 2>/dev/null)" \
      --set "text=$text")" \
    --allowedTools "Read,Glob,Grep,Bash(fraim-watch open:*),Bash(fraim-watch list:*),Bash(fraim-watch undo:*),Bash(fraim-relay timing:*),Bash(fraim-prompt list:*),Bash(fraim-prompt show:*),Bash(fraim-prompt own:*),Bash(fraim-prompt check:*),Bash(fraim-prompt reset:*),Edit(~/fraim/prompts/**),Edit(~/fraim/leads/*/prompts/**),Edit(~/fraim/ui/**),Write(~/fraim/ui/**),Bash(fraim-ui:*),Bash(fraim-lead display:*),Bash(fraim-lead brief:*),Bash(fraim-lead list:*),Bash(fraim-lead ask:*),Bash(fraim-lead tell:*),Bash(fraim-queue list:*),Bash(fraim-queue show:*),Bash(fraim-queue thread show:*),Bash(fraim-queue approve:*),Bash(fraim-queue reject:*),Bash(fraim-queue dismiss:*),Bash(fraim-queue grant:*),Bash(fraim-queue thread ignore:*),Bash(fraim-queue thread close:*),Bash(fraim-goal list:*),Bash(fraim-goal show:*),Bash(fraim-goal send:*),Bash(fraim-sessions list:*),Bash(fraim-sessions read:*),Bash(fraim-sessions send:*),Bash(fraim-auto list:*),Bash(fraim-auto show:*),Bash(fraim-brain:*),Bash(fraim-style:*),Bash(fraim-relay said:*),Bash(fraim-prompt:*),Bash(fraim-auto check:*),Bash(fraim-auto sync:*),Bash(fraim-auto pause:*),Bash(fraim-auto resume:*),Bash(fraim-auto on:*),Bash(fraim-lead pause:*),Bash(fraim-lead resume:*),Edit(~/fraim/leads/**),Write(~/fraim/leads/**),Edit(~/fraim/automations/**),Write(~/fraim/automations/**),Edit(~/fraim/prompts/**),Write(~/fraim/prompts/**),Edit(~/fraim/claude/**),Write(~/fraim/claude/**),Edit(~/fraim/styles/**),Edit(~/fraim/inbox-rules.md),Edit(~/.claude/skills/**)" \
    2>>"$relay/errors.log")"
  code=$?
  output="$(printf '%s' "$output" | sed -e 's/[[:space:]]*$//')"
  [ "$code" -eq 0 ] && [ -n "$output" ] || output="I could not answer just now. Please try again in a minute."
  add_line me app "" "$output"
}

cmd_said() {
  local n="${1:-5}"
  [ -s "$said" ] || { echo "Nothing sent yet."; return 0; }
  awk -v keep="$n" -v total="$(grep -c '^## ' "$said")" '/^## / { i++ } i > total - keep' "$said"
}

action="${1:-}"
[ $# -eq 0 ] || shift
case "$action" in
  add) cmd_add "$@" ;;
  drain) cmd_drain ;;
  said) cmd_said "${1:-5}" ;;
  on) cmd_on ;;
  log) cmd_log "$@" ;;
  context) cmd_context ;;
  chat) cmd_chat "$@" ;;
  timing) cmd_timing "$@" ;;
  *) usage 'add [--chat CHAT_ID] -- TEXT | drain | said [N] | on | log owner|me -- TEXT | context | chat -- TEXT' ;;
esac
