#!/usr/bin/env bash
# Lead agents: one per area of focus (a product, ops, marketing). A lead wakes on a
# schedule, looks at its area, asks the owner's yes for clear work and puts
# ideas and decisions in the owner's review queue. The chief of staff is a lead that reads
# all other leads and the queue, ranks the queue and sends the owner one digest each morning.
# During the day it also wakes on events: new goal results, failures and automation answers in
# the queue (its NAME-events automation), and work the owner asks for in plain words (the
# server's Claude passes it on with fraim-lead ask). Then it starts a goal, hands the work to
# a lead, or asks the owner.
# The engineer is the lead that builds: the chief, other leads and the owner hand it requests
# for automations, watchers, leads, plugins and skills, and failed automations go to it on
# their own. It builds new things switched off and asks the owner once to switch them on
# (fraim-queue add --switch-on). Changes to fraimwork itself become a pull request.
# --off makes a lead paused; the owner's approval (fraim-auto on NAME) starts it.
#
#   fraim-lead new NAME [--area TEXT] [--at "CRON"] [--budget N] [--chief|--engineer] [--off]
#   fraim-lead list
#   fraim-lead show NAME
#   fraim-lead run NAME          what its automation runs; also fine by hand
#   fraim-lead try NAME [--status]  one trial run of a new employee on real data; changes nothing
#   fraim-lead tell NAME [--from WHO] -- TEXT    leave a note in the lead's inbox and wake it now
#   fraim-lead ask [NAME|--chief] -- TEXT        the owner asks a lead (the default contact unless named); it runs now
#   fraim-lead brief [NAME]                      what an agent knows, for the chat that talks as it (default: the contact)
#   fraim-lead events NAME [--every 15m] [--off] wake the lead on new queue events (the chief has it by default)
#   fraim-lead pause NAME | resume NAME
#   fraim-lead rename OLD NEW                    the owner only
#   fraim-lead display [NAME|--chief] [--clear] [-- TEXT]  the name people see for an agent (default: the contact)
#
# Each lead lives in ~/fraim/leads/<name>/: lead.md (its brief, the owner edits it),
# state.md (its own notes between runs), budget (goals per day), tools (extra tools,
# optional), inbox.md (notes from the owner and the chief, cleared by a good run), runs/. Its schedule is an automation with "lead: <name>"
# in ~/fraim/automations/<name>/, so leads and automations share one list, one pause and
# one set of failure rules (fraim-auto list).
# Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail

# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true
[ -z "${TZ:-}" ] || export TZ

leads="${FRAIM_LEADS_DIR:-$HOME/fraim/leads}"
export FRAIM_LEADS_DIR="$leads"
goals="${FRAIM_GOALS_DIR:-$HOME/fraim/goals}"
autos="${FRAIM_AUTOMATIONS_DIR:-$HOME/fraim/automations}"
has_auto() { [ -f "$autos/$1/automation.md" ] && grep -q "^lead: $1\$" "$autos/$1/automation.md"; }

usage() { echo "fraim-lead: $*" >&2; exit 2; }
die() { echo "fraim-lead: $*" >&2; exit 1; }
# SILENT means nothing to report. Models sometimes explain first ("None today, so: SILENT"), so the
# answer is silent when its last non-empty line is SILENT, with or without brackets or stars.
is_silent() { [ "$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -1 | tr -d '[:space:][]*`.:')" = SILENT ]; }

valid_name() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$'; }
lead_dir() {
  valid_name "$1" || usage "'$1' is not a lead name (lowercase letters, digits and -)"
  [ -f "$leads/$1/lead.md" ] || die "no lead $1; create it with: fraim-lead new $1"
  printf '%s' "$leads/$1"
}
cap() { fraim-authority cap "$1" "$2" 2>/dev/null; }
the_fixer() { fraim-authority get fixer 2>/dev/null; }
the_contact() { fraim-authority get contact 2>/dev/null; }
# The name the owner gave an agent: the display: line at the top of its lead.md.
lead_display() {
  awk 'NR == 1 && /^---$/ { f = 1; next } f && /^---$/ { exit } f && sub(/^display:[[:space:]]*/, "") { print; exit }' "$1" 2>/dev/null
}
cmd_display() {
  local who="" value="" clear=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --chief) shift ;;
      --clear) clear=1; shift ;;
      --) shift; value="$*"; break ;;
      -*) usage 'display [NAME|--chief] [--clear] [-- TEXT]' ;;
      *) who="$1"; shift ;;
    esac
  done
  if [ -z "$who" ]; then
    who="$(the_contact)" || { [ "$clear" = 0 ] && [ -z "$value" ] && return 0; die "there is no default contact; name the agent"; }
  fi
  local dir file
  dir="$(lead_dir "$who")"
  file="$dir/lead.md"
  if [ "$clear" = 0 ] && [ -z "$value" ]; then lead_display "$file"; return 0; fi
  [ "${FRAIM_HEADLESS:-}" != 1 ] || die "only the owner changes a name; this run has no owner watching"
  if [ "$clear" = 0 ]; then
    case "$value" in *$'\n'*) usage "the name must be one line" ;; esac
    printf '%s' "$value" | grep -Eq '^[^{}<>"`\\]{1,40}$' || usage "the name must be 1 to 40 characters, without { } < > quotes or backslashes"
  fi
  local tmp
  tmp="$(mktemp "$dir/.lead.XXXXXX")"
  { [ "$(head -1 "$file")" = "---" ] || printf -- '---\n---\n'; cat "$file"; } \
    | V="$value" awk 'NR == 1 && $0 == "---" { f = 1; print; if (ENVIRON["V"] != "") print "display: " ENVIRON["V"]; next } f && /^display:/ { next } f && $0 == "---" { f = 0 } { print }' > "$tmp"
  mv "$tmp" "$file"
  if [ "$clear" = 1 ]; then echo "$who has its default name again."; else echo "$who is now called $value."; fi
}
# Every automation that runs lead NAME: its schedule, and its events automation.
lead_autos() {
  local f
  for f in "$autos"/*/automation.md; do
    [ -f "$f" ] && grep -q "^lead: $1\$" "$f" && basename "$(dirname "$f")"
  done
  return 0
}

cmd_new() {
  local name="${1:-}" area="" at="" budget="" chief=0 engineer=0 off=0 role
  [ -n "$name" ] || usage 'new NAME [--area TEXT] [--at "CRON"] [--budget N] [--chief]'
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --area) area="${2:-}"; shift 2 || usage "--area needs a text" ;;
      --at) at="${2:-}"; shift 2 || usage "--at needs a cron time" ;;
      --budget) budget="${2:-}"; shift 2 || usage "--budget needs a number" ;;
      --chief) chief=1; shift ;;
      --engineer) engineer=1; shift ;;
      --off) off=1; shift ;;
      *) usage "unknown option $1" ;;
    esac
  done
  valid_name "$name" || usage "'$name' is not a lead name (lowercase letters, digits and -)"
  [ "$chief$engineer" != 11 ] || usage "a lead is the chief or the engineer, not both"
  if [ "${FRAIM_HEADLESS:-}" = 1 ] && [ "$chief$engineer" != 00 ]; then die "only the owner makes a chief or an engineer"; fi
  [ -z "${FRAIM_BUILDS_OFF:-}" ] || off=1
  [ ! -e "$leads/$name" ] || die "lead $name already exists: $leads/$name"
  [ ! -e "$autos/$name" ] || die "an automation is already called $name; pick another name"
  if [ "${FRAIM_HEADLESS:-}" = 1 ] && fraim-authority holds "$name"; then die "the name $name has powers on this server; only the owner can use it"; fi
  if [ "$engineer" = 1 ] && role="$(fraim-authority role engineer 2>/dev/null)"; then die "lead $role is already the engineer"; fi
  if [ "$chief" = 1 ] && role="$(fraim-authority role chief 2>/dev/null)"; then die "lead $role is already the chief"; fi
  if [ "$chief" = 1 ]; then at="${at:-30 7 * * *}"; budget="${budget:-2}"
  elif [ "$engineer" = 1 ]; then at="${at:-0 6 * * 1}"; budget="${budget:-99}"
  else at="${at:-0 7 * * 1-5}"; budget="${budget:-3}"; fi
  printf '%s' "$budget" | grep -Eq '^[0-9]{1,2}$' || usage "--budget must be a number from 0 to 99"
  [ "$(printf '%s' "$at" | wc -w | tr -d ' ')" = 5 ] || usage "--at needs five cron fields, for example \"0 7 * * 1-5\""
  printf '%s' "$at" | grep -Eq '^[0-9*/,-]+( [0-9*/,-]+){4}$' || usage "--at may only hold digits and * / , -"

  mkdir -p "$leads/$name/runs"
  if [ "$chief" = 1 ]; then fraim-prompt render brief-chief > "$leads/$name/lead.md"
  elif [ "$engineer" = 1 ]; then fraim-prompt render brief-engineer > "$leads/$name/lead.md"
  else fraim-prompt render brief-lead --set "name=$name" --set "area=$area" > "$leads/$name/lead.md"; fi
  if [ "$chief" = 1 ]; then fraim-authority set-role chief "$name" || die "could not record the chief"; fi
  if [ "$engineer" = 1 ]; then fraim-authority set-role engineer "$name" || die "could not record the engineer"; fi
  # Paused before its schedule exists, so it cannot run before the owner switches it on.
  [ "$off" = 0 ] || touch "$leads/$name/paused"
  printf '# Notes of lead %s\n\nNothing yet.\n' "$name" > "$leads/$name/state.md"
  printf '%s\n' "$budget" > "$leads/$name/budget"

  fraim-auto lead "$name" "$at" || die "could not schedule lead $name as an automation"
  [ "$chief" = 0 ] || cmd_events "$name" >/dev/null || die "could not wake the chief on queue events"
  if [ "$off" = 1 ]; then
    local a
    for a in $(lead_autos "$name"); do fraim-auto pause "$a" >/dev/null; done
  fi

  echo "Lead $name created: $leads/$name/lead.md"
  if [ "$off" = 1 ]; then
    echo "It is off. The owner switches it on (fraim-auto on $name); then it runs at: $at (server time)."
  else
    echo "It runs at: $at (server time). Edit lead.md to tell it what to watch."
  fi
  case ",${FRAIM_MODULES:-}," in
    *,scheduler,*) ;;
    *) echo "Note: the scheduler module is off, so the lead only runs by hand (fraim-lead run $name)." ;;
  esac
}

cmd_list() {
  [ -d "$leads" ] || { echo "No leads yet. Create one with: fraim-lead new NAME --area \"...\""; return 0; }
  local found="" dir name kind at last
  for dir in "$leads"/*/; do
    [ -f "$dir/lead.md" ] || continue
    name="$(basename "$dir")"
    kind="$(fraim-authority role-of "$name" 2>/dev/null)"; kind="${kind:-lead}"
    at=""
    ! has_auto "$name" || at="$(sed -n 's/^schedule:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$autos/$name/automation.md" | head -1)"
    [ ! -f "$dir/paused" ] || at="paused"
    last="$(cat "$dir/last" 2>/dev/null || echo 'never ran')"
    printf '%s  %s  %s  budget %s/day  last: %s\n' "$name" "$kind" "${at:-no schedule}" "$(cat "$dir/budget" 2>/dev/null || echo 3)" "$last"
    found=1
  done
  [ -n "$found" ] || echo "No leads yet. Create one with: fraim-lead new NAME --area \"...\""
}

cmd_show() {
  local dir
  dir="$(lead_dir "$1")" || exit $?
  printf '%s\n\n--- notes (state.md) ---\n%s\n' "$(cat "$dir/lead.md")" "$(cat "$dir/state.md" 2>/dev/null)"
}

# Recent goals of one lead: id, state, goal.
lead_goals() {
  local name="$1" dir id
  for dir in "$goals"/g*/; do
    [ -f "$dir/lead" ] && [ "$(cat "$dir/lead")" = "$name" ] || continue
    id="$(basename "$dir")"
    printf '%s %s | %s\n' "${id#g}" "$(cat "$dir/state" 2>/dev/null)" "$(head -1 "$dir/goal.md" | cut -c1-120)"
  done | sort -rn | head -10 | sed 's/^/g/'
}

# Queue items of one lead (every lead's with queue=all), with the owner's decisions.
queue_view() {
  local name="$1" scope="$2" filter=()
  command -v fraim-queue >/dev/null || return 0
  [ "$scope" = all ] || filter=(--lead "$name")
  fraim-queue list --all --json "${filter[@]}" 2>/dev/null \
    | jq -r '.[:25][] | "\(.id) [\(.state)] p\(.priority) \(.kind): \(.title)" + (if .note != "" then " | owner: \(.note)" else "" end)'
}

# Leads other than the chief and the engineer: the owner's team of "employees".
team_size() { cmd_list 2>/dev/null | grep -Ec '^[a-z0-9-]+  lead  ' || true; }

# What an agent is told lives in prompt files the owner can change (fraim-prompt). This only
# gathers the facts of this run and picks the file.
prompt_for() {
  local name="$1" dir="$2" rules scope template
  # rules=all sees every lead's rules; otherwise the general ones and its own.
  if [ "$(cap "$name" rules)" = all ]; then rules="$(fraim-brain show --for "$name" --all 2>/dev/null)"; else rules="$(fraim-brain show --for "$name" 2>/dev/null)"; fi
  scope="$(cap "$name" queue)"
  local fixer contact team no_team="" inbox="" input="${FRAIM_LEAD_INPUT:-}" input_max=4000
  fixer="$(the_fixer)" || fixer=""
  contact="$(the_contact)" || contact=""
  team="$(team_size)"
  [ "$team" != 0 ] || no_team=1
  [ ! -s "$dir/.running/inbox.md" ] || inbox="$(head -c 6000 "$dir/.running/inbox.md")"
  local args=(--lead "$name"
    --set "name=$name" --set "today=$(date '+%A %Y-%m-%d %H:%M')"
    --set "display=$(lead_display "$dir/lead.md")"
    --set "brief=$(awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front' "$dir/lead.md")"
    --set "state=$(head -c 8000 "$dir/state.md" 2>/dev/null)"
    --set "inbox=$inbox" --set "rules=$rules"
    --set "queue_view=$(queue_view "$name" "$scope" || true)"
    --set "goals=$(lead_goals "$name")"
    --set "engineer=$fixer" --set "chief_name=$contact" --set "team_size=$team" --set "no_team=$no_team"
    --set "repos_note=$(repos_note)"
    --set "style_queue=$(style_block queue)")
  if [ "$(cap "$name" builds_off)" = 1 ]; then
    local fw
    fw="$(code_dir)/fraimwork"
    [ -d "$fw/.git" ] || fw=""
    args+=(--set "fw=$fw"
      --set "automations=$(fraim-auto list 2>/dev/null | head -60)"
      --set "leads=$(cmd_list 2>/dev/null)")
  fi
  if [ "$scope" = all ]; then
    input_max=8000
    local owner_wrote=""
    [ "${input#The owner wrote:}" = "$input" ] || owner_wrote=1
    args+=(--set "owner_wrote=$owner_wrote"
      --set "trigger=${FRAIM_LEAD_TRIGGER:-manual}"
      --set "automations=$(fraim-auto list 2>/dev/null | head -40)"
      --set "outbox=$(tail -c 4000 "${FRAIM_FILES_DIR:-$HOME/fraim}/outbox.md" 2>/dev/null)"
      --set "style_whatsapp=$(style_block whatsapp)")
  fi
  [ "$(cap "$name" source_tools)" != 1 ] || args+=(--set "sources=$(fraim-auto sources 2>/dev/null)")
  args+=(--set "input=${input:0:$input_max}")
  template="$(cap "$name" template)"
  fraim-prompt render "${template:-lead}-run" "${args[@]}"
}

style_block() { command -v fraim-style >/dev/null || return 0; fraim-style prompt "$1" 2>/dev/null || true; }

# Repos cloned with fraim-repo. A lead starts in ~/fraim, and Claude refuses `cd REPO && git ...`,
# so read-only git is allowed per repo as `git -C REPO ...` instead.
code_dir() { printf '%s' "${FRAIM_CODE_DIR:-$HOME/code}"; }
lead_repos() {
  local g
  for g in "$(code_dir)"/*/.git; do [ -d "$g" ] && printf '%s\n' "${g%/.git}"; done
  return 0
}
repos_note() {
  local repos
  repos="$(lead_repos)"
  [ -n "$repos" ] || return 0
  printf '\nCode on this server:\n%s\n' "$(printf '%s\n' "$repos" | sed 's/^/- /')"
  printf 'Read-only git: git -C <repo> fetch|log|status|diff|show, with the full path above. A cd before git is refused. Other repo commands your tools allow (such as npm audit): cd <repo> && <command>.\n'
}

# A lead's base tools are prompt files the owner can change (fraim-prompt), one rule per line.
tool_lines() {
  local line
  while IFS= read -r line; do
    case "$line" in ''|\#*) ;; *) t+=("$line") ;; esac
  done < <(fraim-prompt render "$1" --lead "$2" --set "name=$2")
}

tools_for() {
  local name="$1" dir="$2" repo verb template
  local t=()
  tool_lines tools-lead "$name"
  template="$(cap "$name" template)"
  [ "${template:-lead}" = lead ] || tool_lines "tools-$template" "$name"
  if [ "$(cap "$name" source_tools)" = 1 ]; then
    while IFS= read -r repo; do [ -z "$repo" ] || t+=("$repo"); done < <(fraim-auto sources --tools 2>/dev/null)
  fi
  while IFS= read -r repo; do
    for verb in fetch log status diff show; do t+=("Bash(git -C $repo $verb:*)"); done
  done < <(lead_repos)
  if [ -f "$dir/tools" ]; then
    local extra
    while IFS= read -r extra; do t+=("$extra"); done < <(grep -v '^\s*#' "$dir/tools" | grep -v '^\s*$')
  fi
  local IFS=,
  printf '%s' "${t[*]}"
}

# The run's WhatsApp message: the lead's short answer, then each new queue item by its title.
short_answer() {
  local text
  text="$(printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
  if [ "${#text}" -gt 400 ]; then text="${text:0:400}"; text="${text% *}..."; fi
  printf '%s' "$text"
}
lead_message() {
  local name="$1" output="$2" before="$3" started="$4" items
  items="$(fraim-queue list --all --json --lead "$name" 2>/dev/null \
    | jq -r --arg before "$before" '($before | split("\n")) as $old | .[] | select(.id as $i | $old | index($i) | not) | "- " + .title')"
  printf '%s checked in.\n%s\n' "$name" "$(short_answer "$output")"
  if [ -n "$items" ]; then
    printf '\nWaiting for your answer:\n%s\n' "$items"
  fi
  if [ "$started" -gt 0 ]; then
    printf '\nStarted %s task(s) in the background. The results come to your queue.\n' "$started"
  fi
  printf '\nAnswer here: %s' "$(fraim-queue url 2>/dev/null)"
}

# With herdr answering, a run is a terminal the owner can watch in the Herdr app (docs/sessions.md).
# FRAIM_LEAD_TERMINAL=0 keeps every run headless (-p); 1 needs no check (the tests).
use_terminal() {
  case "${FRAIM_LEAD_TERMINAL:-auto}" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  fraim-herdr alive
}

lead_term() { fraim-herdr lead-term "$1"; }

# The run in a terminal: the same prompt and tool list as -p, marked unattended (fraim-claude).
# It works in the lead's folder, because main's `claude --continue` in ~/fraim must never pick
# up a lead's conversation. Its turn ends done; then the terminal closes, so it holds no memory.
# Sets code and output for cmd_run, and links the transcript as the live log.
run_terminal() {
  local name="$1" dir="$2" prompt="$3" tools="$4" term sid space rec state status turn file="" start=$SECONDS
  local hc=(fraim-herdr hc) envs=(env "FRAIM_LEAD_NAME=$name") labels=(--label fraim=lead)
  term="$(lead_term "$name")"
  sid="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())')"
  [ -z "${FRAIM_THREAD:-}" ] || envs+=("FRAIM_THREAD=$FRAIM_THREAD")
  [ -z "${FRAIM_BUILDS_OFF:-}" ] || envs+=("FRAIM_BUILDS_OFF=$FRAIM_BUILDS_OFF")
  space="$(fraim-herdr space 2>/dev/null)"
  [ -z "$space" ] || labels+=(--label "herdr.space=$space")
  fraim-herdr trust "$dir" 2>/dev/null || true
  "${hc[@]}" rm "$term" >/dev/null 2>&1 || true
  # The task comes before --allowedTools: words after it would become allowed tools.
  if ! "${hc[@]}" run --bg --name "$term" --cwd "$dir" "${labels[@]}" --no-parent --no-notify -- \
      "${envs[@]}" fraim-claude --fraim-unattended --session-id "$sid" "$prompt" \
      --allowedTools "$tools" --disallowedTools mcp__whatsapp --add-dir "$HOME/fraim" ${dirs[@]+"${dirs[@]}"} \
      >/dev/null 2>"$log.err"; then
    code=1 output=""
    return
  fi
  code=""
  while [ -z "$code" ]; do
    rec="$("${hc[@]}" get "$term" --json 2>/dev/null)" || rec='{}'
    if [ -z "$file" ]; then
      file="$(fraim-herdr transcript "$sid")"
      [ -z "$file" ] || ln -sfn "$file" "$live"
    fi
    state="$(jq -r '.state // ""' <<<"$rec" 2>/dev/null)"
    status="$(jq -r '.status.state // ""' <<<"$rec" 2>/dev/null)"
    turn="$(jq -r '.turn // 0' <<<"$rec" 2>/dev/null)"
    if [ "$state" = finished ]; then
      code="$(jq -r '.exit_code // 1' <<<"$rec")"
      [ "$code" != 0 ] || [ "${turn:-0}" -ge 1 ] || code=1
    elif [ "${turn:-0}" -ge 1 ] && [[ "$status" =~ ^(done|idle)$ ]]; then
      code=0
    elif [ "$status" = blocked ] || [ "$status" = error ]; then
      code=1
    elif [ $(( SECONDS - start )) -ge "${FRAIM_LEAD_TIMEOUT:-1800}" ]; then
      code=124
    elif [ "$status" = working ]; then
      "${hc[@]}" wait "$term" --timeout 60 >/dev/null 2>&1 || sleep 2
    else
      sleep 2
    fi
  done
  [ -n "$file" ] || file="$(fraim-herdr transcript "$sid")"
  [ -z "$file" ] || ln -sfn "$file" "$live"
  output="$(fraim-herdr last-text --session "$sid")"
  # A usage limit or a lost sign-in ends the turn with an error message, not an answer.
  if [ "$code" = 0 ] && [ -n "$file" ] \
    && jq -se '[.[] | select(.type == "assistant")] | last | .isApiErrorMessage == true' "$file" >/dev/null 2>&1; then
    code=1
  fi
  [ "$code" = 0 ] || "${hc[@]}" read "$term" --lines 40 >> "$log.err" 2>/dev/null || true
  "${hc[@]}" kill "$term" >/dev/null 2>&1 || true
  "${hc[@]}" rm "$term" >/dev/null 2>&1 || true
}

cmd_run() {
  local name="$1" dir direct=0 log output code before after new started=0
  dir="$(lead_dir "$name")" || exit $?
  [ ! -f "$dir/paused" ] || { echo "Lead $name is paused."; return 0; }
  [ "$(cap "$name" output)" != direct ] || direct=1
  # One run at a time; a lock from a run that died is taken over.
  if ! mkdir "$dir/.running" 2>/dev/null; then
    if kill -0 "$(cat "$dir/.running/pid" 2>/dev/null)" 2>/dev/null; then echo "Lead $name is already running."; return 0; fi
    # Notes the dead run held (a reboot, an out-of-memory kill) go back to the inbox.
    if [ -s "$dir/.running/inbox.md" ]; then
      cat "$dir/.running/inbox.md" "$dir/inbox.md" 2>/dev/null > "$dir/.running/inbox.new"
      mv "$dir/.running/inbox.new" "$dir/inbox.md"
    fi
    rm -rf "$dir/.running"; mkdir "$dir/.running" || die "could not lock $dir"
  fi
  printf '%s\n' "$$" > "$dir/.running/pid"
  # dir is local to this function, so expand it now: the EXIT trap runs after it is gone.
  # shellcheck disable=SC2064
  trap "rm -rf $(printf '%q' "$dir/.running")" EXIT
  # The run reads its own copy of the inbox; notes that arrive during the run wait for the next.
  [ ! -f "$dir/inbox.md" ] || mv "$dir/inbox.md" "$dir/.running/inbox.md"
  # The conversations this run is about show as "working on it" on the page. With exactly one,
  # everything this run says or starts belongs to it without the agent having to name it.
  local threads
  threads="$( { cat "$dir/.running/inbox.md" 2>/dev/null; printf '%s\n' "${FRAIM_LEAD_INPUT:-}"; } | grep -oE '\[t[0-9]{1,6}\]' | tr -d '[]' | sort -u)"
  unset FRAIM_THREAD
  [ -z "$threads" ] || printf '%s\n' "$threads" > "$dir/.running/thread"
  [ -z "$threads" ] || [ "$(printf '%s\n' "$threads" | wc -l | tr -d ' ')" != 1 ] || export FRAIM_THREAD="$threads"

  before="$(fraim-queue list --all --json --lead "$name" 2>/dev/null | jq -r '.[].id' | sort)"
  local goals_before
  goals_before="$(lead_goals "$name" | wc -l | tr -d ' ')"
  mkdir -p "$dir/runs"
  log="$dir/runs/$(date +%Y%m%d-%H%M%S).md"
  cd "$HOME/fraim" 2>/dev/null || cd "$HOME" || exit 1
  local limit=()
  ! command -v timeout >/dev/null || limit=(timeout "${FRAIM_LEAD_TIMEOUT:-1800}")
  local dirs=()
  [ ! -d "$(code_dir)" ] || dirs=(--add-dir "$(code_dir)")
  # What a builds_off agent creates starts switched off (fraim-auto new and fraim-lead new read it).
  if [ "$(cap "$name" builds_off)" = 1 ]; then export FRAIM_BUILDS_OFF=1; else unset FRAIM_BUILDS_OFF; fi
  export FRAIM_LEAD_NAME="$name"
  # stream-json writes each step as it happens, so the queue page shows what the run does now
  # (.running/live.jsonl). The answer is the last "result" line; plain text is kept as it is.
  local live="$dir/.running/live.jsonl" prompt tools
  prompt="$(prompt_for "$name" "$dir"; fraim-prompt render talk-rules --lead "$name")"
  tools="$(tools_for "$name" "$dir")"
  if use_terminal; then
    run_terminal "$name" "$dir" "$prompt" "$tools"
  else
    "${limit[@]}" fraim-claude -p "$prompt" --allowedTools "$tools" --disallowedTools mcp__whatsapp ${dirs[@]+"${dirs[@]}"} \
      --output-format stream-json --verbose > "$live" 2>"$log.err"
    code=$?
    if grep -q '"type":"result"' "$live" 2>/dev/null; then
      output="$(jq -rs 'map(select(type == "object" and .type == "result")) | last | .result // empty' "$live" 2>/dev/null)"
      if [ "$code" -eq 0 ] && [ "$(jq -rs 'map(select(type == "object" and .type == "result")) | last | .is_error // false' "$live" 2>/dev/null)" = true ]; then
        code=1
      fi
    else
      output="$(cat "$live" 2>/dev/null)"
    fi
  fi
  printf '%s\n' "$output" > "$log"
  cp "$live" "$log.jsonl" 2>/dev/null || true
  # The newest 60 runs stay; each run is its .md with .md.jsonl (and .md.err) next to it.
  local runs=("$dir"/runs/[0-9]*-[0-9]*.md) old
  if [ "${#runs[@]}" -gt 60 ]; then
    for old in "${runs[@]:0:${#runs[@]}-60}"; do rm -f "$old" "$old".*; done
  fi

  if [ "$code" -ne 0 ]; then
    local reason="exit $code"
    [ "$code" -ne 124 ] || reason="it ran longer than ${FRAIM_LEAD_TIMEOUT:-1800} seconds"
    case "$output$(tail -20 "$log.err" 2>/dev/null)" in
      *"Not logged in"*|*"Please run /login"*|*"Invalid API key"*|*"OAuth token"*|*"OAuth session"*|*"could not be refreshed"*|*"authentication_error"*|*"API Error: 401"*|*"401 Unauthorized"*|*"invalid_grant"*|*"ession expired"*) reason="the server is not signed in to Claude" ;;
      *"usage limit"*|*"Usage limit"*|*"rate limit"*|*"limit reached"*) reason="the Claude plan's usage limit was reached" ;;
    esac
    # Unread notes go back to the inbox for the next run.
    if [ -s "$dir/.running/inbox.md" ]; then
      cat "$dir/.running/inbox.md" "$dir/inbox.md" 2>/dev/null > "$dir/.running/inbox.new"
      mv "$dir/.running/inbox.new" "$dir/inbox.md"
    fi
    # 75: no free memory, Claude was not started (fraim-capacity). Not a failure: no alert,
    # the notes wait in the inbox, and the runner reports it as skipped.
    if [ "$code" -eq 75 ]; then
      printf 'skipped %s the server had no free memory\n' "$(date '+%Y-%m-%d %H:%M')" > "$dir/last"
      exit 75
    fi
    printf 'failed %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$reason" > "$dir/last"
    # Run by its automation, the runner alerts once and puts the failure in the queue.
    if [ -n "${FRAIM_LEAD_IN_AUTO:-}" ]; then
      echo "Lead $name failed: $reason. Log: ${log#"$HOME"/}" >&2
    else
      FRAIM_NOTIFY_DIRECT="$direct" fraim-notify "Lead $name failed: $reason. Log: ${log#"$HOME"/}"
    fi
    exit 1
  fi
  printf 'ok %s\n' "$(date '+%Y-%m-%d %H:%M')" > "$dir/last"
  rm -f "$log.err"
  [ ! -s "$dir/.running/inbox.md" ] || { printf '\n--- inbox this run read ---\n'; cat "$dir/.running/inbox.md"; } >> "$log"
  # The automation keeps this as the run's answer (its output is "none", so nothing is sent).
  printf '%s\n' "$output"

  if [ "$direct" = 1 ]; then
    is_silent "$output" && return 0
    # A run woken by queue events goes through the relay, which knows what the owner was
    # already told about the same results; the digest and answers to the owner go as they are.
    if [ -n "${FRAIM_LEAD_INPUT:-}" ] && [ "${FRAIM_LEAD_TRIGGER:-manual}" != manual ]; then
      FRAIM_NOTIFY_NO_ALERT=1 fraim-notify "$name routed new work: ${output:0:3500}"
      return 0
    fi
    FRAIM_NOTIFY_DIRECT=1 FRAIM_NOTIFY_NO_ALERT=1 fraim-notify "${output:0:3500}

$(fraim-queue url 2>/dev/null)"
    return 0
  fi

  after="$(fraim-queue list --all --json --lead "$name" 2>/dev/null | jq -r '.[].id' | sort)"
  new="$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | grep -c . || true)"
  started=$(( $(lead_goals "$name" | wc -l | tr -d ' ') - goals_before ))
  [ "$started" -ge 0 ] || started=0
  # One message per run, and none when the lead found nothing: the queue is the inbox.
  if [ "$new" -gt 0 ] || [ "$started" -gt 0 ]; then
    FRAIM_NOTIFY_NO_ALERT=1 fraim-notify "$(lead_message "$name" "$output" "$before" "$started")"
  fi
}

# A trial reads and changes nothing, so it keeps only the rules below. The engineer can write
# in ~/fraim/leads, so the result lives where it cannot.
trial_file() { printf '%s' "$HOME/.local/state/fraim/trials/$1.json"; }
trial_hash() { { cat "$1/lead.md"; cat "$1/tools" 2>/dev/null; } | cksum | cut -d' ' -f1; }
trial_tools() {
  local rule out=()
  while IFS= read -r rule; do
    case "$rule" in
      Read|Glob|Grep|WebSearch|WebFetch|ToolSearch) out+=("$rule") ;;
      mcp__*__*)
        printf '%s' "${rule##*__}" | grep -Eqi 'send|creat|updat|delet|post|put|patch|writ|remov|merge|push|publish|pay|reply|draft|save|modif|upload|cancel|archiv|label' || out+=("$rule") ;;
      *)
        printf '%s' "$rule" | grep -Eq '^Bash\((fraim-api|git( -C [^ ]+)? (log|status|diff|show|fetch)|gh [a-z]+ (list|view)|fraim-(queue|goal|lead|auto) (list|show|runs)|fraim-queue thread show)[: ]' && out+=("$rule") ;;
    esac
  done < <(printf '%s' "$1" | tr ',' '\n')
  local IFS=,
  printf '%s' "${out[*]}"
}

# try NAME: run a new employee once, switched off or not, and keep the verdict. --status only
# says whether the last trial passed for the brief and tools it has now.
cmd_try() {
  local name="$1" status="${2:-}" dir file
  dir="$(lead_dir "$name")" || exit $?
  file="$(trial_file "$name")"
  if [ "$status" = --status ]; then
    [ -f "$file" ] || { echo "it has had no trial yet (fraim-lead try $name)"; exit 1; }
    [ "$(jq -r .status "$file")" = passed ] || { echo "its last trial failed: $(jq -r .reason "$file")"; exit 1; }
    [ "$(jq -r .hash "$file")" = "$(trial_hash "$dir")" ] || { echo "its brief or tools changed after the trial (fraim-lead try $name)"; exit 1; }
    echo "passed $(jq -r .at "$file")"
    return 0
  fi
  if fraim-authority holds "$name"; then die "only a new employee gets a trial; $name has powers of its own"; fi
  [ ! -d "$dir/.running" ] || die "lead $name is running now; try again when it is done"

  local tmp hash live code=0 limit=() dirs=() reason="" verdict=failed answer last
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/fraim-trial.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf $(printf '%q' "$tmp")" EXIT
  hash="$(trial_hash "$dir")"
  live="$tmp/live.jsonl"
  cd "$HOME/fraim" 2>/dev/null || cd "$HOME" || exit 1
  ! command -v timeout >/dev/null || limit=(timeout "${FRAIM_LEAD_TRIAL_TIMEOUT:-540}")
  [ ! -d "$(code_dir)" ] || dirs=(--add-dir "$(code_dir)")
  unset FRAIM_BUILDS_OFF FRAIM_LEAD_INPUT FRAIM_THREAD
  FRAIM_TRIAL=1 "${limit[@]}" fraim-claude -p "$(prompt_for "$name" "$dir"; fraim-prompt render lead-trial --lead "$name")" \
    --allowedTools "$(trial_tools "$(tools_for "$name" "$dir")")" --disallowedTools mcp__whatsapp ${dirs[@]+"${dirs[@]}"} \
    --output-format stream-json --verbose > "$live" 2>"$tmp/err" || code=$?

  answer="$(jq -rs 'map(select(type == "object" and .type == "result")) | last | .result // empty' "$live" 2>/dev/null)"
  last="$(printf '%s\n' "$answer" | awk 'NF { l = $0 } END { print l }')"
  if [ "$code" -eq 75 ]; then reason="the server had no free memory, so it did not start"
  elif [ "$code" -eq 124 ]; then reason="it ran longer than ${FRAIM_LEAD_TRIAL_TIMEOUT:-540} seconds"
  elif [ "$code" -ne 0 ] || [ "$(jq -rs 'map(select(type == "object" and .type == "result")) | last | .is_error' "$live" 2>/dev/null)" != false ]; then
    reason="the run stopped with an error: $(tail -3 "$tmp/err" 2>/dev/null | tr '\n' ' ' | cut -c1-300)"
  elif [ "$(jq -s '[.[] | select(type == "object" and .type == "assistant") | .message.content[]? | select(.type == "tool_use")] | length' "$live" 2>/dev/null)" = 0 ]; then
    reason="it used no tool, so it looked at nothing"
  else
    case "$last" in
      "TRIAL OK"*) verdict=passed ;;
      "TRIAL BLOCKED"*) reason="$last" ;;
      *) reason="its answer did not end with TRIAL OK" ;;
    esac
  fi

  local refused
  refused="$(jq -cs '[.[] | select(type == "object" and .type == "result") | .permission_denials[]? | if .tool_name == "Bash" then .tool_input.command else .tool_name end] | unique' "$live" 2>/dev/null)"
  mkdir -p "$(dirname "$file")"
  jq -n --arg status "$verdict" --arg hash "$hash" --arg at "$(date '+%Y-%m-%d %H:%M')" --arg reason "$reason" --arg answer "$answer" --argjson refused "${refused:-[]}" \
    '{status: $status, hash: $hash, at: $at, reason: $reason, answer: $answer, refused: $refused}' > "$file.tmp"
  mv "$file.tmp" "$file"

  printf 'Trial of %s: %s%s\n\n%s\n' "$name" "$verdict" "${reason:+ ($reason)}" "$answer"
  [ "${refused:-[]}" = "[]" ] || printf '\nRefused during the trial: %s\n' "$refused"
  [ "$verdict" = passed ]
}

# wake NAME TEXT: run the lead now with TEXT as the reason. A lead that is running already
# runs once more when it ends (fraim-auto queues it). FRAIM_LEAD_DEPTH counts notes that woke
# a lead that then wrote a note; past FRAIM_LEAD_MAX_DEPTH hops a note waits for the next run,
# so two leads cannot wake each other forever.
wake_lead() {
  local name="$1" input="$2" depth="${FRAIM_LEAD_DEPTH:-0}"
  case "$depth" in ''|*[!0-9]*) depth=0 ;; esac
  [ ! -f "$leads/$name/paused" ] || return 1
  [ "$depth" -lt "${FRAIM_LEAD_MAX_DEPTH:-6}" ] || return 1
  if command -v fraim-auto >/dev/null && has_auto "$name"; then
    FRAIM_LEAD_DEPTH=$((depth + 1)) nohup fraim-auto run "$name" --input "$input" >/dev/null 2>&1 < /dev/null &
  else
    FRAIM_LEAD_DEPTH=$((depth + 1)) FRAIM_LEAD_TRIGGER=note FRAIM_LEAD_INPUT="$input" nohup "$0" run "$name" >/dev/null 2>&1 < /dev/null &
  fi
}

# tell NAME [--from WHO] [--later] -- TEXT: a note the lead reads first; it wakes the lead now.
cmd_tell() {
  local name="${1:-}" from=owner later=0 dir text thread="${FRAIM_THREAD:-}"
  [ -n "$name" ] || usage "tell NAME [--from WHO] [--later] [--thread tN] -- TEXT"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 || usage "--from needs a name" ;;
      --later) later=1; shift ;;
      --thread) thread="${2:-}"; shift 2 || usage "--thread needs a conversation id" ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  text="$*"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage "tell $name needs a text"
  # A run nobody watches writes under its own name, never as the owner or another agent.
  if [ "${FRAIM_HEADLESS:-}" = 1 ]; then
    if [ -n "${FRAIM_LEAD_NAME:-}" ]; then from="$FRAIM_LEAD_NAME"
    elif [ -n "${FRAIM_GOAL:-}" ]; then from="$FRAIM_GOAL"
    elif [ "$from" = owner ]; then from=agent; fi
  fi
  dir="$(lead_dir "$name")" || exit $?
  # A note about a conversation lands in the chat the owner reads and carries its id to the receiver.
  if printf '%s' "$thread" | grep -Eq '^t[0-9]{1,6}$'; then
    [ ! -d "$leads/$from" ] || fraim-queue thread say "$thread" --from "$from" --to "$name" -- "$text" 2>/dev/null || true
    text="[$thread] $text"
  fi
  printf -- '- %s, from %s: %s\n' "$(date '+%Y-%m-%d %H:%M')" "$from" "${text:0:4000}" >> "$dir/inbox.md"
  if [ "$later" = 0 ] && [ -z "${FRAIM_LEAD_NO_WAKE:-}" ] && wake_lead "$name" "A note from $from in your inbox: ${text:0:1000}"; then
    echo "Lead $name has it in its inbox and is woken now."
  else
    echo "Lead $name has it in its inbox; it acts on it at its next run."
  fi
}

# brief [NAME]: everything an agent knows, in one text, for the chat that talks as it (the
# default contact, unless named): its brief and notes, what the owner was told, goals with what
# they were for, coding sessions, leads, automations, open decisions and the owner's rules.
# Ids are for commands, never for the owner.
cmd_brief() {
  local who="${1:-}" dir g id st by
  printf 'Briefing, %s. Ids (g.., s.., q..) are for commands only; tell the owner what a thing is and what it was for.\n' "$(date '+%A %Y-%m-%d %H:%M')"
  if [ -n "$who" ]; then lead_dir "$who" >/dev/null || exit $?; else who="$(the_contact)" || who=""; fi
  if [ -n "$who" ]; then
    dir="$leads/$who"
    printf '\n## Your brief\n%s\n' "$(awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front' "$dir/lead.md")"
    printf '\n## Your notes\n%s\n' "$(head -c 4000 "$dir/state.md" 2>/dev/null)"
  fi
  if command -v fraim-relay >/dev/null; then
    printf '\n## The conversation with the owner\n%s\n' "$(fraim-relay context 2>/dev/null | tail -c 6000)"
  fi
  printf '\n## Background tasks (newest first)\n'
  if [ -d "$goals" ]; then
    for id in $(find "$goals" -mindepth 1 -maxdepth 1 -type d -name 'g[0-9]*' -exec basename {} \; | sed 's/^g//' | grep -E '^[0-9]+$' | sort -rn | head -12); do
      g="$goals/g$id"
      st="$(cat "$g/state" 2>/dev/null || echo unknown)"
      by="the owner"
      [ ! -s "$g/lead" ] || by="lead $(cat "$g/lead")"
      printf -- '- g%s, %s, started by %s. Task: %s\n' "$id" "$st" "$by" "$(tr '\n' ' ' < "$g/goal.md" 2>/dev/null | cut -c1-300)"
      [ ! -s "$g/result.md" ] || printf '  Result: %s\n' "$(tr '\n' ' ' < "$g/result.md" | cut -c1-300)"
    done
  fi
  if command -v fraim-sessions >/dev/null; then
    printf '\n## Coding sessions\n%s\n' "$(fraim-sessions list 2>/dev/null)"
  fi
  printf '\n## Leads\n'
  for g in "$leads"/*/lead.md; do
    [ -f "$g" ] || continue
    id="$(basename "$(dirname "$g")")"
    [ "$id" != "$who" ] || continue
    printf -- '- %s: %s Last run: %s\n' "$id" "$(awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front && NF' "$g" | head -3 | tr '\n' ' ' | cut -c1-200)" "$(cat "$(dirname "$g")/last" 2>/dev/null || echo never)"
  done
  if command -v fraim-auto >/dev/null; then
    printf '\n## Automations\n%s\n' "$(fraim-auto list 2>/dev/null | head -40)"
  fi
  if command -v fraim-queue >/dev/null; then
    printf '\n## Open decisions for the owner\n%s\n' "$(fraim-queue list --json 2>/dev/null | jq -r '.[:15][] | "- \(.id) p\(.priority): \(.title)" + (if (.ask // "") != "" then " | asks: \(.ask)" else "" end)' 2>/dev/null)"
  fi
  if command -v fraim-brain >/dev/null; then
    printf "\n## The owner's rules\n%s\n" "$(fraim-brain show --plain 2>/dev/null | head -c 3000)"
  fi
}

# ask [NAME|--chief] -- TEXT: the owner's message, answered now by a background run.
cmd_ask() {
  local name="" text input
  case "${1:-}" in
    --chief|--|"") ;;
    *) name="$1" ;;
  esac
  [ "${1:-}" = -- ] || [ $# -eq 0 ] || shift
  [ "${1:-}" != -- ] || shift
  text="$*"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage "ask [NAME] -- TEXT"
  if [ -z "$name" ]; then
    name="$(the_contact)" || die "there is no default contact: answer here, start a goal, or name a lead (fraim-lead list)"
  fi
  lead_dir "$name" >/dev/null || exit $?
  [ ! -f "$leads/$name/paused" ] || die "lead $name is paused; resume it with: fraim-lead resume $name"
  input="The owner wrote: ${text:0:4000}"
  if command -v fraim-auto >/dev/null && has_auto "$name"; then
    nohup fraim-auto run "$name" --input "$input" >/dev/null 2>&1 < /dev/null &
  else
    FRAIM_LEAD_TRIGGER=manual FRAIM_LEAD_INPUT="$input" nohup "$0" run "$name" >/dev/null 2>&1 < /dev/null &
  fi
  echo "Lead $name is on it; the answer comes here."
}

# events NAME [--every 15m] [--off]: an automation NAME-events that runs the lead when new
# goal results, failures or automation answers land in the queue (trigger: queue: events).
cmd_events() {
  local name="${1:-}" every=15m off=0 a f
  [ -n "$name" ] || usage "events NAME [--every 15m] [--off]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --every) every="${2:-}"; shift 2 || usage "--every needs an interval like 15m" ;;
      --off) off=1; shift ;;
      *) usage "unknown option $1" ;;
    esac
  done
  lead_dir "$name" >/dev/null || exit $?
  command -v fraim-auto >/dev/null || die "this server has no automations (fraim-auto)"
  a="$name-events"
  f="$autos/$a/automation.md"
  if [ "$off" = 1 ]; then
    [ -f "$f" ] || { echo "Lead $name does not wake on queue events."; return 0; }
    rm -rf "${autos:?}/$a"
    fraim-auto sync --quiet >/dev/null 2>&1 || true
    echo "Lead $name no longer wakes on queue events."
    return 0
  fi
  if [ -e "$autos/$a" ] && ! grep -q "^lead: $name\$" "$f" 2>/dev/null; then
    die "an automation is already called $a"
  fi
  mkdir -p "$autos/$a"
  printf -- '---\ndescription: Lead %s wakes on new goal results, failures and automation answers in the queue\ntrigger: queue: events\nevery: %s\nhours: 07:00-22:00\nlead: %s\ntimeout: 20m\noutput: none\n---\nThe lead brief is ~/fraim/leads/%s/lead.md. This automation only sets when the lead wakes.\n' \
    "$name" "$every" "$name" "$name" > "$f"
  if ! fraim-auto check "$a" >/dev/null 2>&1; then
    local why
    why="$(fraim-auto check "$a" 2>&1 | tail -1)"
    rm -rf "${autos:?}/$a"
    die "could not make the events automation: $why"
  fi
  [ ! -f "$leads/$name/paused" ] || fraim-auto pause "$a" >/dev/null
  fraim-auto sync --quiet >/dev/null 2>&1 || true
  echo "Lead $name wakes on new queue events, checked every $every between 07:00 and 22:00 ($a)."
}

# rename OLD NEW: the owner renames an agent; its powers, automations and history go with it.
cmd_rename() {
  local old="$1" new="$2" a target dir f tmp
  [ "${FRAIM_HEADLESS:-}" != 1 ] || die "only the owner renames an agent"
  valid_name "$new" || usage "'$new' is not a lead name (lowercase letters, digits and -)"
  dir="$(lead_dir "$old")" || exit $?
  [ ! -d "$dir/.running" ] || die "lead $old is running now; try again when it is done"
  [ ! -e "$leads/$new" ] && [ ! -e "$autos/$new" ] && [ ! -e "$autos/$new-events" ] || die "the name $new is taken"
  fraim-authority rename "$old" "$new" || die "could not record the new name"
  mv "$leads/$old" "$leads/$new"
  local state="${FRAIM_AUTO_STATE_DIR:-$HOME/.local/state/fraim/automations}"
  for a in $(lead_autos "$old"); do
    target="$new${a#"$old"}"
    mv "$autos/$a" "$autos/$target"
    [ ! -d "$state/$a" ] || mv "$state/$a" "$state/$target"
    f="$autos/$target/automation.md"
    tmp="$(mktemp "$f.XXXXXX")"
    sed -e "s/^lead: $old\$/lead: $new/" -e "s/^description: Lead $old/description: Lead $new/" -e "s#leads/$old/#leads/$new/#" "$f" > "$tmp" && mv "$tmp" "$f"
  done
  fraim-auto sync --quiet >/dev/null 2>&1 || true
  echo "$old is now called $new."
}

action="${1:-}"
[ $# -eq 0 ] || shift
case "$action" in
  new) cmd_new "$@" ;;
  rename) [ $# -eq 2 ] || usage "rename OLD NEW"; cmd_rename "$1" "$2" ;;
  list) cmd_list ;;
  show) [ $# -eq 1 ] || usage "show NAME"; cmd_show "$1" ;;
  run) [ $# -eq 1 ] || usage "run NAME"; cmd_run "$1" ;;
  try) { [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = --status ]; }; } || usage "try NAME [--status]"; cmd_try "$@" ;;
  pause)
    [ $# -eq 1 ] || usage "pause NAME"; dir="$(lead_dir "$1")" || exit $?
    touch "$dir/paused"
    for a in $(lead_autos "$1"); do fraim-auto pause "$a" >/dev/null; done
    echo "Lead $1 paused." ;;
  resume)
    [ $# -eq 1 ] || usage "resume NAME"; dir="$(lead_dir "$1")" || exit $?
    rm -f "$dir/paused"
    for a in $(lead_autos "$1"); do fraim-auto resume "$a" >/dev/null; done
    echo "Lead $1 resumed." ;;
  tell) cmd_tell "$@" ;;
  ask) cmd_ask "$@" ;;
  brief) cmd_brief "$@" ;;
  display) cmd_display "$@" ;;
  events) cmd_events "$@" ;;
  *) usage 'new NAME [--area TEXT] [--at "CRON"] [--budget N] [--chief] | list | show NAME | run NAME | tell NAME [--later] -- TEXT | ask [NAME] -- TEXT | events NAME [--every 15m] [--off] | pause NAME | resume NAME | display [NAME|--chief] [--clear] [-- TEXT]' ;;
esac
