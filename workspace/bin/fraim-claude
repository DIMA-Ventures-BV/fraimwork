#!/usr/bin/env bash
# Starts Claude Code with the stored login token (written by `fraim login`), if there is one.
# A full login made by `fraim login --full` (marker file plus ~/.claude/.credentials.json)
# needs no token, and the token would outrank it, so then the token is left out. A stray
# credentials file from an old manual /login does not count: it may have expired.
# Tools added with `fraim tool add` live in the home volume.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
token_file="$HOME/.config/fraim/claude-token"
full_login() { [ -f "$HOME/.config/fraim/full-login" ] && [ -s "$HOME/.claude/.credentials.json" ]; }
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -s "$token_file" ] && ! full_login; then
  CLAUDE_CODE_OAUTH_TOKEN="$(cat "$token_file")"
  export CLAUDE_CODE_OAUTH_TOKEN
fi
# The secrets proxy address and this space's session token (not a real key; see docs/secrets.md).
if [ -r /etc/fraim/runtime.env ]; then
  # shellcheck source=/dev/null
  . /etc/fraim/runtime.env
  export FRAIM_SECRETS_URL FRAIM_SECRETS_TOKEN FRAIM_SPACE
fi
# PERMISSIONS=all in .env (the default): nobody is there to approve a tool, so skip the
# prompts. Managed deny rules and --disallowedTools still apply. --allowedTools does not limit
# anything in that mode, so a -p run that names its tools runs in dontAsk instead: what is not
# on its list is refused. TOOL_LISTS=open in .env turns that off.
# A headless run (-p: goals, leads, automations, the brain) has no owner watching. Commands
# that only the owner may run (queue decisions, brain changes) check this and refuse.
# The exception is the owner's own message in the app (fraim-relay chat): the owner is the one
# asking, as on WhatsApp. It covers this run only, so nothing this run starts inherits it.
headless_run=""
owner_chat="${FRAIM_OWNER_CHAT:-}"
unset FRAIM_OWNER_CHAT
tool_list=""
for arg in "$@"; do
  case "$arg" in
    -p|--print) headless_run=1; [ "$owner_chat" = 1 ] || export FRAIM_HEADLESS=1 ;;
    --allowedTools|--allowed-tools) tool_list=1 ;;
  esac
done
# A run nobody watches (automations, leads, the brain) waits for free memory, at most
# FRAIM_CAPACITY_WAIT seconds (default 300, shorter than its caller's own time limit), instead
# of starting a Claude the server cannot hold (fraim-capacity). Exit 75 means "not started":
# the runners count it as skipped, not failed. Goals and coding sessions check before they
# open their terminal; main and the chief's messages to the owner never wait.
if [ -n "$headless_run" ] && [ "${FRAIM_NO_CAPACITY_WAIT:-}" != 1 ] && command -v fraim-capacity >/dev/null; then
  if ! fraim-capacity wait --max "${FRAIM_CAPACITY_WAIT:-300}"; then
    echo "fraim: the server had no free memory for another Claude run for $(( ${FRAIM_CAPACITY_WAIT:-300} / 60 )) minutes; it was not started" >&2
    exit 75
  fi
fi
if [ "${FRAIM_PERMISSIONS:-all}" = all ]; then
  if [ -n "$headless_run" ] && [ -n "$tool_list" ] && [ "${FRAIM_TOOL_LISTS:-enforce}" != open ]; then
    set -- --permission-mode dontAsk "$@"
  else
    set -- --dangerously-skip-permissions "$@"
  fi
fi
# What every Claude on the server is told is the prompt file "server" (fraim-prompt). Those
# rules must never go missing: without a fresh copy, use the last one, then the shipped one.
prompt_dir="$HOME/.local/state/fraim"
server_prompt="$prompt_dir/server-prompt.md"
if command -v fraim-prompt >/dev/null; then
  mkdir -p "$prompt_dir" 2>/dev/null
  prompt_tmp="$(mktemp "$prompt_dir/.server-prompt.XXXXXX" 2>/dev/null)"
  if [ -n "$prompt_tmp" ] && fraim-prompt render server --set "display=$(fraim-lead display 2>/dev/null)" > "$prompt_tmp" 2>/dev/null && [ -s "$prompt_tmp" ]; then
    mv "$prompt_tmp" "$server_prompt"
  else
    rm -f "$prompt_tmp"
  fi
fi
[ -s "$server_prompt" ] || server_prompt="${FRAIM_PROMPT_DEFAULTS:-/etc/fraim/prompts}/server.md"
[ ! -s "$server_prompt" ] || set -- "$@" --append-system-prompt-file "$server_prompt"
# Runs nobody watches may not rewrite instructions or their own tool list with the edit tools.
# A goal has a full shell and runs as the same Unix user, so this does not stop it (docs/prompts.md).
if [ "${FRAIM_HEADLESS:-}" = 1 ]; then
  set -- "$@" --disallowedTools "Edit(~/fraim/prompts/**),Write(~/fraim/prompts/**),Edit(~/fraim/leads/*/prompts/**),Write(~/fraim/leads/*/prompts/**),Edit(~/fraim/leads/*/tools),Write(~/fraim/leads/*/tools)"
  set -- "$@" --disallowedTools "Edit(~/fraim/ui/**),Write(~/fraim/ui/**)"
  set -- "$@" --disallowedTools "Edit(~/fraim/leads/*/budget),Write(~/fraim/leads/*/budget)"
  # The chief's brief goes into the owner's own chat, so no unattended run may write it.
  if chief="$(fraim-authority role chief 2>/dev/null)" && [ -n "$chief" ]; then
    set -- "$@" --disallowedTools "Edit(~/fraim/leads/$chief/lead.md),Write(~/fraim/leads/$chief/lead.md)"
  fi
fi
# fraim-config loads this machine's secrets (~/.config/fraim/secrets.env) when installed.
if command -v fraim-config >/dev/null; then
  exec fraim-config exec -- claude "$@"
fi
exec claude "$@"
