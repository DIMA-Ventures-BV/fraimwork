#!/usr/bin/env bash
# Checks every fraimwork part. Exit code 1 when anything fails.
#   --json    machine-readable output
#   --notify  send failures to the owner on WhatsApp
set -u
# shellcheck source=/dev/null
. /etc/fraim/runtime.env 2>/dev/null || true

json=0 notify=0
for arg in "$@"; do
  case "$arg" in --json) json=1 ;; --notify) notify=1 ;; esac
done

names=() results=() failures=()
check() {
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then results+=(true); else results+=(false); failures+=("$label"); fi
  names+=("$label")
}
has_module() { case ",${FRAIM_MODULES:-}," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
logged_in() { [ -s "$HOME/.claude/.credentials.json" ] || [ -s "$HOME/.config/fraim/claude-token" ]; }

check "claude-login" logged_in
# claude setup-token tokens last one year; warn a month before.
token_fresh() { local f="$HOME/.config/fraim/claude-token"; [ ! -s "$f" ] || [ -n "$(find "$f" -mtime -335)" ]; }
check "claude-token-not-expiring" token_fresh
check "disk-below-90-percent" sh -c "[ \$(df --output=pcent \"$HOME/fraim\" | tail -1 | tr -dc 0-9) -lt 90 ]"
# The interactive session lives in the workspace container; the scheduler cannot see it.
[ "${FRAIM_ROLE:-workspace}" = scheduler ] || check "claude-session-running" pgrep -x claude
# Failed last run of a job that still exists. State of deleted jobs is removed.
jobs_ok() {
  local f name failed=0
  for f in "$HOME"/.local/state/fraim/jobs/*; do
    [ -f "$f" ] || continue
    name="$(basename "$f")"
    if [ ! -f "$HOME/fraim/jobs/$name.md" ]; then rm -f "$f"; continue; fi
    grep -q '^failed' "$f" && failed=1
  done
  [ "$failed" = 0 ]
}
check "jobs-ok" jobs_ok
# The config layer loads in the background at start; "pending" (still running) counts as ok.
plugins_ok() { local s="$HOME/.local/state/fraim/config-init.status"; [ ! -f "$s" ] || ! grep -q '^failed' "$s"; }
command -v fraim-config >/dev/null && check "plugins-ok" plugins_ok
has_module whatsapp && check "whatsapp-connected" sh -c "fraim-gateway GET /status | jq -e .connected"
has_module browser && check "server-browser" curl -fsS "${BROWSER_CDP_URL}/json/version"
has_module sync && check "syncthing" curl -fsS http://syncthing:8384/rest/noauth/health

if [ "$json" = 1 ]; then
  out='[]'
  for i in "${!names[@]}"; do
    out="$(jq -c --arg n "${names[$i]}" --argjson ok "${results[$i]}" '. + [{name: $n, ok: $ok}]' <<<"$out")"
  done
  login=none
  if [ -s "$HOME/.claude/.credentials.json" ]; then login=full; elif [ -s "$HOME/.config/fraim/claude-token" ]; then login=token; fi
  jq -n --argjson checks "$out" --arg modules "${FRAIM_MODULES:-}" --arg tz "${TZ:-UTC}" --arg space "${FRAIM_SPACE:-main}" --arg login "$login" \
    '{ok: ($checks | all(.ok)), space: $space, login: $login, modules: ($modules | split(",") | map(select(. != ""))), timezone: $tz, checks: $checks}'
else
  for i in "${!names[@]}"; do
    if [ "${results[$i]}" = true ]; then printf 'OK    %s\n' "${names[$i]}"; else printf 'FAIL  %s\n' "${names[$i]}"; fi
  done
fi

# Notify only when the set of failures changes, so an hourly run never repeats itself.
if [ "$notify" = 1 ]; then
  state_dir="$HOME/.local/state/fraim"
  mkdir -p "$state_dir"
  now="$(IFS=,; echo "${failures[*]:-}")"
  last="$(cat "$state_dir/doctor.last" 2>/dev/null || true)"
  if [ "$now" != "$last" ]; then
    if [ -n "$now" ]; then
      fraim-notify "fraim: ${#failures[@]} problem(s) on your server: ${now//,/, }. Ask Claude on your laptop to fix fraim." || true
    else
      fraim-notify "fraim: all problems are fixed, your server is healthy again." || true
    fi
    printf '%s' "$now" > "$state_dir/doctor.last"
  fi
fi

[ ${#failures[@]} -eq 0 ]
