#!/usr/bin/env bash
# Checks every fraimwork part. Exit code 1 when anything fails.
#   --json    machine-readable output
#   --notify  send failures to the owner on WhatsApp
set -u
# Exported, because a manifest's check runs in its own shell.
set -a
# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true
set +a

json=0 notify=0
for arg in "$@"; do
  case "$arg" in --json) json=1 ;; --notify) notify=1 ;; esac
done

names=() results=() failures=()
check() {
  local label="$1"; shift
  if "$@" >/dev/null 2>&1; then results+=(true); else results+=(false); failures+=("$label"); fi
  names+=("$label")
}
has_module() { case ",${FRAIM_MODULES:-}," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
logged_in() { [ -s "$HOME/.claude/.credentials.json" ] || [ -s "$HOME/.config/fraim/claude-token" ]; }
export -f logged_in
warn() { echo "fraim-doctor: $*" >&2; }

# A build without a version number (dev, a bare commit) passes.
version_at_least() {
  local min="${1#v}"
  [[ "${FRAIM_VERSION:-dev}" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+) ]] || return 0
  [ "$(printf '%s\n%s\n' "$min" "${BASH_REMATCH[1]}" | sort -V | head -1)" = "$min" ]
}

# Reads one modules/NAME.manifest and queues the checks of a module that is on. Queued, not
# run here: a check that reads stdin would swallow the rest of the file.
module_names=() module_commands=()
load_manifest() {
  local line key value id="" profile="" min="" entry
  local entries=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%:*}"
    value="${line#*:}"
    value="${value# }"
    case "$key" in
      id) id="$value" ;;
      profile) profile="$value" ;;
      min_fraim_version) min="$value" ;;
      check) entries+=("$value") ;;
    esac
  done < "$1"
  if [ -z "$id" ] || [ -z "$profile" ]; then warn "skipping $1: it needs id and profile"; return; fi
  has_module "$profile" || return 0
  if [ -n "$min" ] && ! version_at_least "$min"; then
    warn "skipping module $id: it needs fraimwork $min, this is ${FRAIM_VERSION:-dev}"
    return
  fi
  for entry in ${entries[@]+"${entries[@]}"}; do
    case "$entry" in
      *' '*) module_names+=("${entry%% *}"); module_commands+=("${entry#* }") ;;
      *) warn "skipping check '$entry' of module $id: it has no command" ;;
    esac
  done
}

check "claude-login" logged_in
# claude setup-token tokens last one year; warn a month before.
token_fresh() { local f="$HOME/.config/fraim/claude-token"; [ ! -s "$f" ] || [ -n "$(find "$f" -mtime -335)" ]; }
check "claude-token-not-expiring" token_fresh
check "disk-below-90-percent" sh -c "[ \$(df --output=pcent \"$HOME/fraim\" | tail -1 | tr -dc 0-9) -lt 90 ]"
# Enough free memory for main, the browser and WhatsApp (fraim-capacity keeps it there; when
# this fails for long, the server is too small for the work it is given).
memory_ok() { [ "$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)" -ge "${FRAIM_MEM_RESERVE_MB:-350}" ]; }
check "memory-headroom" memory_ok
# The interactive session lives in the workspace container; the scheduler cannot see it.
[ "${FRAIM_ROLE:-workspace}" = scheduler ] || check "claude-session-running" pgrep -x claude
# herdr-core holds main, goals and coding sessions (docs/sessions.md).
check "sessions-service" fraim-herdr alive
[ "${FRAIM_ROLE:-workspace}" = scheduler ] || check "queue-page" curl -fsS --max-time 5 http://127.0.0.1:3109/health
# An automation that failed or was blocked on its last run, or was paused after failures.
# State of deleted automations (and of old-style jobs) is removed.
jobs_ok() {
  local d name failed=0
  rm -rf "$HOME/.local/state/fraim/jobs"
  for d in "$HOME"/.local/state/fraim/automations/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    if [ ! -f "$HOME/fraim/automations/$name/automation.md" ]; then rm -rf "$d"; continue; fi
    grep -qE '^(failed|blocked)' "$d/last_status" 2>/dev/null && failed=1
    grep -q '^after' "$d/paused" 2>/dev/null && failed=1
  done
  [ "$failed" = 0 ]
}
check "jobs-ok" jobs_ok
# The config layer loads in the background at start; "pending" (still running) counts as ok.
plugins_ok() { local s="$HOME/.local/state/fraim/config-init.status"; [ ! -f "$s" ] || ! grep -q '^failed' "$s"; }
command -v fraim-config >/dev/null && check "plugins-ok" plugins_ok

modules_dir="${FRAIM_MODULES_DIR:-/etc/fraim/modules}"
manifests=("$modules_dir"/*.manifest)
if [ -f "${manifests[0]}" ]; then
  for manifest in "${manifests[@]}"; do load_manifest "$manifest"; done
elif [ -n "${FRAIM_MODULES:-}" ]; then
  warn "no module manifests in $modules_dir, so no module is checked"
fi
for i in "${!module_names[@]}"; do check "${module_names[$i]}" bash -c "${module_commands[$i]}"; done

if [ "$json" = 1 ]; then
  out='[]'
  for i in "${!names[@]}"; do
    out="$(jq -c --arg n "${names[$i]}" --argjson ok "${results[$i]}" '. + [{name: $n, ok: $ok}]' <<<"$out")"
  done
  login=none
  if [ -f "$HOME/.config/fraim/full-login" ] && [ -s "$HOME/.claude/.credentials.json" ]; then login=full; elif [ -s "$HOME/.config/fraim/claude-token" ]; then login=token; fi
  jq -n --argjson checks "$out" --arg modules "${FRAIM_MODULES:-}" --arg tz "${TZ:-UTC}" --arg space "${FRAIM_SPACE:-main}" --arg login "$login" \
    '{ok: ($checks | all(.ok)), space: $space, login: $login, modules: ($modules | split(",") | map(select(. != ""))), timezone: $tz, checks: $checks}'
else
  for i in "${!names[@]}"; do
    if [ "${results[$i]}" = true ]; then printf 'OK    %s\n' "${names[$i]}"; else printf 'FAIL  %s\n' "${names[$i]}"; fi
  done
fi

# Notify only when the set of failures changes, so an hourly run never repeats itself.
if [ "$notify" = 1 ]; then
  state_dir="$HOME/.local/state/fraim"
  mkdir -p "$state_dir"
  now="$(IFS=,; echo "${failures[*]:-}")"
  last="$(cat "$state_dir/doctor.last" 2>/dev/null || true)"
  if [ "$now" != "$last" ]; then
    if [ -n "$now" ]; then
      fraim-notify "fraim: ${#failures[@]} problem(s) on your server: ${now//,/, }. Ask Claude on your laptop to fix fraim." || true
    else
      fraim-notify "fraim: all problems are fixed, your server is healthy again." || true
    fi
    printf '%s' "$now" > "$state_dir/doctor.last"
  fi
fi

[ ${#failures[@]} -eq 0 ]
