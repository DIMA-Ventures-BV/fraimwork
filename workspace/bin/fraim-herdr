#!/usr/bin/env bash
# herdr-core (hc) on the server: the terminals every Claude session lives in (docs/sessions.md).
# The core runs in the workspace container only. The scheduler container shares the home
# volume, so it reaches the same core through its socket, but it must never start a second
# core of its own (any hc command starts one when none answers).
#
#   fraim-herdr supervise        workspace only: keep the core, main, the queue page and the
#                                watcher running (started by fraim-entrypoint)
#   fraim-herdr up               workspace only: start what is missing once
#   fraim-herdr alive            exit 0 when the core answers (never starts one)
#   fraim-herdr hc ARGS...       run hc; in the scheduler only when the core answers
#   fraim-herdr ls [--json]      the fraim terminals: name, kind, status, folder
#   fraim-herdr attach [NAME]    humans: main (default), g3, s1, or a plain shell that stays
#   fraim-herdr watch            tell the owner when a session needs them or a session finished
#   fraim-herdr status ADDR      the terminal's status word (working, done, blocked, idle, ...)
#   fraim-herdr state NAME       live, finished, gone or unknown (the core did not answer)
#   fraim-herdr trust DIR        mark a folder trusted for Claude Code (atomic ~/.claude.json write)
#   fraim-herdr redact           hide tokens and keys in stdin
#   fraim-herdr last-text ADDR   the last thing Claude said in that terminal (from its transcript)
# Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail

# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true

usage() { echo "fraim-herdr: $*" >&2; exit 2; }
die() { echo "fraim-herdr: $*" >&2; exit 1; }

session="${HC_SESSION:-default}"
socket_path() {
  if [ -n "${HC_SOCKET:-}" ]; then printf '%s' "$HC_SOCKET"; return; fi
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then printf '%s/herdr-core/%s.sock' "$XDG_RUNTIME_DIR" "$session"; return; fi
  if [ -d "/run/user/$(id -u)" ]; then printf '/run/user/%s/herdr-core/%s.sock' "$(id -u)" "$session"; return; fi
  printf '%s/herdr-core/%s/%s.sock' "${XDG_STATE_HOME:-$HOME/.local/state}" "$session" "$session"
}

# Asks the core for its terminal list over the socket; hc itself would start a core.
alive() {
  local sock
  sock="$(socket_path)"
  [ -S "$sock" ] || return 1
  python3 - "$sock" <<'EOF' 2>/dev/null
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
s.connect(sys.argv[1])
s.sendall(b'{"jsonrpc":"2.0","id":1,"method":"terminal.list","params":{}}\n')
buf = b""
while b"\n" not in buf:
    chunk = s.recv(65536)
    if not chunk:
        break
    buf += chunk
sys.exit(0 if "result" in json.loads(buf.split(b"\n")[0]) else 1)
EOF
}

in_workspace() { [ "${FRAIM_ROLE:-workspace}" = workspace ]; }

# A run without the owner (goals, leads, automations: FRAIM_HEADLESS=1) may drive goals,
# which run headless too, but never type into main or a coding session: those act as the
# owner, so a goal that read a hostile page could use them to approve its own work.
# Reading (ls, get, read, wait, events) stays open.
headless_allows() {
  [ "${FRAIM_HEADLESS:-}" = 1 ] || return 0
  local sub="$1" target=""; shift
  case "$sub" in
    ls|get|read|wait|events|schema|templates|--version|-V) return 0 ;;
    run)
      while [ $# -gt 0 ]; do
        case "$1" in --name) target="${2:-}"; break ;; --) break ;; esac
        shift
      done ;;
    send|keys|kill|rm|interrupt|put|label|keep|attach)
      for a in "$@"; do case "$a" in -*) ;; *) target="$a"; break ;; esac; done ;;
  esac
  printf '%s' "$target" | grep -Eq '^g[0-9]{1,6}$'
}

hcx() {
  headless_allows "$@" \
    || die "a run without the owner may only drive goals, not main or a coding session"
  if ! in_workspace && ! alive; then
    die "the session service (herdr) does not answer in the workspace container; run: fraim restart workspace"
  fi
  hc "$@"
}

# live, finished, gone (no such terminal: hc exit 3) or unknown (the core did not answer).
# Only gone or finished may be replaced: a busy core must never cost a running Claude.
term_state() {
  local rec rc
  rec="$(hc get "$1" --json 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 3 ]; then echo gone; return; fi
  if [ "$rc" -ne 0 ]; then echo unknown; return; fi
  jq -r '.state // "unknown"' <<<"$rec" 2>/dev/null || echo unknown
}
live() { [ "$(term_state "$1")" = live ]; }

status_of() { hcx get "$1" --json 2>/dev/null | jq -r '.status.state // "none"'; }

# Claude Code asks once per folder whether to trust it, and a session nobody watches would
# wait there. Running Claudes rewrite ~/.claude.json too: write a copy next to it and rename
# it into place, so no reader ever sees a half-written file.
cmd_trust() {
  local dir="$1" state="$HOME/.claude.json" tmp
  [ -s "$state" ] || echo '{}' > "$state"
  jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$state" >/dev/null 2>&1 && return 0
  tmp="$(mktemp "$state.XXXXXX")" || return 1
  if jq --arg d "$dir" '.projects[$d].hasTrustDialogAccepted = true' "$state" > "$tmp" 2>/dev/null; then
    chmod 0600 "$tmp"
    mv -f "$tmp" "$state"
  else
    rm -f "$tmp"
    return 1
  fi
}

# Tokens and keys a session may have printed never go out in a WhatsApp message.
redact() {
  sed -E \
    -e 's/(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})/[hidden]/g' \
    -e 's/(([A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|PRIVATE_KEY))["'"'"']?[[:space:]]*[:=][[:space:]]*)["'"'"']?[^[:space:]"'"'"']{6,}/\1[hidden]/gI'
}

# A finished terminal with this name blocks a new one with the same name: remove it first.
start_service() {
  local name="$1" kind="$2" state; shift 2
  state="$(term_state "$name")"
  case "$state" in
    live) return 0 ;;
    unknown) echo "fraim-herdr: $name: the core did not answer; not touching it" >&2; return 1 ;;
  esac
  hc rm "$name" >/dev/null 2>&1 || true
  hc run --bg --name "$name" --cwd "$HOME/fraim" --label "fraim=$kind" --no-parent --no-notify -- "$@" >/dev/null
}

cmd_up() {
  in_workspace || die "the session service runs in the workspace container only"
  mkdir -p "$HOME/.local/state/fraim" "$HOME/fraim"
  hc server status >/dev/null 2>&1 || die "herdr-core did not start"
  local failed=0
  start_service main main fraim-session || failed=1
  # The review queue page, on the last preview slot; restarts itself when it stops.
  start_service queue-page service bash -c 'while true; do fraim-queue serve 2>>~/.local/state/fraim/queue.log; sleep 5; done' || failed=1
  start_service watch service bash -c 'while true; do fraim-herdr watch 2>>~/.local/state/fraim/watch.log; sleep 5; done' || failed=1
  return "$failed"
}

cmd_supervise() {
  in_workspace || die "the session service runs in the workspace container only"
  while true; do
    cmd_up 2>>"$HOME/.local/state/fraim/herdr.log" || true
    # A goal whose watcher process died (a container restart) gets a new one.
    fraim-goal reconcile >/dev/null 2>>"$HOME/.local/state/fraim/herdr.log" || true
    sleep "${FRAIM_HERDR_CHECK:-30}"
  done
}

kind_of_name() {
  case "$1" in
    main) echo main ;;
    g[0-9]*) echo goal ;;
    s[0-9]*) echo session ;;
    *) echo service ;;
  esac
}

# fraim shell [NAME]: main, a goal (g3), a coding session (s1), or a plain shell that stays.
cmd_attach() {
  local name="${1:-main}"
  [ -t 0 ] && [ -t 1 ] || usage "attach is for a person in a terminal"
  printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,31}$' || usage "'$name' is not a session name"
  case "$name" in
    g[0-9]*) exec fraim-goal attach "$name" ;;
    s[0-9]*) exec fraim-sessions attach "$name" ;;
  esac
  case "$(term_state "$name")" in
    live) ;;
    unknown) die "the session service does not answer; try again in a minute" ;;
    *)
    [ "$name" != main ] || die "the main session is not running; run: fraim restart workspace"
    hc rm "$name" >/dev/null 2>&1 || true
    hc run --bg --name "$name" --cwd "$HOME" --label fraim=shell --no-parent --no-notify >/dev/null || die "could not open $name" ;;
  esac
  echo "Leave with Ctrl+\\ ($name keeps running)."
  exec hc attach "$name"
}

# hc ls gives a short record per terminal (status as one word, no labels): list each kind by
# its label, and ask the full record (hc get) only for a blocked one, for its question.
cmd_ls() {
  local json='[]' kind part row name
  for kind in main goal session shell service; do
    part="$(hcx ls --label "fraim=$kind" --json 2>/dev/null)" || die "could not list the sessions"
    json="$(jq --arg k "$kind" --argjson p "$part" '. + [$p.terminals[] | {name: (.name // .address), kind: $k, status: (.status // "none"), question: "", cwd, turn}]' <<<"$json")"
  done
  for name in $(jq -r '.[] | select(.status == "blocked") | .name' <<<"$json"); do
    row="$(hc get "$name" --json 2>/dev/null | jq -r '.status.msg // ""')"
    json="$(jq --arg n "$name" --arg q "$row" 'map(if .name == $n then .question = $q else . end)' <<<"$json")"
  done
  if [ "${1:-}" = --json ]; then printf '%s\n' "$json"; return 0; fi
  [ "$(jq length <<<"$json")" -gt 0 ] || { echo "No sessions."; return 0; }
  jq -r --arg h "$HOME/" '.[] | select(.kind != "service") | "\(.name)\t\(.kind)\t\(.status)\t\(.cwd | if startswith($h) then "~/" + .[($h | length):] else . end)\(if .question != "" then "\t" + .question else "" end)"' <<<"$json"
}

# Claude Code's transcript for a session id: the last text it wrote (empty when none yet).
transcript_text() {
  local sid="$1" file
  [ -n "$sid" ] || return 0
  file="$(find "$HOME/.claude/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -1)"
  [ -n "$file" ] || return 0
  jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // ""' "$file" 2>/dev/null
}

cmd_last_text() {
  local name="$1" sid=""
  case "$(kind_of_name "$name")" in
    goal) sid="$(cat "${FRAIM_GOALS_DIR:-$HOME/fraim/goals}/$name/session-id" 2>/dev/null)" ;;
    session) sid="$(cat "${FRAIM_SESSIONS_DIR:-$HOME/fraim/sessions}/$name/session-id" 2>/dev/null)" ;;
  esac
  transcript_text "$sid"
}

tell_owner() { FRAIM_NOTIFY_NO_ALERT=1 fraim-notify "$1" >/dev/null 2>&1 || true; }

# What the owner calls it: the goal's task or the session's repo, never an id. The owner
# answers in plain words; the server's Claude finds the session with fraim-herdr ls.
describe() {
  local name="$1" kind="$2" rec="$3" what
  case "$kind" in
    goal)
      what="$(head -1 "${FRAIM_GOALS_DIR:-$HOME/fraim/goals}/$name/goal.md" 2>/dev/null | cut -c1-80)"
      printf 'The task "%s"' "${what:-a background task}" ;;
    session)
      printf 'The coding session in %s' "$(jq -r '.labels.repo // "a repo"' <<<"$rec")" ;;
    *) printf 'A session on the server' ;;
  esac
}

# Follows status changes. Blocked (a question or a permission) reaches the owner for every
# kind; a coding session that finished a turn reaches the owner too. Goals send their own
# result (fraim-goal), main answers on WhatsApp itself.
cmd_watch() {
  in_workspace || die "the watcher runs in the workspace container only"
  declare -A last=()
  local line type addr state rec name kind msg text
  while IFS= read -r line; do
    type="$(jq -r '.params.type // empty' <<<"$line" 2>/dev/null)"
    [ "$type" = status ] || continue
    addr="$(jq -r '.params.terminal // empty' <<<"$line")"
    state="$(jq -r '.params.data.status.state // "none"' <<<"$line")"
    [ -n "$addr" ] || continue
    [ "${last[$addr]:-}" != "$state" ] || continue
    last[$addr]="$state"
    rec="$(hc get "$addr" --json 2>/dev/null)" || continue
    name="$(jq -r '.name // .address' <<<"$rec")"
    kind="$(jq -r '.labels.fraim // ""' <<<"$rec")"
    [ -n "$kind" ] && [ "$kind" != service ] || continue
    case "$state" in
      blocked)
        msg="$(jq -r '.params.data.status.msg // ""' <<<"$line")"
        if [ "$kind" = main ]; then
          # fraim-session confirms the WhatsApp channel prompt at every start; only a
          # screen that stays blocked for a minute needs the owner.
          (
            sleep "${FRAIM_MAIN_BLOCKED_GRACE:-60}"
            [ "$(status_of "$addr")" = blocked ] \
              && tell_owner "Your always-on assistant is stuck on a question on its screen: ${msg:-open it from the laptop to see it}."
          ) &
        else
          msg="$(printf '%s' "${msg#answer: }" | redact)"
          tell_owner "$(describe "$name" "$kind" "$rec") asks you: ${msg:-it waits for your answer}
Answer me here in your own words."
        fi ;;
      done)
        [ "$kind" = session ] || continue
        # Hide first, then shorten: a cut through a token would keep part of it visible.
        text="$(cmd_last_text "$name" | redact | head -c 1200)"
        tell_owner "$(describe "$name" "$kind" "$rec") is done.
${text:-It wrote no summary.}" ;;
    esac
  done < <(hc events --json 2>/dev/null)
}

action="${1:-}"
[ $# -eq 0 ] || shift
case "$action" in
  supervise) cmd_supervise ;;
  up) cmd_up ;;
  alive) alive ;;
  hc) hcx "$@" ;;
  ls) cmd_ls "${1:-}" ;;
  attach) cmd_attach "${1:-main}" ;;
  trust) [ $# -eq 1 ] || usage "trust DIR"; cmd_trust "$1" ;;
  state) [ $# -eq 1 ] || usage "state NAME"; term_state "$1" ;;
  redact) redact ;;
  watch) cmd_watch ;;
  status) [ $# -eq 1 ] || usage "status NAME"; status_of "$1" ;;
  last-text) [ $# -eq 1 ] || usage "last-text NAME"; cmd_last_text "$1" ;;
  *) usage "supervise | up | alive | hc ARGS | ls [--json] | attach [NAME] | watch | status NAME | last-text NAME" ;;
esac
