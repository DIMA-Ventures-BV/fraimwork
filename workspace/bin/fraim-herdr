#!/usr/bin/env bash
# herdr-core (hc) on the server: the terminals every Claude session lives in (docs/sessions.md).
# The core runs in the workspace container only. The scheduler container shares the home
# volume, so it reaches the same core through its socket, but it must never start a second
# core of its own (any hc command starts one when none answers).
#
#   fraim-herdr supervise        workspace only: keep the core, main, the queue page and the
#                                watcher running (started by fraim-entrypoint)
#   fraim-herdr up               workspace only: start what is missing once
#   fraim-herdr alive            exit 0 when the core answers (never starts one)
#   fraim-herdr hc ARGS...       run hc; in the scheduler only when the core answers
#   fraim-herdr open NAME KIND DIR [--label K=V]... [-- CMD...]
#                                (re)open terminal NAME in DIR, labelled fraim=KIND, in the
#                                background with no parent; no CMD opens a shell
#   fraim-herdr send NAME TEXT   type TEXT and Enter; on a question it is the answer, a
#                                permission prompt is refused (the owner answers it on screen)
#   fraim-herdr ls [--json]      the fraim terminals: name, kind, status, folder
#   fraim-herdr attach [NAME]    humans: main (default), g3, s1, or a plain shell that stays
#   fraim-herdr watch            tell the owner when a session needs them or a session finished
#   fraim-herdr confirm-channel [--once]  press Enter on the WhatsApp channel prompt of main
#   fraim-herdr heal             one repair pass: restart main when WhatsApp cannot reach it
#   fraim-herdr status ADDR      the terminal's status word (working, done, blocked, idle, ...)
#   fraim-herdr state NAME       live, finished, gone or unknown (the core did not answer)
#   fraim-herdr trust DIR        mark a folder trusted for Claude Code (atomic ~/.claude.json write)
#   fraim-herdr redact           hide tokens and keys in stdin
#   fraim-herdr last-text ADDR   the last thing Claude said in that terminal (from its transcript)
#   fraim-herdr last-text --session ID   the same, by Claude's session id
#   fraim-herdr transcript ID    the path of Claude's transcript for that session id
#   fraim-herdr space            the Herdr app space for fraim's agents, when a laptop linked one
#                                (`fraim herdr link` writes ~/.config/fraim/herdr-space)
# Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail

# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true

usage() { echo "fraim-herdr: $*" >&2; exit 2; }
here="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
die() { echo "fraim-herdr: $*" >&2; exit 1; }

session="${HC_SESSION:-default}"
socket_path() {
  if [ -n "${HC_SOCKET:-}" ]; then printf '%s' "$HC_SOCKET"; return; fi
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then printf '%s/herdr-core/%s.sock' "$XDG_RUNTIME_DIR" "$session"; return; fi
  if [ -d "/run/user/$(id -u)" ]; then printf '/run/user/%s/herdr-core/%s.sock' "$(id -u)" "$session"; return; fi
  printf '%s/herdr-core/%s/%s.sock' "${XDG_STATE_HOME:-$HOME/.local/state}" "$session" "$session"
}

# Asks the core for its terminal list over the socket; hc itself would start a core.
alive() {
  local sock
  sock="$(socket_path)"
  [ -S "$sock" ] || return 1
  python3 - "$sock" <<'EOF' 2>/dev/null
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
s.connect(sys.argv[1])
s.sendall(b'{"jsonrpc":"2.0","id":1,"method":"terminal.list","params":{}}\n')
buf = b""
while b"\n" not in buf:
    chunk = s.recv(65536)
    if not chunk:
        break
    buf += chunk
sys.exit(0 if "result" in json.loads(buf.split(b"\n")[0]) else 1)
EOF
}

in_workspace() { [ "${FRAIM_ROLE:-workspace}" = workspace ]; }

# A run without the owner (goals, leads, automations: FRAIM_HEADLESS=1) may drive goals,
# which run headless too, but never type into main or a coding session: those act as the
# owner, so a goal that read a hostile page could use them to approve its own work.
# Reading (ls, get, read, wait, events) stays open.
headless_allows() {
  [ "${FRAIM_HEADLESS:-}" = 1 ] || return 0
  local sub="$1" target="" program=(); shift
  case "$sub" in
    ls|get|read|wait|events|schema|templates|--version|-V) return 0 ;;
    run)
      while [ $# -gt 0 ]; do
        case "$1" in
          --name) target="${2:-}"; shift 2; continue ;;
          --) shift; program=("$@"); break ;;
        esac
        shift
      done ;;
    send|keys|kill|rm|interrupt|put|label|keep|attach)
      for a in "$@"; do case "$a" in -*) ;; *) target="$a"; break ;; esac; done ;;
  esac
  case "$target" in
    lead-*) lead_run_allowed "$sub" "$target" ${program[@]+"${program[@]}"} ;;
    *) printf '%s' "$target" | grep -Eq '^g[0-9]{1,6}$' ;;
  esac
}

# The terminal of a lead's run (fraim-lead run) is started, ended and removed only by that
# lead's own runner, never typed into. It may run nothing but unattended Claude with a tool
# list, so the name is no way to a shell without the owner's yes.
lead_term_of() {
  local term="lead-$1"
  [ "${#term}" -le 32 ] || term="lead-${1:0:20}-$(printf '%s' "$1" | cksum | cut -c1-6)"
  printf '%s' "$term"
}
lead_run_allowed() {
  local sub="$1" target="$2"; shift 2
  [ -n "${FRAIM_LEAD_NAME:-}" ] && [ "$target" = "$(lead_term_of "$FRAIM_LEAD_NAME")" ] || return 1
  case "$sub" in
    kill|rm) return 0 ;;
    run) ;;
    *) return 1 ;;
  esac
  [ "${1:-}" = env ] && shift
  # Only what fraim-lead passes: FRAIM_TOOL_LISTS=open or FRAIM_PERMISSIONS=ask would lift the list.
  while [ $# -gt 0 ] && [[ "$1" =~ ^FRAIM_(LEAD_NAME|THREAD|BUILDS_OFF)= ]]; do shift; done
  [ "${1:-}" = fraim-claude ] && [ "${2:-}" = --fraim-unattended ] || return 1
  local a
  for a in "$@"; do
    case "$a" in --dangerously-skip-permissions|--permission-mode|--fraim-unattended=*) return 1 ;; esac
  done
  for a in "$@"; do [ "$a" != --allowedTools ] || return 0; done
  return 1
}

hcx() {
  headless_allows "$@" \
    || die "a run without the owner may only drive goals, not main or a coding session"
  if ! in_workspace && ! alive; then
    die "the session service (herdr) does not answer in the workspace container; run: fraim restart workspace"
  fi
  exec hc "$@"
}

# live, finished, gone (no such terminal: hc exit 3) or unknown (the core did not answer).
# Only gone or finished may be replaced: a busy core must never cost a running Claude.
term_state() {
  local rec rc
  # Outside the workspace (the scheduler) hc would start a core of its own: ask only a live one.
  in_workspace || alive || { echo unknown; return; }
  rec="$(hc get "$1" --json 2>/dev/null)"
  rc=$?
  if [ "$rc" -eq 3 ]; then echo gone; return; fi
  if [ "$rc" -ne 0 ]; then echo unknown; return; fi
  jq -r '.state // "unknown"' <<<"$rec" 2>/dev/null || echo unknown
}
live() { [ "$(term_state "$1")" = live ]; }

status_of() { hcx get "$1" --json 2>/dev/null | jq -r '.status.state // "none"'; }

# Claude Code asks once per folder whether to trust it, and a session nobody watches would
# wait there. Running Claudes rewrite ~/.claude.json too: write a copy next to it and rename
# it into place, so no reader ever sees a half-written file.
cmd_trust() {
  local dir="$1" state="$HOME/.claude.json" tmp
  [ -s "$state" ] || echo '{}' > "$state"
  jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$state" >/dev/null 2>&1 && return 0
  tmp="$(mktemp "$state.XXXXXX")" || return 1
  if jq --arg d "$dir" '.projects[$d].hasTrustDialogAccepted = true' "$state" > "$tmp" 2>/dev/null; then
    chmod 0600 "$tmp"
    mv -f "$tmp" "$state"
  else
    rm -f "$tmp"
    return 1
  fi
}

# Tokens and keys a session may have printed never go out in a WhatsApp message.
redact() {
  sed -E \
    -e 's/(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})/[hidden]/g' \
    -e 's/(([A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|PRIVATE_KEY))["'"'"']?[[:space:]]*[:=][[:space:]]*)["'"'"']?[^[:space:]"'"'"']{6,}/\1[hidden]/gI'
}

# Every fraim terminal opens here. A finished terminal with this name blocks a new one with
# the same name: remove it first.
open_term() {
  local name="$1" kind="$2" cwd="$3" labels=(); shift 3
  while [ "${1:-}" = --label ]; do labels+=(--label "$2"); shift 2; done
  [ "${1:-}" != -- ] || shift
  # With a linked Herdr app (fraim herdr link), goals and coding sessions show in fraim's
  # space there. main (the chief) does not: fraim's layout shows it in its own column, and as
  # a tab it could be closed, which ends it.
  case "$kind" in
    goal|session)
      local space
      space="$(cmd_space)"
      [ -z "$space" ] || labels+=(--label "herdr.space=$space") ;;
  esac
  local run=(hc run --bg --name "$name" --cwd "$cwd" --label "fraim=$kind" ${labels[@]+"${labels[@]}"} --no-parent --no-notify)
  [ $# -eq 0 ] || run+=(-- "$@")
  hc rm "$name" >/dev/null 2>&1 || true
  "${run[@]}" >/dev/null
}

cmd_open() {
  [ $# -ge 3 ] || usage "open NAME KIND DIR [--label K=V]... [-- CMD...]"
  headless_allows run --name "$1" \
    || die "a run without the owner may only drive goals, not main or a coding session"
  in_workspace || alive || die "the session service (herdr) does not answer in the workspace container; run: fraim restart workspace"
  open_term "$@"
}

# On a question (AskUserQuestion) the text is the answer. A permission prompt is never
# answered this way: typed text plus Enter would pick its default, "Yes".
cmd_send() {
  [ $# -eq 2 ] || usage "send NAME TEXT"
  local name="$1" text="$2" status force=()
  headless_allows send "$name" \
    || die "a run without the owner may only drive goals, not main or a coding session"
  in_workspace || alive || die "the session service (herdr) does not answer in the workspace container; run: fraim restart workspace"
  status="$(hc get "$name" --json 2>/dev/null | jq -c '.status // {}')"
  if [ "$(jq -r '.state // ""' <<<"$status")" = blocked ]; then
    [ "$(jq -r '.kind // ""' <<<"$status")" = question ] \
      || die "$name waits for a permission, not a question; the owner answers it on the screen (fraim shell $name)"
    force=(--force)
  fi
  hc send ${force[@]+"${force[@]}"} "$name" "$text" >/dev/null
}

start_service() {
  local name="$1" kind="$2" state; shift 2
  state="$(term_state "$name")"
  case "$state" in
    live) return 0 ;;
    unknown) echo "fraim-herdr: $name: the core did not answer; not touching it" >&2; return 1 ;;
  esac
  open_term "$name" "$kind" "$HOME/fraim" -- "$@"
}

cmd_up() {
  in_workspace || die "the session service runs in the workspace container only"
  mkdir -p "$HOME/.local/state/fraim" "$HOME/fraim"
  hc server status >/dev/null 2>&1 || die "herdr-core did not start"
  local failed=0
  start_service main main fraim-session || failed=1
  local name command
  while read -r name command; do
    case "$name" in ''|'#'*) continue ;; esac
    printf '%s' "$name" | grep -Eq '^[a-z][a-z0-9-]{0,31}$' || { echo "fraim-herdr: bad service name '$name'" >&2; failed=1; continue; }
    start_service "$name" service bash -c "while true; do $command 2>>~/.local/state/fraim/$name.log; sleep 5; done" || failed=1
  done < "$(services_file)"
  return "$failed"
}

services_file() {
  local f
  for f in "$HOME/fraim/services" /etc/fraim/services "$here/../services"; do
    [ -f "$f" ] && { printf '%s' "$f"; return; }
  done
  printf '/dev/null'
}

# The screen keeps old prompts above the current one, so only a prompt on the last lines counts.
at_channel_prompt() {
  local bottom
  bottom="$(hc read main --lines 0 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 5)"
  grep -q 'Enter to confirm' <<<"$bottom" && grep -q '❯.*local development' <<<"$bottom"
}

cmd_confirm_channel() {
  while true; do
    if at_channel_prompt; then hc keys main enter >/dev/null 2>&1; fi
    [ "${1:-}" != --once ] || return 0
    sleep "${FRAIM_CONFIRM_POLL:-2}"
  done
}

has_whatsapp() { case ",${FRAIM_MODULES:-}," in *,whatsapp,*) return 0 ;; *) return 1 ;; esac; }
logged_in() { [ -s "$HOME/.claude/.credentials.json" ] || [ -s "$HOME/.config/fraim/claude-token" ]; }

# Main listens to WhatsApp through its channel. No listener for a few checks in a row means
# messages only pile up: restart main. A working main finishes first, and after a few failed
# restarts the owner hears it once. The state file holds: misses restarts.
cmd_heal() {
  in_workspace || return 0
  has_whatsapp && logged_in || return 0
  local listeners state="$HOME/.local/state/fraim/heal-main" misses=0 restarts=0
  # Empty when the gateway does not answer: that is whatsapp-connected's problem, not main's.
  listeners="$(fraim-gateway GET /status 2>/dev/null | jq -r '.listeners // empty' 2>/dev/null)"
  [ -n "$listeners" ] || return 0
  if [ "$listeners" -gt 0 ]; then rm -f "$state"; return 0; fi
  if [ -f "$state" ]; then read -r misses restarts < "$state"; fi
  misses=$((misses + 1))
  mkdir -p "$(dirname "$state")"
  if [ "$misses" -ge "${FRAIM_HEAL_MISSES:-4}" ] && [ "$(status_of main)" != working ]; then
    if [ "$restarts" -lt "${FRAIM_HEAL_RESTARTS:-3}" ]; then
      echo "fraim-herdr: WhatsApp cannot reach main; restarting it" >&2
      hc kill main >/dev/null 2>&1 || true
      restarts=$((restarts + 1))
      misses=0
    elif [ "$restarts" -eq "${FRAIM_HEAL_RESTARTS:-3}" ]; then
      tell_owner "$(say notice-whatsapp-down)"
      restarts=$((restarts + 1))
    fi
  fi
  printf '%s %s\n' "$misses" "$restarts" > "$state"
}

cmd_supervise() {
  in_workspace || die "the session service runs in the workspace container only"
  while true; do
    cmd_up 2>>"$HOME/.local/state/fraim/herdr.log" || true
    cmd_heal 2>>"$HOME/.local/state/fraim/herdr.log" || true
    # A goal whose watcher process died (a container restart) gets a new one.
    fraim-goal reconcile >/dev/null 2>>"$HOME/.local/state/fraim/herdr.log" || true
    # Memory running low: close idle goal and coding-session terminals before it runs out.
    fraim-capacity check || fraim-capacity reclaim >/dev/null 2>&1 || true
    sleep "${FRAIM_HERDR_CHECK:-30}"
  done
}

# fraim shell [NAME]: main, a goal (g3), a coding session (s1), or a plain shell that stays.
cmd_attach() {
  local name="${1:-main}"
  [ -t 0 ] && [ -t 1 ] || usage "attach is for a person in a terminal"
  printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]{0,31}$' || usage "'$name' is not a session name"
  case "$name" in
    g[0-9]*) exec fraim-goal attach "$name" ;;
    s[0-9]*) exec fraim-sessions attach "$name" ;;
  esac
  case "$(term_state "$name")" in
    live) ;;
    unknown) die "the session service does not answer; try again in a minute" ;;
    *)
    [ "$name" != main ] || die "the main session is not running; run: fraim restart workspace"
    open_term "$name" shell "$HOME" || die "could not open $name" ;;
  esac
  echo "Leave with Ctrl+\\ ($name keeps running)."
  exec hc attach "$name"
}

# hc ls gives a short record per terminal (status as one word, no labels): list each kind by
# its label, and ask the full record (hc get) only for a blocked one, for its question.
cmd_ls() {
  local json='[]' kind part row name
  for kind in main goal session shell; do
    part="$(hcx ls --label "fraim=$kind" --json 2>/dev/null)" || die "could not list the sessions"
    json="$(jq --arg k "$kind" --argjson p "$part" '. + [$p.terminals[] | {name: (.name // .address), kind: $k, status: (.status // "none"), question: "", cwd, turn}]' <<<"$json")"
  done
  for name in $(jq -r '.[] | select(.status == "blocked") | .name' <<<"$json"); do
    row="$(hc get "$name" --json 2>/dev/null | jq -r '.status.msg // ""')"
    json="$(jq --arg n "$name" --arg q "$row" 'map(if .name == $n then .question = $q else . end)' <<<"$json")"
  done
  if [ "${1:-}" = --json ]; then printf '%s\n' "$json"; return 0; fi
  [ "$(jq length <<<"$json")" -gt 0 ] || { echo "No sessions."; return 0; }
  jq -r --arg h "$HOME/" '.[] | "\(.name)\t\(.kind)\t\(.status)\t\(.cwd | if startswith($h) then "~/" + .[($h | length):] else . end)\(if .question != "" then "\t" + .question else "" end)"' <<<"$json"
}

transcript_file() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_-]{1,64}$' || return 0
  find "$HOME/.claude/projects" -maxdepth 2 -name "$1.jsonl" 2>/dev/null | head -1
}

# Claude Code's transcript for a session id: the last text it wrote (empty when none yet).
transcript_text() {
  local sid="$1" file
  [ -n "$sid" ] || return 0
  file="$(transcript_file "$sid")"
  [ -n "$file" ] || return 0
  jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // ""' "$file" 2>/dev/null
}

# Exit 0 when Claude in this terminal still has a shell running: a background task it
# started (an install, a test run) that it waits for, even though its turn ended. Asked through
# the core (hc exec), so it works from the scheduler container too.
cmd_busy() {
  local rec pid
  in_workspace || alive || return 1
  rec="$(hc get "$1" --json 2>/dev/null)" || return 1
  pid="$(jq -r '.foreground.pid // empty' <<<"$rec")"
  [ -n "$pid" ] || return 1
  hc exec ps -o comm= --ppid "$pid" 2>/dev/null | grep -qxE 'bash|sh|dash|zsh'
}

cmd_space() {
  local id
  id="$(head -1 "${FRAIM_HERDR_SPACE_FILE:-$HOME/.config/fraim/herdr-space}" 2>/dev/null | tr -d '[:space:]')"
  printf '%s' "$id" | grep -Eq '^sp[0-9a-f]{8,64}$' || return 0
  printf '%s\n' "$id"
}

# Goals and sessions carry Claude's session id as label sid (fraim-goal, fraim-sessions).
cmd_last_text() {
  [ "$1" != --session ] || { transcript_text "${2:-}"; return; }
  transcript_text "$(hc get "$1" --json 2>/dev/null | jq -r '.labels.sid // ""')"
}

tell_owner() { FRAIM_NOTIFY_NO_ALERT=1 fraim-notify "$1" >/dev/null 2>&1 || true; }
# The words the owner hears are prompt files (notice-*.md) the owner can change.
say() { local name="$1"; shift; "$here/fraim-prompt" render "$name" "$@" 2>/dev/null; }
# Who it is in the owner's words: the goal's task (label title) or the session's repo, never an id.
who() { jq -r '"--set\nkind=\(.labels.fraim // "")\n--set\ntitle=\(.labels.title // "")\n--set\nrepo=\(.labels.repo // "")"' <<<"$1"; }

# Follows status changes. Blocked (a question or a permission) reaches the owner for every
# kind; a coding session that finished a turn reaches the owner too. Goals send their own
# result (fraim-goal), main answers on WhatsApp itself.
cmd_watch() {
  in_workspace || die "the watcher runs in the workspace container only"
  declare -A last=()
  local line type addr state rec name kind msg text whom
  while IFS= read -r line; do
    type="$(jq -r '.params.type // empty' <<<"$line" 2>/dev/null)"
    [ "$type" = status ] || continue
    addr="$(jq -r '.params.terminal // empty' <<<"$line")"
    state="$(jq -r '.params.data.status.state // "none"' <<<"$line")"
    [ -n "$addr" ] || continue
    [ "${last[$addr]:-}" != "$state" ] || continue
    last[$addr]="$state"
    rec="$(hc get "$addr" --json 2>/dev/null)" || continue
    name="$(jq -r '.name // .address' <<<"$rec")"
    kind="$(jq -r '.labels.fraim // ""' <<<"$rec")"
    # A lead's run ends itself on a question or an error, and its runner tells the owner.
    [ -n "$kind" ] && [ "$kind" != service ] && [ "$kind" != lead ] || continue
    case "$state" in
      blocked)
        msg="$(jq -r '.params.data.status.msg // ""' <<<"$line")"
        if [ "$kind" = main ]; then
          # fraim-session confirms the WhatsApp channel prompt at every start; only a
          # screen that stays blocked for a minute needs the owner.
          (
            sleep "${FRAIM_MAIN_BLOCKED_GRACE:-60}"
            [ "$(status_of "$addr")" = blocked ] \
              && tell_owner "$(say notice-main-blocked --set "question=$msg")"
          ) &
        else
          msg="$(printf '%s' "${msg#answer: }" | redact)"
          mapfile -t whom < <(who "$rec")
          tell_owner "$(say notice-asks "${whom[@]}" --set "question=$msg")"
        fi ;;
      done)
        [ "$kind" = session ] || continue
        # First, so fraim-capacity leaves the session alone while its "done" is written and sent.
        touch "${FRAIM_SESSIONS_DIR:-$HOME/fraim/sessions}/$name/notified" 2>/dev/null || true
        # Hide first, then shorten: a cut through a token would keep part of it visible.
        text="$(cmd_last_text "$name" | redact | head -c 1200)"
        mapfile -t whom < <(who "$rec")
        tell_owner "$(say notice-session-done "${whom[@]}" --set "text=$text")" ;;
    esac
  done < <(hc events --json 2>/dev/null)
}

action="${1:-}"
[ $# -eq 0 ] || shift
case "$action" in
  supervise) cmd_supervise ;;
  up) cmd_up ;;
  alive) alive ;;
  hc) hcx "$@" ;;
  ls) cmd_ls "${1:-}" ;;
  attach) cmd_attach "${1:-main}" ;;
  open) cmd_open "$@" ;;
  send) cmd_send "$@" ;;
  trust) [ $# -eq 1 ] || usage "trust DIR"; cmd_trust "$1" ;;
  state) [ $# -eq 1 ] || usage "state NAME"; term_state "$1" ;;
  redact) redact ;;
  watch) cmd_watch ;;
  confirm-channel) cmd_confirm_channel "${1:-}" ;;
  heal) cmd_heal ;;
  status) [ $# -eq 1 ] || usage "status NAME"; status_of "$1" ;;
  last-text) [ $# -ge 1 ] || usage "last-text NAME | last-text --session ID"; cmd_last_text "$@" ;;
  transcript) [ $# -eq 1 ] || usage "transcript ID"; transcript_file "$1" ;;
  space) cmd_space ;;
  lead-term) [ $# -eq 1 ] || usage "lead-term NAME"; lead_term_of "$1" ;;
  busy) [ $# -eq 1 ] || usage "busy NAME"; cmd_busy "$1" ;;
  *) usage "supervise | up | alive | hc ARGS | ls [--json] | attach [NAME] | watch | status NAME | last-text NAME | last-text --session ID | transcript ID | space | lead-term NAME" ;;
esac
