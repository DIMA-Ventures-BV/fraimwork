#!/usr/bin/env bash
# Runs a goal: a longer task that works in the background on the server while the
# always-on session stays free. The owner asks for it in plain words on WhatsApp (the
# server's Claude starts it), from the laptop (`fraim goal "..."`) or by asking Claude. The result goes back over WhatsApp.
#
#   fraim-goal start [--chat CHAT_ID] [--lead NAME] [--queue qN] [--] TEXT
#                                                 start in the background, print the id (g1, g2, ...)
#   fraim-goal list                               newest first: id, state, start time, goal
#   fraim-goal show ID                            the goal, its state and its result
#   fraim-goal stop ID
#   fraim-goal send ID TEXT                       a message from the owner into the goal
#                                                 (reopens a finished goal's conversation)
#   fraim-goal read ID [LINES]                    the goal's screen, plus LINES of history
#   fraim-goal attach ID                          humans: take over the goal's terminal
#   fraim-goal reconcile                          give running goals a watcher again
#                                                 (fraim-herdr supervise runs it)
#
# A goal is an interactive Claude Code session in the herdr terminal named after its id
# (docs/sessions.md), so the owner can look in, answer a question or correct it while it
# works. A watcher process (`run`) sends the task, waits for the turn to end, and reports.
# After the result the terminal stays open FRAIM_GOAL_KEEP seconds (default 1800) for
# follow-ups; later, send reopens the same conversation (claude --resume).
#
# Each goal lives in ~/fraim/goals/<id>/: goal.md, state, result.md, log.txt, session-id,
# heartbeat (the watcher touches it), and media/ (screenshots and recordings). When it
# ends, its result goes into the owner's review queue (fraim-queue) with the media;
# queue.json from the run sets the title and priority.
# A goal started by a lead (--lead) counts toward that lead's daily budget
# (~/fraim/leads/<name>/budget, default 3); follow-up work the owner asked for in the queue
# does not.
# Tools: ~/fraim/goals/tools (one per line) or the default below. With PERMISSIONS=all (the
# default) a goal is not limited to this list: it is a live session with a full shell anyway.
# Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail

# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true
# The WhatsApp channel starts goals without a login shell; keep the server's time zone.
[ -z "${TZ:-}" ] || export TZ

goals="${FRAIM_GOALS_DIR:-$HOME/fraim/goals}"
DEFAULT_TOOLS="Read,Glob,Grep,Edit,Write,WebSearch,Bash,mcp__browser"

usage() { echo "fraim-goal: $*" >&2; exit 2; }
die() { echo "fraim-goal: $*" >&2; exit 1; }

valid_id() { printf '%s' "$1" | grep -Eq '^g[0-9]{1,6}$'; }
goal_dir() { valid_id "$1" || usage "'$1' is not a goal id (g1, g2, ...)"; [ -d "$goals/$1" ] || die "no goal $1"; printf '%s' "$goals/$1"; }
state_of() { cut -d' ' -f1 "$1/state" 2>/dev/null || echo unknown; }
# The watcher may run in the other container (the scheduler starts goals for leads), so a
# pid says nothing here: a heartbeat younger than three minutes means it runs.
alive() {
  local beat
  [ -f "$1/heartbeat" ] || return 1
  beat="$(stat -c %Y "$1/heartbeat" 2>/dev/null || stat -f %m "$1/heartbeat" 2>/dev/null || echo 0)"
  [ $(( $(date +%s) - beat )) -lt "${FRAIM_GOAL_HEARTBEAT:-180}" ]
}
hc() { fraim-herdr hc "$@"; }
term_get() { hc get "$1" --json 2>/dev/null; }
# live, finished, gone or unknown (the core did not answer). Only gone or finished may be
# replaced or failed: a busy core must never cost a working goal.
term_state() { fraim-herdr state "$1" 2>/dev/null || echo unknown; }
term_live() { [ "$(term_state "$1")" = live ]; }
new_uuid() { cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())'; }

tools() {
  if [ -f "$goals/tools" ]; then
    grep -v '^\s*#' "$goals/tools" | grep -v '^\s*$' | paste -sd, -
  else
    printf '%s' "$DEFAULT_TOOLS"
  fi
}

# Sends the outcome to the chat the goal came from, or to the owner. With a chief of staff,
# fraim-notify hands it to the chief, who writes what the owner reads.
tell() {
  FRAIM_NOTIFY_NO_ALERT=1 FRAIM_NOTIFY_CHAT="$1" fraim-notify "$2"
}

# Goals a lead started today, rework from the queue not counted.
lead_goals_today() {
  local lead="$1" today dir n=0
  today="$(date '+%Y-%m-%d')"
  for dir in "$goals"/g*/; do
    [ -f "$dir/lead" ] && [ "$(cat "$dir/lead")" = "$lead" ] || continue
    [ ! -f "$dir/by-owner" ] || continue
    [ "$(cut -d' ' -f2 "$dir/state" 2>/dev/null)" = "$today" ] && n=$((n + 1))
  done
  printf '%s' "$n"
}

cmd_start() {
  local chat="" lead="" queue="" thread="${FRAIM_THREAD:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --thread) thread="${2:-}"; shift 2 || usage "--thread needs a conversation id" ;;
      --chat) chat="${2:-}"; shift 2 || usage "--chat needs a chat id" ;;
      --lead) lead="${2:-}"; shift 2 || usage "--lead needs a name" ;;
      --queue) queue="${2:-}"; shift 2 || usage "--queue needs a queue id" ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local text="$*"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage 'start [--chat CHAT_ID] [--lead NAME] [--queue qN] "what to do"'
  [ -z "$lead" ] || printf '%s' "$lead" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$' || usage "'$lead' is not a lead name"
  [ -z "$queue" ] || printf '%s' "$queue" | grep -Eq '^q[0-9]{1,6}$' || usage "'$queue' is not a queue id"
  mkdir -p "$goals"
  # The owner's decision in the queue (fraim-queue sets this) is not the lead's own budget.
  local by_owner=0
  [ "${FRAIM_GOAL_FROM_QUEUE:-}" = 1 ] && [ -n "$queue" ] && by_owner=1
  if [ -n "$lead" ] && [ "$by_owner" = 0 ]; then
    local budget used
    budget="$(tr -dc 0-9 2>/dev/null < "${FRAIM_LEADS_DIR:-$HOME/fraim/leads}/$lead/budget")"
    budget="${budget:-${FRAIM_LEAD_GOALS_PER_DAY:-3}}"
    used="$(lead_goals_today "$lead")"
    [ "$used" -lt "$budget" ] || die "lead $lead already started $used of its $budget goals today; add an idea to the queue instead"
  fi
  local n=1 id
  [ -s "$goals/.last" ] && n=$(( $(cat "$goals/.last") + 1 ))
  until mkdir "$goals/g$n" 2>/dev/null; do n=$((n + 1)); done
  id="g$n"
  printf '%s\n' "$n" > "$goals/.last"
  printf '%s\n' "$text" > "$goals/$id/goal.md"
  printf '%s\n' "$chat" > "$goals/$id/chat"
  [ -z "$lead" ] || printf '%s\n' "$lead" > "$goals/$id/lead"
  [ -z "$queue" ] || printf '%s\n' "$queue" > "$goals/$id/queue"
  ! printf '%s' "$thread" | grep -Eq '^t[0-9]{1,6}$' || printf '%s\n' "$thread" > "$goals/$id/thread"
  [ "$by_owner" = 0 ] || : > "$goals/$id/by-owner"
  printf 'running %s\n' "$(date '+%Y-%m-%d %H:%M')" > "$goals/$id/state"
  new_uuid > "$goals/$id/session-id"
  touch "$goals/$id/heartbeat"
  spawn_watcher "$id" run
  printf '%s\n' "$id"
}

# Starts the watcher (`run`: launch, send the task, report; `follow`: only report) apart
# from the caller, so a WhatsApp reply or an ssh session can end.
spawn_watcher() {
  local id="$1" mode="$2" self
  self="$(command -v "$0" 2>/dev/null || printf '%s' "$0")"
  # Every inherited descriptor closed, so a caller waiting on its own pipes is never held.
  if command -v setsid >/dev/null; then
    setsid "$self" "$mode" "$id" </dev/null >/dev/null 2>&1 3>&- &
  else
    nohup "$self" "$mode" "$id" </dev/null >/dev/null 2>&1 3>&- &
  fi
}

# What a goal is told is the prompt file "goal" (fraim-prompt).
prompt_for() {
  local id="$1" text="$2" lead
  lead="$(cat "$goals/$id/lead" 2>/dev/null)"
  local args=()
  [ -z "$lead" ] || args+=(--lead "$lead")
  fraim-prompt render goal ${args[@]+"${args[@]}"} --set "id=$id" --set "text=$text" \
    --set "rules=$(fraim-brain show --for "$lead" 2>/dev/null)" \
    --set "style_queue=$(style_block queue)" --set "style_whatsapp=$(style_block whatsapp)"
}

style_block() { command -v fraim-style >/dev/null || return 0; fraim-style prompt "$1" 2>/dev/null || true; }

# A queue title the owner can read: a goal started from a queue decision begins with
# 'The owner approved queue item q22 ("Topic"). Do this...' (and a retry with "Failed: ...");
# the topic is what matters.
plain_title() {
  local t="$1" inner
  while :; do
    inner="$(printf '%s' "$t" | sed -n 's/^\(Failed: \)*The owner approved\( queue item\)\{0,1\} q[0-9]* ("\(.*\)").*$/\3/p')"
    [ -n "$inner" ] || inner="$(printf '%s' "$t" | sed -n 's/^\(Failed: \)*The owner approved\( queue item\)\{0,1\} q[0-9]* ("\(.*\)$/\3/p')"
    [ -n "$inner" ] && [ "$inner" != "$t" ] || break
    t="$inner"
  done
  t="${t#Failed: }"
  t="${t#The owner approved: }"
  printf '%s' "$t" | cut -c1-100
}

# Puts the result into the review queue and prints the queue id (nothing without fraim-queue).
to_queue() {
  local id="$1" dir="$2" failed="$3" meta='{}' title kind priority on_approve link file
  command -v fraim-queue >/dev/null || return 0
  if [ -s "$dir/queue.json" ] && jq -e 'type == "object"' "$dir/queue.json" >/dev/null 2>&1; then meta="$(cat "$dir/queue.json")"; fi
  title="$(jq -r '.title // "" | tostring' <<<"$meta" | head -1 | cut -c1-120)"
  [ -n "$title" ] || title="$(plain_title "$(head -1 "$dir/goal.md")")"
  kind="$(jq -r '.kind // "review" | tostring' <<<"$meta")"
  case "$kind" in review|decision) ;; *) kind=review ;; esac
  priority="$(jq -r '.priority // 2 | tostring' <<<"$meta")"
  case "$priority" in 1|2|3) ;; *) priority=2 ;; esac
  on_approve="$(jq -r '.on_approve // "" | tostring' <<<"$meta")"
  if [ "$failed" = 1 ]; then kind=failed priority=1 on_approve="" title="Failed: $title"; fi
  local args=(add --quiet --result --goal "$id" --title "$title" --kind "$kind" --priority "$priority" --summary-file "$dir/result.md")
  [ ! -s "$dir/lead" ] || args+=(--lead "$(cat "$dir/lead")")
  [ ! -s "$dir/queue" ] || args+=(--continues "$(cat "$dir/queue")")
  [ -z "$on_approve" ] || args+=(--on-approve "$on_approve")
  if [ "$failed" != 1 ]; then
    local ask advise why f v
    ask="$(jq -r '.ask // "" | tostring' <<<"$meta" | head -1 | cut -c1-300)"
    advise="$(jq -r '.advise // "" | tostring' <<<"$meta")"
    [ -z "$ask" ] || args+=(--ask "$ask")
    for f in need if_yes if_no; do
      v="$(jq -r --arg f "$f" '.[$f] // "" | tostring' <<<"$meta" | head -1 | cut -c1-400)"
      [ -z "$v" ] || args+=("--${f//_/-}" "$v")
    done
    case "$advise" in approve|reject|dismiss) args+=(--advise "$advise") ;; esac
    while IFS= read -r why; do
      [ -z "$why" ] || args+=(--why "$why")
    done < <(jq -r '.why // [] | if type == "array" then .[] else . end | tostring' <<<"$meta" 2>/dev/null | head -3)
  else
    args+=(--ask "Try this task again?" --advise approve --why "The run stopped before it was done; the details say why."
      --need "The task you asked for is not finished." --if-yes "I start it again and build on what is already done."
      --if-no "It stays unfinished; nothing else changes."
      --on-approve "Try this task again and finish it, building on the earlier notes: $(head -c 1500 "$dir/goal.md")")
  fi
  while IFS= read -r link; do
    [ -z "$link" ] || args+=(--link "$link")
  done < <(jq -r '.links // [] | if type == "array" then .[] else empty end | tostring' <<<"$meta" 2>/dev/null | head -10)
  for file in "$dir"/media/*; do
    [ -f "$file" ] && args+=(--media "$file")
  done
  fraim-queue "${args[@]}" 2>>"$dir/log.txt" || true
  [ "$failed" = 1 ] && return 0
  local question extra=(--quiet --result --goal "$id" --kind decision --priority "$priority")
  [ ! -s "$dir/lead" ] || extra+=(--lead "$(cat "$dir/lead")")
  while IFS= read -r question; do
    [ -n "$question" ] || continue
    fraim-queue add "${extra[@]}" --title "$(cut -c1-120 <<<"$question")" --ask "$(cut -c1-300 <<<"$question")" \
      --summary "From goal $id. The full report is on the goal's main item." \
      --on-approve "The owner approved this, from goal $id: $question" >/dev/null 2>>"$dir/log.txt" || true
  done < <(jq -r '.more // [] | if type == "array" then .[] else empty end | tostring' <<<"$meta" 2>/dev/null | head -3)
}


# Why a goal stopped early, from the text it ended on; empty when it looks like a result.
# Claude's own error lines are short; a real result that discusses rate limits or OAuth
# tokens is longer and must not count as a failure. A screen (second argument "screen") is
# long by nature and is checked whole: it only shows when the session already stopped.
fail_reason() {
  [ "${2:-}" = screen ] || [ "${#1}" -le "${FRAIM_GOAL_ERROR_MAX:-400}" ] || return 0
  case "$1" in
    *"Not logged in"*|*"Please run /login"*|*"Invalid API key"*|*"OAuth token"*|*"OAuth session"*|*"could not be refreshed"*|*"authentication_error"*|*"API Error: 401"*|*"401 Unauthorized"*|*"invalid_grant"*|*"ession expired"*)
      echo "the server is not signed in to Claude" ;;
    *"usage limit"*|*"Usage limit"*|*"rate limit"*|*"limit reached"*)
      echo "the Claude plan's usage limit was reached" ;;
  esac
}

heartbeat() { touch "$1/heartbeat"; }
screen_text() { hc read "$1" --lines "${2:-40}" 2>/dev/null; }
reported_turn() { tr -dc 0-9 < "$1/turn" 2>/dev/null || echo 0; }
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

# Messages that did not go out wait in unsent and are tried again on every watcher round;
# whatever is left when the watcher ends goes to the alerts (fraim status shows them).
deliver() {
  local chat="$1" dir="$2" text="$3"
  if tell "$chat" "$text"; then return 0; fi
  printf '%s\n\n' "$text" >> "$dir/unsent"
}
retry_unsent() {
  local chat="$1" dir="$2" text
  [ -s "$dir/unsent" ] || return 0
  text="$(cat "$dir/unsent")"
  tell "$chat" "$text" && rm -f "$dir/unsent"
}

# Opens the goal's terminal: a new conversation, or the same one again (--resume). It works
# in its own folder: main runs `claude --continue` in ~/fraim, which would otherwise pick up
# a goal's conversation as its own.
launch() {
  local id="$1" dir="$2" resume="${3:-}" sid
  sid="$(cat "$dir/session-id" 2>/dev/null)"
  [ -n "$sid" ] || { sid="$(new_uuid)"; printf '%s\n' "$sid" > "$dir/session-id"; }
  local args=(env FRAIM_HEADLESS=1 "FRAIM_GOAL=$id" fraim-claude)
  if [ -n "$resume" ]; then args+=(--resume "$sid"); else args+=(--session-id "$sid"); fi
  args+=(--permission-mode acceptEdits --allowedTools "$(tools)")
  fraim-herdr trust "$dir" 2>>"$dir/log.txt" || true
  wait_for_room "$dir" || return 1
  hc rm "$id" >/dev/null 2>&1 || true
  hc run --bg --name "$id" --cwd "$dir" --label fraim=goal --no-parent --no-notify -- "${args[@]}" \
    >/dev/null 2>>"$dir/log.txt" || return 1
  echo 0 > "$dir/turn"
  # Ready when Claude Code first reports its status.
  hc wait "$id" --timeout "${FRAIM_GOAL_READY:-90}" --json >/dev/null 2>&1 || true
  wait_known "$id" "$dir"
}

# A goal starts only when the server has memory for one more Claude (fraim-capacity); it
# waits in line meanwhile, with its heartbeat, up to its own time limit.
wait_for_room() {
  local dir="$1" start said=""
  command -v fraim-capacity >/dev/null || return 0
  start="$(date +%s)"
  until fraim-capacity admit || { fraim-capacity reclaim && fraim-capacity admit; }; do
    [ $(( $(date +%s) - start )) -lt "${FRAIM_GOAL_TIMEOUT:-14400}" ] || return 1
    if [ -z "$said" ]; then
      printf '%s waiting for free memory\n' "$(date '+%H:%M:%S')" >> "$dir/log.txt"
      said=1
    fi
    heartbeat "$dir"
    sleep "${FRAIM_CAPACITY_POLL:-10}"
  done
}

# The terminal's state, asked again for as long as the core does not answer (busy right after
# a start): an unknown state never fails a goal that may be running fine. The heartbeat keeps
# the goal alive meanwhile; the goal's time limit still ends the wait.
wait_known() {
  local id="$1" dir="$2" state start
  start="$(date +%s)"
  while state="$(term_state "$id")"; [ "$state" = unknown ]; do
    [ $(( $(date +%s) - start )) -lt "${FRAIM_GOAL_TIMEOUT:-14400}" ] || return 1
    heartbeat "$dir"
    sleep 1
  done
  [ "$state" = live ]
}

fail_goal() {
  local id="$1" dir="$2" chat="$3" reason="$4" qid review=""
  [ "$(state_of "$dir")" = stopped ] && return 0
  printf 'failed %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$reason" > "$dir/state"
  { printf 'The goal failed: %s.\n\n' "$reason"; screen_text "$id" 30 | grep -v '^\s*$' | tail -30; } > "$dir/result.md"
  qid="$(to_queue "$id" "$dir" 1)"
  [ -z "$qid" ] || review=" It is queue item $qid. To try again with a change, tell me what to change."
  deliver "$chat" "$dir" "Goal $id failed: $reason. Details: ~/fraim/goals/$id.$review"
  hc kill "$id" >/dev/null 2>&1 || true
}

# A turn ended: its last words are the result. The first result goes to the queue.
report_done() {
  local id="$1" dir="$2" chat="$3" text reason qid review="" summary
  text="$(fraim-herdr last-text "$id" 2>/dev/null)"
  [ -n "$text" ] || text="$(screen_text "$id" 30 | grep -v '^\s*$' | tail -30)"
  reason="$(fail_reason "$text")"
  if [ -n "$reason" ]; then
    fail_goal "$id" "$dir" "$chat" "$reason"
    return 1
  fi
  printf '%s\n' "$text" > "$dir/result.md"
  printf 'done %s\n' "$(date '+%Y-%m-%d %H:%M')" > "$dir/state"
  if [ ! -f "$dir/queued" ]; then
    qid="$(to_queue "$id" "$dir" 0)"
    printf '%s\n' "${qid:-none}" > "$dir/queued"
    # Earlier failed attempts at the same decision are done now: they leave the queue.
    if [ -s "$dir/queue" ] && command -v fraim-queue >/dev/null; then
      fraim-queue supersede --origin "$(cat "$dir/queue")" --by "$id" >/dev/null 2>>"$dir/log.txt" || true
    fi
    [ -z "$qid" ] || review="

It waits for review as queue item $qid. Tell me what you think of it in your own words, or open the queue: $(fraim-queue url 2>/dev/null)"
    summary="Goal $id done.

${text:0:3500}$review"
  else
    summary="Goal $id answered.

${text:0:3500}"
  fi
  # A message that did not go out is not a failed goal: it waits in unsent for the next try.
  deliver "$chat" "$dir" "$summary"
}

# The watcher. run: open the terminal and send the task first. follow: only watch.
cmd_watch() {
  local id="$1" mode="$2" dir chat rec tstate st tturn reason idle_since="" busy_since="" deadline
  dir="$(goal_dir "$id")" || exit $?
  chat="$(cat "$dir/chat" 2>/dev/null || true)"
  heartbeat "$dir"
  # A watcher that ended is not alive, even within the heartbeat window. A message that never
  # went out lands in the alerts, which fraim status reports.
  trap 'rm -f "$dir/heartbeat"; printf "%s watcher ended (%s)\n" "$(date "+%H:%M:%S")" "${why:-?}" >> "$dir/log.txt"; if [ -s "$dir/unsent" ]; then fraim-notify "Not delivered earlier: $(cat "$dir/unsent")" >/dev/null 2>&1; rm -f "$dir/unsent"; fi' EXIT
  local why="" rc misses=0
  deadline=$(( $(date +%s) + ${FRAIM_GOAL_TIMEOUT:-14400} ))
  if [ "$mode" = run ]; then
    if ! launch "$id" "$dir"; then
      fail_goal "$id" "$dir" "$chat" "the Claude session did not start"
      exit 1
    fi
    if ! hc send "$id" "$(prompt_for "$id" "$(cat "$dir/goal.md")")" >/dev/null 2>>"$dir/log.txt"; then
      fail_goal "$id" "$dir" "$chat" "the task could not be sent to the Claude session"
      exit 1
    fi
  fi
  while true; do
    heartbeat "$dir"
    retry_unsent "$chat" "$dir"
    [ "$(state_of "$dir")" = stopped ] && { why=stopped; hc kill "$id" >/dev/null 2>&1; exit 0; }
    rec="$(hc get "$id" --json 2>/dev/null)"
    rc=$?
    # Exit 3 is "no such terminal"; anything else (a busy or restarting core) is retried.
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && [ "$misses" -lt 10 ]; then
      misses=$((misses + 1))
      sleep "${FRAIM_GOAL_POLL:-15}"
      continue
    fi
    misses=0
    [ -n "$rec" ] || rec='{}'
    tstate="$(jq -r '.state // "gone"' <<<"$rec")"
    st="$(jq -r '.status.state // "none"' <<<"$rec")"
    tturn="$(jq -r '.turn // 0' <<<"$rec")"
    if [ "$tstate" != live ]; then
      # Closed after its result (keep time over, or the owner closed it): nothing to report.
      if [ "$(state_of "$dir")" = "done" ] && [ "${tturn:-0}" -le "$(reported_turn "$dir")" ]; then
        why="terminal closed after its result"
        exit 0
      fi
      why="terminal $tstate (get exit $rc)"
      reason="$(fail_reason "$(screen_text "$id")" screen)"
      fail_goal "$id" "$dir" "$chat" "${reason:-the Claude session ended}"
      exit 1
    fi
    case "$st" in
      done|idle)
        # Claude can end a turn while something it started still runs in the background (an
        # install, a test run); it continues when that finishes. Not a result yet. Something
        # that never ends (a dev server) holds the result back no longer than the busy limit.
        if [ "${tturn:-0}" -gt "$(reported_turn "$dir")" ] && fraim-herdr busy "$id" 2>/dev/null; then
          [ -n "$busy_since" ] || busy_since="$(date +%s)"
          if [ $(( $(date +%s) - busy_since )) -lt "${FRAIM_GOAL_BUSY_MAX:-1800}" ]; then
            idle_since=""
            sleep "${FRAIM_GOAL_POLL:-15}"
            continue
          fi
        fi
        busy_since=""
        if [ "${tturn:-0}" -gt "$(reported_turn "$dir")" ]; then
          printf '%s\n' "$tturn" > "$dir/turn"
          if ! report_done "$id" "$dir" "$chat"; then why="the turn ended on an error"; exit 1; fi
          idle_since="$(date +%s)"
        fi
        [ -n "$idle_since" ] || idle_since="$(date +%s)"
        # A message sent since the last turn ended (it may not show as working yet) keeps
        # the terminal open: closing it now would lose that message.
        if [ "$(mtime "$dir/last-send")" -ge "$idle_since" ]; then
          idle_since="$(date +%s)"
        fi
        if [ $(( $(date +%s) - idle_since )) -ge "${FRAIM_GOAL_KEEP:-1800}" ]; then
          if [ "$(reported_turn "$dir")" = 0 ] && [ "$(state_of "$dir")" != "done" ]; then
            why="no turn before the keep time"
            fail_goal "$id" "$dir" "$chat" "Claude did not start on the task"
            exit 1
          fi
          why="keep time over"
          hc kill "$id" >/dev/null 2>&1; hc rm "$id" >/dev/null 2>&1
          exit 0
        fi
        sleep "${FRAIM_GOAL_POLL:-15}"
        continue ;;
      error)
        reason="$(fail_reason "$(screen_text "$id")" screen)"
        fail_goal "$id" "$dir" "$chat" "${reason:-Claude reported an error}"
        exit 1 ;;
      *)
        # working, or blocked (fraim-herdr watch tells the owner; the goal waits for the
        # answer). Either way the time limit holds: a question nobody answers ends too.
        idle_since=""
        busy_since=""
        if [ "$(date +%s)" -ge "$deadline" ]; then
          why="time limit"
          fail_goal "$id" "$dir" "$chat" "it ran longer than ${FRAIM_GOAL_TIMEOUT:-14400} seconds and was stopped"
          exit 1
        fi
        if [ "$st" = blocked ]; then
          sleep "${FRAIM_GOAL_POLL:-15}"
        else
          hc wait "$id" --timeout 60 --json >/dev/null 2>&1 || sleep "${FRAIM_GOAL_POLL:-15}"
        fi ;;
    esac
  done
}

# Live status of goal terminals by name, for list and show (empty when herdr does not answer).
live_statuses() { fraim-herdr ls --json 2>/dev/null || echo '[]'; }

cmd_list() {
  [ -d "$goals" ] || { echo "No goals yet."; return 0; }
  local found="" dir id st live now
  live="$(live_statuses)"
  for id in $(find "$goals" -mindepth 1 -maxdepth 1 -type d -name 'g[0-9]*' -exec basename {} \; | sed 's/^g//' | grep -E '^[0-9]+$' | sort -rn | head -20); do
    dir="$goals/g$id"
    st="$(cat "$dir/state" 2>/dev/null || echo unknown)"
    if [ "${st%% *}" = running ] && ! alive "$dir"; then st="restarting (the server restarted)"; fi
    now="$(jq -r --arg n "g$id" '.[] | select(.name == $n) | if .status == "blocked" then "needs you: " + .question else empty end' <<<"$live" 2>/dev/null)"
    printf 'g%s  %s  %s%s\n' "$id" "$st" "$(head -1 "$dir/goal.md" | cut -c1-80)" "${now:+  ($now)}"
    found=1
  done
  [ -n "$found" ] || echo "No goals yet."
}

cmd_show() {
  local dir now
  dir="$(goal_dir "$1")" || exit $?
  printf 'Goal %s: %s\n\n%s\n' "$1" "$(cat "$dir/state")" "$(cat "$dir/goal.md")"
  now="$(live_statuses | jq -r --arg n "$1" '.[] | select(.name == $n) | "Now: " + .status + (if .question != "" then " (" + .question + ")" else "" end)' 2>/dev/null)"
  [ -z "$now" ] || printf '\n%s\n' "$now"
  [ ! -s "$dir/result.md" ] || printf '\nResult:\n%s\n' "$(cat "$dir/result.md")"
}

cmd_stop() {
  local dir
  dir="$(goal_dir "$1")" || exit $?
  if ! alive "$dir" && ! term_live "$1"; then echo "Goal $1 is not running."; return 0; fi
  printf 'stopped %s\n' "$(date '+%Y-%m-%d %H:%M')" > "$dir/state"
  hc kill "$1" >/dev/null 2>&1 || true
  echo "Goal $1 stopped."
}

# Opens the conversation again when its terminal was closed. Prints nothing.
reopen() {
  local id="$1" dir="$2" state
  state="$(term_state "$id")"
  case "$state" in
    live) return 0 ;;
    unknown) die "the session service does not answer; try again in a minute" ;;
  esac
  # A watcher that is still opening the first terminal: wait for it rather than replace it
  # with a --resume of a conversation that does not exist yet.
  if alive "$dir" && [ "$(state_of "$dir")" = running ] && [ "$(reported_turn "$dir")" = 0 ]; then
    local waited=0
    while [ "$waited" -lt "${FRAIM_GOAL_READY:-90}" ]; do
      term_live "$id" && return 0
      sleep 1
      waited=$((waited + 1))
    done
  fi
  [ -s "$dir/session-id" ] || die "goal $id has no conversation to continue"
  launch "$id" "$dir" --resume || die "could not reopen goal $id"
}

cmd_send() {
  local id="$1" dir text status force=()
  shift
  dir="$(goal_dir "$id")" || exit $?
  text="$*"
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || usage "send ID \"message\""
  case "$(state_of "$dir")" in stopped|failed) [ -s "$dir/session-id" ] || die "goal $id has ended" ;; esac
  reopen "$id" "$dir"
  # On a question (AskUserQuestion) the text is the answer. A permission prompt is never
  # answered this way: typed text plus Enter would pick its default, "Yes".
  status="$(term_get "$id" | jq -c '.status // {}')"
  if [ "$(jq -r '.state // ""' <<<"$status")" = blocked ]; then
    [ "$(jq -r '.kind // ""' <<<"$status")" = question ] \
      || die "goal $id waits for a permission, not a question; the owner answers it on the screen (fraim shell $id)"
    force=(--force)
  fi
  # Before the send: the watcher must not close the terminal while this message is in it.
  touch "$dir/last-send"
  hc send "${force[@]}" "$id" "$text" >/dev/null || die "the message did not reach goal $id"
  printf 'running %s\n' "$(date '+%Y-%m-%d %H:%M')" > "$dir/state"
  alive "$dir" || { touch "$dir/heartbeat"; spawn_watcher "$id" follow; }
  echo "Sent to $id."
}

cmd_read() {
  local id="$1" lines="${2:-0}" dir
  dir="$(goal_dir "$id")" || exit $?
  printf '%s' "$lines" | grep -Eq '^[0-9]{1,5}$' || usage "read ID [LINES]"
  if term_get "$id" >/dev/null; then
    hc read "$id" --lines "$lines"
  elif [ -s "$dir/result.md" ]; then
    cat "$dir/result.md"
  else
    echo "Goal $id has no screen and no result yet."
  fi
}

cmd_attach() {
  local id="$1" dir
  dir="$(goal_dir "$id")" || exit $?
  [ -t 0 ] && [ -t 1 ] || usage "attach is for a person in a terminal; use read or send"
  reopen "$id" "$dir"
  alive "$dir" || { touch "$dir/heartbeat"; spawn_watcher "$id" follow; }
  echo "Goal $id. Leave with Ctrl+\\ (the goal keeps running)."
  exec fraim-herdr hc attach "$id"
}

# Goals whose watcher died (a container restart) but whose terminal still runs get a new
# watcher; running goals whose terminal is gone too are failed.
cmd_reconcile() {
  [ -d "$goals" ] || return 0
  local dir id st
  for dir in "$goals"/g*/; do
    id="$(basename "$dir")"
    valid_id "$id" || continue
    st="$(state_of "$dir")"
    case "$st" in running|done) ;; *) continue ;; esac
    alive "$dir" && continue
    case "$(term_state "$id")" in
      live)
        if [ -s "$dir/session-id" ]; then
          touch "$dir/heartbeat"
          spawn_watcher "$id" follow
        elif [ "$st" = running ]; then
          # No conversation to follow: start the goal again (restart_goal starts fresh).
          restart_goal "$id" "$dir"
        fi ;;
      unknown) ;;
      *)
        [ "$st" != running ] || restart_goal "$id" "$dir" ;;
    esac
  done
}

# A server restart (an update) ended a running goal: start it again, at most
# FRAIM_GOAL_RESTARTS times. It continues its own conversation when there is one.
restart_goal() {
  local id="$1" dir="$2" n
  n="$(cat "$dir/restarts" 2>/dev/null || echo 0)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -ge "${FRAIM_GOAL_RESTARTS:-2}" ]; then
    fail_goal "$id" "$dir" "$(cat "$dir/chat" 2>/dev/null)" "the Claude session ended (the server restarted)"
    # No watcher runs for this goal to try again: what did not go out goes to the alerts.
    if [ -s "$dir/unsent" ]; then
      fraim-notify "Not delivered earlier: $(cat "$dir/unsent")" >/dev/null 2>&1
      rm -f "$dir/unsent"
    fi
    return 0
  fi
  echo $((n + 1)) > "$dir/restarts"
  echo "restart $((n + 1)) after the session ended $(date '+%Y-%m-%d %H:%M')" >> "$dir/log.txt"
  if [ -s "$dir/session-id" ] && (cmd_send "$id" "The server restarted while you worked. Continue the goal where you stopped; your notes are in ~/fraim/goals/$id.") >/dev/null 2>>"$dir/log.txt"; then
    return 0
  fi
  rm -f "$dir/session-id"
  touch "$dir/heartbeat"
  spawn_watcher "$id" run
}

action="${1:-}"
[ $# -eq 0 ] || shift
case "$action" in
  start) cmd_start "$@" ;;
  run|follow) [ $# -eq 1 ] || usage "$action ID"; cmd_watch "$1" "$action" ;;
  list) cmd_list ;;
  show) [ $# -eq 1 ] || usage "show ID"; cmd_show "$1" ;;
  stop) [ $# -eq 1 ] || usage "stop ID"; cmd_stop "$1" ;;
  send) [ $# -ge 2 ] || usage 'send ID "message"'; cmd_send "$@" ;;
  read) [ $# -ge 1 ] && [ $# -le 2 ] || usage "read ID [LINES]"; cmd_read "$@" ;;
  attach) [ $# -eq 1 ] || usage "attach ID"; cmd_attach "$1" ;;
  reconcile) cmd_reconcile ;;
  *) usage 'start [--chat CHAT_ID] "what to do" | list | show ID | stop ID | send ID "message" | read ID [LINES] | attach ID' ;;
esac
