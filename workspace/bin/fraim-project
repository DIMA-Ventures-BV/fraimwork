#!/usr/bin/env bash
# Projects: a repo in ~/code carries a .fraim/ folder with its leads, automations and needs.
# Only the default branch counts, at a commit the owner saw in the plan. New items arrive
# switched off; each owner decides what runs on their server. See docs/projects.md.
#
#   fraim-project head NAME            fetch ~/code/NAME; print the default branch's commit
#   fraim-project plan NAME COMMIT     what apply would do
#   fraim-project needs NAME COMMIT    print .fraim/needs.mirror (the laptop runs it)
#   fraim-project apply NAME COMMIT    do it; only the owner, not a headless run
#   fraim-project on NAME ITEM...|--all   switch on; only the owner, not a headless run
#   fraim-project list
#   fraim-project export ITEM...       a .fraim/ tree of this server's leads and automations, as tar
# Exit codes: 0 ok, 1 failure, 2 usage.
set -uo pipefail

# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}" 2>/dev/null || true

code="$HOME/code"
projects="${FRAIM_PROJECTS_DIR:-$HOME/fraim/projects}"
leads="${FRAIM_LEADS_DIR:-$HOME/fraim/leads}"
autos="${FRAIM_AUTOMATIONS_DIR:-$HOME/fraim/automations}"

usage() { echo "fraim-project: $*" >&2; exit 2; }
die() { echo "fraim-project: $*" >&2; exit 1; }
sha() { if command -v sha256sum >/dev/null; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1; }
valid_item() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,39}$'; }
owner_only() { [ "${FRAIM_HEADLESS:-}" != 1 ] || die "only the owner can do this, not a headless run"; }

repo_dir() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]+$' && [ "$1" != . ] && [ "$1" != .. ] || usage "'$1' is not a folder in ~/code"
  [ -d "$code/$1/.git" ] || die "no repo $1 in ~/code; on the laptop: fraim project add OWNER/$1"
  printf '%s' "$code/$1"
}

default_commit() {
  git -C "$1" remote set-head origin --auto >/dev/null 2>&1
  git -C "$1" rev-parse --verify -q 'refs/remotes/origin/HEAD^{commit}' || die "cannot find the default branch of $1"
}

check_commit() {
  printf '%s' "$2" | grep -Eq '^[0-9a-f]{7,64}$' || usage "'$2' is not a commit"
  git -C "$1" fetch --quiet origin || die "could not fetch $1"
  git -C "$1" merge-base --is-ancestor "$2" "$(default_commit "$1")" 2>/dev/null || die "commit $2 is not on the default branch"
}

# Header helpers: the "key: value" lines between the first two "---" lines.
header_get() {
  awk -v k="$2" 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); gsub(/^[ \t"]+|[ \t"]+$/, "", v); print v; exit }' "$1"
}
header_without() {
  awk -v re="^[ \t]*($2)[ \t]*:" 'NR == 1 && $0 == "---" { h = 1; print; next } h && $0 == "---" { h = 0 } h && $0 ~ re { next } { print }' "$1"
}

# What a lead.md on the server holds: schedule and budget are defaults for the first install,
# and tools go to the lead's tools file. A lead's hash covers its brief and its tools.
lead_brief() { header_without "$1" 'schedule|budget|tools'; }
repo_tools() { header_get "$1" tools | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$'; }
here_tools() { grep -v '^[[:space:]]*#' "$1" 2>/dev/null | grep -v '^[[:space:]]*$'; }
lead_hash() { { lead_brief "$1"; echo '--tools--'; repo_tools "$1" | LC_ALL=C sort; } | sha; }
here_lead_hash() { { lead_brief "$leads/$1/lead.md"; echo '--tools--'; here_tools "$leads/$1/tools" | LC_ALL=C sort; } | sha; }
write_tools() {  # NAME FILE
  local t
  t="$(repo_tools "$2")"
  if [ -n "$t" ]; then printf '%s\n' "$t" > "$leads/$1/tools"; else rm -f "$leads/$1/tools"; fi
}
auto_hash() {
  local f
  for f in "$1/automation.md" "$1"/*.sh; do
    [ -f "$f" ] || continue
    basename "$f"
    case "$f" in */automation.md) header_without "$f" enabled ;; *) cat "$f" ;; esac
  done | sha
}

here_hash() {
  case "$1" in
    lead) [ ! -f "$leads/$2/lead.md" ] || here_lead_hash "$2" ;;
    auto) [ ! -f "$autos/$2/automation.md" ] || auto_hash "$autos/$2" ;;
  esac
}

manifest() { printf '%s' "$projects/$1/installed.tsv"; }
recorded() { awk -F'\t' -v k="$2" -v n="$3" '$1 == k && $2 == n { print $3 }' "$(manifest "$1")" 2>/dev/null; }
record() {
  local m tmp
  m="$(manifest "$1")"
  mkdir -p "$(dirname "$m")"
  tmp="$(mktemp)"
  awk -F'\t' -v k="$2" -v n="$3" '!($1 == k && $2 == n)' "$m" 2>/dev/null > "$tmp"
  printf '%s\t%s\t%s\n' "$2" "$3" "$4" >> "$tmp"
  cat "$tmp" > "$m"
  rm -f "$tmp"
}

# extract DIR COMMIT DEST: .fraim of that commit into DEST. Git history is the only source,
# so sessions working on branches in ~/code cannot change what is installed.
extract() {
  git -C "$1" cat-file -e "$2:.fraim" 2>/dev/null || die "commit $2 has no .fraim folder"
  if git -C "$1" ls-tree -r "$2" -- .fraim | awk '$1 == "120000"' | grep -q .; then
    die "the .fraim folder holds a symbolic link; that is not allowed"
  fi
  git -C "$1" archive "$2" .fraim | tar -xf - -C "$3" || die "could not read .fraim of commit $2"
}

validate() {
  local root="$1/.fraim" f d n bad="" v
  for f in "$root"/leads/*; do
    [ -e "$f" ] || continue
    n="$(basename "$f" .md)"
    case "$f" in *.md) ;; *) bad="$bad
  leads/$(basename "$f"): only NAME.md files belong here"; continue ;; esac
    [ -f "$f" ] || { bad="$bad
  leads/$n.md: not a file"; continue; }
    valid_item "$n" || bad="$bad
  leads/$n.md: the name may only hold lowercase letters, digits and -"
    [ "$(header_get "$f" role)" = lead ] || bad="$bad
  leads/$n.md: the header needs role: lead (a repo cannot add a chief or an engineer)"
    v="$(header_get "$f" schedule)"
    [ -z "$v" ] || { [ "$(printf '%s' "$v" | wc -w | tr -d ' ')" = 5 ] && printf '%s' "$v" | grep -Eq '^[0-9*/,-]+( [0-9*/,-]+){4}$'; } || bad="$bad
  leads/$n.md: schedule needs five cron fields"
    v="$(header_get "$f" budget)"
    [ -z "$v" ] || printf '%s' "$v" | grep -Eq '^[0-9]{1,2}$' || bad="$bad
  leads/$n.md: budget must be a number from 0 to 99"
    if repo_tools "$f" | grep -Evq '^[A-Za-z0-9_:()*. /-]+$'; then bad="$bad
  leads/$n.md: tools holds a character that is not allowed"; fi
    [ ! -d "$root/automations/$n" ] || bad="$bad
  $n: a lead and an automation cannot share a name"
  done
  for d in "$root"/automations/*; do
    [ -e "$d" ] || continue
    n="$(basename "$d")"
    valid_item "$n" || bad="$bad
  automations/$n: the name may only hold lowercase letters, digits and -"
    [ -f "$d/automation.md" ] || { bad="$bad
  automations/$n: no automation.md"; continue; }
    [ -z "$(find "$d" -mindepth 1 ! -name automation.md ! -name '*.sh' -print -quit)" ] || bad="$bad
  automations/$n: only automation.md and *.sh files belong here"
    [ -z "$(header_get "$d/automation.md" lead)" ] || bad="$bad
  automations/$n: lead: is not allowed; put the lead in leads/"
  done
  [ -z "$bad" ] || die "these items in .fraim are not valid (see docs/projects.md):$bad"
}

decide() {  # NAME RECORDED REPO HERE
  local name="$1" was="$2" repo="$3" here="$4"
  if [ -z "$was" ]; then
    if [ -z "$here" ]; then
      if [ -e "$leads/$name" ] || [ -e "$autos/$name" ]; then echo skip; else echo new; fi
    elif [ "$here" = "$repo" ]; then echo adopt
    else echo skip; fi
  elif [ "$repo" = "$was" ]; then echo same
  elif [ -z "$here" ]; then echo keep
  elif [ "$here" = "$repo" ]; then echo adopt
  elif [ "$here" = "$was" ]; then echo update
  else echo keep; fi
}

# scan NAME TREE: one line per item, "STATE KIND NAME HASH".
scan() {
  local name="$1" root="$2/.fraim" f d n h
  for f in "$root"/leads/*.md; do
    [ -f "$f" ] || continue
    n="$(basename "$f" .md)"; h="$(lead_hash "$f")"
    printf '%s lead %s %s\n' "$(decide "$n" "$(recorded "$name" lead "$n")" "$h" "$(here_hash lead "$n")")" "$n" "$h"
  done
  for d in "$root"/automations/*/; do
    [ -f "$d/automation.md" ] || continue
    n="$(basename "$d")"; h="$(auto_hash "${d%/}")"
    printf '%s auto %s %s\n' "$(decide "$n" "$(recorded "$name" auto "$n")" "$h" "$(here_hash auto "$n")")" "$n" "$h"
  done
}

lead_area() { awk '/^## Area/ { getline; print; exit }' "$1" | cut -c1-100; }

show_diff() {  # OLD NEW
  local out
  out="$(diff -u "$1" "$2" | tail -n +3)"
  printf '%s\n' "$out" | head -40 | sed 's/^/    /'
  [ "$(printf '%s\n' "$out" | wc -l)" -le 40 ] || echo "    ... and more lines"
}

describe() {  # STATE KIND NAME TREE
  local state="$1" kind="$2" name="$3" root="$4/.fraim" what extra="" tmp f
  case "$kind" in lead) what="lead $name" ;; auto) what="automation $name" ;; esac
  case "$state" in
    new)
      if [ "$kind" = lead ]; then extra="$(lead_area "$root/leads/$name.md")"
      else
        extra="$(header_get "$root/automations/$name/automation.md" description)"
        for f in "$root/automations/$name"/*.sh; do [ -f "$f" ] && extra="$extra (runs the script $(basename "$f"))"; done
      fi
      echo "new      $what, arrives switched off${extra:+: $extra}"
      if [ "$kind" = lead ] && [ -n "$(repo_tools "$root/leads/$name.md")" ]; then
        echo "         may use: $(repo_tools "$root/leads/$name.md" | paste -sd, - | sed 's/,/, /g')"
      fi
      ;;
    adopt) echo "adopt    $what is already here and the same; it becomes part of this project" ;;
    keep) echo "keep     $what was edited on this server; the repo's new version is not installed" ;;
    skip) echo "skip     $what: this server already has a different item with that name" ;;
    update)
      echo "update   $what (it stays on or off as it is)"
      if [ "$kind" = lead ]; then
        tmp="$(mktemp)"; lead_brief "$root/leads/$name.md" > "$tmp"
        cmp -s "$leads/$name/lead.md" "$tmp" || show_diff "$leads/$name/lead.md" "$tmp"
        repo_tools "$root/leads/$name.md" | LC_ALL=C sort > "$tmp"
        local was; was="$(mktemp)"; here_tools "$leads/$name/tools" | LC_ALL=C sort > "$was"
        cmp -s "$was" "$tmp" || { echo "    what it may use:"; show_diff "$was" "$tmp"; }
        rm -f "$tmp" "$was"
      else
        for f in "$root/automations/$name"/automation.md "$root/automations/$name"/*.sh; do
          [ -f "$f" ] || continue
          if [ -f "$autos/$name/$(basename "$f")" ]; then show_diff "$autos/$name/$(basename "$f")" "$f"
          else echo "    new file $(basename "$f")"; fi
        done
      fi
      ;;
  esac
}

gone_items() {  # NAME TREE
  local kind n rest p
  while IFS=$'\t' read -r kind n rest; do
    case "$kind" in lead) p="$2/.fraim/leads/$n.md" ;; *) p="$2/.fraim/automations/$n/automation.md" ;; esac
    [ -f "$p" ] || echo "gone     $kind $n is no longer in the repo; it stays here until the owner removes it"
  done < <(cat "$(manifest "$1")" 2>/dev/null)
}

# MCP servers an item names that this server lacks and needs.mirror does not add.
missing_tools() {  # TREE
  local connected f n srv needs="$1/.fraim/needs.mirror"
  connected="$(fraim-connect list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null)"
  [ -n "$connected" ] || return 0
  for f in "$1"/.fraim/leads/*.md "$1"/.fraim/automations/*/automation.md; do
    [ -f "$f" ] || continue
    case "$f" in
      */automation.md) n="automation $(basename "$(dirname "$f")")" ;;
      *) n="lead $(basename "$f" .md)" ;;
    esac
    while read -r srv; do
      grep -qxF "$srv" <<<"$connected" && continue
      awk -v s="$srv" '$1 == "connect" && $2 == s { f = 1 } END { exit !f }' "$needs" 2>/dev/null && continue
      echo "missing  $n needs $srv: it is not connected on this server and not in needs.mirror"
    done < <(repo_tools "$f" | grep '^mcp__' | sed 's/^mcp__//; s/__.*//' | grep -v '^plugin_' | sort -u)
  done
}

tree_for() {  # DIR COMMIT: prints a temp folder holding .fraim
  local tree
  tree="$(mktemp -d)"
  extract "$1" "$2" "$tree"
  validate "$tree"
  printf '%s' "$tree"
}

cmd_head() {
  local d
  d="$(repo_dir "$1")" || exit $?
  git -C "$d" fetch --quiet origin || die "could not fetch $1"
  default_commit "$d"
}

cmd_plan() {
  local d tree state kind n changes=0
  d="$(repo_dir "$1")" || exit $?
  check_commit "$d" "$2"
  tree="$(tree_for "$d" "$2")" || exit $?
  echo "Project $1 at ${2:0:9}"
  while read -r state kind n _; do
    [ "$state" != same ] || continue
    changes=1
    describe "$state" "$kind" "$n" "$tree"
  done < <(scan "$1" "$tree")
  gone_items "$1" "$tree"
  [ "$changes" = 1 ] || echo "Leads and automations: nothing new."
  missing_tools "$tree"
  rm -rf "$tree"
}

cmd_needs() {
  local d
  d="$(repo_dir "$1")" || exit $?
  check_commit "$d" "$2"
  git -C "$d" show "$2:.fraim/needs.mirror" 2>/dev/null || true
}

install_lead() {  # NAME FILE
  local args=(new "$1" --off) v
  v="$(lead_area "$2")"; [ -z "$v" ] || args+=(--area "$v")
  v="$(header_get "$2" schedule)"; [ -z "$v" ] || args+=(--at "$v")
  v="$(header_get "$2" budget)"; [ -z "$v" ] || args+=(--budget "$v")
  fraim-lead "${args[@]}" >/dev/null || die "could not create lead $1"
  lead_brief "$2" > "$leads/$1/lead.md"
  write_tools "$1" "$2"
}

off_header() { { echo ---; echo 'enabled: false'; tail -n +2 "$1"; } > "$1.new" && mv "$1.new" "$1"; }

copy_auto() {  # NAME SRC OFF(1|0)
  local dest="$autos/$1"
  mkdir -p "$dest"
  rm -f "$dest"/*.sh
  cp -p "$2"/*.sh "$dest/" 2>/dev/null || true
  header_without "$2/automation.md" enabled > "$dest/automation.md"
  [ "$3" = 0 ] || off_header "$dest/automation.md"
}

cmd_apply() {
  owner_only
  local d tree state kind n h did=0
  d="$(repo_dir "$1")" || exit $?
  check_commit "$d" "$2"
  tree="$(tree_for "$d" "$2")" || exit $?
  while read -r state kind n h; do
    case "$state:$kind" in
      new:lead) install_lead "$n" "$tree/.fraim/leads/$n.md" ;;
      new:auto) copy_auto "$n" "$tree/.fraim/automations/$n" 1 ;;
      update:lead)
        lead_brief "$tree/.fraim/leads/$n.md" > "$leads/$n/lead.md"
        write_tools "$n" "$tree/.fraim/leads/$n.md"
        ;;
      update:auto)
        local off=0
        [ "$(header_get "$autos/$n/automation.md" enabled)" != false ] || off=1
        copy_auto "$n" "$tree/.fraim/automations/$n" "$off"
        ;;
      adopt:*) ;;
      *) continue ;;
    esac
    record "$1" "$kind" "$n" "$h"
    echo "$state $kind $n"
    did=$((did + 1))
  done < <(scan "$1" "$tree")
  mkdir -p "$projects/$1"
  printf '%s\n' "$2" > "$projects/$1/commit"
  rm -rf "$tree"
  fraim-auto sync --quiet || die "could not update the scheduler"
  echo "Project $1: $did item(s) changed."
}

item_state() {
  case "$1" in
    lead) if [ -f "$leads/$2/paused" ]; then echo off; else echo on; fi ;;
    *) if [ "$(header_get "$autos/$2/automation.md" enabled 2>/dev/null)" = false ]; then echo off; else echo on; fi ;;
  esac
}

cmd_on() {
  owner_only
  local name="$1" kind n rest want found=0 hits=0
  shift
  [ -f "$(manifest "$name")" ] || die "no project $name on this server"
  [ $# -gt 0 ] || usage "on PROJECT ITEM...|--all"
  for want in "$@"; do
    [ "$want" = --all ] && continue
    awk -F'\t' -v n="$want" '$2 == n { f = 1 } END { exit !f }' "$(manifest "$name")" || die "$want is not part of project $name"
  done
  while IFS=$'\t' read -r kind n rest; do
    found=0
    for want in "$@"; do [ "$want" = --all ] || [ "$want" = "$n" ] && found=1; done
    [ "$found" = 1 ] || continue
    fraim-auto on "$n" || die "could not switch on $n"
    hits=$((hits + 1))
  done < "$(manifest "$name")"
  echo "Project $name: $hits item(s) on."
}

cmd_list() {
  local p name kind n rest
  for p in "$projects"/*/; do
    [ -f "$p/installed.tsv" ] || continue
    name="$(basename "$p")"
    printf '%s  at %s\n' "$name" "$(cut -c1-9 "$p/commit" 2>/dev/null)"
    while IFS=$'\t' read -r kind n rest; do
      printf '  %s %s  %s\n' "$kind" "$n" "$(item_state "$kind" "$n")"
    done < "$p/installed.tsv"
  done
  [ -n "$(find "$projects" -mindepth 2 -maxdepth 2 -name installed.tsv -print -quit 2>/dev/null)" ] || echo "No projects yet."
}

cmd_export() {
  local tree item f s b t
  tree="$(mktemp -d)"
  for item in "$@"; do
    valid_item "$item" || usage "'$item' is not a name"
    if [ -f "$leads/$item/lead.md" ]; then
      f="$leads/$item/lead.md"
      [ "$(header_get "$f" role)" = lead ] || die "$item is a chief or an engineer; those stay personal"
      s="$(header_get "$autos/$item/automation.md" schedule 2>/dev/null)"
      b="$(cat "$leads/$item/budget" 2>/dev/null)"
      t="$(here_tools "$leads/$item/tools" | paste -sd, -)"
      mkdir -p "$tree/leads"
      { head -1 "$f"; [ -z "$s" ] || printf 'schedule: "%s"\n' "$s"; [ -z "$b" ] || printf 'budget: %s\n' "$b"; [ -z "$t" ] || printf 'tools: %s\n' "$t"; tail -n +2 "$f"; } > "$tree/leads/$item.md"
    elif [ -f "$autos/$item/automation.md" ]; then
      [ -z "$(header_get "$autos/$item/automation.md" lead)" ] || die "$item belongs to a lead; export the lead"
      mkdir -p "$tree/automations/$item"
      cp -p "$autos/$item"/*.sh "$tree/automations/$item/" 2>/dev/null || true
      header_without "$autos/$item/automation.md" enabled > "$tree/automations/$item/automation.md"
    else
      die "no lead or automation $item on this server"
    fi
  done
  tar -C "$tree" -cf - .
  rm -rf "$tree"
}

action="${1:-list}"
[ $# -gt 0 ] && shift
case "$action" in
  head) [ $# -eq 1 ] || usage "head NAME"; cmd_head "$1" ;;
  plan) [ $# -eq 2 ] || usage "plan NAME COMMIT"; cmd_plan "$1" "$2" ;;
  needs) [ $# -eq 2 ] || usage "needs NAME COMMIT"; cmd_needs "$1" "$2" ;;
  apply) [ $# -eq 2 ] || usage "apply NAME COMMIT"; cmd_apply "$1" "$2" ;;
  on) [ $# -ge 2 ] || usage "on NAME ITEM...|--all"; cmd_on "$@" ;;
  list) cmd_list ;;
  export) [ $# -ge 1 ] || usage "export ITEM..."; cmd_export "$@" ;;
  *) usage "head NAME | plan NAME COMMIT | needs NAME COMMIT | apply NAME COMMIT | on NAME ITEM...|--all | list | export ITEM..." ;;
esac
