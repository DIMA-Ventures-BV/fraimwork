#!/usr/bin/env bash
# Tells the owner something. Usage: fraim-notify "text"  or  echo text | fraim-notify
# Every message is appended to ~/fraim/alerts.md (so owners without WhatsApp still see it,
# and `fraim status --json` reports it); with the whatsapp module or a channel it is also sent there.
# With a chief of staff, the notice goes to fraim-relay: the chief writes what the owner reads.
#   FRAIM_NOTIFY_NO_ALERT=1  a normal result (a job's answer), not something that went wrong
#   FRAIM_NOTIFY_CHAT=ID     send to this chat instead of the owner's
#   FRAIM_NOTIFY_DIRECT=1    send the text as it is (the chief's own words, security notices)
set -euo pipefail
# shellcheck source=/dev/null
. "${FRAIM_RUNTIME_ENV:-/etc/fraim/runtime.env}"

if [ $# -gt 0 ]; then text="$*"; else text="$(cat)"; fi

alerts="$HOME/fraim/alerts.md"
[ "${FRAIM_NOTIFY_NO_ALERT:-}" = 1 ] || {
  [ -s "$alerts" ] || printf '# fraim alerts\n\nNewest at the bottom. fraim keeps the last 200.\n\n'
  printf -- '- %s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-500)"
} >> "$alerts"
if [ -f "$alerts" ] && [ "$(grep -c '^- ' "$alerts")" -gt 200 ]; then
  tmp="$(mktemp)"
  { grep -v '^- ' "$alerts"; grep '^- ' "$alerts" | tail -200; } > "$tmp" && cat "$tmp" > "$alerts"
  rm -f "$tmp"
fi

if [ -z "${FRAIM_CHANNEL_URL:-}" ]; then
  case ",${FRAIM_MODULES:-}," in
    *,whatsapp,*) ;;
    *) exit 0 ;;
  esac
fi

chat="${FRAIM_NOTIFY_CHAT:-}"
if [ "${FRAIM_NOTIFY_DIRECT:-}" != 1 ] && command -v fraim-relay >/dev/null && fraim-relay on; then
  fraim-relay add ${chat:+--chat "$chat"} -- "$text" && exit 0
fi

if [ -n "$chat" ]; then
  fraim-gateway POST /send "$(jq -n --arg chat "$chat" --arg text "$text" '{chat_id: $chat, text: $text}')" >/dev/null && exit 0
fi
fraim-gateway POST /send "$(jq -n --arg to "${WHATSAPP_OWNER:-}" --arg text "$text" '{to: $to, text: $text}')" >/dev/null
