#!/usr/bin/env bash
# Sends a WhatsApp message to the owner. Usage: fraim-notify "text"  or  echo text | fraim-notify
set -euo pipefail
# shellcheck source=/dev/null
. /etc/fraim/runtime.env

if [ $# -gt 0 ]; then text="$*"; else text="$(cat)"; fi

case ",${FRAIM_MODULES:-}," in
  *,whatsapp,*) ;;
  *) echo "fraim-notify: the whatsapp module is off, message not sent" >&2; exit 0 ;;
esac

fraim-gateway POST /send "$(jq -n --arg to "$WHATSAPP_OWNER" --arg text "$text" '{to: $to, text: $text}')" >/dev/null
