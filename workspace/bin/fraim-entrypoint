#!/usr/bin/env bash
# Container entrypoint. Roles: "workspace" (SSH + Claude session) or "scheduler" (cron jobs).
set -euo pipefail

role="${1:-workspace}"
home=/home/claude

write_runtime_env() {
  install -d -m 0755 /etc/fraim
  umask 027
  {
    printf 'FRAIM_ROLE=%q\n' "$role"
    printf 'FRAIM_MODULES=%q\n' "${FRAIM_MODULES:-}"
    printf 'FRAIM_HOSTNAME=%q\n' "${FRAIM_HOSTNAME:-fraim}"
    printf 'FRAIM_GATEWAY_URL=%q\n' "${FRAIM_GATEWAY_URL:-}"
    printf 'FRAIM_GATEWAY_TOKEN=%q\n' "${FRAIM_GATEWAY_TOKEN:-}"
    printf 'WHATSAPP_OWNER=%q\n' "${WHATSAPP_OWNER:-}"
    printf 'BROWSER_CDP_URL=%q\n' "${BROWSER_CDP_URL:-}"
    printf 'FRAIM_BROWSER_VIEW_URL=%q\n' "${FRAIM_BROWSER_VIEW_URL:-}"
    printf 'TZ=%q\n' "${TZ:-UTC}"
    printf 'FRAIM_AUTO_CONFIRM_CHANNEL=%q\n' "${FRAIM_AUTO_CONFIRM_CHANNEL:-1}"
    printf 'FRAIM_VERSION=%q\n' "${FRAIM_VERSION:-dev}"
    printf 'FRAIM_RELEASES_REPO=%q\n' "${FRAIM_RELEASES_REPO:-}"
  } > /etc/fraim/runtime.env
  chown root:claude /etc/fraim/runtime.env
  chmod 0640 /etc/fraim/runtime.env
  umask 022
}

has_module() {
  case ",${FRAIM_MODULES:-}," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

# Root only touches volume mount points (claude cannot replace a mount point with a
# symlink); everything inside the home folder is done as claude by fraim-home-setup.
prepare_home() {
  local dir
  for dir in "$home" "$home/fraim"; do
    [ -L "$dir" ] || chown claude:claude "$dir"
  done
  # Drop folders shared with the browser and the WhatsApp gateway (other users).
  for dir in "$home/fraim/downloads" "$home/fraim/inbox"; do
    if mountpoint -q "$dir" && [ ! -L "$dir" ]; then
      chown claude:claude "$dir"
      chmod 0777 "$dir"
    fi
  done
  su claude -s /bin/bash -c "fraim-home-setup '$role'"
}

as_claude() {
  su - claude -c "$1"
}

register_mcp() {
  local name="$1" command="$2"
  if ! as_claude "claude mcp get $name >/dev/null 2>&1"; then
    as_claude "claude mcp add --scope user $name -- $command" >/dev/null \
      || echo "fraim: could not register MCP server '$name'" >&2
  fi
}

case "$role" in
  workspace)
    write_runtime_env
    prepare_home

    install -d -m 0755 /etc/ssh/keys /run/sshd
    for type in ed25519 rsa; do
      key="/etc/ssh/keys/ssh_host_${type}_key"
      [ -f "$key" ] || ssh-keygen -q -N "" -t "$type" -f "$key"
    done

    install -d -o root -g root -m 0755 /etc/ssh/authorized_keys
    if [ -s /etc/fraim/authorized_keys ]; then
      install -o root -g root -m 0644 /etc/fraim/authorized_keys /etc/ssh/authorized_keys/claude
    else
      echo "fraim: config/authorized_keys is empty, nobody can log in" >&2
    fi

    if command -v fraim-config >/dev/null; then
      as_claude "fraim-config init --role server --quiet" || echo "fraim: fraim-config init failed" >&2
    fi
    if [ -d /opt/fraim/server-plugin ]; then
      as_claude "mkdir -p ~/.claude/skills && ln -sfn /opt/fraim/server-plugin ~/.claude/skills/fraim-system"
    fi

    register_mcp my-chrome "chrome-devtools-mcp --browser-url http://127.0.0.1:9222"
    if has_module browser; then
      register_mcp browser "chrome-devtools-mcp --browser-url ${BROWSER_CDP_URL}"
    fi
    if has_module whatsapp; then
      register_mcp whatsapp "node /opt/fraim/channel/whatsapp-channel.mjs"
    fi

    as_claude "tmux has-session -t main 2>/dev/null || tmux new-session -d -s main fraim-session"

    exec /usr/sbin/sshd -D -e
    ;;

  scheduler)
    write_runtime_env
    prepare_home
    exec su claude -s /bin/bash -c "cd ~ && exec fraim-scheduler"
    ;;

  *)
    exec "$@"
    ;;
esac
