#!/usr/bin/env bash
# Container entrypoint. Roles: "workspace" (SSH + Claude session) or "scheduler" (cron jobs).
set -euo pipefail

role="${1:-workspace}"
home=/home/claude

write_runtime_env() {
  install -d -m 0755 /etc/fraim
  umask 027
  {
    printf 'FRAIM_ROLE=%q\n' "$role"
    printf 'FRAIM_MODULES=%q\n' "${FRAIM_MODULES:-}"
    printf 'FRAIM_HOSTNAME=%q\n' "${FRAIM_HOSTNAME:-fraim}"
    printf 'FRAIM_GATEWAY_URL=%q\n' "${FRAIM_GATEWAY_URL:-}"
    printf 'FRAIM_GATEWAY_TOKEN=%q\n' "${FRAIM_GATEWAY_TOKEN:-}"
    printf 'FRAIM_REPLY_TOKEN=%q\n' "${FRAIM_REPLY_TOKEN:-}"
    printf 'WHATSAPP_OWNER=%q\n' "${WHATSAPP_OWNER:-}"
    printf 'BROWSER_CDP_URL=%q\n' "${BROWSER_CDP_URL:-}"
    printf 'FRAIM_BROWSER_VIEW_URL=%q\n' "${FRAIM_BROWSER_VIEW_URL:-}"
    printf 'TZ=%q\n' "${TZ:-UTC}"
    printf 'FRAIM_AUTO_CONFIRM_CHANNEL=%q\n' "${FRAIM_AUTO_CONFIRM_CHANNEL:-1}"
    printf 'FRAIM_PERMISSIONS=%q\n' "${FRAIM_PERMISSIONS:-all}"
    printf 'FRAIM_TOOL_LISTS=%q\n' "${FRAIM_TOOL_LISTS:-enforce}"
    printf 'FRAIM_VERSION=%q\n' "${FRAIM_VERSION:-dev}"
    printf 'FRAIM_RELEASES_REPO=%q\n' "${FRAIM_RELEASES_REPO:-}"
    printf 'FRAIM_SPACE=%q\n' "${FRAIM_SPACE:-main}"
    printf 'FRAIM_ACCESS_MODE=%q\n' "${FRAIM_ACCESS_MODE:-}"
    printf 'FRAIM_SECRETS_URL=%q\n' "${FRAIM_SECRETS_URL:-}"
    printf 'FRAIM_SECRETS_TOKEN=%q\n' "${FRAIM_SECRETS_TOKEN:-}"
    printf 'FRAIM_PREVIEW_PORTS=%q\n' "${FRAIM_PREVIEW_PORTS:-3100-3109}"
    printf 'FRAIM_PREVIEW_HOST=%q\n' "${FRAIM_PREVIEW_HOST:-}"
  } > /etc/fraim/runtime.env
  chown root:claude /etc/fraim/runtime.env
  chmod 0640 /etc/fraim/runtime.env
  umask 022
}

# Per-space MCP policy as a managed-settings drop-in: root-owned, so Claude in the space
# cannot loosen it. FRAIM_MCP_DENY is a comma list of server names (claude.ai connectors
# are named like "claude.ai Gmail"); FRAIM_CLAUDEAI_CONNECTORS=off turns all of them off.
write_space_policy() {
  local dir=/etc/claude-code/managed-settings.d deny_json disable=false
  install -d -m 0755 "$dir"
  # --arg, not stdin: jq 1.6 prints nothing for empty input.
  deny_json="$(jq -cn --arg s "${FRAIM_MCP_DENY:-}" '$s | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != "")) | map({serverName: .})')" \
    || deny_json='[]'
  [ "${FRAIM_CLAUDEAI_CONNECTORS:-on}" != off ] || disable=true
  jq -n --argjson deny "$deny_json" --argjson disable "$disable" \
    '{deniedMcpServers: $deny} + (if $disable then {disableClaudeAiConnectors: true, env: {ENABLE_CLAUDEAI_MCP_SERVERS: "false"}} else {} end)' \
    > "$dir/50-fraim-space.json"
  chmod 0644 "$dir/50-fraim-space.json"
}

has_module() {
  case ",${FRAIM_MODULES:-}," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

# Root only touches volume mount points (claude cannot replace a mount point with a
# symlink); everything inside the home folder is done as claude by fraim-home-setup.
prepare_home() {
  local dir
  for dir in "$home" "$home/fraim"; do
    [ -L "$dir" ] || chown claude:claude "$dir"
  done
  # Drop folders shared with the browser and the WhatsApp gateway (other users).
  for dir in "$home/fraim/downloads" "$home/fraim/inbox"; do
    if mountpoint -q "$dir" && [ ! -L "$dir" ]; then
      chown claude:claude "$dir"
      chmod 0777 "$dir"
    fi
  done
  su claude -s /bin/bash -c "fraim-home-setup '$role'"
}

as_claude() {
  su - claude -c "$1"
}

# Registered again at every start when the command changed (an update can add flags).
# `claude mcp get` prints the program and its arguments on separate lines: compare the stored
# config instead.
mcp_registered() {
  local name="$1" command="$2" where="${3:-user}"
  as_claude "jq -e --arg n '$name' --arg c '$command' --arg w '$where' '
    (if \$w == \"user\" then .mcpServers else .projects[env.HOME + \"/fraim\"].mcpServers end)[\$n]
    | ([.command] + (.args // [])) | join(\" \") == \$c' ~/.claude.json >/dev/null 2>&1"
}
register_mcp() {
  local name="$1" command="$2"
  if ! mcp_registered "$name" "$command" user; then
    as_claude "claude mcp remove --scope user $name >/dev/null 2>&1 || true"
    as_claude "claude mcp add --scope user $name -- $command" >/dev/null \
      || echo "fraim: could not register MCP server '$name'" >&2
  fi
}

# An MCP server for main only: registered for ~/fraim (local scope), and removed from the user
# scope where older versions put it, so other Claudes stop starting their own copy.
register_main_mcp() {
  local name="$1" command="$2"
  as_claude "claude mcp remove --scope user $name >/dev/null 2>&1 || true"
  if ! mcp_registered "$name" "$command" local; then
    as_claude "cd ~/fraim && claude mcp remove --scope local $name >/dev/null 2>&1 || true"
    as_claude "cd ~/fraim && claude mcp add --scope local $name -- $command" >/dev/null \
      || echo "fraim: could not register MCP server '$name'" >&2
  fi
}

case "$role" in
  workspace)
    write_runtime_env
    write_space_policy
    prepare_home

    install -d -m 0755 /etc/ssh/keys /run/sshd
    for type in ed25519 rsa; do
      key="/etc/ssh/keys/ssh_host_${type}_key"
      [ -f "$key" ] || ssh-keygen -q -N "" -t "$type" -f "$key"
    done

    install -d -o root -g root -m 0755 /etc/ssh/authorized_keys
    if [ -s /etc/fraim/authorized_keys ]; then
      install -o root -g root -m 0644 /etc/fraim/authorized_keys /etc/ssh/authorized_keys/claude
    else
      echo "fraim: config/authorized_keys is empty, nobody can log in" >&2
    fi

    if [ -d /opt/fraim/server-plugin ]; then
      as_claude "mkdir -p ~/.claude/skills && ln -sfn /opt/fraim/server-plugin ~/.claude/skills/fraim-system"
    fi

    if has_module browser; then
      register_mcp browser "chrome-devtools-mcp --no-usage-statistics --browser-url ${BROWSER_CDP_URL}"
    fi
    # Every MCP server starts once per Claude. WhatsApp and the lent laptop Chrome are for
    # main only, so they belong to main's folder (~/fraim, local scope): goals and coding
    # sessions run in their own folders and do not start them (each copy took 60 to 160 MB;
    # ten Claudes froze a 4 GB server on 2026-11-09).
    register_main_mcp my-chrome "chrome-devtools-mcp --no-usage-statistics --browser-url http://127.0.0.1:9222"
    if has_module whatsapp; then
      register_main_mcp whatsapp "node /opt/fraim/channel/whatsapp-channel.mjs"
    fi

    # Tells the owner when what the agents are told changes (docs/prompts.md). Its own user
    # (uid 1101), so the agents can read its history but not change it or stop it.
    install -d -o 1101 -g 1101 -m 0755 /var/lib/fraim/watch
    chown -R 1101:1101 /var/lib/fraim/watch
    (
      while :; do
        setpriv --reuid=1101 --regid=1101 --clear-groups \
          env HOME=/var/lib/fraim/watch FRAIM_WATCH_HOME="$home" fraim-watch loop >>/var/lib/fraim/watch/log 2>&1 || true
        sleep 10
      done
    ) &

    # herdr-core holds every Claude session (main, goals, coding sessions), the queue page
    # and the watcher; the supervisor starts them and restarts what stops (docs/sessions.md).
    as_claude "mkdir -p ~/.local/state/fraim && setsid fraim-herdr supervise </dev/null >>~/.local/state/fraim/herdr.log 2>&1 &"

    # The Claude config layer can need the network (plugin marketplaces on GitHub). Never let
    # SSH access wait on it: run it in the background with a time limit, record the result
    # for fraim-doctor (plugins-ok), and restart the Claude session once so it loads the result.
    if command -v fraim-config >/dev/null; then
      (
        as_claude "mkdir -p ~/.local/state/fraim && echo \"pending \$(date '+%Y-%m-%d %H:%M')\" > ~/.local/state/fraim/config-init.status && if timeout 180 fraim-config init --role server --quiet >~/.local/state/fraim/config-init.log 2>&1; then echo ok; else echo \"failed \$(date '+%Y-%m-%d %H:%M')\"; fi > ~/.local/state/fraim/config-init.status"
        as_claude "pkill -x claude || true"
      ) &
    fi

    exec /usr/sbin/sshd -D -e
    ;;

  scheduler)
    write_runtime_env
    write_space_policy
    prepare_home
    exec su claude -s /bin/bash -c "cd ~ && exec fraim-scheduler"
    ;;

  *)
    exec "$@"
    ;;
esac
