#!/usr/bin/env bash
# fraim cloud: create, prepare and destroy fraim servers on Hetzner, DigitalOcean and AWS,
# and make any other Ubuntu or Debian server ready for `fraim deploy`.
#
# Same conventions as bin/fraim: no prompts without a terminal, exit 0 ok, 1 failure,
# 2 usage or missing input, 3 human step needed ("HUMAN STEP: ..." on one line).
# Provider API tokens stay in each provider's own CLI login. This script never reads them.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fraim"
STATE_DIR="$CONFIG_DIR/cloud"
USER_DATA="$REPO/deploy/cloud-init.yaml"
SSH_BASE=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o BatchMode=yes)
# Extra ssh options, for tests against local containers (for example "-o Port=2299").
read -r -a SSH_EXTRA <<< "${FRAIM_CLOUD_SSH_OPTS:-}"
SSH_BASE+=(${SSH_EXTRA[@]+"${SSH_EXTRA[@]}"})

die()   { printf 'fraim cloud: %s\n' "$*" >&2; exit 1; }
usage() { printf 'fraim cloud: %s\n' "$*" >&2; exit 2; }
human() { printf 'HUMAN STEP: %s\n' "$*"; exit 3; }
say()   { printf '%s\n' "$*" >&2; }

# --- flags -------------------------------------------------------------------------
POSITIONAL=()
parse_flags() {
  POSITIONAL=()
  local key value
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; POSITIONAL+=("$@"); break ;;
      --*=*) key="${1%%=*}"; value="${1#*=}" ;;
      --*)
        key="$1"
        if [ $# -gt 1 ] && [ "${2#--}" = "$2" ]; then value="$2"; shift; else value=1; fi
        ;;
      *) POSITIONAL+=("$1"); shift; continue ;;
    esac
    key="$(printf '%s' "${key#--}" | tr 'a-z-' 'A-Z_')"
    printf -v "FLAG_$key" '%s' "$value"
    shift
  done
}
flag() {
  local name
  name="FLAG_$(printf '%s' "$1" | tr 'a-z-' 'A-Z_')"
  printf '%s' "${!name:-}"
}

env_get() { grep -E "^$1=" "$REPO/.env" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

find_ssh_key() {
  local key
  for key in "$(flag ssh-key)" "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa" "$HOME/.ssh/id_rsa"; do
    if [ -n "$key" ] && [ -f "$key.pub" ]; then printf '%s' "$key"; return; fi
  done
}
md5_fingerprint() { ssh-keygen -E md5 -lf "$1" | awk '{print $2}' | sed 's/^MD5://'; }

state_file() { printf '%s/%s.env' "$STATE_DIR" "$1"; }
state_get() { grep -E "^$2=" "$(state_file "$1")" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
save_state() {
  local name="$1"; shift
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$@" > "$(state_file "$name")"
}

# run: execute, or print the command in --dry-run mode.
DRY_RUN=""
run() {
  if [ -n "$DRY_RUN" ]; then printf '+ %s\n' "$*" >&2; return 0; fi
  "$@"
}

# --- ports -------------------------------------------------------------------------
# Inbound ports the provider firewall must allow. ufw on the server is the real firewall;
# this list only matters for providers that block everything by default (AWS).
inbound_ports() {
  local access="$1" ssh_port
  ssh_port="$(env_get SSH_PORT)"; ssh_port="${ssh_port:-2222}"
  printf 'tcp 22 22\n'
  if [ "$access" = tailscale ]; then
    printf 'udp 41641 41641\n'
  else
    printf 'tcp %s %s\nudp 60000 60010\ntcp 22000 22000\nudp 22000 22000\n' "$ssh_port" "$ssh_port"
  fi
}

# --- providers ---------------------------------------------------------------------
need_cli() {
  case "$1" in
    hetzner)
      command -v hcloud >/dev/null || human "Install the Hetzner CLI: run 'brew install hcloud' (macOS) or see https://github.com/hetznercloud/cli. Then ask Claude to continue."
      hcloud server list -o noheader >/dev/null 2>&1 || human "Log in to Hetzner in your own terminal, not in the Claude chat: in https://console.hetzner.com open your project, Security > API tokens > Generate (Read & Write). Then run 'hcloud context create fraim' and paste the token at its prompt."
      ;;
    digitalocean)
      command -v doctl >/dev/null || human "Install the DigitalOcean CLI: run 'brew install doctl' (macOS) or see https://docs.digitalocean.com/reference/doctl/how-to/install/. Then ask Claude to continue."
      doctl account get >/dev/null 2>&1 || human "Log in to DigitalOcean in your own terminal, not in the Claude chat: create a token at https://cloud.digitalocean.com/account/api/tokens (full access), then run 'doctl auth init' and paste the token at its prompt."
      ;;
    aws)
      command -v aws >/dev/null || human "Install the AWS CLI: run 'brew install awscli' (macOS) or see https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html. Then ask Claude to continue."
      aws sts get-caller-identity >/dev/null 2>&1 || human "Log in to AWS in your own terminal, not in the Claude chat: run 'aws login' (or 'aws configure sso'). Then ask Claude to continue."
      ;;
    *) usage "--provider must be hetzner, digitalocean or aws (for any other provider: create the server yourself, then run 'fraim deploy USER@IP')" ;;
  esac
}

defaults() {
  local provider="$1" arch="$2"
  case "$provider:$arch" in
    hetzner:x86)       SIZE=cx23;          REGION=nbg1;         IMAGE=ubuntu-24.04;     PRICE="about EUR 5.50 per month" ;;
    hetzner:arm)       SIZE=cax11;         REGION=fsn1;         IMAGE=ubuntu-24.04;     PRICE="about EUR 6 per month" ;;
    digitalocean:x86)  SIZE=s-2vcpu-4gb;   REGION=ams3;         IMAGE=ubuntu-24-04-x64; PRICE="about USD 24 per month" ;;
    digitalocean:arm)  usage "DigitalOcean has no ARM droplets; use --arch x86" ;;
    aws:x86)           SIZE=t3.medium;     REGION="";           IMAGE=amd64;            PRICE="about USD 35 per month plus disk (30 GB gp3, about USD 3)" ;;
    aws:arm)           SIZE=t4g.medium;    REGION="";           IMAGE=arm64;            PRICE="about USD 28 per month plus disk (30 GB gp3, about USD 3)" ;;
    *) usage "--arch must be x86 or arm" ;;
  esac
  if [ "$provider" = aws ]; then
    REGION="$(aws configure get region 2>/dev/null || true)"; REGION="${REGION:-eu-central-1}"
  fi
}

hetzner_create() {
  local name="$1" key="$2" fp key_id
  fp="$(md5_fingerprint "$key.pub")"
  key_id="$(hcloud ssh-key list -o json | jq -r --arg fp "$fp" '.[] | select(.fingerprint == $fp) | .id' | head -1)"
  if [ -z "$key_id" ]; then
    run hcloud ssh-key create --name "fraim-$(whoami)-$(printf '%s' "$fp" | tr -d : | cut -c1-12)" --public-key-from-file "$key.pub" >/dev/null
    key_id="$(hcloud ssh-key list -o json | jq -r --arg fp "$fp" '.[] | select(.fingerprint == $fp) | .id' | head -1)"
  fi
  run hcloud server create --name "$name" --type "$SIZE" --image "$IMAGE" --location "$REGION" \
    --ssh-key "${key_id:-DRYRUN}" --user-data-from-file "$USER_DATA" --label managed-by=fraim >/dev/null
  if [ -n "$DRY_RUN" ]; then SERVER_ID=dry-run; SERVER_IP=203.0.113.10; return; fi
  SERVER_ID="$(hcloud server describe "$name" -o json | jq -r .id)"
  SERVER_IP="$(hcloud server ip "$name")"
}

digitalocean_create() {
  local name="$1" key="$2" fp
  fp="$(md5_fingerprint "$key.pub")"
  if ! doctl compute ssh-key get "$fp" >/dev/null 2>&1; then
    run doctl compute ssh-key import "fraim-$(whoami)-$(printf '%s' "$fp" | tr -d : | cut -c1-12)" --public-key-file "$key.pub" >/dev/null
  fi
  if [ -n "$DRY_RUN" ]; then
    run doctl compute droplet create "$name" --size "$SIZE" --image "$IMAGE" --region "$REGION" \
      --ssh-keys "$fp" --user-data-file "$USER_DATA" --tag-name fraim --wait
    SERVER_ID=dry-run; SERVER_IP=203.0.113.10; return
  fi
  local out
  out="$(doctl compute droplet create "$name" --size "$SIZE" --image "$IMAGE" --region "$REGION" \
    --ssh-keys "$fp" --user-data-file "$USER_DATA" --tag-name fraim --wait \
    --format ID,PublicIPv4 --no-header)"
  SERVER_ID="$(printf '%s' "$out" | awk '{print $1}')"
  SERVER_IP="$(printf '%s' "$out" | awk '{print $2}')"
}

aws_create() {
  local name="$1" key="$2" access="$3" key_name ami vpc sg proto from to
  local a=(aws --region "$REGION")
  key_name="fraim-$(whoami)-$(md5_fingerprint "$key.pub" | tr -d : | cut -c1-12)"
  if ! "${a[@]}" ec2 describe-key-pairs --key-names "$key_name" >/dev/null 2>&1; then
    run "${a[@]}" ec2 import-key-pair --key-name "$key_name" --public-key-material "fileb://$key.pub" >/dev/null
  fi
  ami="$("${a[@]}" ssm get-parameter --query Parameter.Value --output text \
    --name "/aws/service/canonical/ubuntu/server/24.04/stable/current/$IMAGE/hvm/ebs-gp3/ami-id")"
  vpc="$("${a[@]}" ec2 describe-vpcs --filters Name=isDefault,Values=true --query 'Vpcs[0].VpcId' --output text)"
  [ -n "$vpc" ] && [ "$vpc" != None ] || die "region $REGION has no default VPC; create one in the AWS console (VPC > Actions > Create default VPC) or use --region"

  sg="$("${a[@]}" ec2 describe-security-groups --filters "Name=group-name,Values=fraim-$name" "Name=vpc-id,Values=$vpc" \
    --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)"
  if [ -z "$sg" ] || [ "$sg" = None ]; then
    if [ -n "$DRY_RUN" ]; then
      run "${a[@]}" ec2 create-security-group --group-name "fraim-$name" --vpc-id "$vpc" --description "fraim $name"
      sg="sg-dryrun"
    else
      sg="$("${a[@]}" ec2 create-security-group --group-name "fraim-$name" --vpc-id "$vpc" \
        --description "fraim $name" --query GroupId --output text)"
    fi
    while read -r proto from to; do
      run "${a[@]}" ec2 authorize-security-group-ingress --group-id "$sg" \
        --ip-permissions "IpProtocol=$proto,FromPort=$from,ToPort=$to,IpRanges=[{CidrIp=0.0.0.0/0}],Ipv6Ranges=[{CidrIpv6=::/0}]" >/dev/null
    done < <(inbound_ports "$access")
  fi

  local run_args=(ec2 run-instances --image-id "$ami" --instance-type "$SIZE" --key-name "$key_name"
    --security-group-ids "$sg" --user-data "file://$USER_DATA"
    --block-device-mappings 'DeviceName=/dev/sda1,Ebs={VolumeSize=30,VolumeType=gp3,DeleteOnTermination=true}'
    --metadata-options 'HttpTokens=required,HttpEndpoint=enabled'
    --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=$name},{Key=managed-by,Value=fraim}]"
    --query 'Instances[0].InstanceId' --output text)
  if [ -n "$DRY_RUN" ]; then
    run "${a[@]}" "${run_args[@]}"
    SERVER_ID="i-dryrun"; SERVER_IP=203.0.113.10; SECURITY_GROUP="$sg"; return
  fi
  SERVER_ID="$("${a[@]}" "${run_args[@]}")"
  "${a[@]}" ec2 wait instance-running --instance-ids "$SERVER_ID"
  SERVER_IP="$("${a[@]}" ec2 describe-instances --instance-ids "$SERVER_ID" \
    --query 'Reservations[0].Instances[0].PublicIpAddress' --output text)"
  SECURITY_GROUP="$sg"
}

# --- prepare: make root@HOST work, wait for cloud-init, make sure rsync exists ------
# Offer only the fraim key. An agent with many keys (1Password, ...) hits MaxAuthTries first.
use_key() {
  case " ${SSH_BASE[*]} " in *" IdentitiesOnly=yes "*) return ;; esac
  SSH_BASE+=(-o IdentitiesOnly=yes -i "$1")
}
ssh_ok() { ssh "${SSH_BASE[@]}" "$1" true >/dev/null 2>&1; }

wait_for_ssh() {
  local target="$1"
  for _ in $(seq 60); do
    ssh_ok "$target" && return 0
    sleep 5
  done
  return 1
}

# Copies this laptop's key to root through sudo. Removes old lines for the same key first,
# because cloud images add a 'command="Please login as ubuntu"' line that would win.
enable_root() {
  local target="$1" key="$2" pub
  pub="$(cat "$key.pub")"
  # shellcheck disable=SC2087  # expands on the laptop on purpose
  ssh "${SSH_BASE[@]}" "$target" "sudo -n sh -s" <<EOF || return 1
set -e
body='$(printf '%s' "$pub" | awk '{print $2}')'
install -d -m 700 /root/.ssh
touch /root/.ssh/authorized_keys
grep -vF "\$body" /root/.ssh/authorized_keys > /root/.ssh/authorized_keys.fraim || true
printf '%s\n' '$pub' >> /root/.ssh/authorized_keys.fraim
mv /root/.ssh/authorized_keys.fraim /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
mkdir -p /etc/ssh/sshd_config.d
printf 'PermitRootLogin prohibit-password\n' > /etc/ssh/sshd_config.d/01-fraim-root.conf
systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
EOF
}

cmd_prepare() {
  parse_flags "$@"
  local target="${POSITIONAL[0]:-}" host user key
  [ -n "$target" ] || usage "fraim cloud prepare USER@IP"
  case "$target" in *@*) user="${target%@*}"; host="${target#*@}" ;; *) user=root; host="$target" ;; esac
  key="$(find_ssh_key)"
  [ -n "$key" ] || human "Create an SSH key on this computer: run ssh-keygen -t ed25519 and press Enter at every question."
  use_key "$key"

  if ! ssh_ok "root@$host"; then
    local tried="" u
    for u in "$user" ubuntu admin debian ec2-user; do
      [ "$u" != root ] || continue
      case " $tried " in *" $u "*) continue ;; esac
      tried="$tried $u"
      if ssh_ok "$u@$host"; then
        say "Giving root this laptop's SSH key through $u@$host (sudo)."
        enable_root "$u@$host" "$key" || die "$u@$host has no passwordless sudo; log in as root or a sudo user"
        break
      fi
    done
    ssh_ok "root@$host" || human "Claude cannot log in to $host as root or as$tried. Add the public key from $key.pub to the server (in the provider's console: SSH keys, then rebuild the server), or check the IP."
  fi

  # Fresh cloud servers run apt in cloud-init for the first minutes; install.sh must wait.
  ssh "${SSH_BASE[@]}" "root@$host" 'command -v cloud-init >/dev/null && cloud-init status --wait >/dev/null 2>&1; true'
  ssh "${SSH_BASE[@]}" "root@$host" sh -s <<'EOF' >&2
set -e
export LC_ALL=C
. /etc/os-release
case "$ID" in ubuntu|debian) ;; *) echo "fraim cloud: $ID is not supported; use Ubuntu 22.04+ or Debian 12+" >&2; exit 1 ;; esac
command -v rsync >/dev/null || { DEBIAN_FRONTEND=noninteractive apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q rsync; } >/dev/null
EOF
  printf 'root@%s\n' "$host"
}

# --- commands ----------------------------------------------------------------------
cmd_create() {
  parse_flags "$@"
  local provider name arch access key
  provider="$(flag provider)"
  [ -n "$provider" ] || usage "fraim cloud create --provider hetzner|digitalocean|aws [--name NAME] [--arch x86|arm] [--size S] [--region R] [--yes]"
  name="$(flag name)"; name="${name:-$(env_get FRAIM_HOSTNAME)}"; name="${name:-fraim-$(whoami)}"
  arch="$(flag arch)"; arch="${arch:-x86}"
  access="$(flag access)"; access="${access:-$(env_get ACCESS_MODE)}"; access="${access:-tailscale}"
  DRY_RUN="$(flag dry-run)"
  [ -z "$(state_get "$name" PROVIDER)" ] || usage "a server named $name already exists ($(state_get "$name" PROVIDER) $(state_get "$name" IP)); use --name or 'fraim cloud destroy --name $name'"

  case "$provider" in hetzner|digitalocean|aws) defaults "$provider" "$arch" ;; esac
  need_cli "$provider"
  [ "$provider" != aws ] || defaults "$provider" "$arch"
  [ -z "$(flag size)" ] || SIZE="$(flag size)"
  [ -z "$(flag region)" ] || REGION="$(flag region)"
  key="$(find_ssh_key)"
  [ -n "$key" ] || human "Create an SSH key on this computer: run ssh-keygen -t ed25519 and press Enter at every question."

  if [ -z "$(flag yes)" ] && [ -z "$DRY_RUN" ]; then
    say "Plan: $provider server '$name', type $SIZE, region $REGION, Ubuntu 24.04, $arch, $access access."
    say "Cost: $PRICE, billed by $provider until you destroy it."
    usage "this costs money; rerun with --yes after the user agrees"
  fi

  SECURITY_GROUP=""
  say "Creating $provider server '$name' ($SIZE in $REGION)."
  case "$provider" in
    hetzner) hetzner_create "$name" "$key" ;;
    digitalocean) digitalocean_create "$name" "$key" ;;
    aws) aws_create "$name" "$key" "$access" ;;
  esac
  [ -n "$DRY_RUN" ] && { printf 'root@%s\n' "$SERVER_IP"; return; }
  [ -n "${SERVER_IP:-}" ] && [ "$SERVER_IP" != None ] || die "the server was created (id $SERVER_ID) but has no public IPv4; check the provider console"

  save_state "$name" "PROVIDER=$provider" "ID=$SERVER_ID" "IP=$SERVER_IP" "REGION=$REGION" \
    "SIZE=$SIZE" "SECURITY_GROUP=$SECURITY_GROUP" "CREATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  say "Server $SERVER_ID has IP $SERVER_IP. Waiting for SSH."
  use_key "$key"
  ssh-keygen -R "$SERVER_IP" >/dev/null 2>&1 || true
  local u found=""
  for u in root ubuntu; do
    if wait_for_ssh "$u@$SERVER_IP"; then found="$u"; break; fi
  done
  [ -n "$found" ] || die "SSH on $SERVER_IP does not answer after 5 minutes; check the provider console"
  cmd_prepare "$found@$SERVER_IP"
}

cmd_destroy() {
  parse_flags "$@"
  local name provider id region sg
  name="$(flag name)"; name="${name:-$(env_get FRAIM_HOSTNAME)}"
  provider="$(state_get "$name" PROVIDER)"
  [ -n "$provider" ] || usage "no server named '$name' in $STATE_DIR; run 'fraim cloud list'"
  id="$(state_get "$name" ID)"; region="$(state_get "$name" REGION)"; sg="$(state_get "$name" SECURITY_GROUP)"
  if [ -z "$(flag yes)" ]; then
    say "This deletes $provider server '$name' ($id, $(state_get "$name" IP)) and its disk: the Claude login, files, browser profile and WhatsApp session on it."
    usage "this cannot be undone; rerun with --yes after the user agrees"
  fi
  need_cli "$provider"
  case "$provider" in
    hetzner) hcloud server delete "$id" >/dev/null ;;
    digitalocean) doctl compute droplet delete "$id" --force ;;
    aws)
      aws --region "$region" ec2 terminate-instances --instance-ids "$id" >/dev/null
      aws --region "$region" ec2 wait instance-terminated --instance-ids "$id"
      [ -z "$sg" ] || aws --region "$region" ec2 delete-security-group --group-id "$sg" \
        || say "could not delete security group $sg; delete it in the AWS console"
      ;;
  esac
  rm -f "$(state_file "$name")"
  say "Deleted $provider server '$name'. Also remove it from Tailscale: https://login.tailscale.com/admin/machines"
}

cmd_list() {
  local f
  [ -d "$STATE_DIR" ] || { say "No servers created with fraim cloud."; return; }
  for f in "$STATE_DIR"/*.env; do
    [ -f "$f" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$(basename "$f" .env)" \
      "$(grep ^PROVIDER= "$f" | cut -d= -f2)" "$(grep ^SIZE= "$f" | cut -d= -f2)" \
      "$(grep ^REGION= "$f" | cut -d= -f2)" "$(grep ^IP= "$f" | cut -d= -f2)"
  done
}

cmd_help() {
  cat <<'EOF'
fraim cloud: create the server, then run 'fraim deploy root@IP'.

  fraim cloud create --provider hetzner|digitalocean|aws [--name NAME] [--arch x86|arm]
                     [--size TYPE] [--region R] [--access tailscale|public] [--dry-run] [--yes]
      Without --yes: prints the plan and the cost, exits 2. Last output line: root@IP.
  fraim cloud prepare USER@IP      any other provider: make root@IP ready (sudo user is fine)
  fraim cloud destroy --name NAME [--yes]
  fraim cloud list

Defaults: Hetzner cx23 (arm: cax11) in nbg1, DigitalOcean s-2vcpu-4gb in ams3,
AWS t3.medium (arm: t4g.medium) with 30 GB disk in your default region.
Every server: Ubuntu 24.04 and deploy/cloud-init.yaml as user data.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    create) cmd_create "$@" ;;
    prepare) cmd_prepare "$@" ;;
    destroy) cmd_destroy "$@" ;;
    list) cmd_list ;;
    help|-h|--help) cmd_help ;;
    *) usage "unknown command '$cmd'; run 'fraim cloud help'" ;;
  esac
}

main "$@"
