{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "theme": "graphite",
  "traffic_lights": [
    16,
    18
  ],
  "ui_font": "Inter",
  "terminal_padding": [
    16,
    10
  ],
  "background": "#0b0b0c",
  "colors": {
    "background": "#0b0b0c",
    "surface": "#0b0b0c",
    "chrome": "#0b0b0c",
    "canvas": "#0b0b0c",
    "raised": "#101012",
    "popover": "#101012",
    "foreground": "#d4d4d8",
    "terminal_foreground": "#d4d4d8",
    "muted": "#8b8b94",
    "dim": "#5f5f68",
    "border": "#1f1f23",
    "input": "#2a2a2f",
    "accent": "#5e6ad2",
    "selection": "#1c1d23",
    "selected": "#1c1d23",
    "hover": "#17171a"
  },
  "children": [
    {
      "id": "top",
      "type": "block",
      "size": {
        "px": 36
      },
      "window_drag": true,
      "background": "#0b0b0c",
      "content": {
        "mod": "fraim",
        "props": {
          "role": "top"
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "resizable": true,
      "divider": {
        "width": 1,
        "color": "#1f1f23"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 240
          },
          "min": 200,
          "max": 360,
          "background": "#0b0b0c",
          "resizable": true,
          "divider": {
            "width": 1,
            "color": "#1f1f23"
          },
          "children": [
            {
              "id": "fraim-side",
              "type": "block",
              "size": {
                "weight": 3
              },
              "min": 160,
              "content": {
                "mod": "fraim",
                "props": {
                  "role": "sidebar"
                }
              }
            },
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 69
              },
              "content": {
                "mod": "workspace-chrome",
                "props": {
                  "footer": true
                }
              }
            }
          ]
        },
        {
          "id": "chief",
          "type": "column",
          "size": {
            "weight": 1
          },
          "min": 420,
          "background": "#0b0b0c",
          "children": [
            {
              "id": "chief-head",
              "type": "block",
              "size": {
                "px": 44
              },
              "content": {
                "mod": "fraim",
                "props": {
                  "role": "chiefhead"
                }
              }
            },
            {
              "id": "chief-term",
              "type": "block",
              "content": {
                "terminal": "fraim/main"
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "size": {
            "weight": 1
          },
          "min": 420,
          "background": "#0b0b0c",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 42
              },
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "terminals",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 6,
                  "radius": 6,
                  "background": "#0b0b0c",
                  "border": {
                    "width": 1,
                    "color": "#1f1f23"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#2a2a2f"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
