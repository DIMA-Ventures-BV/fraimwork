#!/bin/sh
# fraim-secret: the keys the secrets proxy adds to requests. Runs inside the secrets container.
#
#   fraim-secret add NAME --upstream https://host [--header Authorization] [--format 'Bearer %s']
#   fraim-secret set NAME          the key comes from stdin, never from an argument
#   fraim-secret rm NAME
#   fraim-secret list              names, upstreams and headers; never a key
#   fraim-secret render            rewrite the Caddyfile and reload Caddy
#
# Claude's workspace calls http://secrets:8080/NAME/... with the session token (SECRETS_TOKEN)
# in the configured header. The proxy checks it, puts the real key in its place and forwards
# the request to the one upstream of NAME. Claude never holds a real key.
# Exit codes: 0 ok, 1 failure, 2 usage.
set -eu

STORE="${FRAIM_SECRETS_DIR:-/data/secrets}"
CADDYFILE="${FRAIM_SECRETS_CADDYFILE:-/etc/caddy/Caddyfile}"

die() { echo "fraim-secret: $*" >&2; exit 1; }
usage() { echo "fraim-secret: $*" >&2; exit 2; }

valid_name() { printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9-]{0,30}$'; }
valid_header() { printf '%s' "$1" | grep -Eq '^[A-Za-z][A-Za-z0-9-]{0,63}$'; }
# Exactly one %s and nothing that could break the Caddyfile.
valid_format() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9 _:-]*%s[A-Za-z0-9 _:-]*$'
}
# A key or token: visible ASCII only, and none of " \ { } ` (Caddyfile quoting and placeholders).
valid_value() {
  [ -n "$1" ] || return 1
  if printf '%s' "$1" | LC_ALL=C grep -q '[^[:graph:]]'; then return 1; fi
  if printf '%s' "$1" | grep -q '["\\{}`]'; then return 1; fi
  return 0
}
# Scheme and host (and port) only: Caddy upstreams cannot carry a path.
valid_upstream() {
  if printf '%s' "$1" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$'; then return 0; fi
  # Plain http only for tests, never in production.
  if [ "${SECRETS_ALLOW_HTTP:-}" = 1 ] && printf '%s' "$1" | grep -Eq '^http://[A-Za-z0-9.-]+(:[0-9]{1,5})?$'; then return 0; fi
  return 1
}

field() { sed -n "s/^$1=//p" "$2" | head -1; }

prepare() {
  umask 077
  mkdir -p "$STORE/routes" "$STORE/values"
  chmod 700 "$STORE" "$STORE/routes" "$STORE/values"
}

render() {
  token="${SECRETS_TOKEN:-}"
  tmp="$CADDYFILE.tmp"
  umask 077
  {
    printf '{\n\tadmin localhost:2019\n\tauto_https off\n\tpersist_config off\n}\n\n'
    printf ':8080 {\n'
    printf '\thandle /healthz {\n\t\trespond "ok" 200\n\t}\n'
    if ! valid_value "$token"; then
      # No usable session token: refuse every request (fail closed).
      printf '\thandle {\n\t\trespond "fraim secrets: SECRETS_TOKEN is not set; run install.sh" 503\n\t}\n}\n'
    else
      services="NAME HEADER FORMAT UPSTREAM
"
      for route in "$STORE"/routes/*; do
        [ -f "$route" ] || continue
        name="$(basename "$route")"
        valid_name "$name" || continue
        [ -s "$STORE/values/$name" ] || continue
        upstream="$(field UPSTREAM "$route")"
        header="$(field HEADER "$route")"
        format="$(field FORMAT "$route")"
        value="$(cat "$STORE/values/$name")"
        valid_upstream "$upstream" && valid_header "$header" && valid_format "$format" && valid_value "$value" || continue
        # shellcheck disable=SC2059  # the format is validated: exactly one %s
        phantom="$(printf "$format" "$token")"
        # shellcheck disable=SC2059
        real="$(printf "$format" "$value")"
        printf '\t@%s {\n\t\tpath /%s /%s/*\n\t\theader %s "%s"\n\t}\n' "$name" "$name" "$name" "$header" "$phantom"
        printf '\thandle @%s {\n\t\turi strip_prefix /%s\n' "$name" "$name"
        printf '\t\treverse_proxy %s {\n\t\t\theader_up Host {upstream_hostport}\n\t\t\theader_up %s "%s"\n\t\t}\n\t}\n' \
          "$upstream" "$header" "$real"
        services="$services$name $header $format $upstream
"
      done
      # Names, headers and upstreams only, so Claude can find what exists. Never a key.
      printf '\thandle /_services {\n\t\trespond <<SERVICES\n'
      tab="$(printf '\t')"
      printf '%s' "$services" | sed "s/^/$tab$tab/"
      printf '\t\tSERVICES 200\n\t}\n'
      printf '\thandle {\n\t\trespond "fraim secrets: unknown service or wrong token" 401\n\t}\n}\n'
    fi
  } > "$tmp"
  mv "$tmp" "$CADDYFILE"
}

reload() {
  render
  # Not running yet (the entrypoint renders before Caddy starts): nothing to reload.
  if wget -q -O /dev/null http://127.0.0.1:8080/healthz 2>/dev/null; then
    caddy reload --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 || die "Caddy refused the new config"
  fi
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
prepare
case "$cmd" in
  add)
    name="${1:-}"; [ $# -gt 0 ] && shift
    valid_name "$name" || usage "NAME must be lowercase letters, digits and dashes, starting with a letter"
    upstream="" header="Authorization" format="Bearer %s"
    while [ $# -gt 0 ]; do
      case "$1" in
        --upstream) upstream="${2:-}"; shift 2 ;;
        --header) header="${2:-}"; shift 2 ;;
        --format) format="${2:-}"; shift 2 ;;
        *) usage "unknown option $1" ;;
      esac
    done
    valid_upstream "$upstream" || usage "--upstream must be https://host or https://host:port (no path)"
    valid_header "$header" || usage "--header must be a header name, like Authorization or x-api-key"
    valid_format "$format" || usage "--format must contain %s exactly once, like 'Bearer %s' or '%s'"
    printf 'UPSTREAM=%s\nHEADER=%s\nFORMAT=%s\n' "$upstream" "$header" "$format" > "$STORE/routes/$name"
    reload
    if [ -s "$STORE/values/$name" ]; then
      echo "Updated $name ($upstream)."
    else
      echo "Added $name ($upstream). It works once its key is set."
    fi
    ;;
  set)
    name="${1:-}"
    valid_name "$name" || usage "fraim-secret set NAME (the key comes from stdin)"
    [ -f "$STORE/routes/$name" ] || usage "unknown service $name; add it first"
    value="$(cat | tr -d '\r\n')"
    valid_value "$value" || usage "the key is empty or has characters a key never has (spaces, quotes, braces)"
    printf '%s' "$value" > "$STORE/values/$name"
    reload
    echo "Key for $name stored. It is never shown again."
    ;;
  rm)
    name="${1:-}"
    valid_name "$name" || usage "fraim-secret rm NAME"
    [ -f "$STORE/routes/$name" ] || usage "unknown service $name"
    rm -f "$STORE/routes/$name" "$STORE/values/$name"
    reload
    echo "Removed $name and its key."
    ;;
  list)
    found=0
    for route in "$STORE"/routes/*; do
      [ -f "$route" ] || continue
      found=1
      name="$(basename "$route")"
      if [ -s "$STORE/values/$name" ]; then state="key set"; else state="no key yet"; fi
      printf '%s\t%s\t%s\t%s\n' "$name" "$(field UPSTREAM "$route")" "$(field HEADER "$route")" "$state"
    done
    [ "$found" = 1 ] || echo "No services yet. Add one with: fraim secret add NAME --upstream https://host"
    ;;
  render) reload ;;
  *) usage "add NAME --upstream URL [--header H] [--format F] | set NAME | rm NAME | list | render" ;;
esac
