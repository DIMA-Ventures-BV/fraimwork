#!/bin/sh
# fraim-secret-gate: one connection on port 8081 of the secrets container.
# A laptop that was invited has no root on the server, so it cannot run fraim-secret itself.
# It sends its gate token and one command here. The server keeps only the token's hash, so
# Claude on the server cannot use the gate. The laptop can store keys, never read them.
#
#   line 1: the gate token
#   line 2: add<TAB>NAME<TAB>UPSTREAM<TAB>HEADER<TAB>FORMAT | set<TAB>NAME | has<TAB>NAME
#   line 3: the key (set only)
# Answers one line: "ok ..." or "error ...".
set -u

STORE="${FRAIM_SECRETS_DIR:-/data/secrets}"
SECRET="${FRAIM_SECRET_BIN:-fraim-secret}"

answer() {
  if out="$("$@" 2>&1 </dev/null)"; then echo "ok $out"; else echo "error $out"; fi
}

IFS= read -r token || exit 0
IFS= read -r request || exit 0

hash="$(printf '%s' "$token" | sha256sum | cut -d' ' -f1)"
allowed=""
for gate in "$STORE"/gates/*; do
  [ -f "$gate" ] || continue
  [ "$(cat "$gate")" = "$hash" ] && allowed=1
done
[ -n "$allowed" ] || { echo "error refused"; exit 0; }

tab="$(printf '\t')"
set -f
IFS="$tab"
# shellcheck disable=SC2086  # split on tabs on purpose
set -- $request
unset IFS
set +f

case "${1:-}" in
  add)
    [ $# -eq 5 ] || { echo "error usage"; exit 0; }
    answer "$SECRET" add "$2" --upstream "$3" --header "$4" --format "$5"
    ;;
  set)
    [ $# -eq 2 ] || { echo "error usage"; exit 0; }
    IFS= read -r value || [ -n "${value:-}" ] || { echo "error no key"; exit 0; }
    if out="$(printf '%s' "$value" | "$SECRET" set "$2" 2>&1)"; then echo "ok $out"; else echo "error $out"; fi
    ;;
  has)
    [ $# -eq 2 ] || { echo "error usage"; exit 0; }
    if "$SECRET" list 2>/dev/null | awk -F'\t' -v n="$2" '$1 == n && $4 == "key set" { f = 1 } END { exit !f }'; then
      echo "ok yes"
    else
      echo "ok no"
    fi
    ;;
  *) echo "error usage" ;;
esac
