#!/usr/bin/env bash
# A fake herdr-core CLI for the unit tests. Terminals are JSON files in $HC_FAKE.
#   FAKE_REPLY       what Claude "answers" after a send (written to its transcript)
#   FAKE_SEND_STATE  status after a send: done (default), working (stays busy), blocked, error
#   FAKE_RUN_FAIL=1  run fails
#   FAKE_SCREEN      what read prints
#   FAKE_SEND_HOOK   a program to run on every send (to write files a real run writes)
#   FAKE_BLOCK_KIND  status.kind after a send (question by default; permission for a menu)
#   FAKE_EVENTS      a file of JSON-RPC event lines that `hc events` prints
#   $HC_FAKE/events-down  `hc events --terminal` fails at once (no stream)
#   $HC_FAKE/noise   `hc events --terminal` also prints heartbeats and title changes
#   $HC_FAKE/get-fail  a count of gets that fail with exit 1 (a busy core), then work again
# Every call is logged to $HC_FAKE/calls.
set -u
d="${HC_FAKE:?}"
mkdir -p "$d"
printf '%s\n' "$*" >> "$d/calls"
json=0
args=()
for a in "$@"; do [ "$a" = --json ] && json=1 || args+=("$a"); done
set -- ${args[@]+"${args[@]}"}
cmd="${1:-}"
[ $# -eq 0 ] || shift

file() { printf '%s/t-%s.json' "$d" "$1"; }
need() { [ -f "$(file "$1")" ] || { echo '{"error":{"kind":"not_found"}}' >&2; exit 3; }; }
set_field() {
  local f
  f="$(file "$1")"
  until mkdir "$f.lock" 2>/dev/null; do sleep 0.01; done
  jq "if .state == \"finished\" then . else $2 end" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  rmdir "$f.lock"
}

case "$cmd" in
  server) echo '{"live":0}' ;;
  run)
    [ -z "${FAKE_RUN_FAIL:-}" ] || { echo '{"error":{"kind":"spawn_failed"}}' >&2; exit 1; }
    name="" cwd="" labels='{}'
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift 2 ;;
        --cwd) cwd="$2"; shift 2 ;;
        --label) labels="$(jq --arg k "${2%%=*}" --arg v "${2#*=}" '. + {($k): $v}' <<<"$labels")"; shift 2 ;;
        --bg|--no-parent|--no-notify|--keep|--rm|--outlive-parent) shift ;;
        --) shift; break ;;
        *) break ;;
      esac
    done
    [ -n "$name" ] || name="t$RANDOM"
    printf '%s\n' "$@" > "$d/$name.argv"
    jq -n --arg n "$name" --arg c "$cwd" --argjson l "$labels" \
      '{address: $n, name: $n, cwd: $c, labels: $l, state: "live", status: {app: "claude-code", state: "idle"}, turn: 0, foreground: {pid: 4242}}' > "$(file "$name")"
    # FAKE_RUN_REPLY: Claude answers the task it was started with (its first turn ends done).
    # FAKE_RUN_EXIT: the program exits at once with this code (75: no free memory).
    if [ -n "${FAKE_RUN_EXIT:-}" ]; then
      set_field "$name" ".state = \"finished\" | .status = null | .exit_code = ${FAKE_RUN_EXIT}"
    elif [ -n "${FAKE_RUN_REPLY:-}" ]; then
      sid="$(grep -A1 -E '^--session-id$' "$d/$name.argv" | tail -1)"
      mkdir -p "$HOME/.claude/projects/-fake"
      jq -cn --arg t "$FAKE_RUN_REPLY" '{type: "assistant", message: {content: [{type: "text", text: $t}]}}' >> "$HOME/.claude/projects/-fake/$sid.jsonl"
      set_field "$name" '.turn = 1 | .status.state = "done"'
    fi
    jq -c '{address, name, state}' "$(file "$name")" ;;
  get)
    # $HC_FAKE/get-fail holds a count: that many gets fail with exit 1 (a busy core).
    if [ -s "$d/get-fail" ] && [ "$(cat "$d/get-fail")" -gt 0 ]; then
      echo $(( $(cat "$d/get-fail") - 1 )) > "$d/get-fail"
      echo '{"error":{"kind":"unavailable"}}' >&2
      exit 1
    fi
    need "$1"; cat "$(file "$1")" ;;
  ls)
    # Like the real hc: live terminals only, a short record (status as one word, no labels).
    label=""
    [ "${1:-}" != --label ] || label="$2"
    shopt -s nullglob
    files=("$d"/t-*.json)
    if [ ${#files[@]} -eq 0 ]; then echo '{"terminals":[],"hidden_finished":0}'
    else
      jq -s --arg k "${label%%=*}" --arg v "${label#*=}" \
        '{terminals: [.[] | select(.state == "live") | select($k == "" or .labels[$k] == $v)
          | {address, name, cwd, state, status: (.status.state // null), turn}], hidden_finished: 0}' "${files[@]}"
    fi ;;
  wait)
    need "$1"
    [ "$(jq -r '.status.state' "$(file "$1")")" != working ] || sleep 0.2
    jq -c '{reason: "status", status: .status.state, turn}' "$(file "$1")" ;;
  send)
    force=0
    [ "$1" != --force ] || { force=1; shift; }
    need "$1"
    st="$(jq -r '.status.state' "$(file "$1")")"
    if [ "$st" = blocked ] && [ "$force" = 0 ]; then echo '{"error":{"kind":"blocked"}}' >&2; exit 9; fi
    printf '%s\n---\n' "$2" >> "$d/$1.sent"
    [ -z "${FAKE_SEND_HOOK:-}" ] || "$FAKE_SEND_HOOK"
    sid="$(grep -A1 -E '^--(session-id|resume)$' "$d/$1.argv" | tail -1)"
    if [ -n "$sid" ] && [ -n "${FAKE_REPLY:-}" ]; then
      mkdir -p "$HOME/.claude/projects/-fake"
      jq -cn --arg t "$FAKE_REPLY" '{type: "assistant", message: {content: [{type: "text", text: $t}]}}' >> "$HOME/.claude/projects/-fake/$sid.jsonl"
    fi
    set_field "$1" ".turn += 1 | .status.state = \"${FAKE_SEND_STATE:-done}\" | .status.kind = \"${FAKE_BLOCK_KIND:-question}\""
    echo '{"started":true}' ;;
  keys) need "$1"; n="$1"; shift; printf '%s\n' "$*" >> "$d/$n.keys" ;;
  read) need "$1"; printf '%s\n' "${FAKE_SCREEN:-screen of $1}" ;;
  kill) need "$1"; set_field "$1" '.state = "finished" | .status = null' ;;
  rm) [ -f "$(file "$1")" ] && rm -f "$(file "$1")" ;;
  attach) need "$1"; echo "attached $1" ;;
  exec) [ ! -e "$d/busy" ] || echo bash ;;
  events)
    if [ "${1:-}" != --terminal ]; then
      [ -z "${FAKE_EVENTS:-}" ] || cat "$FAKE_EVENTS"
      exit 0
    fi
    [ ! -e "$d/events-down" ] || { echo '{"error":{"kind":"unavailable"}}' >&2; exit 1; }
    need "$2"
    printf '%s\n' "$$" >> "$d/events.pids"
    f="$(file "$2")"
    ev() { jq -cn --arg k "$1" --arg t "$2" --arg s "${3:-}" '{jsonrpc: "2.0", method: "event", params: {type: $k, terminal: $t, data: {status: {state: $s}}, seq: 2}}'; }
    jq -c '{seq: 1, terminals: [.]}' "$f"
    was="$(jq -r '"\(.state) \(.status.state // "none") \(.turn)"' "$f")"
    for _ in $(seq 400); do
      sleep 0.05
      [ ! -e "$d/noise" ] || { echo '{"jsonrpc":"2.0","method":"heartbeat","params":{"seq":2}}'; ev title "$2"; }
      [ -f "$f" ] || { ev removed "$2"; continue; }
      now="$(jq -r '"\(.state) \(.status.state // "none") \(.turn)"' "$f")"
      [ "$now" != "$was" ] || continue
      read -r state status _ <<<"$now"
      if [ "$state" = live ]; then ev status "$2" "$status"; else ev finished "$2"; fi
      was="$now"
    done ;;
  *) echo "fake hc: $cmd not faked" >&2; exit 2 ;;
esac
: "$json"
