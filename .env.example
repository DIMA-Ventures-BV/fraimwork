# fraimwork server configuration. `fraim init` fills this in for you.
# install.sh generates the secrets marked "generated" and sets BIND_IP / PRIVATE_BIND_IP.

# Name of the server on your tailnet, e.g. fraim-michael
FRAIM_HOSTNAME=fraim

# tailscale (recommended: no public ports) or public (SSH keys only, firewall)
ACCESS_MODE=tailscale

# One-time Tailscale auth key, tagged tag:fraim. install.sh clears it after use.
TS_AUTHKEY=

# Modules to run: any of sync,browser,whatsapp,scheduler,google
# browser costs about 1.5 GB of memory; add it when a service needs a real browser login.
COMPOSE_PROFILES=sync,whatsapp,scheduler

TZ=Europe/Amsterdam
SSH_PORT=2222

# Updates: on = the server installs new releases by itself in the night window, checks its
# health and goes back if something breaks. stable waits 24 hours, canary installs at once.
AUTO_UPDATE=on
UPDATE_RING=stable
UPDATE_WINDOW=3-5

# WhatsApp voice messages need a speech engine of 622 MB. Empty: on with WhatsApp, off without.
VOICE=

# WhatsApp: the owner's personal number (gets approvals and notifications),
# plus extra numbers allowed to talk to the agent. International format, digits only.
WHATSAPP_OWNER=
WHATSAPP_ALLOW=

# The WhatsApp channel is a Claude Code development channel, which shows a confirmation
# screen at every start. 1 = confirm it automatically so Claude restarts unattended.
AUTO_CONFIRM_CHANNEL=1

# all = every Claude on the server (session, goals, leads, automations) runs with
# --dangerously-skip-permissions, so nothing waits for an approval nobody gives.
# The managed deny rules (key files, sudo) still apply. ask = only the listed tools run.
PERMISSIONS=all

# Generated by install.sh
GATEWAY_TOKEN=
VNC_PASSWORD=
SYNCTHING_GUI_PASSWORD=
SECRETS_TOKEN=

# Set by install.sh
BIND_IP=
PRIVATE_BIND_IP=
BROWSER_VIEW_URL=
