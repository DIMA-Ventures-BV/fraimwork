// Tailscale access policy for fraimwork.
//
// IMPORTANT: this file REPLACES your tailnet's whole policy when you paste it.
// If your tailnet already has rules you care about, merge the groups, tagOwners,
// grants and ssh entries below into your existing policy instead.
// `fraim tailscale policy --email you@example.com` prints this file filled in.
//
// Use one tailnet per person: everyone in group:fraim-users can reach EVERY tag:fraim
// server on the tailnet. Do not put several people's fraim servers in one tailnet.
//
// Effect:
//   - Your own devices (laptop, phone) can still reach each other.
//   - People in group:fraim-users can reach fraim servers on the fraim ports.
//   - fraim servers can reach NOTHING on the tailnet, so a server can never
//     connect to a laptop or phone (there is no grant with tag:fraim as src).
//   - Admins get a root shell on servers with Tailscale SSH, without re-login
//     prompts, so Claude can run admin commands unattended.
{
  "groups": {
    "group:fraim-users": ["owner@example.com"],
    "group:fraim-admins": ["owner@example.com"],
  },

  "tagOwners": {
    "tag:fraim": ["group:fraim-admins"],
  },

  "grants": [
    {
      // keep every member's own devices connected to each other
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "ip": ["*"],
    },
    {
      // workspace SSH, mosh, noVNC, Syncthing GUI and sync, for the main space and up to
      // four more spaces (space n uses port + n, mosh + 20n), plus dev server previews
      "src": ["group:fraim-users"],
      "dst": ["tag:fraim"],
      "ip": [
        "tcp:2222-2226", "udp:60000-60090", "tcp:6080-6084", "tcp:8384-8388",
        "tcp:22000-22004", "udp:22000-22004", "tcp:3100-3149",
      ],
    },
    {
      // Tailscale SSH for admins: the ssh rule below authorizes the login, but the
      // packet filter must also allow port 22, or `fraim lock` can never succeed.
      "src": ["group:fraim-admins"],
      "dst": ["tag:fraim"],
      "ip": ["tcp:22"],
    },
  ],

  "ssh": [
    {
      "action": "accept",
      "src": ["group:fraim-admins"],
      "dst": ["tag:fraim"],
      "users": ["root"],
    },
  ],
}
