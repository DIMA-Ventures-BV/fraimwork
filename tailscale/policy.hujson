// Tailscale access policy for fraimwork. Paste into https://login.tailscale.com/admin/acls
// and replace the example addresses.
//
// Effect:
//   - People in group:fraim-users can reach fraim servers on the fraim ports.
//   - fraim servers can reach NOTHING on the tailnet, so a server can never
//     connect to a laptop or phone (there is no grant with tag:fraim as src).
//   - Admins can open a root shell on servers with Tailscale SSH.
{
  "groups": {
    "group:fraim-users": ["michael@example.com"],
    "group:fraim-admins": ["michael@example.com"],
  },

  "tagOwners": {
    "tag:fraim": ["group:fraim-admins"],
  },

  "grants": [
    {
      // workspace SSH, mosh, noVNC, Syncthing GUI and sync
      "src": ["group:fraim-users"],
      "dst": ["tag:fraim"],
      "ip": ["tcp:2222", "udp:60000-60010", "tcp:6080", "tcp:8384", "tcp:22000", "udp:22000"],
    },
  ],

  "ssh": [
    {
      "action": "check",
      "src": ["group:fraim-admins"],
      "dst": ["tag:fraim"],
      "users": ["root"],
    },
  ],
}
